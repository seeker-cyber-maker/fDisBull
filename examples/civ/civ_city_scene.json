    "view-map": {
      "format": "fdisbull-il-1",
      "role": "uil",
      "variables": {
        "$view_mode": {"type": "u8", "initial": 0},
        "$city_size": {"type": "i16", "initial": 1},
        "$food_box": {"type": "i16", "initial": 0},
        "$shield_box": {"type": "i16", "initial": 0},
        "$production": {"type": "i16", "initial": 0},
        "$city_status": {"type": "u8", "initial": 0},
        "$city_owner": {"type": "u8", "initial": 0},
        "$auto_build": {"type": "bool", "initial": false},
        "$chooser_open": {"type": "bool", "initial": false},
        "$unit_list_open": {"type": "bool", "initial": false},
        "$unit_cursor": {"type": "i16", "initial": 0},
        "$unit_last": {"type": "i16", "initial": 0},
        "$unit_count": {"type": "i16", "initial": 0},
        "$city_cursor": {"type": "i16", "initial": 0}
      },
      "resources": {
        "map-caption": {"kind": "text", "text": "Map"}
      },
      "body": [
        {"id": "select-map", "op": "set", "var": "$view_mode", "value": 2},
        {"id": "announce-map", "op": "text", "resource": "map-caption"}
      ]
    },
    "view-history": {
      "format": "fdisbull-il-1",
      "role": "uil",
      "variables": {
        "$view_mode": {"type": "u8", "initial": 0},
        "$city_size": {"type": "i16", "initial": 1},
        "$food_box": {"type": "i16", "initial": 0},
        "$shield_box": {"type": "i16", "initial": 0},
        "$production": {"type": "i16", "initial": 0},
        "$city_status": {"type": "u8", "initial": 0},
        "$city_owner": {"type": "u8", "initial": 0},
        "$auto_build": {"type": "bool", "initial": false},
        "$chooser_open": {"type": "bool", "initial": false},
        "$unit_list_open": {"type": "bool", "initial": false},
        "$unit_cursor": {"type": "i16", "initial": 0},
        "$unit_last": {"type": "i16", "initial": 0},
        "$unit_count": {"type": "i16", "initial": 0},
        "$city_cursor": {"type": "i16", "initial": 0}
      },
      "resources": {
        "history-caption": {"kind": "text", "text": "City View"}
      },
      "body": [
        {"id": "select-history", "op": "set", "var": "$view_mode", "value": 3},
        {"id": "announce-history", "op": "text", "resource": "history-caption"}
      ]
    },
    "open-production": {
      "format": "fdisbull-il-1",
      "role": "uil",
      "variables": {
        "$view_mode": {"type": "u8", "initial": 0},
        "$city_size": {"type": "i16", "initial": 1},
        "$food_box": {"type": "i16", "initial": 0},
        "$shield_box": {"type": "i16", "initial": 0},
        "$production": {"type": "i16", "initial": 0},
        "$city_status": {"type": "u8", "initial": 0},
        "$city_owner": {"type": "u8", "initial": 0},
        "$auto_build": {"type": "bool", "initial": false},
        "$chooser_open": {"type": "bool", "initial": false},
        "$unit_list_open": {"type": "bool", "initial": false},
        "$unit_cursor": {"type": "i16", "initial": 0},
        "$unit_last": {"type": "i16", "initial": 0},
        "$unit_count": {"type": "i16", "initial": 0},
        "$city_cursor": {"type": "i16", "initial": 0}
      },
      "resources": {
        "chooser-prompt": {"kind": "text", "text": "What shall we build in Rome?\n 1 Settlers (40 turns)\n 2 Militia (10 turns)"}
      },
      "body": [
        {"id": "require-closed", "op": "require", "condition": {"op": "eq", "left": {"var": "$chooser_open"}, "right": false}},
        {"id": "open", "op": "set", "var": "$chooser_open", "value": true},
        {"id": "prompt", "op": "text", "resource": "chooser-prompt"}
      ]
    },
    "build-settlers": {
      "format": "fdisbull-il-1",
      "role": "uil",
      "variables": {
        "$view_mode": {"type": "u8", "initial": 0},
        "$city_size": {"type": "i16", "initial": 1},
        "$food_box": {"type": "i16", "initial": 0},
        "$shield_box": {"type": "i16", "initial": 0},
        "$production": {"type": "i16", "initial": 0},
        "$city_status": {"type": "u8", "initial": 0},
        "$city_owner": {"type": "u8", "initial": 0},
        "$auto_build": {"type": "bool", "initial": false},
        "$chooser_open": {"type": "bool", "initial": false},
        "$unit_list_open": {"type": "bool", "initial": false},
        "$unit_cursor": {"type": "i16", "initial": 0},
        "$unit_last": {"type": "i16", "initial": 0},
        "$unit_count": {"type": "i16", "initial": 0},
        "$city_cursor": {"type": "i16", "initial": 0}
      },
      "resources": {
        "settlers-caption": {"kind": "text", "text": "Settlers (40 turns)"}
      },
      "body": [
        {"id": "require-open", "op": "require", "condition": {"op": "eq", "left": {"var": "$chooser_open"}, "right": true}},
        {"id": "commit", "op": "set", "var": "$production", "value": 0},
        {"id": "close", "op": "set", "var": "$chooser_open", "value": false},
        {"id": "announce", "op": "text", "resource": "settlers-caption"}
      ]
    },
    "build-militia": {
      "format": "fdisbull-il-1",
      "role": "uil",
      "variables": {
        "$view_mode": {"type": "u8", "initial": 0},
        "$city_size": {"type": "i16", "initial": 1},
        "$food_box": {"type": "i16", "initial": 0},
        "$shield_box": {"type": "i16", "initial": 0},
        "$production": {"type": "i16", "initial": 0},
        "$city_status": {"type": "u8", "initial": 0},
        "$city_owner": {"type": "u8", "initial": 0},
        "$auto_build": {"type": "bool", "initial": false},
        "$chooser_open": {"type": "bool", "initial": false},
        "$unit_list_open": {"type": "bool", "initial": false},
        "$unit_cursor": {"type": "i16", "initial": 0},
        "$unit_last": {"type": "i16", "initial": 0},
        "$unit_count": {"type": "i16", "initial": 0},
        "$city_cursor": {"type": "i16", "initial": 0}
      },
      "resources": {
        "militia-caption": {"kind": "text", "text": "Militia (10 turns)"}
      },
      "body": [
        {"id": "require-open", "op": "require", "condition": {"op": "eq", "left": {"var": "$chooser_open"}, "right": true}},
        {"id": "commit", "op": "set", "var": "$production", "value": 1},
        {"id": "close", "op": "set", "var": "$chooser_open", "value": false},
        {"id": "announce", "op": "text", "resource": "militia-caption"}
      ]
    },
    "toggle-auto": {
      "format": "fdisbull-il-1",
      "role": "uil",
      "variables": {
        "$view_mode": {"type": "u8", "initial": 0},
        "$city_size": {"type": "i16", "initial": 1},
        "$food_box": {"type": "i16", "initial": 0},
        "$shield_box": {"type": "i16", "initial": 0},
        "$production": {"type": "i16", "initial": 0},
        "$city_status": {"type": "u8", "initial": 0},
        "$city_owner": {"type": "u8", "initial": 0},
        "$auto_build": {"type": "bool", "initial": false},
        "$chooser_open": {"type": "bool", "initial": false},
        "$unit_list_open": {"type": "bool", "initial": false},
        "$unit_cursor": {"type": "i16", "initial": 0},
        "$unit_last": {"type": "i16", "initial": 0},
        "$unit_count": {"type": "i16", "initial": 0},
        "$city_cursor": {"type": "i16", "initial": 0}
      },
      "resources": {
        "auto-caption": {"kind": "text", "text": "Automatic production toggled"}
      },
      "body": [
        {"id": "toggle", "op": "if", "condition": {"op": "eq", "left": {"var": "$auto_build"}, "right": true}, "then": [{"id": "off", "op": "set", "var": "$auto_build", "value": false}], "else": [{"id": "on", "op": "set", "var": "$auto_build", "value": true}]},
        {"id": "announce", "op": "text", "resource": "auto-caption"}
      ]
    },
    "open-units": {
      "format": "fdisbull-il-1",
      "role": "uil",
      "variables": {
        "$view_mode": {"type": "u8", "initial": 0},
        "$city_size": {"type": "i16", "initial": 1},
        "$food_box": {"type": "i16", "initial": 0},
        "$shield_box": {"type": "i16", "initial": 0},
        "$production": {"type": "i16", "initial": 0},
        "$city_status": {"type": "u8", "initial": 0},
        "$city_owner": {"type": "u8", "initial": 0},
        "$auto_build": {"type": "bool", "initial": false},
        "$chooser_open": {"type": "bool", "initial": false},
        "$unit_list_open": {"type": "bool", "initial": false},
        "$unit_cursor": {"type": "i16", "initial": 0},
        "$unit_last": {"type": "i16", "initial": 0},
        "$unit_count": {"type": "i16", "initial": 0},
        "$city_cursor": {"type": "i16", "initial": 0}
      },
      "resources": {
        "units-caption": {"kind": "text", "text": "City units"}
      },
      "body": [
        {"id": "require-closed", "op": "require", "condition": {"op": "eq", "left": {"var": "$unit_list_open"}, "right": false}},
        {"id": "seed", "op": "set", "var": "$unit_cursor", "value": 0},
        {"id": "last", "op": "set", "var": "$unit_last", "value": {"var": "$unit_count"}},
        {"id": "last-minus-one", "op": "subtract", "var": "$unit_last", "value": 1},
        {"id": "clamp-last", "op": "if", "condition": {"op": "ge", "left": {"var": "$unit_last"}, "right": 0}, "then": [], "else": [{"id": "floor-last", "op": "set", "var": "$unit_last", "value": 0}]},
        {"id": "open", "op": "set", "var": "$unit_list_open", "value": true},
        {"id": "announce", "op": "text", "resource": "units-caption"}
      ]
    },
    "unit-next": {
      "format": "fdisbull-il-1",
      "role": "uil",
      "variables": {
        "$view_mode": {"type": "u8", "initial": 0},
        "$city_size": {"type": "i16", "initial": 1},
        "$food_box": {"type": "i16", "initial": 0},
        "$shield_box": {"type": "i16", "initial": 0},
        "$production": {"type": "i16", "initial": 0},
        "$city_status": {"type": "u8", "initial": 0},
        "$city_owner": {"type": "u8", "initial": 0},
        "$auto_build": {"type": "bool", "initial": false},
        "$chooser_open": {"type": "bool", "initial": false},
        "$unit_list_open": {"type": "bool", "initial": false},
        "$unit_cursor": {"type": "i16", "initial": 0},
        "$unit_last": {"type": "i16", "initial": 0},
        "$unit_count": {"type": "i16", "initial": 0},
        "$city_cursor": {"type": "i16", "initial": 0}
      },
      "resources": {
        "cursor-caption": {"kind": "text", "text": "Unit cursor moved"}
      },
      "body": [
        {"id": "require-open", "op": "require", "condition": {"op": "eq", "left": {"var": "$unit_list_open"}, "right": true}},
        {"id": "advance", "op": "add", "var": "$unit_cursor", "value": 1},
        {"id": "clamp", "op": "if", "condition": {"op": "ge", "left": {"var": "$unit_cursor"}, "right": {"var": "$unit_count"}}, "then": [{"id": "to-last", "op": "set", "var": "$unit_cursor", "value": {"var": "$unit_last"}}], "else": []},
        {"id": "announce", "op": "text", "resource": "cursor-caption"}
      ]
    },
    "unit-previous": {
      "format": "fdisbull-il-1",
      "role": "uil",
      "variables": {
        "$view_mode": {"type": "u8", "initial": 0},
        "$city_size": {"type": "i16", "initial": 1},
        "$food_box": {"type": "i16", "initial": 0},
        "$shield_box": {"type": "i16", "initial": 0},
        "$production": {"type": "i16", "initial": 0},
        "$city_status": {"type": "u8", "initial": 0},
        "$city_owner": {"type": "u8", "initial": 0},
        "$auto_build": {"type": "bool", "initial": false},
        "$chooser_open": {"type": "bool", "initial": false},
        "$unit_list_open": {"type": "bool", "initial": false},
        "$unit_cursor": {"type": "i16", "initial": 0},
        "$unit_last": {"type": "i16", "initial": 0},
        "$unit_count": {"type": "i16", "initial": 0},
        "$city_cursor": {"type": "i16", "initial": 0}
      },
      "resources": {
        "cursor-caption": {"kind": "text", "text": "Unit cursor moved"}
      },
      "body": [
        {"id": "require-open", "op": "require", "condition": {"op": "eq", "left": {"var": "$unit_list_open"}, "right": true}},
        {"id": "guard", "op": "if", "condition": {"op": "ge", "left": {"var": "$unit_cursor"}, "right": 1}, "then": [{"id": "back", "op": "subtract", "var": "$unit_cursor", "value": 1}], "else": []},
        {"id": "announce", "op": "text", "resource": "cursor-caption"}
      ]
    },
    "unit-select": {
      "format": "fdisbull-il-1",
      "role": "uil",
      "variables": {
        "$view_mode": {"type": "u8", "initial": 0},
        "$city_size": {"type": "i16", "initial": 1},
        "$food_box": {"type": "i16", "initial": 0},
        "$shield_box": {"type": "i16", "initial": 0},
        "$production": {"type": "i16", "initial": 0},
        "$city_status": {"type": "u8", "initial": 0},
        "$city_owner": {"type": "u8", "initial": 0},
        "$auto_build": {"type": "bool", "initial": false},
        "$chooser_open": {"type": "bool", "initial": false},
        "$unit_list_open": {"type": "bool", "initial": false},
        "$unit_cursor": {"type": "i16", "initial": 0},
        "$unit_last": {"type": "i16", "initial": 0},
        "$unit_count": {"type": "i16", "initial": 0},
        "$city_cursor": {"type": "i16", "initial": 0}
      },
      "resources": {
        "select-caption": {"kind": "text", "text": "Unit selected"}
      },
      "body": [
        {"id": "require-open", "op": "require", "condition": {"op": "eq", "left": {"var": "$unit_list_open"}, "right": true}},
        {"id": "require-one", "op": "require", "condition": {"op": "ge", "left": {"var": "$unit_count"}, "right": 1}},
        {"id": "store", "op": "set", "var": "$city_cursor", "value": {"var": "$unit_cursor"}},
        {"id": "close", "op": "set", "var": "$unit_list_open", "value": false},
        {"id": "announce", "op": "text", "resource": "select-caption"}
      ]
    },
    "unit-exit": {
      "format": "fdisbull-il-1",
      "role": "uil",
      "variables": {
        "$view_mode": {"type": "u8", "initial": 0},
        "$city_size": {"type": "i16", "initial": 1},
        "$food_box": {"type": "i16", "initial": 0},
        "$shield_box": {"type": "i16", "initial": 0},
        "$production": {"type": "i16", "initial": 0},
        "$city_status": {"type": "u8", "initial": 0},
        "$city_owner": {"type": "u8", "initial": 0},
        "$auto_build": {"type": "bool", "initial": false},
        "$chooser_open": {"type": "bool", "initial": false},
        "$unit_list_open": {"type": "bool", "initial": false},
        "$unit_cursor": {"type": "i16", "initial": 0},
        "$unit_last": {"type": "i16", "initial": 0},
        "$unit_count": {"type": "i16", "initial": 0},
        "$city_cursor": {"type": "i16", "initial": 0}
      },
      "resources": {
        "exit-caption": {"kind": "text", "text": "Unit cursor stored"}
      },
      "body": [
        {"id": "require-open", "op": "require", "condition": {"op": "eq", "left": {"var": "$unit_list_open"}, "right": true}},
        {"id": "store", "op": "set", "var": "$city_cursor", "value": {"var": "$unit_cursor"}},
        {"id": "close", "op": "set", "var": "$unit_list_open", "value": false},
        {"id": "announce", "op": "text", "resource": "exit-caption"}
      ]
    }
  },
  "contexts": [
    {
      "id": "city",
      "title": "City — selected city",
      "description": "Partial address-free representation of the original 320x200 city screen.",
      "when": {"op": "and", "conditions": [{"op": "not", "condition": {"op": "eq", "left": {"var": "$chooser_open"}, "right": true}}, {"op": "not", "condition": {"op": "eq", "left": {"var": "$unit_list_open"}, "right": true}}]}
    },
    {
      "id": "production-chooser",
      "title": "What shall we build",
      "description": "Production menu opened by key c or CHANGE; dispatch compare 0A99:7626 and civd CITYMGT.C 1439-1448.",
      "when": {"op": "eq", "left": {"var": "$chooser_open"}, "right": true}
    },
    {
      "id": "unit-list",
      "title": "City units",
      "description": "Unit-list cursor opened by key a; dispatch compare 0A99:7785 and civd CITYMGT.C 1483-1524.",
      "when": {"op": "eq", "left": {"var": "$unit_list_open"}, "right": true}
    }
  ],
  "objects": [
    {
      "id": "city-title",
      "context": "city",
      "label": "City — selected city",
      "aliases": ["city"],
      "description": "The selected city record; name and catalog text remain outside this fixture.",
      "bindings": []
    },
    {
      "id": "tab-resources",
      "context": "city",
      "label": "resources",
      "aliases": ["income", "i"],
      "description": "Original key i and the first city-view tab.",
      "bindings": [{"verb": "select", "program": "view-resources"}]
    },
    {
      "id": "tab-happiness",
      "context": "city",
      "label": "happiness",
      "aliases": ["h", "happy"],
      "description": "Original key h and happiness tab.",
      "bindings": [{"verb": "select", "program": "view-happiness"}]
    },
    {
      "id": "tab-map",
      "context": "city",
      "label": "map",
      "aliases": ["m"],
      "description": "Original key m and minimap tab.",
      "bindings": [{"verb": "select", "program": "view-map"}]
    },
    {
      "id": "tab-city-view",
      "context": "city",
      "label": "city view",
      "aliases": ["v", "view"],
      "description": "Original key v; animation and VGA scene effects are not modeled.",
      "bindings": [{"verb": "select", "program": "view-history"}]
    },
    {
      "id": "food-storage",
      "context": "city",
      "label": "Food Storage",
      "aliases": ["food"],
      "description": "Food box at source panel coordinates 3,115; capacity and granary marker are state fields.",
      "visible_when": {"op": "eq", "left": {"var": "$view_mode"}, "right": 0},
      "bindings": []
    },
    {
      "id": "production-storage",
      "context": "city",
      "label": "Production",
      "aliases": ["shields", "shield box"],
      "description": "Signed shield_box display and selected unit/improvement; source panel begins at 230,99.",
      "visible_when": {"op": "eq", "left": {"var": "$view_mode"}, "right": 0},
      "bindings": []
    },
    {
      "id": "city-resources",
      "context": "city",
      "label": "City Resources",
      "aliases": ["resources"],
      "description": "Food, shields, trade, luxuries, taxes and science bars from the city resource panel.",
      "visible_when": {"op": "eq", "left": {"var": "$view_mode"}, "right": 0},
      "bindings": []
    },
    {
      "id": "city-radius",
      "context": "city",
      "label": "City Radius",
      "aliases": ["tiles", "workers"],
      "description": "The 21-tile radius and worker assignment surface. Tile pixels and terrain are not rendered.",
      "visible_when": {"op": "eq", "left": {"var": "$view_mode"}, "right": 0},
      "bindings": []
    },
    {
      "id": "routes",
      "context": "city",
      "label": "Trade Routes",
      "aliases": ["routes", "trade"],
      "description": "Up to three city routes and their source-derived trade display.",
      "visible_when": {"op": "eq", "left": {"var": "$view_mode"}, "right": 0},
      "bindings": []
    },
    {
      "id": "building-panel",
      "context": "city",
      "label": "Buildings and Wonders",
      "aliases": ["buildings", "wonders", "more"],
      "description": "Improvement list, wonder precedence, sale surface and MORE paging from CITYMGT.C.",
      "visible_when": {"op": "eq", "left": {"var": "$view_mode"}, "right": 0},
      "bindings": []
    },
