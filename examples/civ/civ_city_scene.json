{
  "format": "fdisbull-il-scene-1",
  "partial": true,
  "programs": {
    "view-resources": {
      "format": "fdisbull-il-1",
      "role": "uil",
      "variables": {
        "$view_mode": {"type": "u8", "initial": 0},
        "$city_size": {"type": "i16", "initial": 1},
        "$food_box": {"type": "i16", "initial": 0},
        "$shield_box": {"type": "i16", "initial": 0},
        "$production": {"type": "i16", "initial": 0},
        "$city_status": {"type": "u8", "initial": 0},
        "$city_owner": {"type": "u8", "initial": 0},
        "$auto_build": {"type": "bool", "initial": false},
        "$chooser_open": {"type": "bool", "initial": false},
        "$unit_list_open": {"type": "bool", "initial": false},
        "$unit_cursor": {"type": "i16", "initial": 0},
        "$unit_last": {"type": "i16", "initial": 0},
        "$unit_count": {"type": "i16", "initial": 0},
        "$city_cursor": {"type": "i16", "initial": 0}
      },
      "resources": {
        "resources-caption": {"kind": "text", "text": "City Resources"}
      },
      "body": [
        {"id": "select-resources", "op": "set", "var": "$view_mode", "value": 0},
        {"id": "announce-resources", "op": "text", "resource": "resources-caption"}
      ]
