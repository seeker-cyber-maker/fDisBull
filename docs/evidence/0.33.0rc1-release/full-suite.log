        if not isinstance(value, dict) or value.get('node') not in NODES:
            raise ValueError('Invalid procedural UIL node')
        c_ast, _, _ = _parser()
        cls = getattr(c_ast, value['node'])
        allowed = set(cls.__slots__) - {'coord', '__weakref__'}
