+#ifndef DOSBOX_AGENT_AUDIO_CAPTURE_H
+#define DOSBOX_AGENT_AUDIO_CAPTURE_H
+
+#include <cstddef>
+#include <cstdint>
+#include <new>
+#include <string>
+#include <vector>
+
+namespace dosbox_agent {
+
+static const std::size_t kAudioCaptureMaxBytes = 4u * 1024u * 1024u;
+
+struct AudioCaptureSnapshot {
+    std::uint32_t capture_id = 0;
+    bool active = false;
+    bool complete = false;
+    bool truncated = false;
+    std::string stop_reason;
+    std::uint32_t max_bytes = 0;
+    std::uint32_t byte_count = 0;
+    std::uint32_t sample_rate = 0;
+    std::uint64_t captured_frames = 0;
+    std::uint64_t first_mixer_frame = 0;
+    std::uint64_t next_mixer_frame = 0;
+    std::uint64_t start_guest_ticks = 0;
+    std::uint64_t end_guest_ticks = 0;
+    std::uint64_t last_data_guest_ticks = 0;
+    std::vector<std::uint8_t> pcm;
+};
+
+// All methods are called on the emulation thread. This observer never owns
+// guest memory, schedules guest work, changes CaptureState or opens a file.
+class AudioCaptureBuffer {
+public:
+    bool Start(const std::string& owner, const std::uint32_t max_bytes,
+               const std::uint32_t rate, const std::uint64_t ticks,
+               const std::uint64_t mixer_frame, std::string* error)
+    {
+        if (state.active) return Fail(error, "CAPTURE_ACTIVE");
+        if (owner.empty() || max_bytes < 4 || max_bytes > kAudioCaptureMaxBytes ||
+            max_bytes % 4 != 0 || rate == 0 || next_id == 0)
+            return Fail(error, "INVALID_CAPTURE_PARAMETERS");
+        std::vector<std::uint8_t> fresh;
+        try { fresh.reserve(max_bytes); }
+        catch (const std::bad_alloc&) { return Fail(error, "CAPTURE_ALLOCATION_FAILED"); }
+        state = AudioCaptureSnapshot();
+        state.pcm.swap(fresh);
+        session_owner = owner;
+        state.capture_id = next_id++;
+        state.active = true;
+        state.max_bytes = max_bytes;
+        state.sample_rate = rate;
+        state.first_mixer_frame = state.next_mixer_frame = mixer_frame;
+        state.start_guest_ticks = state.end_guest_ticks = state.last_data_guest_ticks = ticks;
+        return true;
+    }
+
+    bool Active() const { return state.active; }
+    std::uint32_t CurrentId() const { return state.capture_id; }
+
+    void Append(const std::uint32_t rate, const std::size_t frames,
+                const std::int16_t* stereo, const std::uint64_t ticks,
+                const std::uint64_t first_mixer_frame)
+    {
+        if (!state.active || frames == 0) return;
+        if (rate != state.sample_rate) { Close(ticks, "format_changed", true); return; }
+        if (!stereo || first_mixer_frame != state.next_mixer_frame ||
+            ticks < state.last_data_guest_ticks) {
+            Close(ticks, "timeline_discontinuity", true); return;
+        }
+        const std::size_t room = (state.max_bytes - state.pcm.size()) / 4;
+        const std::size_t count = frames < room ? frames : room;
+        for (std::size_t i = 0; i < count * 2; ++i) {
+            const std::uint16_t value = static_cast<std::uint16_t>(stereo[i]);
+            state.pcm.push_back(static_cast<std::uint8_t>(value));
+            state.pcm.push_back(static_cast<std::uint8_t>(value >> 8));
+        }
+        state.byte_count = static_cast<std::uint32_t>(state.pcm.size());
+        state.captured_frames += count;
+        state.next_mixer_frame += count;
+        state.last_data_guest_ticks = state.end_guest_ticks = ticks;
+        if (count != frames || state.pcm.size() == state.max_bytes)
+            Close(ticks, "byte_limit", true);
+    }
+
+    bool Get(const std::string& owner, const std::uint32_t id,
+             const bool stop, const std::uint64_t ticks,
+             AudioCaptureSnapshot* result, std::string* error)
+    {
+        if (!result || owner != session_owner || id == 0 || id != state.capture_id)
+            return Fail(error, "CAPTURE_ID_MISMATCH");
+        if (stop) Close(ticks, "requested", false);
+        // A status snapshot is metadata-only; do not copy the PCM vector.
+        result->capture_id = state.capture_id;
+        result->active = state.active;
+        result->complete = state.complete;
+        result->truncated = state.truncated;
+        result->stop_reason = state.stop_reason;
+        result->max_bytes = state.max_bytes;
+        result->byte_count = state.byte_count;
+        result->sample_rate = state.sample_rate;
+        result->captured_frames = state.captured_frames;
+        result->first_mixer_frame = state.first_mixer_frame;
+        result->next_mixer_frame = state.next_mixer_frame;
+        result->start_guest_ticks = state.start_guest_ticks;
+        result->end_guest_ticks = state.end_guest_ticks;
+        result->last_data_guest_ticks = state.last_data_guest_ticks;
+        if (stop) result->pcm = state.pcm;
+        else result->pcm.clear();
+        return true;
+    }
+
+    void EndOwner(const std::string& owner, const std::uint64_t ticks,
+                  const std::string& reason)
+    {
+        if (owner == session_owner) Close(ticks, reason, true);
+    }
+
+    void Reset()
+    {
+        session_owner.clear();
+        state = AudioCaptureSnapshot();
+        // Keep monotonic capture IDs across selected targets in this process.
+    }
+
+private:
+    static bool Fail(std::string* error, const char* reason)
+    {
+        if (error) *error = reason;
+        return false;
+    }
+    void Close(const std::uint64_t ticks, const std::string& reason, const bool truncated)
+    {
+        if (!state.active) return;
+        state.active = false;
+        state.complete = true;
+        state.truncated = truncated;
+        state.stop_reason = reason;
+        state.end_guest_ticks = ticks;
+    }
+    std::string session_owner;
+    AudioCaptureSnapshot state;
+    std::uint32_t next_id = 1;
+};
+
+bool AGENT_AudioCaptureStart(const std::string&, std::uint32_t,
+                             AudioCaptureSnapshot*, std::string*);
+bool AGENT_AudioCaptureGet(const std::string&, std::uint32_t, bool,
+                           AudioCaptureSnapshot*, std::string*);
+bool AGENT_AudioCaptureActive();
+void AGENT_AddWave(std::uint32_t, std::size_t, const std::int16_t*, std::uint64_t);
+void AGENT_AudioCaptureReset();
+void AGENT_AudioCaptureEndOwner(const std::string&, const std::string&);
+
+} // namespace dosbox_agent
+#endif
