+namespace dosbox_agent {
+static AudioCaptureBuffer agent_audio_capture;
+bool AGENT_AudioCaptureStart(const std::string& owner, const std::uint32_t max_bytes,
+                             AudioCaptureSnapshot* snapshot, std::string* error)
+{
+    if (!AGENT_EmulationQueue().IsBoundToCurrentThread()) { if(error) *error="COMMAND_REJECTED"; return false; }
+    if (!agent_audio_capture.Start(owner, max_bytes, mixer.freq, PIC_Ticks,
+                                   mixer_sample_counter, error)) return false;
+    return agent_audio_capture.Get(owner, agent_audio_capture.CurrentId(), false, PIC_Ticks, snapshot, error);
+}
+bool AGENT_AudioCaptureGet(const std::string& owner, const std::uint32_t id, const bool stop,
+                           AudioCaptureSnapshot* snapshot, std::string* error)
+{
+    if (!AGENT_EmulationQueue().IsBoundToCurrentThread()) { if(error) *error="COMMAND_REJECTED"; return false; }
+    return agent_audio_capture.Get(owner, id, stop, PIC_Ticks, snapshot, error);
+}
+bool AGENT_AudioCaptureActive() { return agent_audio_capture.Active(); }
+void AGENT_AddWave(const std::uint32_t rate, const std::size_t frames,
+                   const std::int16_t* samples, const std::uint64_t first_frame)
+{
+    agent_audio_capture.Append(rate, frames, samples, PIC_Ticks, first_frame);
+}
+void AGENT_AudioCaptureReset() { agent_audio_capture.Reset(); }
+void AGENT_AudioCaptureEndOwner(const std::string& owner, const std::string& reason)
+{
+    agent_audio_capture.EndOwner(owner, PIC_Ticks, reason);
+}
+} // namespace dosbox_agent
+#endif
