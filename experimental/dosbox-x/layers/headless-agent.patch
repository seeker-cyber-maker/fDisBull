+static void PngU32(std::vector<std::uint8_t>* out, std::uint32_t value)
+{
+    for (int shift = 24; shift >= 0; shift -= 8) out->push_back((value >> shift) & 255);
+}
+
+static void PngChunk(std::vector<std::uint8_t>* out, const char* tag,
+                     const std::vector<std::uint8_t>& data)
+{
+    PngU32(out, static_cast<std::uint32_t>(data.size()));
+    const std::size_t start = out->size();
+    out->insert(out->end(), tag, tag + 4);
+    out->insert(out->end(), data.begin(), data.end());
+    PngU32(out, static_cast<std::uint32_t>(crc32(0, out->data() + start,
+                                              static_cast<uInt>(4 + data.size()))));
+}
+
+static bool EncodeFramePng(const FrameSnapshot& frame, std::vector<std::uint8_t>* png)
+{
+    const std::size_t stride = static_cast<std::size_t>(frame.width) * 4;
+    if (!frame.width || !frame.height || frame.rgba.size() > 16u * 1024u * 1024u ||
+        frame.rgba.size() != stride * frame.height) return false;
+    std::vector<std::uint8_t> scanlines;
+    scanlines.reserve(frame.rgba.size() + frame.height);
+    for (std::uint32_t y = 0; y < frame.height; ++y) {
+        scanlines.push_back(0); // PNG filter: none
+        scanlines.insert(scanlines.end(), frame.rgba.begin() + y * stride,
+                         frame.rgba.begin() + (y + 1) * stride);
+    }
+    uLongf size = compressBound(static_cast<uLong>(scanlines.size()));
+    std::vector<std::uint8_t> compressed(size);
+    if (compress2(compressed.data(), &size, scanlines.data(),
+                  static_cast<uLong>(scanlines.size()), Z_BEST_SPEED) != Z_OK) return false;
+    compressed.resize(size);
+    const std::uint8_t signature[] = {137,80,78,71,13,10,26,10};
+    png->assign(signature, signature + 8);
+    std::vector<std::uint8_t> header;
+    PngU32(&header, frame.width); PngU32(&header, frame.height);
+    const std::uint8_t attributes[] = {8,6,0,0,0};
+    header.insert(header.end(), attributes, attributes + 5);
+    PngChunk(png, "IHDR", header); PngChunk(png, "IDAT", compressed);
+    PngChunk(png, "IEND", std::vector<std::uint8_t>());
+    return true;
+}
