+class UnixSocketTransport:
+    """Bounded JSON-lines over a private, same-user filesystem Unix socket.
+
+    A timeout or malformed response closes the connection. No side-effecting
+    request is retried after a send: the caller must resolve request IDs.
+    """
+
+    def __init__(self, endpoint: str) -> None:
+        self._endpoint = endpoint
+        self._socket: socket.socket | None = None
+        self._lock = threading.Lock()
+
+    def _connect(self, deadline: float) -> None:
+        if os.name == "nt" or not hasattr(socket, "AF_UNIX"):
+            raise AgentConnectionError("unix_socket transport requires a POSIX host")
+        path = Path(self._endpoint)
+        if not path.is_absolute() or "\x00" in self._endpoint:
+            raise AgentConnectionError("Unix socket endpoint must be an absolute path without NUL bytes")
+        try:
+            parent = path.parent.lstat()
+            endpoint = path.lstat()
+        except OSError as error:
+            raise AgentConnectionError(f"unable to inspect Unix socket endpoint: {error}") from error
+        if (not stat.S_ISDIR(parent.st_mode) or parent.st_uid != os.geteuid()
+                or stat.S_IMODE(parent.st_mode) != 0o700):
+            raise AgentConnectionError("Unix socket parent must be an owner-owned mode-0700 directory")
+        if (not stat.S_ISSOCK(endpoint.st_mode) or endpoint.st_uid != os.geteuid()
+                or stat.S_IMODE(endpoint.st_mode) != 0o600):
+            raise AgentConnectionError("Unix socket endpoint must be an owner-owned mode-0600 socket")
+        connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        try:
+            connection.settimeout(max(0.001, deadline-time.monotonic()))
+            connection.connect(self._endpoint)
+            if hasattr(socket, "SO_PEERCRED"):
+                import struct
+                credentials = connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
+                if struct.unpack("3i", credentials)[1] != os.geteuid():
+                    raise AgentConnectionError("Unix socket server has a different user identity")
+            elif hasattr(connection, "getpeereid"):
+                if connection.getpeereid()[0] != os.geteuid():
+                    raise AgentConnectionError("Unix socket server has a different user identity")
+            self._socket = connection
+        except (OSError, AgentConnectionError):
+            connection.close()
+            raise
+
+    def request(self, payload: str, timeout_ms: int, max_message_bytes: int) -> str:
+        encoded = payload.encode("utf-8")
+        if len(encoded) > max_message_bytes:
+            raise AgentProtocolError("request exceeds configured max_message_bytes")
+        deadline = time.monotonic() + timeout_ms/1000
+        with self._lock:
+            try:
+                if self._socket is None:
+                    self._connect(deadline)
+                connection = self._socket
+                assert connection is not None
+                connection.settimeout(max(0.001, deadline-time.monotonic()))
+                connection.sendall(encoded+b"\n")
+                response = bytearray()
+                while True:
+                    remaining = deadline-time.monotonic()
+                    if remaining <= 0:
+                        raise AgentConnectionError("timed out waiting for Unix-socket response")
+                    connection.settimeout(remaining)
+                    chunk = connection.recv(min(4096, max_message_bytes+1-len(response)))
+                    if not chunk:
+                        raise AgentConnectionError("Unix socket closed before a complete response")
+                    response.extend(chunk)
+                    newline = response.find(b"\n")
+                    if newline >= 0:
+                        if newline > max_message_bytes:
+                            raise AgentProtocolError("response exceeds configured max_message_bytes")
+                        if newline != len(response)-1:
+                            raise AgentProtocolError("unsolicited bytes after Unix-socket response")
+                        try:
+                            return bytes(response[:newline]).decode("utf-8")
+                        except UnicodeDecodeError as error:
+                            raise AgentProtocolError("server response is not UTF-8") from error
+                    if len(response) > max_message_bytes:
+                        raise AgentProtocolError("response exceeds configured max_message_bytes")
+            except OSError as error:
+                self.close()
+                raise AgentConnectionError(f"Unix socket I/O failed: {error}") from error
+            except (AgentConnectionError, AgentProtocolError):
+                self.close()
+                raise
+
+    def close(self) -> None:
+        if self._socket is not None:
+            self._socket.close()
+        self._socket = None
+
+
+def _pipe_descriptors(endpoint: str) -> tuple[int, int]:
+    fields = endpoint.split(":")
+    if (len(fields) != 3 or fields[0] != "fd" or
+            any(not value or not value.isascii() or not value.isdecimal() for value in fields[1:])):
+        raise ValueError("Pipe endpoint must be fd:READ:WRITE with distinct dedicated descriptors >= 3")
+    descriptors = tuple(int(value, 10) for value in fields[1:])
+    if any(value < 3 or value > 2147483647 for value in descriptors) or descriptors[0] == descriptors[1]:
+        raise ValueError("Pipe endpoint must be fd:READ:WRITE with distinct dedicated descriptors >= 3")
+    return descriptors[0], descriptors[1]
+
+
+class PipeTransport:
+    """Bounded JSON-lines RPC over two dedicated inherited POSIX pipes.
+
+    Duplicates and owns only its copies of the descriptors. All request I/O
+    shares one deadline; an uncertain exchange permanently closes this channel
+    instead of reconnecting or replaying a potentially side-effecting request.
+    """
+
+    def __init__(self, read_fd: int, write_fd: int) -> None:
+        if os.name != "posix":
+            raise AgentConnectionError("pipe transport requires a POSIX host")
+        if (type(read_fd) is not int or type(write_fd) is not int or
+                min(read_fd, write_fd) < 3 or read_fd == write_fd):
+            raise ValueError("pipe transport requires distinct dedicated descriptors >= 3")
+        import fcntl
+
+        self._read_fd: int | None = None
+        self._write_fd: int | None = None
+        self._lock = threading.Lock()
+        try:
+            reader, writer = os.fstat(read_fd), os.fstat(write_fd)
+            if (not stat.S_ISFIFO(reader.st_mode) or not stat.S_ISFIFO(writer.st_mode) or
+                    (reader.st_dev, reader.st_ino) == (writer.st_dev, writer.st_ino) or
+                    fcntl.fcntl(read_fd, fcntl.F_GETFL) & os.O_ACCMODE != os.O_RDONLY or
+                    fcntl.fcntl(write_fd, fcntl.F_GETFL) & os.O_ACCMODE != os.O_WRONLY):
+                raise ValueError("pipe transport requires a readable FIFO and a separate writable FIFO")
+            self._read_fd = os.dup(read_fd)
+            self._write_fd = os.dup(write_fd)
+            # Keep each write atomic and bounded even if the original pipe is
+            # blocking. POLLOUT promises capacity for this many bytes.
+            self._write_chunk = os.fpathconf(self._write_fd, "PC_PIPE_BUF")
+        except (OSError, ValueError) as error:
+            self._close_unlocked()
+            if isinstance(error, ValueError):
+                raise
+            raise AgentConnectionError(f"unable to duplicate RPC pipe descriptors: {error}") from error
+
+    @classmethod
+    def from_endpoint(cls, endpoint: str) -> "PipeTransport":
+        return cls(*_pipe_descriptors(endpoint))
+
+    @staticmethod
+    def _wait(descriptor: int, event: int, deadline: float) -> None:
+        poller = select.poll()
+        poller.register(descriptor, event)
+        while True:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise AgentConnectionError("timed out waiting for inherited-pipe I/O")
+            try:
+                if poller.poll(max(1, min(2147483647, int(remaining * 1000) + 1))):
+                    return
+            except InterruptedError:
+                continue
+
+    def request(self, payload: str, timeout_ms: int, max_message_bytes: int) -> str:
+        encoded = payload.encode("utf-8")
+        if len(encoded) > max_message_bytes:
+            raise AgentProtocolError("request exceeds configured max_message_bytes")
+        if b"\n" in encoded:
+            raise AgentProtocolError("request must contain a single JSON line")
+        deadline = time.monotonic() + timeout_ms / 1000
+        if not self._lock.acquire(timeout=max(0, deadline-time.monotonic())):
+            raise AgentConnectionError("timed out waiting for inherited-pipe request lock")
+        try:
+            if self._read_fd is None or self._write_fd is None:
+                raise AgentConnectionError("inherited-pipe transport is closed")
+            outgoing = encoded + b"\n"
+            sent = 0
+            while sent < len(outgoing):
+                self._wait(self._write_fd, select.POLLOUT, deadline)
+                try:
+                    written = os.write(self._write_fd, outgoing[sent:sent+self._write_chunk])
+                except (BlockingIOError, InterruptedError):
+                    continue
+                if written <= 0:
+                    raise AgentConnectionError("inherited-pipe write did not make progress")
+                sent += written
+            response = bytearray()
+            while True:
+                self._wait(self._read_fd, select.POLLIN, deadline)
+                try:
+                    chunk = os.read(self._read_fd, min(65536, max_message_bytes+1-len(response)))
+                except (BlockingIOError, InterruptedError):
+                    continue
+                if not chunk:
+                    raise AgentConnectionError("inherited pipe closed before a complete response")
+                response.extend(chunk)
+                newline = response.find(b"\n")
+                if newline >= 0:
+                    if newline > max_message_bytes:
+                        raise AgentProtocolError("response exceeds configured max_message_bytes")
+                    if newline != len(response)-1:
+                        raise AgentProtocolError("unsolicited bytes after inherited-pipe response")
+                    try:
+                        return bytes(response[:newline]).decode("utf-8")
+                    except UnicodeDecodeError as error:
+                        raise AgentProtocolError("server response is not UTF-8") from error
+                if len(response) > max_message_bytes:
+                    raise AgentProtocolError("response exceeds configured max_message_bytes")
+        except OSError as error:
+            self._close_unlocked()
+            raise AgentConnectionError(f"inherited-pipe I/O failed: {error}") from error
+        except (AgentConnectionError, AgentProtocolError):
+            self._close_unlocked()
+            raise
+        except BaseException:
+            # Cancellation after any bytes were sent leaves completion unknown.
+            self._close_unlocked()
+            raise
+        finally:
+            self._lock.release()
+
+    def _close_unlocked(self) -> None:
+        for descriptor in (self._read_fd, self._write_fd):
+            if descriptor is not None:
+                os.close(descriptor)
+        self._read_fd = self._write_fd = None
+
+    def close(self) -> None:
+        with self._lock:
+            self._close_unlocked()
+
