+#if defined(C_DEBUG) && defined(C_DOSBOX_AGENT)
+bool AGENT_StateFile(const std::string& path, bool load, std::string* error) {
+    const bool old_file = use_save_file, old_remark = noremark_save_state;
+    const bool old_force = force_load_state;
+    const std::string old_name = savefilename;
+    use_save_file = true; noremark_save_state = true; force_load_state = false;
+    savefilename = path; agent_state_error.clear(); agent_state_active = true;
+    try {
+        if (load) SaveState::instance().load(0); else SaveState::instance().save(0);
+    } catch (const std::string& e) { agent_state_error = e; }
+      catch (...) { agent_state_error = "Native state serialization failed"; }
+    agent_state_active = false;
+    use_save_file = old_file; noremark_save_state = old_remark;
+    force_load_state = old_force; savefilename = old_name;
+    if (error) *error = agent_state_error;
+    return agent_state_error.empty();
+}
