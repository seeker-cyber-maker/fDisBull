@@ -0,0 +1,255 @@
+"""Real inherited-pipe RPC tests; no local socket service is required."""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import select
+import sys
+import tempfile
+import threading
+import time
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from dosbox_agent import AgentClient, AgentConfig, AgentConnectionError, AgentProtocolError
+from dosbox_agent.client import PipeTransport, load_config
+
+
+@unittest.skipUnless(os.name == "posix", "POSIX inherited-pipe transport")
+class PipeTransportTests(unittest.TestCase):
+    def setUp(self):
+        self.server_read, self.client_write = os.pipe()
+        self.client_read, self.server_write = os.pipe()
+        for fd in (self.server_read, self.client_write, self.client_read, self.server_write):
+            self.addCleanup(self.close_fd, fd)
+
+    @staticmethod
+    def close_fd(fd):
+        try:
+            os.close(fd)
+        except OSError:
+            pass
+
+    def transport(self):
+        transport = PipeTransport(self.client_read, self.client_write)
+        self.addCleanup(transport.close)
+        return transport
+
+    @staticmethod
+    def read_line(fd):
+        data = bytearray()
+        while not data.endswith(b"\n"):
+            if not select.select([fd], [], [], 2)[0]:
+                raise TimeoutError("test server received no complete request")
+            chunk = os.read(fd, 4096)
+            if not chunk:
+                raise EOFError("test client closed before a complete request")
+            data.extend(chunk)
+        return bytes(data[:-1])
+
+    def server(self, action):
+        errors = []
+
+        def run():
+            try:
+                action(self.server_read, self.server_write)
+            except BaseException as error:
+                errors.append(error)
+
+        thread = threading.Thread(target=run, daemon=True)
+        thread.start()
+        self.addCleanup(thread.join, 3)
+        return thread, errors
+
+    def test_launcher_import_and_config_accept_dedicated_pipe_endpoint(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "agent.env"
+            content = "\n".join(("transport=pipe", "endpoint=fd:3:4",
+                "dosbox_executable=/program", "dosbox_workdir=/work",
+                "request_timeout_ms=100", "max_message_bytes=128",
+                "max_memory_read_bytes=64", "max_trace_events=16"))
+            path.write_text(content)
+            self.assertEqual(load_config(path).transport, "pipe")
+            for endpoint in ("fd:0:4", "fd:3:3", "fd:3:-4", "fd:3:4:5", "fd:3:999999999999999", "pipe:3:4"):
+                path.write_text(content.replace("fd:3:4", endpoint))
+                with self.subTest(endpoint=endpoint), self.assertRaisesRegex(ValueError, "fd:READ:WRITE"):
+                    load_config(path)
+
+    def test_sequential_agent_client_calls_use_same_inherited_channels(self):
+        received = []
+        def reply(read_fd, write_fd):
+            for _ in range(2):
+                request = json.loads(self.read_line(read_fd))
+                received.append(request)
+                data = json.dumps({"jsonrpc":"2.0", "id":request["id"], "result":{"transport":"pipe"}}).encode()+b"\n"
+                os.write(write_fd, data[:7])
+                os.write(write_fd, data[7:])
+        thread, errors = self.server(reply)
+        config = AgentConfig(Path("/config"), "pipe", f"fd:{self.client_read}:{self.client_write}",
+                             Path("/program"), Path("/work"), 500, 1024, 256, 100)
+        with AgentClient(config) as client:
+            self.assertEqual(client.capabilities(), {"transport":"pipe"})
+            self.assertEqual(client.capabilities(), {"transport":"pipe"})
+        thread.join(1)
+        self.assertEqual(errors, [])
+        self.assertEqual(len({request["id"] for request in received}), 2)
+
+    def test_transport_duplicates_descriptors_and_close_preserves_caller_ownership(self):
+        transport = self.transport()
+        transport.close()
+        transport.close()
+        os.fstat(self.client_read)
+        os.fstat(self.client_write)
+        with self.assertRaisesRegex(AgentConnectionError, "closed"):
+            transport.request("{}", 100, 128)
+
+    def test_large_request_and_response_are_framed_without_truncation(self):
+        payload = json.dumps({"data":"x"*200000})
+        response = json.dumps({"data":"é"*70000}, ensure_ascii=False)
+        received = []
+        def reply(read_fd, write_fd):
+            received.append(self.read_line(read_fd).decode())
+            encoded = response.encode()+b"\n"
+            for index in range(0, len(encoded), 317):
+                os.write(write_fd, encoded[index:index+317])
+        thread, errors = self.server(reply)
+        self.assertEqual(self.transport().request(payload, 2000, 300000), response)
+        thread.join(1)
+        self.assertEqual(errors, [])
+        self.assertEqual(received, [payload])
+
+    def test_request_size_limit_rejects_before_writing_and_keeps_channel_usable(self):
+        transport = self.transport()
+        with self.assertRaisesRegex(AgentProtocolError, "request exceeds"):
+            transport.request("é"*65, 100, 128)
+        self.assertEqual(select.select([self.server_read], [], [], 0)[0], [])
+        thread, errors = self.server(lambda r,w: (self.read_line(r), os.write(w,b"ok\n")))
+        self.assertEqual(transport.request("{}", 500, 128), "ok")
+        thread.join(1)
+        self.assertEqual(errors, [])
+
+    def test_exact_response_byte_limit_is_accepted(self):
+        thread, errors = self.server(lambda r,w: (self.read_line(r), os.write(w,b"x"*128+b"\n")))
+        self.assertEqual(self.transport().request("{}", 500, 128), "x"*128)
+        thread.join(1)
+        self.assertEqual(errors, [])
+
+    def assert_bad_response_closes_channel(self, response, message):
+        transport = self.transport()
+        thread, errors = self.server(lambda r,w: (self.read_line(r), os.write(w,response)))
+        with self.assertRaisesRegex(AgentProtocolError, message):
+            transport.request("{}", 500, 128)
+        thread.join(1)
+        self.assertEqual(errors, [])
+        with self.assertRaisesRegex(AgentConnectionError, "closed"):
+            transport.request("{}", 100, 128)
+
+    def test_oversized_response_closes_channel(self):
+        self.assert_bad_response_closes_channel(b"x"*129+b"\n", "response exceeds")
+
+    def test_invalid_utf8_response_closes_channel(self):
+        self.assert_bad_response_closes_channel(b"\xff\n", "UTF-8")
+
+    def test_unsolicited_bytes_after_response_close_channel(self):
+        self.assert_bad_response_closes_channel(b"ok\nextra", "unsolicited")
+
+    def test_partial_response_eof_is_an_error(self):
+        def reply(read_fd, write_fd):
+            self.read_line(read_fd)
+            os.write(write_fd, b"partial")
+            os.close(write_fd)
+        thread, errors = self.server(reply)
+        with self.assertRaisesRegex(AgentConnectionError, "complete response"):
+            self.transport().request("{}", 500, 128)
+        thread.join(1)
+        self.assertEqual(errors, [])
+
+    def test_response_timeout_closes_channel_without_replaying_request(self):
+        received = []
+        def reply(read_fd, write_fd):
+            received.append(self.read_line(read_fd))
+            time.sleep(0.15)
+        thread, errors = self.server(reply)
+        transport = self.transport()
+        with self.assertRaisesRegex(AgentConnectionError, "timed out"):
+            transport.request('{"id":1}', 30, 128)
+        with self.assertRaisesRegex(AgentConnectionError, "closed"):
+            transport.request('{"id":1}', 30, 128)
+        thread.join(1)
+        self.assertEqual(errors, [])
+        self.assertEqual(received, [b'{"id":1}'])
+        self.assertEqual(select.select([self.server_read], [], [], 0)[0], [])
+
+    def test_write_timeout_is_bounded_when_server_does_not_read(self):
+        transport = self.transport()
+        started = time.monotonic()
+        with self.assertRaisesRegex(AgentConnectionError, "timed out"):
+            transport.request("x"*2000000, 30, 2000001)
+        self.assertLess(time.monotonic()-started, 0.5)
+        with self.assertRaisesRegex(AgentConnectionError, "closed"):
+            transport.request("{}", 100, 128)
+
+    def test_waiting_request_deadline_does_not_interrupt_active_exchange(self):
+        transport = self.transport()
+        received, results, failures = [], [], []
+        first_received, release_reply = threading.Event(), threading.Event()
+
+        def reply(read_fd, write_fd):
+            received.append(self.read_line(read_fd))
+            first_received.set()
+            if not release_reply.wait(1):
+                raise TimeoutError("test did not release first response")
+            os.write(write_fd, b"first-response\n")
+
+        def first_request():
+            try:
+                results.append(transport.request("first", 1000, 128))
+            except BaseException as error:
+                failures.append(error)
+
+        server_thread, errors = self.server(reply)
+        requester = threading.Thread(target=first_request, daemon=True)
+        requester.start()
+        self.assertTrue(first_received.wait(1))
+        try:
+            with self.assertRaisesRegex(AgentConnectionError, "request lock"):
+                transport.request("second", 30, 128)
+        finally:
+            release_reply.set()
+            requester.join(1)
+            server_thread.join(1)
+        self.assertEqual(failures, [])
+        self.assertEqual(errors, [])
+        self.assertEqual(results, ["first-response"])
+        self.assertEqual(received, [b"first"])
+        self.assertEqual(select.select([self.server_read], [], [], 0)[0], [])
+
+    def test_only_distinct_readable_and_writable_fifo_descriptors_are_accepted(self):
+        with tempfile.TemporaryFile() as file:
+            for read_fd, write_fd in ((0,self.client_write), (self.client_read,self.client_read),
+                                     (self.client_write,self.client_read), (file.fileno(),self.client_write)):
+                with self.subTest(read_fd=read_fd,write_fd=write_fd), self.assertRaises((ValueError, AgentConnectionError)):
+                    PipeTransport(read_fd, write_fd)
+
+    def test_same_backing_fifo_is_rejected(self):
+        # Darwin assigns different inode identities to an anonymous pipe's
+        # two ends. A named FIFO gives both hosts the same observable identity.
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'same-fifo'
+            os.mkfifo(path, 0o600)
+            read_fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
+            try:
+                write_fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK)
+                try:
