@@ -0,0 +1,212 @@
+#!/usr/bin/env python3
+"""Launch a trusted DOS fixture using dedicated inherited POSIX RPC pipes.
+
+This controls an emulator process. It does not create a security sandbox.
+The reusable HeadlessAgent context exposes the repository's AgentClient.
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import time
+from typing import Any
+
+REPOSITORY = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPOSITORY / "client" / "python"))
+
+from dosbox_agent import AgentClient  # noqa: E402
+from dosbox_agent.client import PipeTransport, load_config  # noqa: E402
+
+
+class HeadlessAgent:
+    """Own one emulator process and its RPC pipes; always reap it on exit."""
+
+    def __init__(self, executable: str | Path, workdir: str | Path, *,
+                 window: bool = False, request_timeout_ms: int = 15000) -> None:
+        if os.name != "posix":
+            raise RuntimeError("This inherited-pipe launcher requires macOS or Linux")
+        self.executable = Path(executable).expanduser().resolve(strict=True)
+        self.workdir = Path(workdir).expanduser().resolve(strict=True)
+        if not self.executable.is_file() or not os.access(self.executable, os.X_OK):
+            raise ValueError("executable must be an executable file")
+        if not self.workdir.is_dir():
+            raise ValueError("workdir must be the explicit DOS fixture directory")
+        for path in (self.executable, self.workdir):
+            if any(character in str(path) for character in ("\n", "\r", "\x00")):
+                raise ValueError("configuration paths cannot contain line breaks or NUL")
+        if not 1 <= request_timeout_ms <= 60000:
+            raise ValueError("request_timeout_ms must be between 1 and 60000")
+        self.window = window
+        self.request_timeout_ms = request_timeout_ms
+        self.client: AgentClient | None = None
+        self.process: subprocess.Popen[bytes] | None = None
+        self._temporary: tempfile.TemporaryDirectory[str] | None = None
+        self._log_path: Path | None = None
+
+    def __enter__(self) -> "HeadlessAgent":
+        if self.process is not None:
+            raise RuntimeError("HeadlessAgent is already started")
+        self._temporary = tempfile.TemporaryDirectory(prefix="dosbox-agent-")
+        directory = Path(self._temporary.name)
+        descriptors: list[int] = []
+        try:
+            child_read, parent_write = os.pipe()
+            descriptors.extend((child_read, parent_write))
+            parent_read, child_write = os.pipe()
+            descriptors.extend((parent_read, child_write))
+            configuration = directory / "agent.env"
+            configuration.write_text(
+                "transport=pipe\n"
+                f"endpoint=fd:{child_read}:{child_write}\n"
+                f"dosbox_executable={self.executable}\n"
+                f"dosbox_workdir={self.workdir}\n"
+                "profile=production\n"
+                f"request_timeout_ms={self.request_timeout_ms}\n"
+                "max_message_bytes=8388608\n"
+                "max_memory_read_bytes=65536\n"
+                "max_trace_events=10000\n",
+                encoding="utf-8",
+            )
+            configuration.chmod(0o600)
+            # Use the guest's native pixel grid for screenshots and absolute
+            # input, rather than VGA scanline duplication before the scaler.
+            arguments = [str(self.executable), "--defaultconf", "--noautoexec", "--noconfig",
+                         "-set", "render doublescan=false",
+                         "--agent-config", str(configuration)]
+            if self.window:
+                arguments.append("--agent-window")
+            environment = {key: value for key, value in os.environ.items()
+                           if not key.upper().startswith("DOSBOX_")}
+            environment["XDG_CONFIG_HOME"] = str(directory / "config")
+            self._log_path = directory / "emulator.log"
+            with self._log_path.open('wb') as log:
+                self.process = subprocess.Popen(
+                    arguments, cwd=directory, env=environment, stdin=subprocess.DEVNULL,
+                    stdout=log, stderr=subprocess.STDOUT,
+                    pass_fds=(child_read, child_write), close_fds=True,
+                )
+            # PipeTransport duplicates the parent ends and owns only its copies.
+            transport = PipeTransport(parent_read, parent_write)
+            try:
+                self.client = AgentClient(load_config(configuration), transport=transport)
+            except BaseException:
+                transport.close()
+                raise
+            for descriptor in descriptors:
+                os.close(descriptor)
+            descriptors.clear()
+            # This read-only request waits for actual RPC readiness; no startup
+            # sleep and no side-effecting request is automatically retried.
+            self.client.capabilities()
+            return self
+        except BaseException as error:
+            for descriptor in descriptors:
+                os.close(descriptor)
+            details = self._log_path.read_text(errors='replace')[-6000:] if self._log_path else ''
+            self.close()
+            if details and isinstance(error, Exception):
+                raise RuntimeError(f'{error}\nDOSBox startup log:\n{details}') from error
+            raise
+
+    def close(self) -> None:
+        if self.client is not None:
+            self.client.close()
+            self.client = None
+        if self.process is not None:
+            if self.process.poll() is None:
+                self.process.terminate()
+                try:
+                    self.process.wait(timeout=2)
+                except subprocess.TimeoutExpired:
+                    self.process.kill()
+                    self.process.wait(timeout=2)
+            else:
+                self.process.wait()
+            self.process = None
+        if self._temporary is not None:
+            self._temporary.cleanup()
+            self._temporary = None
+
+    def __exit__(self, *_: object) -> None:
+        self.close()
+
+
+def save_screenshot(client: AgentClient, session_id: str, path: Path) -> dict[str, Any]:
+    """Save the completed frame already cached by DOSBox, without stepping."""
+    result = client.call("video.screenshot", {"session_id": session_id})
+    if result.get("format") != "png":
+        raise RuntimeError("video.screenshot did not return PNG")
+    data = base64.b64decode(result["png_base64"], validate=True)
+    if not data.startswith(b"\x89PNG\r\n\x1a\n"):
+        raise RuntimeError("video.screenshot returned an invalid PNG signature")
+    if hashlib.sha256(data).hexdigest() != result["sha256"]:
+        raise RuntimeError("video.screenshot PNG hash mismatch")
+    # Publish only a complete, validated artifact, including on interrupted writes.
+    with tempfile.NamedTemporaryFile(dir=path.parent, prefix=path.name + ".", delete=False) as stream:
+        temporary_path = Path(stream.name)
+        try:
+            stream.write(data)
+            stream.close()
+            temporary_path.replace(path)
+        finally:
+            temporary_path.unlink(missing_ok=True)
+    return {key: value for key, value in result.items() if key != "png_base64"}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--executable", required=True, type=Path)
+    parser.add_argument("--workdir", required=True, type=Path,
+                        help="Directory containing a trusted DOS fixture and its data")
+    parser.add_argument("--target", required=True, help="DOS name, for example AGENTFIX.COM")
+    parser.add_argument("--run-ms", type=int, default=0,
+                        help="Explicitly execute for up to this many host milliseconds before pausing")
+    parser.add_argument("--screenshot", type=Path)
+    parser.add_argument("--window", action="store_true")
+    arguments = parser.parse_args()
+    if not 0 <= arguments.run_ms <= 60000:
+        parser.error("--run-ms must be between 0 and 60000")
+    report: dict[str, Any] = {}
+    with HeadlessAgent(arguments.executable, arguments.workdir, window=arguments.window) as launched:
+        client = launched.client
+        assert client is not None
+        session = client.start(arguments.target)
+        if arguments.run_ms:
+            operation = client.continue_(session.id)
+            deadline = time.monotonic() + arguments.run_ms / 1000
+            while time.monotonic() < deadline:
+                remaining_ms = max(1, min(100, int((deadline - time.monotonic()) * 1000)))
+                result = client.wait(session.id, operation.id, timeout_ms=remaining_ms)
+                session = result.session
+                if not result.running:
+                    break
+            if session.state == "running":
+                pause = client.pause(session.id)
+                result = client.wait(session.id, pause.id, timeout_ms=1000)
+                if result.running:
+                    raise RuntimeError("Target did not pause within the bounded wait")
+                session = result.session
+        report["session"] = {"id": session.id, "state": session.state}
+        if arguments.screenshot:
+            report["screenshot"] = save_screenshot(client, session.id, arguments.screenshot.resolve())
+        if session.state == "stopped":
+            registers = client.get_registers(session.id)
+            report["registers"] = {"cs": registers.segments["cs"], "ip": registers.instruction_pointer}
+    print(json.dumps(report, indent=2, sort_keys=True))
+    return 0
