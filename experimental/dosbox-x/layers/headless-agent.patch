+// Standalone transport acceptance fixture; not part of the DOSBox executable.
+#include "rpc_transport.h"
+#include <iostream>
+#include <string>
+
+int main(int argc, char** argv)
+{
+    if (argc != 2) return 2;
+    dosbox_agent::AgentConfig config;
+    config.transport = dosbox_agent::AgentTransport::UnixSocket;
+    config.endpoint = argv[1];
+    config.max_message_bytes = 128;
+    config.request_timeout_ms = 200;
+    std::unique_ptr<dosbox_agent::IRpcTransport> transport =
+        dosbox_agent::AGENT_CreateLocalTransport(config.transport);
+    std::string error;
+    if (!transport->Start(config, [](const std::string& input) { return input; }, &error)) {
+        std::cerr << error << std::endl;
+        return 1;
+    }
+    std::cout << "READY" << std::endl;
+    std::string command;
+    std::getline(std::cin, command);
+    transport->Stop();
+    std::cout << "STOPPED" << std::endl;
+    return 0;
+}
