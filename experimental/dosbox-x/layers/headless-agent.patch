+#!/usr/bin/env python3
+"""Exercise the real emulator through inherited pipes; never mock DOS/INT33.
+
+Requires Python 3.10+, Pillow, NASM and an SDL2/heavy-debug/agent DOSBox-X build.
+Outputs PNGs and a JSON evidence report in the explicit --output directory.
+"""
+from __future__ import annotations
+
+import argparse
+import dataclasses
+import json
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / 'tools'))
+sys.path.insert(0, str(ROOT / 'client' / 'python'))
+
+from headless_agent import HeadlessAgent, save_screenshot
+from dosbox_agent import MemoryAddress, AgentRpcError
+from PIL import Image
+
+STATUS_FIELDS = (
+    'version sample_count mouse_x mouse_y mouse_buttons presses releases '
+    'press_x press_y release_x release_y callback_count callback_mask '
+    'callback_buttons callback_x callback_y down_samples command_ack '
+    'video_mode frame_width frame_height palette_revision last_key '
+    'ticks_low ticks_high mouse_installed button_count command_sequence'
+).split()
+
+
+def run_for(client, sid, milliseconds=150):
+    operation = client.continue_(sid)
+    result = client.wait(sid, operation.id, milliseconds)
+    if result.running:
+        pause = client.pause(sid)
+        result = client.wait(sid, pause.id, 3000)
+    assert not result.running and result.session.state == 'stopped', result
+    return result.session
+
+
+def read_status(client, sid, segment):
+    raw = client.read_memory(sid, MemoryAddress.segmented(segment, 0x800),
+                             4 + len(STATUS_FIELDS) * 2).data
+    assert raw[:4] == b'MVID', raw.hex()
+    return dict(zip(STATUS_FIELDS, struct.unpack('<' + 'H'*len(STATUS_FIELDS), raw[4:])))
+
+
+def command(client, sid, segment, value):
+    address = MemoryAddress.segmented(segment, 0x840)
+    before = client.read_memory(sid, address, 2)
+    client.write_memory(sid, address, struct.pack('<H', value), expected_sha256=before.sha256)
+    run_for(client, sid)
+    status = read_status(client, sid, segment)
+    assert status['command_ack'] == value, status
+    return status
+
+
+def must_reject(client, method, params, reason):
+    try:
+        client.call(method, params)
+    except AgentRpcError as error:
+        assert error.data.get('reason') == reason, (error, error.data)
+    else:
+        raise AssertionError(f'{method} accepted invalid input')
+
+
+def debugger_checks(executable, runtime):
+    with HeadlessAgent(executable, runtime) as launched:
+        client = launched.client
+        capabilities = client.capabilities()
+        assert capabilities['debugger'] and capabilities['trace']['cpu'], capabilities
+        session = client.start('AGENTFIX.COM')
+        assert session.state == 'stopped' and session.stop_reason.kind == 'startup'
+        registers = client.get_registers(session.id)
+        assert int(registers.instruction_pointer, 16) == 0x100
+        segment = registers.segments['cs']
+        entry = client.read_memory(session.id, MemoryAddress.segmented(segment, 0x100), 6)
+        assert entry.data == bytes.fromhex('b83412bb7856')
+        # A real CPU trace, bounded to two instructions, must stop execution.
+        client.start_trace(session.id, 'normal', 2)
+        operation = client.continue_(session.id)
+        result = client.wait(session.id, operation.id, 3000)
+        assert not result.running and result.session.state == 'stopped'
+        trace = client.read_trace(session.id, None, 10)
+        assert [event.sequence for event in trace.events] == [1, 2]
+        assert [int(event.address.offset, 16) for event in trace.events] == [0x100, 0x103]
+        assert all(event.instruction and event.register_changes for event in trace.events)
+        assert int(trace.events[1].register_changes['eax'], 16) == 0x1234
+        client.stop_trace(session.id)
+        breakpoint = client.create_execution_breakpoint(session.id, segment, 0x106)
+        operation = client.continue_(session.id)
+        result = client.wait(session.id, operation.id, 3000)
+        assert not result.running and result.session.stop_reason.kind == 'breakpoint'
+        registers = client.get_registers(session.id)
+        assert int(registers.instruction_pointer, 16) == 0x106
+        assert int(registers.general['eax'], 16) == 0x1234
+        assert int(registers.general['ebx'], 16) == 0x5678
+        address = MemoryAddress.segmented(registers.segments['ds'], 0x200)
+        before = client.read_memory(session.id, address, 4)
+        try:
+            client.write_memory(session.id, address, b'\xde\xad\xbe\xef', expected_sha256='0'*64)
+        except AgentRpcError as error:
+            assert error.data.get('reason') == 'MEMORY_PRECONDITION_FAILED'
+        else:
+            raise AssertionError('incorrect memory precondition was accepted')
+        assert client.read_memory(session.id, address, 4).data == before.data
+        client.write_memory(session.id, address, b'\xde\xad\xbe\xef', expected_sha256=before.sha256)
+        assert client.read_memory(session.id, address, 4).data == b'\xde\xad\xbe\xef'
+        stepped, after = client.step(session.id)
+        assert stepped.stop_reason.kind == 'step'
+        assert int(after.instruction_pointer, 16) == 0x109
+        assert int(after.general['esi'], 16) == 0x200
+        client.delete_breakpoint(session.id, breakpoint.id)
+        operation = client.stop(session.id)
+        stopped = client.wait(session.id, operation.id, 3000)
+        assert not stopped.running and stopped.session.state == 'exited'
+        return {'capabilities': capabilities, 'trace': dataclasses.asdict(trace),
+                'breakpoint_registers': dataclasses.asdict(registers),
+                'step_registers': dataclasses.asdict(after), 'memory_patch': 'deadbeef',
+                'wrong_memory_hash_rejected': True, 'stop': dataclasses.asdict(stopped)}
+
+
+def video_mouse_checks(executable, runtime, output):
+    with HeadlessAgent(executable, runtime) as launched:
+        client = launched.client
+        session = client.start('MOUSEVID.COM')
+        segment = client.get_registers(session.id).segments['cs']
+        run_for(client, session.id, 250)
+        initial = read_status(client, session.id, segment)
+        assert initial['mouse_installed'] == 0xffff and initial['sample_count'] > 0, initial
+        frame = save_screenshot(client, session.id, output/'mode13.png')
+        assert (frame['width'], frame['height']) == (320, 200), frame
+        with Image.open(output/'mode13.png') as image:
+            assert image.size == (320, 200)
+            for y, rgb in [(10,(255,0,0)), (60,(0,255,0)), (110,(0,0,255)), (160,(255,255,255))]:
+                assert image.getpixel((10,y))[:3] == rgb, (y,image.getpixel((10,y)))
+        before = client.get_registers(session.id)
+        repeated = save_screenshot(client, session.id, output/'mode13-repeat.png')
+        assert frame == repeated, (frame,repeated)
+        assert before == client.get_registers(session.id), 'screenshot advanced CPU registers'
+        assert initial == read_status(client, session.id, segment), 'screenshot advanced guest status'
+        moved = client.call('input.mouse.move', {'session_id':session.id,'x':160,'y':90,'mode_id':frame['mode_id']})
+        assert (moved['mouse']['x'], moved['mouse']['y']) == (320,90), moved
+        clicked = client.call('input.mouse.click', {'session_id':session.id,'x':160,'y':90,'button':'left','hold_ms':50})
+        assert clicked['mouse']['buttons'] & 1 and clicked['mouse']['release_pending'], clicked
+        save_screenshot(client, session.id, output/'click-queued.png')
+        # Queuing input while stopped cannot run a guest callback or its timer.
+        assert initial == read_status(client, session.id, segment)
+        queued_registers = client.get_registers(session.id)
+        # Move and click are state mutations; the CPU register values stay put
+        # while the session revision advances once for each accepted mutation.
+        assert queued_registers.state_revision == before.state_revision + 2
+        assert before == dataclasses.replace(queued_registers, state_revision=before.state_revision)
+        run_for(client, session.id, 250)
+        delivered = read_status(client, session.id, segment)
+        assert (delivered['mouse_x'], delivered['mouse_y']) == (320,90), delivered
+        assert delivered['presses'] == 1 and delivered['releases'] == 1, delivered
+        assert delivered['down_samples'] > 0 and delivered['callback_count'] > 0, delivered
+        assert (delivered['press_x'], delivered['press_y']) == (320,90), delivered
+        assert (delivered['release_x'], delivered['release_y']) == (320,90), delivered
+        assert not client.call('input.mouse.state', {'session_id':session.id})['mouse']['release_pending']
+        command(client, session.id, segment, 1)
+        clipped = client.call('input.mouse.move', {'session_id':session.id,'x':319,'y':199})
+        assert (clipped['mouse']['x'],clipped['mouse']['y']) == (200,80), clipped
+        run_for(client, session.id)
+        clipping = read_status(client, session.id, segment)
+        assert (clipping['mouse_x'],clipping['mouse_y']) == (200,80), clipping
+        must_reject(client,'input.mouse.move',{'session_id':session.id,'x':0,'y':0,'mode_id':frame['mode_id']+999},'STALE_FRAME')
+        must_reject(client,'input.mouse.move',{'session_id':session.id,'x':320,'y':0},'COMMAND_REJECTED')
+        command(client, session.id, segment, 3)
+        palette = save_screenshot(client, session.id, output/'palette-magenta.png')
+        with Image.open(output/'palette-magenta.png') as image:
+            assert image.getpixel((10,10))[:3] == (255,0,255)
+        assert palette['sha256'] != frame['sha256']
+        command(client, session.id, segment, 4)
+        high = save_screenshot(client, session.id, output/'mode12.png')
+        assert (high['width'], high['height']) == (640,480), high
+        assert high['mode_id'] != frame['mode_id']
+        must_reject(client,'input.mouse.move',{'session_id':session.id,'x':10,'y':10,'mode_id':frame['mode_id']},'STALE_FRAME')
+        high_move=client.call('input.mouse.move', {'session_id':session.id,'x':80,'y':60,'mode_id':high['mode_id']})
+        assert (high_move['mouse']['x'],high_move['mouse']['y']) == (80,60), high_move
+        run_for(client, session.id)
+        high_status=read_status(client,session.id,segment)
+        assert (high_status['mouse_x'],high_status['mouse_y']) == (80,60), high_status
+        command(client,session.id,segment,5)
+        restored=save_screenshot(client,session.id,output/'mode13-restored.png')
+        assert (restored['width'],restored['height']) == (320,200)
+        operation=client.stop(session.id)
+        assert client.wait(session.id,operation.id,3000).session.state == 'exited'
+        return {'initial_status':initial,'frame':frame,'click_accepted':clicked,
+                'delivered_status':delivered,'clipped_status':clipping,
+                'palette':palette,'mode12':high,'mode12_status':high_status,
+                'restored':restored,'stopped_observations_do_not_execute':True}
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--executable',required=True,type=Path)
+    parser.add_argument('--output',required=True,type=Path)
+    parser.add_argument('--nasm',default=shutil.which('nasm'))
+    args=parser.parse_args()
+    if not args.nasm: parser.error('NASM is required; set --nasm')
+    output=args.output.resolve()
+    output.mkdir(parents=True,exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix='dosbox-acceptance-') as directory:
+        runtime=Path(directory)
+        subprocess.run([args.nasm,'-f','bin',str(ROOT/'tests/agent/fixtures/agent_fixture.asm'),'-o',str(runtime/'AGENTFIX.COM')],check=True)
+        subprocess.run([args.nasm,'-f','bin',str(Path(__file__).with_name('MOUSEVID.asm')),'-o',str(runtime/'MOUSEVID.COM')],check=True)
+        report={'debugger':debugger_checks(args.executable,runtime),
+                'video_mouse':video_mouse_checks(args.executable,runtime,output)}
+    (output/'verification.json').write_text(json.dumps(report,indent=2)+'\n')
+    print('PASS: real headless DOS execution, registers, memory, trace, breakpoint, screenshots, absolute mouse and guest callbacks')
+    return 0
+
+
+if __name__=='__main__':
+    raise SystemExit(main())
