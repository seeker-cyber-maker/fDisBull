+
+static void CaptureCompletedAgentFrame()
+{
+    if (!agent_frame_capture_enabled || !scalerSourceCacheBuffer ||
+        render.scale.inLine < render.src.height || !render.src.width || !render.src.height)
+        return;
+    const std::size_t width = render.src.width;
+    const std::size_t height = render.src.height;
+    if (width > max_agent_frame_bytes / 4u ||
+        height > max_agent_frame_bytes / (width * 4u)) {
+        agent_frame_valid = false;
+        agent_frame = FrameSnapshot();
+        return;
+    }
+    const unsigned int bpp = static_cast<unsigned int>(render.src.bpp);
+    const std::size_t bytes_per_pixel = bpp == 8 ? 1u : bpp == 15 || bpp == 16 ? 2u : bpp == 32 ? 4u : 0u;
+    if (!bytes_per_pixel || render.scale.cachePitch < width * bytes_per_pixel ||
+        render.scale.cachePitch > scalerSourceCacheBufferSize / height) {
+        agent_frame_valid = false;
+        return;
+    }
+    // Headless display change flags can miss palette-only changes, including
+    // a palette already expanded into a 32-bit renderer source. Refresh
+    // every completed source frame; resize reuses the RGBA allocation.
+    agent_frame.rgba.resize(width * height * 4u);
+    for (std::size_t y = 0; y < height; ++y) {
+        const std::uint8_t* row = scalerSourceCacheBuffer + y * render.scale.cachePitch;
+        for (std::size_t x = 0; x < width; ++x) {
+            std::uint8_t* pixel = &agent_frame.rgba[(y * width + x) * 4u];
+            if (bpp == 8) {
+                pixel[0] = render.pal.rgb[row[x]].red;
+                pixel[1] = render.pal.rgb[row[x]].green;
+                pixel[2] = render.pal.rgb[row[x]].blue;
+            } else if (bpp == 15 || bpp == 16) {
+                std::uint16_t value;
+                memcpy(&value, row + x * 2u, sizeof(value));
+                const unsigned int r = bpp == 15 ? (value >> 10u) & 31u : (value >> 11u) & 31u;
+                const unsigned int g = bpp == 15 ? (value >> 5u) & 31u : (value >> 5u) & 63u;
+                const unsigned int b = value & 31u;
+                pixel[0] = static_cast<std::uint8_t>((r << 3u) | (r >> 2u));
+                pixel[1] = static_cast<std::uint8_t>(bpp == 15 ? (g << 3u) | (g >> 2u) : (g << 2u) | (g >> 4u));
+                pixel[2] = static_cast<std::uint8_t>((b << 3u) | (b >> 2u));
+            } else {
+                std::uint32_t value;
+                memcpy(&value, row + x * 4u, sizeof(value));
+                pixel[0] = static_cast<std::uint8_t>((value >> 16u) & 255u);
+                pixel[1] = static_cast<std::uint8_t>((value >> 8u) & 255u);
+                pixel[2] = static_cast<std::uint8_t>(value & 255u);
+            }
+            pixel[3] = 255;
+        }
+    }
