diff --git a/client/python/tests/test_unix_transport.py b/client/python/tests/test_unix_transport.py
new file mode 100644
index 0000000..aed1ff4
--- /dev/null
+++ b/client/python/tests/test_unix_transport.py
@@ -0,0 +1,233 @@
+"""Real local IPC tests for the POSIX debugger transport and client."""
+from __future__ import annotations
+
+from dataclasses import replace
+import json
+import os
+from pathlib import Path
+import select
+import shutil
+import socket
+import stat
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from dosbox_agent import AgentClient, AgentConfig, AgentConnectionError, AgentProtocolError
+from dosbox_agent.client import UnixSocketTransport, load_config
+
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+@unittest.skipUnless(os.name == 'posix', 'POSIX local socket transport')
+class UnixSocketClientTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.path = Path(self.directory.name)/'agent.sock'
+
+    def server(self, action):
+        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        listener.bind(str(self.path))
+        os.chmod(self.path, 0o600)
+        listener.listen(1)
+        errors = []
+
+        def run():
+            try:
+                connection, _ = listener.accept()
+                with connection:
+                    action(connection)
+            except Exception as error:
+                errors.append(error)
+            finally:
+                listener.close()
+
+        thread = threading.Thread(target=run, daemon=True)
+        thread.start()
+        self.addCleanup(listener.close)
+        self.addCleanup(lambda: thread.join(2))
+        return thread, errors
+
+    def test_agent_client_uses_real_socket_and_matches_request_identity(self):
+        def reply(connection):
+            request = json.loads(connection.makefile('rb').readline())
+            payload = json.dumps(dict(jsonrpc='2.0', id=request['id'], result={'transport':'unix_socket'})).encode()+b'\n'
+            connection.sendall(payload[:9])
+            connection.sendall(payload[9:])
+
+        thread, errors = self.server(reply)
+        config = AgentConfig(Path(self.directory.name)/'agent.env','unix_socket',str(self.path),
+                             Path('/program'),Path('/work'),500,1024,256,100)
+        with AgentClient(config) as client:
+            self.assertEqual(client.capabilities(), {'transport':'unix_socket'})
+        thread.join(1)
+        self.assertEqual(errors, [])
+
+    def test_private_parent_and_socket_permissions_are_required(self):
+        self.server(lambda connection: connection.close())
+        os.chmod(self.path, 0o666)
+        transport = UnixSocketTransport(str(self.path))
+        with self.assertRaisesRegex(AgentConnectionError, 'mode-0600'):
+            transport.request('{}',100,128)
+        os.chmod(self.path, 0o600)
+        os.chmod(self.directory.name,0o755)
+        try:
+            with self.assertRaisesRegex(AgentConnectionError, 'mode-0700'):
+                transport.request('{}',100,128)
+        finally:
+            os.chmod(self.directory.name,0o700)
+
+    def test_oversized_response_is_rejected_without_truncating(self):
+        def reply(connection):
+            connection.recv(128)
+            connection.sendall(b'x'*129+b'\n')
+        self.server(reply)
+        with self.assertRaisesRegex(AgentProtocolError, 'exceeds'):
+            UnixSocketTransport(str(self.path)).request('{}',500,128)
+
+    def test_non_utf8_response_is_explicit_protocol_error(self):
+        def reply(connection):
+            connection.recv(128)
+            connection.sendall(b'\xff\n')
+        self.server(reply)
+        with self.assertRaisesRegex(AgentProtocolError, 'UTF-8'):
+            UnixSocketTransport(str(self.path)).request('{}',500,128)
+
+    def test_timeout_closes_connection_without_resending_request(self):
+        received = []
+        def reply(connection):
+            received.append(connection.recv(128))
+            time.sleep(0.15)
+        thread, errors = self.server(reply)
+        transport = UnixSocketTransport(str(self.path))
+        with self.assertRaises(AgentConnectionError):
+            transport.request('{"id":1}',30,128)
+        self.assertIsNone(transport._socket)
+        thread.join(1)
+        self.assertEqual(received,[b'{"id":1}\n'])
+
+    def test_unix_config_is_explicit_and_has_absolute_endpoint(self):
+        path = Path(self.directory.name)/'agent.env'
+        content = '\n'.join(('transport=unix_socket',f'endpoint={self.path}',
+                             'dosbox_executable=/program','dosbox_workdir=/work',
+                             'request_timeout_ms=100','max_message_bytes=128',
+                             'max_memory_read_bytes=64','max_trace_events=16'))
+        path.write_text(content)
+        self.assertEqual(load_config(path).transport,'unix_socket')
+        path.write_text(content.replace(str(self.path),'relative.sock'))
+        with self.assertRaisesRegex(ValueError, 'absolute'):
+            load_config(path)
+
+
+@unittest.skipUnless(os.name == 'posix' and shutil.which('g++'), 'POSIX C++ compiler')
+class UnixSocketServerTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.build = tempfile.TemporaryDirectory()
+        cls.executable = Path(cls.build.name)/'transport-probe'
+        subprocess.run(['g++','-std=c++11','-pthread','-DC_DEBUG=1','-DC_DOSBOX_AGENT=1',
+                        '-I'+str(ROOT/'include'),str(ROOT/'src/agent/transport/local_transport.cpp'),
+                        str(ROOT/'src/agent/transport/unix_transport_probe.cpp'),'-o',str(cls.executable)],
+                       check=True,capture_output=True,text=True)
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.build.cleanup()
+
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.path = Path(self.directory.name)/'agent.sock'
+
+    def launch(self):
+        process = subprocess.Popen([str(self.executable),str(self.path)],stdin=subprocess.PIPE,
+                                   stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
+        self.addCleanup(lambda: self.cleanup_process(process))
+        self.assertTrue(select.select([process.stdout],[],[],3)[0], 'server startup timed out')
+        self.assertEqual(process.stdout.readline().strip(),'READY')
+        return process
+
+    @staticmethod
+    def cleanup_process(process):
+        if process.poll() is None:
+            try:
+                process.communicate('stop\n',timeout=2)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.communicate(timeout=2)
+
+    def test_real_server_permissions_framing_and_concurrent_clients(self):
+        process = self.launch()
+        self.assertEqual(stat.S_IMODE(self.path.stat().st_mode),0o600)
+        first = socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
+        first.connect(str(self.path))
+        self.addCleanup(first.close)
+        second = UnixSocketTransport(str(self.path))
+        self.addCleanup(second.close)
+        # An idle connection must not prevent another debugger request.
+        self.assertEqual(second.request('{"id":2}',500,128),'{"id":2}')
+        first.sendall(b'{"id":')
+        first.sendall(b'1}\n')
+        self.assertEqual(first.recv(128),b'{"id":1}\n')
+        self.assertEqual(second.request('{"id":3}',500,128),'{"id":3}')
+        stdout,stderr = process.communicate('stop\n',timeout=2)
+        self.assertEqual(process.returncode,0,stderr)
+        self.assertIn('STOPPED',stdout)
+        self.assertFalse(self.path.exists())
+
+    def test_existing_file_or_socket_is_not_removed_or_replaced(self):
+        self.path.write_text('retain me')
+        result = subprocess.run([str(self.executable),str(self.path)],input='stop\n',
+                                capture_output=True,text=True,timeout=3)
+        self.assertEqual(result.returncode,1)
+        self.assertIn('refusing to replace',result.stderr)
+        self.assertEqual(self.path.read_text(),'retain me')
+        self.path.unlink()
+        listener = socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
+        self.addCleanup(listener.close)
+        listener.bind(str(self.path))
+        inode=self.path.stat().st_ino
+        result=subprocess.run([str(self.executable),str(self.path)],capture_output=True,text=True,timeout=3)
+        self.assertEqual(result.returncode,1)
+        self.assertEqual(self.path.stat().st_ino,inode)
+
+    def test_replaced_endpoint_is_not_unlinked_during_shutdown(self):
+        process=self.launch()
+        self.path.unlink()
+        self.path.write_text('replacement')
+        process.communicate('stop\n',timeout=2)
+        self.assertEqual(self.path.read_text(),'replacement')
+
+    def test_parent_permissions_and_overlong_path_reject_before_bind(self):
+        os.chmod(self.directory.name,0o755)
+        try:
+            result=subprocess.run([str(self.executable),str(self.path)],capture_output=True,text=True,timeout=3)
+            self.assertEqual(result.returncode,1)
+            self.assertIn('0700',result.stderr)
+            self.assertFalse(self.path.exists())
+        finally:
+            os.chmod(self.directory.name,0o700)
+        result=subprocess.run([str(self.executable),str(self.path.parent/('x'*120))],
+                              capture_output=True,text=True,timeout=3)
+        self.assertEqual(result.returncode,1)
+        self.assertIn('too long',result.stderr)
+
+    def test_oversized_request_disconnects_without_executing_truncated_request(self):
+        self.launch()
+        connection=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
+        self.addCleanup(connection.close)
+        connection.settimeout(1)
+        connection.connect(str(self.path))
+        connection.sendall(b'x'*129+b'\n')
+        self.assertEqual(connection.recv(128),b'')
+
+
+if __name__ == '__main__':
+    unittest.main()
