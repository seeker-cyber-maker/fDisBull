+static bool OptionalFrameNumber(const JsonValue& params, const char* name,
+                                bool* present, std::uint64_t* result)
+{
+    const JsonValue* value = params.Find(name);
+    *present = value != NULL;
+    if (!value) return true;
+    if (value->type != JsonType::Number || value->text.empty()) return false;
+    *result = 0;
+    for (char c : value->text) {
+        if (c < '0' || c > '9' || *result > ((std::numeric_limits<std::uint64_t>::max)() - (c-'0')) / 10) return false;
+        *result = *result * 10 + (c-'0');
+    }
+    return true;
+}
