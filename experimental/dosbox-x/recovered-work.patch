+    ReadMouseState(state);
+    return true;
+}
+
+bool AGENT_MouseMoveAbsolute(std::uint32_t x, std::uint32_t y,
+                             std::uint32_t frame_width,
+                             std::uint32_t frame_height,
+                             AgentMouseState* state, std::string* error)
+{
+    if (!RequireAbsoluteMouse(error)) return false;
+    if (frame_width == 0 || frame_height == 0 ||
+        frame_width > 4096 || frame_height > 4096 ||
+        x >= frame_width || y >= frame_height) {
+        if (error) *error = "Absolute mouse point must lie inside a 1..4096 pixel framebuffer";
+        return false;
+    }
+    const std::int32_t next_x = FrameToMouseAxis(x, frame_width,
+        mouse.max_screen_x, mouse.min_x, mouse.max_x);
+    const std::int32_t next_y = FrameToMouseAxis(y, frame_height,
+        mouse.max_screen_y, mouse.min_y, mouse.max_y);
+    const std::int32_t previous_x = POS_X;
+    const std::int32_t previous_y = POS_Y;
+    mouse.x = static_cast<float>(next_x);
+    mouse.y = static_cast<float>(next_y);
+    if (previous_x != POS_X || previous_y != POS_Y) {
+        Mouse_AddEvent(MOUSE_HAS_MOVED);
+    }
+    ReadMouseState(state);
+    return true;
+}
+
+bool AGENT_MouseButton(std::uint32_t button, bool pressed,
+                       AgentMouseState* state, std::string* error)
+{
+    if (!RequireAbsoluteMouse(error)) return false;
+    if (button >= MOUSE_BUTTONS) {
+        if (error) *error = "Mouse button must be 0 (left), 1 (right) or 2 (middle)";
+        return false;
+    }
+    const std::uint8_t mask = static_cast<std::uint8_t>(1u << button);
+    if ((mouse.buttons & mask) && !(agent_owned_buttons & mask)) {
+        if (error) *error = "Mouse button is held outside this agent; it will not be taken over";
+        return false;
+    }
+    if (pressed) {
+        Mouse_ButtonPressed(static_cast<std::uint8_t>(button));
+        agent_owned_buttons |= mask;
+    } else {
+        PIC_RemoveSpecificEvents(AgentMouseReleaseEvent, button);
+        agent_pending_release_buttons &= static_cast<std::uint8_t>(~mask);
+        Mouse_ButtonReleased(static_cast<std::uint8_t>(button));
+        agent_owned_buttons &= static_cast<std::uint8_t>(~mask);
+    }
+    ReadMouseState(state);
+    return true;
+}
+
+bool AGENT_MouseClickAbsolute(std::uint32_t x, std::uint32_t y,
+                              std::uint32_t frame_width,
+                              std::uint32_t frame_height,
+                              std::uint32_t button, std::uint32_t hold_ms,
+                              AgentMouseState* state, std::string* error)
+{
+    if (!RequireAbsoluteMouse(error)) return false;
+    if (button >= MOUSE_BUTTONS || hold_ms < 1 || hold_ms > 1000) {
+        if (error) *error = "Click requires button 0..2 and hold_ms 1..1000 of guest time";
+        return false;
+    }
+    const std::uint8_t mask = static_cast<std::uint8_t>(1u << button);
+    if ((mouse.buttons | agent_pending_release_buttons) & mask) {
+        if (error) *error = "Mouse button is already held or has a pending click release";
+        return false;
+    }
+    if (!AGENT_MouseMoveAbsolute(x, y, frame_width, frame_height, NULL, error)) return false;
+    if (!AGENT_MouseButton(button, true, NULL, error)) return false;
+    agent_pending_release_buttons |= mask;
+    PIC_AddEvent(AgentMouseReleaseEvent, static_cast<pic_tickindex_t>(hold_ms), button);
+    ReadMouseState(state);
+    return true;
+}
+
+void AGENT_MouseResetInput()
+{
+    PIC_RemoveEvents(AgentMouseReleaseEvent);
+    agent_pending_release_buttons = 0;
+    for (std::uint32_t button = 0; button < MOUSE_BUTTONS; ++button) {
+        const std::uint8_t mask = static_cast<std::uint8_t>(1u << button);
+        if (agent_owned_buttons & mask) {
+            Mouse_ButtonReleased(static_cast<std::uint8_t>(button));
+        }
+    }
+    agent_owned_buttons = 0;
+}
