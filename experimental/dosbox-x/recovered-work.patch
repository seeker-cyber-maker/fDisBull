+class UnixSocketTransport:
+    """Bounded JSON-lines over a private, same-user filesystem Unix socket.
+
+    A timeout or malformed response closes the connection. No side-effecting
+    request is retried after a send: the caller must resolve request IDs.
+    """
+
+    def __init__(self, endpoint: str) -> None:
+        self._endpoint = endpoint
+        self._socket: socket.socket | None = None
+        self._lock = threading.Lock()
+
+    def _connect(self, deadline: float) -> None:
+        if os.name == "nt" or not hasattr(socket, "AF_UNIX"):
+            raise AgentConnectionError("unix_socket transport requires a POSIX host")
+        path = Path(self._endpoint)
+        if not path.is_absolute() or "\x00" in self._endpoint:
+            raise AgentConnectionError("Unix socket endpoint must be an absolute path without NUL bytes")
+        try:
+            parent = path.parent.lstat()
+            endpoint = path.lstat()
+        except OSError as error:
+            raise AgentConnectionError(f"unable to inspect Unix socket endpoint: {error}") from error
+        if (not stat.S_ISDIR(parent.st_mode) or parent.st_uid != os.geteuid()
+                or stat.S_IMODE(parent.st_mode) != 0o700):
+            raise AgentConnectionError("Unix socket parent must be an owner-owned mode-0700 directory")
+        if (not stat.S_ISSOCK(endpoint.st_mode) or endpoint.st_uid != os.geteuid()
+                or stat.S_IMODE(endpoint.st_mode) != 0o600):
+            raise AgentConnectionError("Unix socket endpoint must be an owner-owned mode-0600 socket")
+        connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        try:
+            connection.settimeout(max(0.001, deadline-time.monotonic()))
+            connection.connect(self._endpoint)
+            if hasattr(socket, "SO_PEERCRED"):
+                import struct
+                credentials = connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
+                if struct.unpack("3i", credentials)[1] != os.geteuid():
+                    raise AgentConnectionError("Unix socket server has a different user identity")
+            elif hasattr(connection, "getpeereid"):
+                if connection.getpeereid()[0] != os.geteuid():
+                    raise AgentConnectionError("Unix socket server has a different user identity")
+            self._socket = connection
+        except (OSError, AgentConnectionError):
+            connection.close()
+            raise
+
+    def request(self, payload: str, timeout_ms: int, max_message_bytes: int) -> str:
+        encoded = payload.encode("utf-8")
+        if len(encoded) > max_message_bytes:
+            raise AgentProtocolError("request exceeds configured max_message_bytes")
+        deadline = time.monotonic() + timeout_ms/1000
+        with self._lock:
+            try:
+                if self._socket is None:
+                    self._connect(deadline)
+                connection = self._socket
+                assert connection is not None
+                connection.settimeout(max(0.001, deadline-time.monotonic()))
+                connection.sendall(encoded+b"\n")
+                response = bytearray()
+                while True:
+                    remaining = deadline-time.monotonic()
+                    if remaining <= 0:
+                        raise AgentConnectionError("timed out waiting for Unix-socket response")
+                    connection.settimeout(remaining)
+                    chunk = connection.recv(min(4096, max_message_bytes+1-len(response)))
+                    if not chunk:
+                        raise AgentConnectionError("Unix socket closed before a complete response")
+                    response.extend(chunk)
+                    newline = response.find(b"\n")
+                    if newline >= 0:
+                        if newline > max_message_bytes:
+                            raise AgentProtocolError("response exceeds configured max_message_bytes")
+                        if newline != len(response)-1:
+                            raise AgentProtocolError("unsolicited bytes after Unix-socket response")
+                        try:
+                            return bytes(response[:newline]).decode("utf-8")
+                        except UnicodeDecodeError as error:
+                            raise AgentProtocolError("server response is not UTF-8") from error
+                    if len(response) > max_message_bytes:
+                        raise AgentProtocolError("response exceeds configured max_message_bytes")
+            except OSError as error:
+                self.close()
+                raise AgentConnectionError(f"Unix socket I/O failed: {error}") from error
+            except (AgentConnectionError, AgentProtocolError):
+                self.close()
+                raise
+
+    def close(self) -> None:
+        if self._socket is not None:
+            self._socket.close()
+        self._socket = None
+
