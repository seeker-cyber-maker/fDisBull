+    Add(&result, "min_y", SignedNumber(mouse.min_y)); Add(&result, "max_y", SignedNumber(mouse.max_y));
+    Add(&result, "screen_max_x", SignedNumber(mouse.screen_max_x));
+    Add(&result, "screen_max_y", SignedNumber(mouse.screen_max_y));
+    Add(&result, "buttons", Number(mouse.buttons));
+    Add(&result, "owned_buttons", Number(mouse.owned_buttons));
+    Add(&result, "pending_release_buttons", Number(mouse.pending_release_buttons));
+    Add(&result, "release_pending", JsonValue::Bool(mouse.release_pending));
+    return result;
+}
