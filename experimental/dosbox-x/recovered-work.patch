+#ifndef DOSBOX_AGENT_INPUT_ADAPTER_H
+#define DOSBOX_AGENT_INPUT_ADAPTER_H
+
+#include <cstdint>
+#include <string>
+
+namespace dosbox_agent {
+
+// Observed DOS INT 33h driver coordinates, after clipping and granularity.
+// These are not host pointer coordinates or accelerated relative mickeys.
+struct AgentMouseState {
+    std::int32_t x = 0;
+    std::int32_t y = 0;
+    std::int32_t min_x = 0;
+    std::int32_t max_x = 0;
+    std::int32_t min_y = 0;
+    std::int32_t max_y = 0;
+    std::int32_t screen_max_x = 0;
+    std::int32_t screen_max_y = 0;
+    std::uint32_t buttons = 0;
+    std::uint32_t owned_buttons = 0;
+    std::uint32_t pending_release_buttons = 0;
+    bool release_pending = false;
+};
+
+// All functions are called on the emulation thread. Absolute positions are
+// zero-based pixels in a supplied completed framebuffer's coordinate space.
+// Frame freshness/current mode must be checked by the caller before injection.
+// The supported target is the built-in DOS INT 33h driver, not guest PS/2,
+// serial-only, PC-98, protected-mode or externally installed mouse drivers.
+bool AGENT_MouseGetState(AgentMouseState* state, std::string* error);
+bool AGENT_MouseMoveAbsolute(std::uint32_t x, std::uint32_t y,
+                             std::uint32_t frame_width,
+                             std::uint32_t frame_height,
+                             AgentMouseState* state, std::string* error);
+bool AGENT_MouseButton(std::uint32_t button, bool pressed,
+                       AgentMouseState* state, std::string* error);
+bool AGENT_MouseClickAbsolute(std::uint32_t x, std::uint32_t y,
+                              std::uint32_t frame_width,
+                              std::uint32_t frame_height,
+                              std::uint32_t button, std::uint32_t hold_ms,
+                              AgentMouseState* state, std::string* error);
+
+// Cancel queued releases and release only buttons pressed by this adapter.
+// A queued click holds its button until hold_ms of guest emulated time passes;
+// an RPC response does not establish that the guest has processed that input.
+void AGENT_MouseResetInput();
+
+} // namespace dosbox_agent
+
+#endif
