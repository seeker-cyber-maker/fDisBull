+// Standalone transport acceptance fixture; not part of the DOSBox executable.
+#include "rpc_transport.h"
+#include <iostream>
+#include <string>
+
+int main(int argc, char** argv)
+{
+    if (argc != 2) return 2;
+    dosbox_agent::AgentConfig config;
+    config.transport = dosbox_agent::AgentTransport::UnixSocket;
+    config.endpoint = argv[1];
+    config.max_message_bytes = 128;
+    config.request_timeout_ms = 200;
+    std::unique_ptr<dosbox_agent::IRpcTransport> transport =
+        dosbox_agent::AGENT_CreateLocalTransport(config.transport);
+    std::string error;
+    if (!transport->Start(config, [](const std::string& input) { return input; }, &error)) {
+        std::cerr << error << std::endl;
+        return 1;
+    }
+    std::cout << "READY" << std::endl;
+    std::string command;
+    std::getline(std::cin, command);
+    transport->Stop();
+    std::cout << "STOPPED" << std::endl;
+    return 0;
+}
diff --git a/tests/agent_headless/MOUSEVID.asm b/tests/agent_headless/MOUSEVID.asm
new file mode 100644
index 0000000..18a2649
--- /dev/null
+++ b/tests/agent_headless/MOUSEVID.asm
@@ -0,0 +1,257 @@
+; Real DOS/INT33 acceptance fixture. Build: nasm -f bin MOUSEVID.asm -o MOUSEVID.COM
+; All offsets below are runtime CS-relative offsets (COM origin = 0100h).
+;
+; 0600h: ready / repeated poll checkpoint, safe for an execution breakpoint.
+; 0800h: status block, see verify_headless.py STATUS_FIELDS.
+; 0840h: command word, consumed and cleared by the guest:
+;   1 clip X=100..200, Y=20..80; 2 restore mode13 full ranges;
+;   3 change palette index 1 from red to magenta;
+;   4 switch to mode12 (640x480); 5 switch to mode13 (320x200);
+;   6 hide cursor; 7 show cursor; 8 exit to DOS.
+; The callback records genuine mouse IRQ delivery as well as INT33 polling.
+bits 16
+org 100h
+
+    jmp start
+
+start:
+    push cs
+    pop ds
+    cld
+    call set_mode13
+    jmp poll_checkpoint
+
+set_mode13:
+    mov ax, 0013h
+    int 10h
+    mov word [video_mode], 13h
+    mov word [frame_width], 320
+    mov word [frame_height], 200
+    mov word [palette_revision], 0
+    mov ax, 0a000h
+    mov es, ax
+    xor di, di
+    mov al, 1
+    mov cx, 16000
+    rep stosb
+    mov al, 2
+    mov cx, 16000
+    rep stosb
+    mov al, 3
+    mov cx, 16000
+    rep stosb
+    mov al, 4
+    mov cx, 16000
+    rep stosb
+    mov dx, 03c8h
+    mov al, 1
+    out dx, al
+    inc dx
+    mov al, 63                  ; 1 red
+    out dx, al
+    xor al, al
+    out dx, al
+    out dx, al
+    out dx, al                  ; 2 green
+    mov al, 63
+    out dx, al
+    xor al, al
+    out dx, al
+    out dx, al                  ; 3 blue
+    out dx, al
+    mov al, 63
+    out dx, al
+    out dx, al                  ; 4 white
+    out dx, al
+    out dx, al
+    call reset_mouse
+    ret
+
+set_mode12:
+    mov ax, 0012h
+    int 10h
+    mov word [video_mode], 12h
+    mov word [frame_width], 640
+    mov word [frame_height], 480
+    call reset_mouse
+    ret
+
+reset_mouse:
+    xor ax, ax
+    int 33h
+    mov [mouse_installed], ax
+    mov [button_count], bx
+    push cs
+    pop es
+    mov dx, mouse_callback
+    mov cx, 007fh
+    mov ax, 000ch
+    int 33h
+    mov ax, 0001h
+    int 33h
+    ret
+
+apply_command:
+    mov ax, [command]
+    or ax, ax
+    jz .done
+    mov [command_ack], ax
+    inc word [command_sequence]
+    mov word [command], 0
+    cmp ax, 1
+    je .clip
+    cmp ax, 2
+    je .full
+    cmp ax, 3
+    je .palette
+    cmp ax, 4
+    je .mode12
+    cmp ax, 5
+    je .mode13
+    cmp ax, 6
+    je .hide
+    cmp ax, 7
+    je .show
+    cmp ax, 8
+    je .exit
+.done:
+    ret
+.clip:
+    mov ax, 7
+    mov cx, 100
+    mov dx, 200
+    int 33h
+    mov ax, 8
+    mov cx, 20
+    mov dx, 80
+    int 33h
+    ret
+.full:
+    mov ax, 7
+    xor cx, cx
+    mov dx, 639
+    int 33h
+    mov ax, 8
+    xor cx, cx
+    mov dx, 199
+    int 33h
+    ret
+.palette:
+    mov dx, 03c8h
+    mov al, 1
+    out dx, al
+    inc dx
+    mov al, 63
+    out dx, al
+    xor al, al
+    out dx, al
+    mov al, 63
+    out dx, al
+    inc word [palette_revision]
+    ret
+.mode12:
+    call set_mode12
+    ret
+.mode13:
+    call set_mode13
+    ret
+.hide:
+    mov ax, 2
+    int 33h
+    ret
+.show:
+    mov ax, 1
+    int 33h
+    ret
+.exit:
+    mov ax, 3
+    int 10h
+    mov ax, 4c00h
+    int 21h
+
+mouse_callback:
+    ; All writes use CS: so the interrupted program's DS is irrelevant.
+    inc word [cs:callback_count]
+    mov [cs:callback_mask], ax
+    mov [cs:callback_buttons], bx
+    mov [cs:callback_x], cx
+    mov [cs:callback_y], dx
+    retf
+
+times 0600h - ($ - $$ + 0100h) db 90h
+poll_checkpoint:
+    call apply_command
+    mov ax, 3
+    int 33h
+    mov [mouse_x], cx
+    mov [mouse_y], dx
+    mov [mouse_buttons], bx
+    test bx, 1
+    jz .not_down
+    inc word [down_samples]
+.not_down:
+    mov ax, 5
+    xor bx, bx
+    int 33h
+    add [presses], bx
+    or bx, bx
+    jz .no_press
+    mov [press_x], cx
+    mov [press_y], dx
+.no_press:
+    mov ax, 6
+    xor bx, bx
+    int 33h
+    add [releases], bx
+    or bx, bx
+    jz .no_release
+    mov [release_x], cx
+    mov [release_y], dx
+.no_release:
+    mov ah, 01h
+    int 16h
+    jz .no_key
+    xor ah, ah
+    int 16h
+    mov [last_key], ax
+.no_key:
+    xor ah, ah
+    int 1ah
+    mov [ticks_low], dx
+    mov [ticks_high], cx
+    inc word [sample_count]
+    jmp poll_checkpoint
+
+times 0800h - ($ - $$ + 0100h) db 0
+status:
+    db 'MVID'
+version:            dw 1
+sample_count:       dw 0
+mouse_x:            dw 0
+mouse_y:            dw 0
+mouse_buttons:      dw 0
+presses:            dw 0
+releases:           dw 0
+press_x:            dw 0
+press_y:            dw 0
+release_x:          dw 0
+release_y:          dw 0
+callback_count:     dw 0
+callback_mask:      dw 0
+callback_buttons:   dw 0
+callback_x:         dw 0
+callback_y:         dw 0
+down_samples:       dw 0
+command_ack:        dw 0
+video_mode:         dw 0
+frame_width:        dw 0
+frame_height:       dw 0
+palette_revision:   dw 0
+last_key:           dw 0
+ticks_low:          dw 0
+ticks_high:         dw 0
+mouse_installed:    dw 0
+button_count:       dw 0
+command_sequence:   dw 0
+    times 0840h - ($ - $$ + 0100h) db 0
+command:            dw 0
diff --git a/tools/headless_agent.py b/tools/headless_agent.py
