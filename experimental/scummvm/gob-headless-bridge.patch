+static Common::String fdisbullRawFNV(Common::SeekableReadStream &stream, uint32 offset, uint32 size) {
+	const int64 old = stream.pos(); uint64 hash = 14695981039346656037ULL;
+	if (!stream.seek(offset)) return "";
+	byte buf[4096]; uint32 remain = size;
+	while (remain) { uint32 n = MIN<uint32>(remain, sizeof(buf)); if (stream.read(buf, n) != n) { stream.seek(old); return ""; }
+		for (uint32 i = 0; i < n; ++i) { hash ^= buf[i]; hash *= 1099511628211ULL; } remain -= n; }
+	stream.seek(old); return Common::String::format("%016llx", (unsigned long long)hash);
+}
