+namespace FDisBullBridge {
+bool enabled() { return bridge().enabled(); }
+void attachGraphics(FDisBullGraphicsManager *graphics) { bridge().attach(graphics); }
+bool pollEvent(Common::Event &event) { return bridge().pollEvent(event); }
+void warpMouse(int x, int y) { bridge().warp(x, y); }
+void beforeOpcode(Gob::GobEngine *engine, const char *family, int offset, int opcode, int width) { bridge().before(engine, family, offset, opcode, width); }
+void afterOpcode() { bridge().after(); }
+void serviceModal() { bridge().service(); }
+void memoryAccess(const Gob::Variables *arena, int offset, int length, const char *mode) { bridge().access(arena, offset, length, mode); }
+void hotspotDispatch(Gob::GobEngine *engine, const char *event, int id, int index, int target) { bridge().hotspot(engine, event, id, index, target); }
+uint32 guestMillis() { return bridge().guestMillis(); }
+void delayGuestMillis(uint32 millis) { bridge().delay(millis); }
