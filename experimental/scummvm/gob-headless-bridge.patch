+struct ScheduledEvent { Common::Event event; uint64 dueMs; int lease; };
+struct KeyLease { int id; std::string key; Common::KeyCode code; uint16 ascii; bool delivered; bool releaseScheduled; };
+struct Breakpoint { std::string script, family; uint32 generation; int offset; };
+struct Watch { int offset, length; std::string access; };
+struct Dispatch { uint64 id; std::string script, family; uint32 generation; int offset, opcode, depth, encodingWidth; std::string rawHex; };
+
+class Bridge {
+public:
+ Bridge() : _fd(-1), _graphics(nullptr), _engine(nullptr), _guestMs(0), _executed(0),
+  _queueTailMs(0), _nextLeaseId(1), _running(false), _servicing(false), _backendYield(false),
+  _pauseRequested(false), _watchHit(false), _runId(-1), _runStart(0), _maxInstructions(0),
+  _virtualDeadline(0), _hasVirtualDeadline(false), _hasHostDeadline(false), _offset(-1),
+  _opcode(-1), _skipBreak(false), _traceEnabled(false), _traceTruncated(false), _nextDispatch(1) {
+  const char *value = getenv("FDISBULL_SCUMMVM_FD");
+  if (value && *value) { char *end = nullptr; long fd = strtol(value, &end, 10); if (end && !*end && fd >= 3 && fd < 1048576) _fd = int(fd); }
+  if (_fd >= 0) signal(SIGPIPE, SIG_IGN);
+ }
+ bool enabled() const { return _fd >= 0; }
+ void attach(FDisBullGraphicsManager *graphics) { _graphics = graphics; }
+ uint32 guestMillis() const { return uint32(_guestMs); }
+ void delay(uint32 ms) { _guestMs += ms; }
+ bool pollEvent(Common::Event &event) {
+  if (_events.empty() || _events.front().dueMs > _guestMs) return false;
+  const ScheduledEvent scheduled = _events.front(); _events.erase(_events.begin()); event = scheduled.event;
+  if (event.type == Common::EVENT_KEYDOWN) _heldKeycodes.insert(int(event.kbd.keycode));
+  if (event.type == Common::EVENT_KEYUP) _heldKeycodes.erase(int(event.kbd.keycode));
+  if (scheduled.lease) for (auto it = _leases.begin(); it != _leases.end(); ++it) if (it->id == scheduled.lease) {
+   if (event.type == Common::EVENT_KEYDOWN) it->delivered = true;
+   if (event.type == Common::EVENT_KEYUP) _leases.erase(it);
+   break;
+  }
+  ++_deliveredEvents;
+  return true;
+ }
+ void warp(int x, int y) {
+  Common::Event e; e.type = Common::EVENT_MOUSEMOVE; e.mouse = Common::Point(x, y);
+  auto it = std::find_if(_events.begin(), _events.end(), [&](const ScheduledEvent &s) { return s.dueMs >= _guestMs; });
+  _events.insert(it, {e, _guestMs, 0});
+ }
+ void before(Gob::GobEngine *engine, const char *family, int offset, int opcode, int encodingWidth) {
+  if (!enabled()) return;
+  _engine = engine; _family = family; _offset = offset; _opcode = opcode;
+  _backendYield = false; _atAfter = false; safePoint();
+  Gob::Script *s = script();
+  Dispatch d = {_nextDispatch++, s ? s->fdisbullName().c_str() : "", family,
+    s ? s->fdisbullGeneration() : 0, offset, opcode, int(_stack.size()), encodingWidth, ""};
+  if (s && offset >= 0 && offset + encodingWidth <= s->getSize()) d.rawHex = hex(s->getData() + offset, encodingWidth);
+  _stack.push_back(d); trace(d, "start");
+ }
+ void after() {
+  if (!enabled() || _stack.empty()) return;
+  Dispatch d = _stack.back(); _stack.pop_back(); ++_executed; trace(d, "complete");
+  _family = d.family; _offset = d.offset; _opcode = d.opcode; _backendYield = false; _atAfter = true; safePoint();
+ }
+ void service() {
+  if (!_engine || !_running || _servicing) return;
+  _servicing = true; _backendYield = true; _atAfter = false; safePoint(); _servicing = false;
+ }
+ void access(const Gob::Variables *arena, int offset, int length, const char *mode) {
+  if (!_running || !_engine || !_engine->_inter || arena != _engine->_inter->_variables || length < 1) return;
+  for (const Watch &w : _watches) if (offset < w.offset + w.length && w.offset < offset + length && (w.access == "rw" || w.access == mode)) {
+   _watchHit = true; _watchOffset = offset; _watchLength = length; _watchAccess = mode; break;
+  }
+ }
+ void hotspot(Gob::GobEngine *engine, const char *event, int id, int index, int target) {
+  if (!enabled()) return;
+  JSONObject e; e["event"] = str(event); e["id"] = num(id); e["index"] = num(index); e["target"] = num(target);
+  e["guest_ms"] = num(_guestMs); e["frame_revision"] = num(_graphics ? _graphics->revision() : 0);
+  e["script"] = new JSONValue(scriptMetadata());
+  if (_hotspotEvents.size() >= 256) { _hotspotEvents.erase(_hotspotEvents.begin()); _hotspotTruncated = true; }
+  _hotspotEvents.push_back(std::make_shared<JSONValue>(e)); ++_hotspotDispatches;
+ }
+private:
+ int _fd; FDisBullGraphicsManager *_graphics; Gob::GobEngine *_engine;
+ std::string _rx; uint64 _guestMs, _executed, _queueTailMs; int _nextLeaseId;
+ std::vector<ScheduledEvent> _events; std::set<int> _heldKeycodes; std::vector<KeyLease> _leases;
+ bool _running, _servicing, _backendYield, _pauseRequested, _watchHit;
+ bool _atAfter = false;
+ bool _stoppedOnBreakpoint = false;
+ long long _runId; uint64 _runStart, _maxInstructions, _virtualDeadline;
+ bool _hasVirtualDeadline, _hasHostDeadline; Clock::time_point _hostDeadline;
+ int _offset, _opcode; std::string _family; bool _skipBreak;
+ std::string _skipScript, _skipFamily; uint32 _skipGeneration = 0; int _skipOffset = -1;
+ std::vector<Breakpoint> _breakpoints; std::vector<Watch> _watches;
+ int _watchOffset = -1, _watchLength = 0; std::string _watchAccess;
+ bool _traceEnabled, _traceTruncated; uint64 _nextDispatch;
+ std::vector<Dispatch> _stack; // Each retained tree has one shared owner. Responses use JSONValue's deep-copy
+ // constructor; copying JSONObject would transfer shared raw pointers to send().
+ std::vector<std::shared_ptr<JSONValue>> _trace;
+ std::vector<std::shared_ptr<JSONValue>> _hotspotEvents; bool _hotspotTruncated = false;
+ uint64 _hotspotDispatches = 0, _deliveredEvents = 0;
+ Gob::Script *script() const { return _engine && _engine->_game ? _engine->_game->_script : nullptr; }
+ Gob::Variables *variables() const { return _engine && _engine->_inter ? _engine->_inter->_variables : nullptr; }
+ JSONObject scriptMetadata() {
+  JSONObject b; Gob::Script *s = script();
+  if (!s || !s->isLoaded()) { b["loaded"] = boolean(false); return b; }
+  b["loaded"] = boolean(true); b["name"] = str(s->fdisbullName().c_str()); b["generation"] = num(s->fdisbullGeneration());
+  b["size"] = num(s->getSize()); b["fnv1a64"] = str(fnv1a64(s->getData(), s->getSize()).c_str());
+  b["offset_origin"] = str("tot_file_start"); b["raw_header_included"] = boolean(true);
+  b["scope"] = str("loaded_script_memory");
+  const Gob::FDisBullSourceInfo &source = s->fdisbullSource();
+  JSONObject src; src["kind"] = str(source.kind.c_str()); src["container"] = str(source.container.c_str());
+  src["member"] = str(source.member.c_str()); src["offset"] = num(source.offset); src["size"] = num(source.size);
+  src["compression"] = num(source.compression); src["raw_fnv1a64"] = str(source.rawFNV.c_str());
+  src["lookup_precedence"] = str("last_opened_archive_first_then_loose");
+  b["source"] = new JSONValue(src); return b;
+ }
+ void trace(const Dispatch &d, const char *phase) {
+  if (!_traceEnabled) return;
+  JSONObject e; e["event"] = str(phase); e["phase"] = str(phase); e["event_id"] = num(d.id); e["dispatch_id"] = num(d.id); e["script"] = str(d.script.c_str());
+  e["generation"] = num(d.generation); e["family"] = str(d.family.c_str()); e["offset"] = num(d.offset);
+  e["raw_hex"] = str(d.rawHex.c_str()); e["span_start"] = num(d.offset); e["span_length"] = num(d.encodingWidth); e["span_scope"] = str("opcode_encoding_only"); e["opcode"] = num(d.opcode); e["depth"] = num(d.depth); e["encoding_width"] = num(d.encodingWidth);
+  e["guest_ms"] = num(_guestMs);
+  Gob::Script *s = script(); e["next_offset"] = num(s ? s->pos() : -1);
+  e["next_generation"] = num(s ? s->fdisbullGeneration() : 0);
+  if (_trace.size() >= 2048) { _trace.erase(_trace.begin()); _traceTruncated = true; }
+  _trace.push_back(std::make_shared<JSONValue>(e));
+ }
+	void send(const JSONObject &obj) {
+		JSONValue value(obj);
+		Common::String s = value.stringify();
+		std::string line = std::string(s.c_str()) + "\n";
+		const char *ptr = line.data(); size_t remaining = line.size();
+		while (remaining) {
+			ssize_t n = write(_fd, ptr, remaining);
+			if (n < 0 && errno == EINTR) continue;
+			if (n <= 0) std::exit(3); // Do not continue game execution after losing the owner.
+			ptr += n; remaining -= size_t(n);
+		}
+	}
+	void ok(long long id, JSONObject &body) { body["id"] = num(id); body["ok"] = boolean(true); send(body); }
+	void error(long long id, const char *code, const char *message) {
+		JSONObject body; body["id"] = num(id); body["ok"] = boolean(false);
+		body["error"] = str(code); body["message"] = str(message); send(body);
+	}
+	bool receiveLine(bool block, std::string &line) {
+		for (;;) {
+			size_t newline = _rx.find('\n');
+			if (newline != std::string::npos) {
+				line = _rx.substr(0, newline); _rx.erase(0, newline + 1); return true;
+			}
+			pollfd pfd = {_fd, POLLIN, 0};
+			int ready = poll(&pfd, 1, block ? -1 : 0);
+			if (ready < 0 && errno == EINTR) continue;
+			if (ready < 0) std::exit(3);
+			if (ready == 0) return false;
+			char buf[4096]; ssize_t n = read(_fd, buf, sizeof(buf));
+			if (n < 0 && errno == EINTR) continue;
+			if (n < 0) std::exit(3);
+			if (n == 0) std::exit(0); // The controlling agent closed the socket.
+			_rx.append(buf, size_t(n));
+			if (_rx.size() > 1048576) std::exit(3);
+		}
+	}
+
+ bool breakpointHere() {
+  Gob::Script *s = script(); if (_backendYield || _atAfter || !s || !s->isLoaded()) return false;
+  if (_skipBreak && _skipScript == s->fdisbullName().c_str() && _skipGeneration == s->fdisbullGeneration() && _skipOffset == _offset && _skipFamily == _family) { _skipBreak = false; return false; }
+  for (const auto &bp : _breakpoints) if (bp.script == s->fdisbullName().c_str() && bp.generation == s->fdisbullGeneration() && bp.offset == _offset && (bp.family.empty() || bp.family == _family)) return true;
+  return false;
+ }
+ JSONObject location() {
+  JSONObject b; b["script"] = new JSONValue(scriptMetadata()); b["offset"] = num(_offset); b["opcode"] = num(_opcode);
+  b["family"] = str(_family.c_str()); b["phase"] = str(_backendYield ? "backend_yield" : _atAfter ? "after_opcode" : "before_opcode");
+  b["at_backend_yield"] = boolean(_backendYield); b["guest_ms"] = num(_guestMs); b["instructions"] = num(_executed);
+  b["next_offset"] = num(script() ? script()->pos() : -1); b["pending_depth"] = num(_stack.size()); b["frame_revision"] = num(_graphics ? _graphics->revision() : 0);
+  return b;
+ }
+ void finishRun(const char *reason) {
+  _running = false; _stoppedOnBreakpoint = std::string(reason) == "breakpoint"; JSONObject stop = location(); stop["reason"] = str(reason);
+  stop["instructions"] = num(_executed - _runStart); stop["completed_dispatches"] = num(_executed - _runStart);
+  if (_watchHit) { JSONObject w; w["offset"] = num(_watchOffset); w["length"] = num(_watchLength); w["access"] = str(_watchAccess.c_str()); w["coverage"] = str("scalar_string_copy_accessors_only"); stop["watch"] = new JSONValue(w); }
+  JSONObject b; b["stop"] = new JSONValue(stop); ok(_runId, b); _runId = -1; _watchHit = false; _pauseRequested = false;
+ }
+ void safePoint() {
+  for (;;) {
+   std::string line; while (receiveLine(false, line)) handle(line);
+   if (_running) {
+    const char *reason = nullptr;
+    if (_pauseRequested) reason = "pause";
+    else if (_watchHit) reason = "watchpoint";
+    else if (_maxInstructions && _executed - _runStart >= _maxInstructions) reason = "budget";
+    else if (_hasVirtualDeadline && _guestMs >= _virtualDeadline) reason = "guest_budget";
+    else if (_hasHostDeadline && Clock::now() >= _hostDeadline) reason = "host_timeout";
+    else if (breakpointHere()) reason = "breakpoint";
+    if (!reason) return;
+    finishRun(reason);
+   }
+   if (receiveLine(true, line)) handle(line);
+  }
+ }
+ JSONObject displayMetadata() {
+  JSONObject d; d["width"] = num(_graphics ? _graphics->width() : 0); d["height"] = num(_graphics ? _graphics->height() : 0);
+  d["game_width"] = num(_engine ? _engine->_width : 0); d["game_height"] = num(_engine ? _engine->_height : 0);
+  d["input_space"] = str("committed_frame_pixels"); d["hotspot_space"] = str("engine_surface_pixels_relative_to_window");
+  if (_engine && _engine->_video) {
+   d["screen_delta_x"] = num(_engine->_video->_screenDeltaX); d["screen_delta_y"] = num(_engine->_video->_screenDeltaY);
+   d["scroll_offset_x"] = num(_engine->_video->_scrollOffsetX); d["scroll_offset_y"] = num(_engine->_video->_scrollOffsetY);
+   d["surface_width"] = num(_engine->_video->_surfWidth); d["surface_height"] = num(_engine->_video->_surfHeight);
+   d["frame_to_engine_mouse"] = str("x+scroll_offset_x-screen_delta_x,y+scroll_offset_y-screen_delta_y");
+  }
+  if (_engine && _engine->_draw) {
+   d["need_adjust"] = num(_engine->_draw->_needAdjust);
+   d["script_coordinate_scale"] = num((_engine->_draw->_needAdjust == 2 || _engine->_draw->_needAdjust == 10) ? 1 : 2);
+  }
+  if (_engine && _engine->_global) { d["engine_mouse_x"] = num(_engine->_global->_inter_mouseX); d["engine_mouse_y"] = num(_engine->_global->_inter_mouseY); }
+  return d;
+ }
+ JSONObject state() {
+  JSONObject b = location(); b["engine"] = str("gob"); b["display"] = new JSONValue(displayMetadata());
+  Gob::Variables *v = variables(); JSONObject arena; arena["arena"] = str("variables"); arena["size"] = num(v ? v->getSize() : 0);
+  arena["endian"] = str(_engine->getEndianness() == Gob::kEndiannessLE ? "little" : "big"); arena["variable_stride"] = num(4);
+  b["variables"] = new JSONValue(arena);
+  JSONArray hs; if (_engine->_game && _engine->_game->_hotspots) _engine->_game->_hotspots->fdisbullSnapshot(hs);
+  b["hotspots"] = new JSONValue(hs); b["hotspot_dispatches"] = num(_hotspotDispatches); b["delivered_events"] = num(_deliveredEvents);
+  return b;
+ }
+	void queueKeyEvent(Common::KeyCode keycode, uint16 ascii, Common::EventType type, uint64 due, int lease = 0) {
+		Common::Event event; event.type = type; event.kbd.keycode = keycode; event.kbd.ascii = ascii;
+		_events.push_back({event, due, lease});
+	}
+	void queueKeyPair(Common::KeyCode keycode, uint16 ascii, uint32 holdMs, uint32 gapMs) {
+		const uint64 start = std::max(_guestMs, _queueTailMs);
+		queueKeyEvent(keycode, ascii, Common::EVENT_KEYDOWN, start);
+		queueKeyEvent(keycode, ascii, Common::EVENT_KEYUP, start + holdMs);
+		_queueTailMs = start + holdMs + gapMs;
+	}
+	bool keyFromName(const std::string &name, Common::KeyCode &key, uint16 &ascii) {
+		if (name == "enter") { key = Common::KEYCODE_RETURN; ascii = 13; }
+		else if (name == "tab") { key = Common::KEYCODE_TAB; ascii = 9; }
+		else if (name == "left") { key = Common::KEYCODE_LEFT; ascii = 0; }
