+static JSONValue *num(long long value) { return new JSONValue(value); }
+static JSONValue *str(const char *value) { return new JSONValue(value ? value : ""); }
+static JSONValue *boolean(bool value) { return new JSONValue(value); }
+static long long integer(const JSONValue *parent, const char *key, long long fallback = -1) {
+	if (!parent) return fallback;
+	JSONValue *child = const_cast<JSONValue *>(parent)->child(key);
+	return child && child->isIntegerNumber() ? child->asIntegerNumber() : fallback;
+}
+static std::string stringValue(const JSONValue *parent, const char *key) {
+	if (!parent) return "";
+	JSONValue *child = const_cast<JSONValue *>(parent)->child(key);
+	return child && child->isString() ? child->asString().c_str() : "";
+}
+static std::string base64(const byte *data, size_t size) {
+	static const char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	std::string output;
+	output.reserve((size + 2) / 3 * 4);
+	for (size_t i = 0; i < size; i += 3) {
+		const uint a = data[i], b = i + 1 < size ? data[i + 1] : 0, c = i + 2 < size ? data[i + 2] : 0;
+		output += alphabet[a >> 2]; output += alphabet[((a & 3) << 4) | (b >> 4)];
+		output += i + 1 < size ? alphabet[((b & 15) << 2) | (c >> 6)] : '=';
+		output += i + 2 < size ? alphabet[c & 63] : '=';
+	}
+	return output;
+}
+static std::string hex(const byte *data, size_t size) {
+	static const char digits[] = "0123456789abcdef";
+	std::string output; output.reserve(size * 2);
+	for (size_t i = 0; i < size; ++i) { output += digits[data[i] >> 4]; output += digits[data[i] & 15]; }
+	return output;
+}
+static bool unhex(const std::string &input, std::vector<byte> &output) {
+	if (input.empty() || input.size() % 2 || input.size() > 8192) return false;
+	output.clear(); output.reserve(input.size() / 2);
+	for (size_t i = 0; i < input.size(); i += 2) {
+		const size_t a = std::string("0123456789abcdef").find(input[i]);
+		const size_t b = std::string("0123456789abcdef").find(input[i + 1]);
+		if (a == std::string::npos || b == std::string::npos) return false;
+		output.push_back(byte((a << 4) | b));
+	}
+	return true;
+}
+static std::string fnv1a64(const byte *data, size_t size) {
+	uint64 hash = 14695981039346656037ULL;
+	for (size_t i = 0; i < size; ++i) { hash ^= data[i]; hash *= 1099511628211ULL; }
+	byte bytes[8]; for (int i = 7; i >= 0; --i) { bytes[i] = byte(hash & 255); hash >>= 8; }
+	return hex(bytes, 8);
+}
