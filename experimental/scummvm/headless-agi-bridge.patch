+/* Experimental fDisBull headless AGI bridge. GPL-3.0-or-later, as ScummVM. */
+#ifndef BACKENDS_PLATFORM_NULL_FDISBULL_BRIDGE_H
+#define BACKENDS_PLATFORM_NULL_FDISBULL_BRIDGE_H
+
+#include "backends/graphics/null/null-graphics.h"
+#include "common/events.h"
+#include "common/array.h"
+
+namespace Agi { class AgiEngine; }
+
+class FDisBullGraphicsManager : public NullGraphicsManager {
+public:
+	FDisBullGraphicsManager();
+	void initSize(uint width, uint height, const Graphics::PixelFormat *format = nullptr) override;
+	void setPalette(const byte *colors, uint start, uint num) override;
+	void grabPalette(byte *colors, uint start, uint num) const override;
+	void copyRectToScreen(const void *buf, int pitch, int x, int y, int w, int h) override;
+	void fillScreen(uint32 color) override;
+	void fillScreen(const Common::Rect &rect, uint32 color) override;
+	void updateScreen() override;
+	uint64 revision() const { return _revision; }
+	uint width() const { return _width; }
+	uint height() const { return _height; }
+	void rgb(Common::Array<byte> &out) const;
+	bool pixel(int x, int y, byte &r, byte &g, byte &b) const;
+
+private:
+	uint _width, _height;
+	uint64 _revision;
+	Common::Array<byte> _working, _committed;
+	byte _palette[768], _committedPalette[768];
+};
+
+namespace FDisBullBridge {
+bool enabled();
+void attachGraphics(FDisBullGraphicsManager *graphics);
+bool pollEvent(Common::Event &event);
+void beforeOpcode(Agi::AgiEngine *engine, int logic, int offset, int opcode);
+void afterOpcode(Agi::AgiEngine *engine);
+void cycle(Agi::AgiEngine *engine);
+void serviceModal();
+void stateWrite(const char *kind, int index, int oldValue, int newValue);
+void stateRead(const char *kind, int index, int value);
+uint32 guestMillis();
+void delayGuestMillis(uint32 millis);
+}
+
+#endif
