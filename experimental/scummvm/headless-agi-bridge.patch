+FDisBullGraphicsManager::FDisBullGraphicsManager() : _width(0), _height(0), _revision(0) {
+	memset(_palette, 0, sizeof(_palette));
+	memset(_committedPalette, 0, sizeof(_committedPalette));
+}
+
+void FDisBullGraphicsManager::initSize(uint width, uint height, const Graphics::PixelFormat *format) {
+	NullGraphicsManager::initSize(width, height, format);
+	_width = width;
+	_height = height;
+	_working.resize(size_t(width) * height);
+	memset(_working.data(), 0, _working.size());
+	_committed = _working;
+	++_revision;
+}
+
+void FDisBullGraphicsManager::setPalette(const byte *colors, uint start, uint num) {
+	if (!colors || start >= 256 || num > 256 - start) return;
+	memcpy(_palette + 3 * start, colors, 3 * num);
+}
+
+void FDisBullGraphicsManager::grabPalette(byte *colors, uint start, uint num) const {
+	if (!colors || start >= 256 || num > 256 - start) return;
+	memcpy(colors, _palette + 3 * start, 3 * num);
+}
+
+void FDisBullGraphicsManager::copyRectToScreen(const void *buf, int pitch, int x, int y, int w, int h) {
+	if (!buf || pitch <= 0 || w <= 0 || h <= 0 || _working.empty()) return;
+	const byte *src = static_cast<const byte *>(buf);
+	for (int row = 0; row < h; ++row) {
+		const int dstY = y + row;
+		if (dstY < 0 || dstY >= int(_height)) continue;
+		for (int col = 0; col < w; ++col) {
+			const int dstX = x + col;
+			if (dstX >= 0 && dstX < int(_width))
+				_working[size_t(dstY) * _width + dstX] = src[size_t(row) * pitch + col];
+		}
+	}
+}
+
+void FDisBullGraphicsManager::fillScreen(uint32 color) {
+	std::fill(_working.begin(), _working.end(), byte(color));
+}
+
+void FDisBullGraphicsManager::fillScreen(const Common::Rect &rect, uint32 color) {
+	for (int y = std::max(0, int(rect.top)); y < std::min(int(_height), int(rect.bottom)); ++y)
+		for (int x = std::max(0, int(rect.left)); x < std::min(int(_width), int(rect.right)); ++x)
+			_working[size_t(y) * _width + x] = byte(color);
+}
+
+void FDisBullGraphicsManager::updateScreen() {
+	_committed = _working;
+	memcpy(_committedPalette, _palette, sizeof(_palette));
+	++_revision;
+}
+
+void FDisBullGraphicsManager::rgb(Common::Array<byte> &out) const {
+	out.resize(_committed.size() * 3);
+	for (size_t i = 0; i < _committed.size(); ++i) {
+		const size_t p = size_t(_committed[i]) * 3;
+		out[3 * i] = _committedPalette[p];
+		out[3 * i + 1] = _committedPalette[p + 1];
+		out[3 * i + 2] = _committedPalette[p + 2];
+	}
+}
+
+bool FDisBullGraphicsManager::pixel(int x, int y, byte &r, byte &g, byte &b) const {
+	if (x < 0 || y < 0 || x >= int(_width) || y >= int(_height) || _committed.empty()) return false;
+	const size_t p = size_t(_committed[size_t(y) * _width + x]) * 3;
+	r = _committedPalette[p]; g = _committedPalette[p + 1]; b = _committedPalette[p + 2];
+	return true;
+}
