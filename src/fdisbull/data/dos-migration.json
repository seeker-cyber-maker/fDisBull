  "slices": [
    {
      "id": "core",
      "order": 0,
      "title": "Owned QEMU lifecycle and CPU controls",
      "depends_on": [],
      "gate": "Explicit backend selection, bounded transport, process cleanup, stopped inspection, physical/virtual RAM, guarded registers/RAM, native breakpoint/watchpoint and stored capture; retain DOSBox choices.",
      "status": "in_progress",
      "witness_tests": [
        "tests/test_debug_semantics.py",
