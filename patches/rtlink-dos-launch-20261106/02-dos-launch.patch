diff --git a/src/fdisbull/dos_media_launch.py b/src/fdisbull/dos_media_launch.py
new file mode 100644
index 0000000..6e74b91
--- /dev/null
+++ b/src/fdisbull/dos_media_launch.py
@@ -0,0 +1,91 @@
+"""Validated launch arguments and owned read-only CD mounting for native DOSBox.
+
+Only caller-selected media is exposed. No host shell, ambient configuration,
+mount command supplied by a target, or installer is executed.
+"""
+from __future__ import annotations
+from hashlib import sha256
+import os
+from pathlib import Path
+import stat
+
+
+def validate_arguments(arguments):
+    if arguments is None:
+        return []
+    if not isinstance(arguments, list) or len(arguments) > 32:
+        raise ValueError('arguments must be a list of at most 32 DOS argument tokens')
+    for token in arguments:
+        if (not isinstance(token, str) or not token or
+                any(ord(c) < 33 or ord(c) > 126 or c in '\"<>|&' for c in token)):
+            raise ValueError('DOS argument tokens must be nonempty printable ASCII without whitespace, quotes or shell operators')
+    if len(' '.join(arguments)) > 125:
+        raise ValueError('DOS arguments exceed the 126-byte command-tail budget')
+    return list(arguments)
+
+
+def _identity(path):
+    s = Path(path).stat()
+    if not stat.S_ISREG(s.st_mode):
+        raise ValueError('CD input must be a regular file')
+    return (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
+
+
+def _digest(path):
+    from hashlib import file_digest
+    with Path(path).open('rb') as stream:
+        return file_digest(stream, 'sha256').hexdigest()
+
+
+def describe_cd(path):
+    from .disc import inspect_disc_path
+    from .cue import inspect_cue_path
+    source = Path(path).expanduser().resolve(strict=True)
+    if source.suffix.lower() not in ('.cue', '.ins', '.iso'):
+        raise ValueError('cd_image requires CUE/INS or a cooked ISO; raw data needs an explicit descriptor')
+    if _identity(source)[2] > 2 * 1024**3:
+        raise ValueError('CD input exceeds 2 GiB')
+    if source.suffix.lower() in ('.cue', '.ins'):
+        layout = inspect_cue_path(source)
+        if not layout['valid'] or not layout['complete']:
+            raise ValueError('Invalid CD descriptor: ' + '; '.join(layout.get('errors', [])))
+        tracks = layout['tracks']
+        # Keep this first native launch implementation narrower than the reader.
+        if len(tracks) != 1 or tracks[0]['mode'] not in ('MODE1/2352', 'MODE1/2048'):
+            raise ValueError('CD launch currently supports one Mode-1 track, not audio or mixed-mode layouts')
+        if tracks[0]['file_index01_sector'] != 0 or tracks[0]['pregap_sectors'] or tracks[0]['postgap_sectors']:
+            raise ValueError('CD launch currently requires INDEX 01 at zero and no generated gaps')
+        mode = tracks[0]['mode']
+        image = Path(tracks[0]['file_path'])
+    else:
+        image, mode = source, 'MODE1/2048'
+    paths = list(dict.fromkeys((source, image)))
+    if sum(_identity(p)[2] for p in paths) > 2 * 1024**3:
+        raise ValueError('CD media exceeds 2 GiB')
+    identities = {str(p): _identity(p) for p in paths}
+    report = inspect_disc_path(source, mode=mode if source.suffix.lower() == '.iso' else None)
+    if report.get('valid') is not True or report.get('complete') is not True or report.get('all_entry_extents_available') is not True:
+        raise ValueError('CD must contain validated primary ISO metadata')
+    sources = [{'path': str(p), 'identity': list(identities[str(p)]), 'sha256': _digest(p)} for p in paths]
+    if any(_identity(p) != identities[str(p)] for p in paths):
+        raise ValueError('CD source changed during validation')
+    return {'drive': 'D', 'kind': 'readonly-cdrom', 'image_path': str(image), 'mode': mode,
+            'sources': sources, 'runtime_mount_verified': False,
+            'scope': 'one Mode-1 track; metadata validated, target access requires a runtime witness'}
+
+
+def stage_cd(media, directory):
+    """Generate a fixed-name CUE and owned link; never interpolate target commands."""
+    for source in media['sources']:
+        if list(_identity(source['path'])) != source['identity']:
+            raise ValueError('CD source changed before process launch')
+    root = Path(directory)
+    # Directory comes from our TemporaryDirectory. The link references only the
+    # source selected and fingerprinted above. DOSBox opens it as a CD image.
+    os.symlink(media['image_path'], root / 'disc-track.bin')
+    cue = root / 'disc.cue'
+    if any(c in str(cue) for c in '\r\n\0\"'):
+        raise ValueError('Owned CD path is not representable in DOSBox configuration')
+    with cue.open('x', encoding='ascii') as stream:
+        stream.write(f'FILE "disc-track.bin" BINARY\n TRACK 01 {media["mode"]}\n INDEX 01 00:00:00\n')
+    return cue
