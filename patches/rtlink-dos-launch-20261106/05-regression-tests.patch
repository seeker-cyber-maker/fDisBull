+"""Authored arguments/disc cases; optional actual DOSBox round trip."""
+import base64
+from hashlib import sha256
+import os
+from pathlib import Path
+import pytest
+from fdisbull.dos_media_launch import validate_arguments, describe_cd, stage_cd
+from fdisbull.cue import parse_cue
+from fdisbull.disc import inspect_disc_path
+from test_iso9660 import image
+
+
+@pytest.mark.parametrize('bad', ['-p',[None],[''],['a b'],['x\ny'],['x\0y'],['é'],['a&b'],['a"b'],['x']*33,['x'*126]])
+def test_arguments_refuse_ambiguity(bad):
+    with pytest.raises(ValueError):validate_arguments(bad)
+
+
+def test_arguments_are_copied():
+    v=['-p'];r=validate_arguments(v);v[0]='changed';assert r==['-p']
+    assert validate_arguments(None)==[]
+
+
+def disc(tmp_path, suffix='.ins'):
+    blocks=image();blocks[25][:4]=b'TEST'
+    payload=b''.join(blocks);iso=tmp_path/'data.bin';iso.write_bytes(payload)
+    cue=tmp_path/('disc'+suffix)
+    cue.write_text('FILE "data.bin" BINARY\n TRACK 1 MODE1/2048\n INDEX 1 00:00:00\n')
+    return cue,iso
+
+
+def test_ins_content_with_single_digit_track_and_index(tmp_path):
+    cue,_=disc(tmp_path)
+    r=inspect_disc_path(cue)
+    assert r['valid'] and r['complete'] and r['format']=='CUE/BIN disc'
+    media=describe_cd(cue)
+    stage=tmp_path/'stage';stage.mkdir();normalized=stage_cd(media,stage)
+    assert normalized.suffix=='.cue'
+    assert 'TRACK 01 MODE1/2048' in normalized.read_text()
+    assert (stage/'disc-track.bin').resolve()==(tmp_path/'data.bin').resolve()
+    assert not media['runtime_mount_verified']
+
+
+def test_cue_single_and_double_digits_cannot_duplicate_index():
+    r=parse_cue('FILE "a.bin" BINARY\n TRACK 1 MODE1/2048\n INDEX 1 00:00:00\n INDEX 01 00:00:00')
+    assert not r['valid'] and 'duplicate' in r['errors'][0]
+
+
+def test_ins_is_not_assumed_to_be_a_disc(tmp_path):
+    p=tmp_path/'unrelated.ins';p.write_bytes(b'MZ'+bytes(100))
+    assert not inspect_disc_path(p)['valid']
+    with pytest.raises(ValueError):describe_cd(p)
+
+
+def test_cd_drift_and_external_reference_refuse(tmp_path):
+    cue,iso=disc(tmp_path);m=describe_cd(cue)
+    iso.write_bytes(iso.read_bytes()+bytes(2048))
+    stage=tmp_path/'stage';stage.mkdir()
+    with pytest.raises(ValueError,match='changed'):stage_cd(m,stage)
+    assert not list(stage.iterdir())
+    cue.write_text('FILE "../outside.bin" BINARY\n TRACK 1 MODE1/2048\n INDEX 1 00:00:00')
+    with pytest.raises(ValueError):describe_cd(cue)
+
+
+def test_non_dos_backend_refuses_dos_options(tmp_path):
+    from fdisbull.project import Project
+    p=tmp_path/'ARGS.COM';p.write_bytes(bytes.fromhex('ebfe'))
+    with Project.create(tmp_path/'a.fdb',p,image='com') as project:
+        with pytest.raises(ValueError,match='native DOSBox'):
+            project.debugger('/missing',tmp_path,backend='scummvm-agi',arguments=['-p'])
+
+
+@pytest.mark.parametrize('use_cue',[False,True])
+def test_real_dos_arguments_and_readonly_cd(tmp_path,use_cue):
+    from fdisbull.project import Project
+    exe=os.environ.get('FDISBULL_DOSBOX')
+    if not exe:pytest.skip('Select a real DOSBox agent with FDISBULL_DOSBOX')
+    cue,iso=disc(tmp_path)
+    if not use_cue:
+        renamed=tmp_path/'disc.iso';iso.rename(renamed);media=renamed
+    else:media=cue
+    original=sha256(media.read_bytes()).hexdigest()
+    code=bytes.fromhex('ba4001b8003dcd2189c3ba8001b90400b43fcd21a39001ebfe')
+    p=tmp_path/'PROBE.COM';p.write_bytes(code.ljust(64,b'\0')+b'D:\\ONE.BIN\0'+bytes(200))
+    with Project.create(tmp_path/'probe.fdb',p,image='com') as project:
+        with project.debugger(exe,tmp_path,arguments=['-p'],cd_image=media) as debug:
+            process=debug.rpc.process
+            tail=debug.call('memory.read',{'address':{'space':'linear','offset':f'0x{debug.runtime_load*16+0x80:08X}'},'length':5})
+            assert base64.b64decode(tail['data_base64'])==b'\x03 -p\r'
+            debug.run(guest_ms=100,timeout_ms=5000,fast_forward=True)
+            assert debug.memory('1000:0180',length=4)['hex']==b'TEST'.hex()
+            assert debug.memory('1000:0190',length=2)['hex']=='0400'
+            assert debug.metadata['arguments']==['-p']
+            assert debug.metadata['cd_media']['drive']=='D'
+            with pytest.raises(ValueError,match='not yet qualified'):
+                debug.save_state()
+            with pytest.raises(ValueError,match='not yet qualified'):
+                debug._restore_native_checkpoint({'metadata':{}})
+        assert process.poll() is not None
+    assert sha256(media.read_bytes()).hexdigest()==original
diff --git a/tests/test_rtlink.py b/tests/test_rtlink.py
