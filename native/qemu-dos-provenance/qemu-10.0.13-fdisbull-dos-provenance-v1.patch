+# Bounded native provenance for one source-owned DOS create/write/close path.
+##
+# @FdisbullDosSaveWitnessRange:
+# @start: Guest linear start of an admitted caller code range.
+# @size: Nonzero byte extent of the caller code range.
+##
+{ 'struct': 'FdisbullDosSaveWitnessRange',
+  'data': { 'start': 'uint32', 'size': 'uint32' } }
+
+##
+# @FdisbullDosSaveWitnessEvent:
+# @sequence: Monotone ledger event index.
+# @function: DOS INT 21h function number observed at caller entry.
+# @handle: DOS handle relevant to the event, or 65535 when not applicable.
+# @carry: Carry flag observed after the matching INT 21h return.
+# @ax: AX observed after the matching INT 21h return.
+# @requested: Requested byte count for a write, otherwise zero.
+# @accepted: Accepted byte count for a successful write, otherwise zero.
+# @caller-pc: Caller linear address of the INT 21h instruction.
+# @return-pc: Linear address immediately after the INT instruction.
+##
+{ 'struct': 'FdisbullDosSaveWitnessEvent',
+  'data': { 'sequence': 'uint32', 'function': 'uint8', 'handle': 'uint16',
+            'carry': 'bool', 'ax': 'uint16', 'requested': 'uint16',
+            'accepted': 'uint16', 'caller-pc': 'uint32',
+            'return-pc': 'uint32' } }
+
+##
+# @FdisbullDosSaveWitnessInterruptFrame:
+# @cs: Code selector captured before the hardware interrupt frame was pushed.
+# @ss: Stack selector captured before the hardware interrupt frame was pushed.
+# @sp: Stack pointer captured before the hardware interrupt frame was pushed.
+# @return-pc: Linear PC to which the hardware IRET must return.
+##
+{ 'struct': 'FdisbullDosSaveWitnessInterruptFrame',
+  'data': { 'cs': 'uint16', 'ss': 'uint16', 'sp': 'uint16',
+            'return-pc': 'uint32' } }
+
+##
+# @FdisbullDosSaveWitnessInfo:
+# @api-version: Private native protocol version.
+# @model: Exact observer model.
+# @epoch: Native owner epoch, changed after VM restore.
+# @generation: Monotone observer state generation.
+# @active: Observer is armed and recording.
+# @valid: No unsupported or ambiguous operation has invalidated evidence.
+# @phase: Current ledger phase: idle, armed, created, writing, committed,
+#   closed, ready or invalid.
+# @token: Host owner token, omitted before arming.
+# @child-psp: Admitted caller PSP.
+# @int21-vector: Pinned little-endian IVT value from bytes 84h..87h.
+# @dos-path: One absolute DOS 8.3 path, such as D:\\SAVE.DAT.
+# @source-ranges: Admitted caller code ranges.
+# @create-seen: Successful exclusive AH=5Bh create was observed.
+# @created-handle: Handle returned by the create, or 65535 before creation.
+# @write-count: Successful nonzero sequential writes to the created handle.
+# @bytes-written: Accepted sequential payload bytes captured exactly.
+# @commit-seen: Successful AH=68h commit observed.
+# @flush-seen: Successful AH=0Dh disk flush observed after close.
+# @close-seen: Successful AH=3Eh close of the created handle observed.
+# @event-count: Number of matching INT 21h calls recorded.
+# @events: Bounded ordered call ledger.
+# @payload-hex: Concatenated accepted write bytes, lower-case hex.
+# @pending: An INT 21h call has entered and has not yet returned.
+# @pending-function: Function number for the in-flight call.
+# @pending-handle: DOS handle associated with the call, or 65535.
+# @pending-requested: Requested bytes for an in-flight write.
+# @pending-caller-pc: Caller linear address at INT 21h entry.
+# @pending-return-pc: Exact linear return address of the call.
+# @pending-ss: Stack selector at entry.
+# @pending-cs: Code selector at entry.
+# @pending-sp: Stack pointer at entry.
+# @pending-payload-hex: Captured write buffer for an in-flight write.
+# @hardware-interrupt-depth: Bounded unreturned hardware interrupt depth.
+# @hardware-returns: Ordered hardware interrupt return frames, outermost first.
+# @fault: Diagnostic when invalid.
+##
+{ 'struct': 'FdisbullDosSaveWitnessInfo',
+  'data': { 'api-version': 'int', 'model': 'str', 'epoch': 'uint64',
+            'generation': 'uint64', 'active': 'bool', 'valid': 'bool',
+            'phase': 'str', '*token': 'str', 'child-psp': 'uint16',
+            'int21-vector': 'uint32',
+            'dos-path': 'str', 'source-ranges': ['FdisbullDosSaveWitnessRange'],
+            'create-seen': 'bool', 'created-handle': 'uint16',
+            'write-count': 'uint32', 'bytes-written': 'uint32',
+            'commit-seen': 'bool', 'flush-seen': 'bool', 'close-seen': 'bool',
+            'event-count': 'uint32', 'events': ['FdisbullDosSaveWitnessEvent'],
+            'payload-hex': 'str', 'pending': 'bool',
+            'pending-function': 'uint8', 'pending-handle': 'uint16',
+            'pending-requested': 'uint16', 'pending-caller-pc': 'uint32',
+            'pending-return-pc': 'uint32', 'pending-ss': 'uint16',
+            'pending-cs': 'uint16', 'pending-sp': 'uint16',
+            'pending-payload-hex': 'str', 'hardware-interrupt-depth': 'uint8',
+            'hardware-returns': ['FdisbullDosSaveWitnessInterruptFrame'],
+            '*fault': 'str' } }
+
+##
+# @x-fdisbull-arm-dos-save-witness:
+# @token: Opaque host owner token, at least 16 and at most 64 characters.
+# @child-psp: PSP identity observed for the admitted caller.
+# @source-ranges: Sorted, disjoint physical code ranges owned by the caller.
+# @dos-path: Absolute root destination on drive D, in DOS 8.3 form.
+# @int21-vector: Expected IVT value captured from the trusted kernel.
+#
+# Arm a stopped, single-CPU, real-mode DOS call observer for one caller and
+# one absolute 8.3 destination. The observer does not execute guest code.
+##
+{ 'command': 'x-fdisbull-arm-dos-save-witness',
+  'data': { 'token': 'str', 'child-psp': 'uint16',
+            'source-ranges': ['FdisbullDosSaveWitnessRange'],
+            'dos-path': 'str', 'int21-vector': 'uint32' },
+  'returns': 'FdisbullDosSaveWitnessInfo' }
+
+##
+# @x-fdisbull-query-dos-save-witness:
+# Query the current native DOS save witness without changing it.
+##
+{ 'command': 'x-fdisbull-query-dos-save-witness',
+  'returns': 'FdisbullDosSaveWitnessInfo' }
+
+##
+# @x-fdisbull-disarm-dos-save-witness:
+# @token: Current host owner token.
+# @expected-generation: Generation observed by the caller before disarming.
+#
+# Disarm an observer after its receipt has been durably consumed. The ledger
+# remains queryable and is not erased.
+##
+{ 'command': 'x-fdisbull-disarm-dos-save-witness',
+  'data': { 'token': 'str', 'expected-generation': 'uint64' },
+  'returns': 'FdisbullDosSaveWitnessInfo' }
