+##
+# @FdisbullDisplayPoint:
+#
+# One pixel coordinate in a retained renderer publication.
+#
+# @x: Zero-based horizontal coordinate, less than retained width.
+# @y: Zero-based vertical coordinate, less than retained height.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullDisplayPoint',
+  'data': { 'x': 'int', 'y': 'int' } }
+
+##
+# @FdisbullDisplaySample:
+#
+# One packed RGB24 pixel from the retained publication, without rendering.
+#
+# @x: Requested zero-based horizontal coordinate.
+# @y: Requested zero-based vertical coordinate.
+# @r: Red channel, 0..255.
+# @g: Green channel, 0..255.
+# @b: Blue channel, 0..255.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullDisplaySample',
+  'data': { 'x': 'int', 'y': 'int',
+            'r': 'uint8', 'g': 'uint8', 'b': 'uint8' } }
+
+##
+# @FdisbullDisplayProbe:
+#
+# A bounded sparse observation of one retained renderer publication.
+#
+# @display: Exact retained publication and current stopped observation time.
+# @samples: One sample per requested point, in request order with duplicates.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullDisplayProbe',
+  'data': { 'display': 'FdisbullDisplayInfo',
+            'samples': [ 'FdisbullDisplaySample' ] } }
+
+##
+# @x-fdisbull-probe-display:
+#
+# @token: Current owner token.
+# @update-id: Exact positive ID of the latest retained publication.
+# @points: Zero through 256 ordered pixel coordinates.  Each must lie within
+#     the retained dimensions; duplicate coordinates remain separate samples.
+#
+# Read only the owned packed RGB publication under the stopped clock guard.
+# The entire point list validates before any sample is read or result allocated.
+# An empty list still requires a retained publication and exact identity.
+# Rejected arguments preserve the observer and its publication.
+#
+# This command does not refresh the display, create a file, advance time, run
+# guest instructions, or modify timers.  Coordinates describe the retained
+# renderer image, not a guest cursor, mode identity or completed guest frame.
+# A later guest mode or palette change cannot relabel the retained publication.
+#
+# Returns: Publication receipt and requested RGB samples.  No full-raster hash
+#     or guest drawing completion is established by this sparse observation.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-probe-display',
+  'data': { 'token': 'str', 'update-id': 'uint64',
+            'points': [ 'FdisbullDisplayPoint' ] },
+  'returns': 'FdisbullDisplayProbe' }
