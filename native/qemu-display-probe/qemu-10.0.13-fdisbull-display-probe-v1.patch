+
+FdisbullDisplayProbe *qmp_x_fdisbull_probe_display(
+    const char *token, uint64_t update_id, FdisbullDisplayPointList *points,
+    Error **errp)
+{
+    FdisbullDisplayPointList *entry;
+    FdisbullDisplayProbe *probe;
+    FdisbullDisplaySampleList **tail;
+    unsigned count = 0;
+
+    if (!display_guard(errp) || !display_token(token, errp)) {
+        return NULL;
+    }
+    if (!display_window.rgb) {
+        error_setg(errp, "Display observer has no retained renderer publication");
+        return NULL;
+    }
+    if (!update_id || update_id != display_window.updates) {
+        error_setg(errp, "Display probe update ID does not match the retained "
+                   "publication");
+        return NULL;
+    }
+
+    /* Reject the entire request before allocating a result or reading pixels. */
+    for (entry = points; entry; entry = entry->next) {
+        const FdisbullDisplayPoint *point = entry->value;
+
+        if (++count > DISPLAY_MAX_PROBE_POINTS) {
+            error_setg(errp, "Display probe accepts at most 256 points");
+            return NULL;
+        }
+        if (point->x < 0 || point->y < 0 ||
+            point->x >= display_window.width ||
+            point->y >= display_window.height) {
+            error_setg(errp, "Display probe point is outside the retained "
+                       "publication");
+            return NULL;
+        }
+    }
+
+    probe = g_new0(FdisbullDisplayProbe, 1);
+    probe->display = display_info();
+    tail = &probe->samples;
+    for (entry = points; entry; entry = entry->next) {
+        const FdisbullDisplayPoint *point = entry->value;
+        size_t offset = ((size_t)point->y * display_window.width +
+                         (size_t)point->x) * 3;
+        FdisbullDisplaySample *sample = g_new0(FdisbullDisplaySample, 1);
+
+        sample->x = point->x;
+        sample->y = point->y;
+        sample->r = display_window.rgb[offset];
+        sample->g = display_window.rgb[offset + 1];
+        sample->b = display_window.rgb[offset + 2];
+        QAPI_LIST_APPEND(tail, sample);
+    }
+    return probe;
+}
