+# Experimental fDisBull capture window, separate from clock extension API 1.
+{ 'include': 'run-state.json' }
+
+##
+# @FdisbullAudioChunk:
+#
+# @first-frame: First retained PCM frame, zero based within this window.
+# @frames: Number of complete PCM frames delivered in this callback.
+# @virtual-ns: QEMU virtual time of the delivery callback, not sample onset.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullAudioChunk',
+  'data': { 'first-frame': 'uint64', 'frames': 'uint64', 'virtual-ns': 'int' } }
+
+##
+# @FdisbullAudioInfo:
+#
+# @api-version: Capture protocol version, one.
+# @epoch: Native clock epoch.
+# @state: idle, capturing, stopped, overflow or invalidated.
+# @virtual-ns: Stopped observation time.
+# @token: Owning window token, absent before the first start.
+# @start-ns: Capture registration time, absent before start.
+# @stop-ns: Explicit stop time, absent until stopped.
+# @max-frames: Maximum retained PCM frames.
+# @frames: Retained PCM frames.
+# @dropped-frames: Callback frames refused after a capacity limit.
+# @rate: PCM frames per second, 32000.
+# @channels: Channel count, one.
+# @format: Sample format, u8.
+# @enabled: Most recent capture enable notification.
+# @chunks: Callback boundaries for the retained prefix.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullAudioInfo',
+  'data': { 'api-version': 'int', 'epoch': 'uint64', 'state': 'str',
+            'virtual-ns': 'int', '*token': 'str', '*start-ns': 'int',
+            '*stop-ns': 'int', 'max-frames': 'uint64', 'frames': 'uint64',
+            'dropped-frames': 'uint64', 'rate': 'int', 'channels': 'int',
+            'format': 'str', 'enabled': 'bool', 'chunks': ['FdisbullAudioChunk'] } }
+
+##
+# @x-fdisbull-query-audio:
+#
+# Observe an explicitly owned audio window without generating samples.
+# Requires the stopped native virtual-clock profile.
+#
+# Returns: Window receipt.
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-query-audio', 'returns': 'FdisbullAudioInfo' }
+
+##
+# @x-fdisbull-start-audio:
+#
+# @token: New owner token of 1..128 bytes.
+# @max-frames: Retained frame capacity, 1..1920000.
+#
+# Register capture on the explicit fdisbull-pc audiodev. Does not run the VM.
+# A prior active window must be stopped before replacement.
+#
+# Returns: Empty active window receipt.
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-start-audio',
+  'data': { 'token': 'str', 'max-frames': 'int' },
+  'returns': 'FdisbullAudioInfo' }
+
+##
+# @x-fdisbull-stop-audio:
+#
+# @token: Current owner token.
+#
+# Detach capture without flushing or advancing audio. Idempotent for this token.
+#
+# Returns: Retained window receipt.
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-stop-audio', 'data': { 'token': 'str' },
+  'returns': 'FdisbullAudioInfo' }
+
+##
+# @x-fdisbull-export-audio:
+#
+# @token: Current owner token.
+# @filename: New private output path for raw u8 mono PCM.
+#
+# Copy retained samples while stopped. No audio_run, flush or guest execution.
+# Overflowed windows are refused. The file is created exclusively.
+#
+# Returns: Receipt describing exactly the exported bytes.
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-export-audio',
+  'data': { 'token': 'str', 'filename': 'str' },
+  'returns': 'FdisbullAudioInfo' }
