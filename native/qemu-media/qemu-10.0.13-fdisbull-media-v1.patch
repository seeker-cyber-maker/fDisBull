+bool qemu_console_can_update_headless_sync(QemuConsole *con)
+{
+    assert(bql_locked());
+    return qemu_console_is_graphic(con) && con->hw_ops &&
+           con->hw_ops->gfx_update && !con->hw_ops->gfx_update_async &&
+           !con->gl && !con->gl_block && con->ds &&
+           QLIST_EMPTY(&con->ds->listeners) &&
+           qemu_co_queue_empty(&con->dump_queue);
+}
+
 void graphic_hw_update(QemuConsole *con)
 {
     bool async = false;
