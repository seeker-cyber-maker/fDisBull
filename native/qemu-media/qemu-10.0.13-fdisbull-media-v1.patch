+# Experimental fDisBull renderer observation, separate from clock API 1.
+{ 'include': 'run-state.json' }
+
+##
+# @FdisbullDisplayInfo:
+#
+# A retained, completed synchronous renderer update.  An update does not
+# establish guest application frame completion or a VGA retrace boundary.
+#
+# @api-version: Observer protocol version, one.
+# @epoch: Native clock epoch.
+# @state: idle, observing, stopped or invalidated.
+# @virtual-ns: Stopped observation time.
+# @token: Owning observer token, absent before the first start.
+# @start-ns: Observer registration time, absent before start.
+# @stop-ns: Explicit stop time, absent until stopped.
+# @period-ns: Requested virtual observation period; zero before start.
+#     This is not a guest frame period.  Missed observations are not invented.
+# @updates: Completed owned publications within this token, initially zero.
+# @update-id: Latest publication ID, equal to updates, absent before publication.
+# @published-ns: Actual virtual publication time, absent before publication.
+# @width: Retained image width, absent before publication.
+# @height: Retained image height, absent before publication.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullDisplayInfo',
+  'data': { 'api-version': 'int', 'epoch': 'uint64', 'state': 'str',
+            'virtual-ns': 'int', '*token': 'str', '*start-ns': 'int',
+            '*stop-ns': 'int', 'period-ns': 'int', 'updates': 'uint64',
+            '*update-id': 'uint64', '*published-ns': 'int',
+            '*width': 'int', '*height': 'int' } }
+
+##
+# @x-fdisbull-query-display:
+#
+# Observe retained renderer state without updating the display or running the VM.
+# Requires the stopped native virtual-clock API 1 profile.
+#
+# Returns: Observer receipt.
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-query-display', 'returns': 'FdisbullDisplayInfo' }
+
+##
+# @x-fdisbull-start-display:
+#
+# @token: New owner token of 1..128 bytes.
+# @period-ns: Virtual observation period, 1000000..1000000000 nanoseconds.
+#
+# Arm an observer for headless synchronous standard VGA console zero.
+# Start neither renders nor runs the VM.  A prior observer must be explicitly
+# stopped before replacement.  The first deadline is one period after start;
+# later deadlines follow that phase, skipping any missed deadlines.
+#
+# Each callback copies a completed renderer update into owned RGB storage.
+# Only the latest update is retained; images are limited to 8192 pixels per
+# dimension and 16 MiB of packed RGB bytes.  Guest frame completion is unknown.
+# Reset, loss of the required profile or an observation error invalidates the
+# observer.  Migration stays blocked after the first successful start.
+#
+# Returns: Empty observing receipt.
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-start-display',
+  'data': { 'token': 'str', 'period-ns': 'int' },
+  'returns': 'FdisbullDisplayInfo' }
+
+##
+# @x-fdisbull-stop-display:
+#
+# @token: Current owner token.
+#
+# Disarm observation without rendering or running the VM.  Retains the latest
+# owned pixels and is idempotent for this token.
+#
+# Returns: Retained observer receipt.
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-stop-display', 'data': { 'token': 'str' },
+  'returns': 'FdisbullDisplayInfo' }
+
+##
+# @x-fdisbull-export-display:
+#
+# @token: Current owner token.
+# @filename: New private output path for a binary PPM image.
+#
+# Copy the latest retained packed RGB pixels while stopped.  This command does
+# not call the renderer, advance time or execute guest instructions.  No update
+# is fabricated when the observer has not yet published.  The file is created
+# exclusively with private permissions.
+#
+# Returns: Receipt identifying the exported publication.
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-export-display',
+  'data': { 'token': 'str', 'filename': 'str' },
+  'returns': 'FdisbullDisplayInfo' }
