+FdisbullRasterProof *pci_std_vga_fdisbull_raster_query(
+    Object *obj, uint64_t epoch, int64_t virtual_ns, Error **errp)
+{
+    g_autoptr(FdisbullVgaConfigurationSnapshot) current = NULL;
+    g_autoptr(FdisbullRasterProof) result = NULL;
+    VGACommonState *s;
+
+    assert(bql_locked());
+    if (!pci_std_vga_fdisbull_configuration_selected(obj) ||
+        !PCI_VGA(obj)->vga.fdisbull_raster_proof) {
+        error_setg(errp, "Raster proof requires explicit primary "
+                   "VGA.x-fdisbull-raster-proof=on");
+        return NULL;
+    }
+    current = pci_std_vga_fdisbull_configuration_snapshot(
+        obj, epoch, virtual_ns, errp);
+    if (!current) {
+        return NULL;
+    }
+    s = &PCI_VGA(obj)->vga;
+    result = vga_fdisbull_raster_query(s, errp);
+    if (!result) {
+        return NULL;
+    }
+    result->api_version = 1;
+    result->model = g_strdup("qemu-vga-raster-proof-v1");
+    result->epoch = epoch;
+    result->virtual_ns = virtual_ns;
+    result->device = g_strdup(current->device);
+    result->device_type = g_strdup("VGA");
+    result->console = 0;
+    result->head = 0;
+    result->current_configuration_matches =
+        result->producing_configuration &&
+        result->producing_configuration->epoch == epoch &&
+        result->producing_configuration->configuration_generation ==
+        current->configuration_generation;
+    return g_steal_pointer(&result);
 }
 
