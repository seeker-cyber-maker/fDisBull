--- /dev/null
+++ b/qapi/fdisbull-raster.json
@@ -0,0 +1,107 @@
+# Private successful-raster evidence. This is not a completed-frame API.
+{ 'include': 'fdisbull-vga-configuration.json' }
+
+##
+# @FdisbullRasterOutcome:
+#
+# @unavailable: No current admitted complete-raster proof.
+# @valid-unchanged: A complete previously valid raster was checked again;
+#     the renderer did not redraw any row during this attempt.
+# @updated: The renderer redrew one or more rows and the complete owned raster
+#     was checked against the admitted source interpretation.
+#
+# Since: 10.0
+##
+{ 'enum': 'FdisbullRasterOutcome',
+  'data': [ 'unavailable', 'valid-unchanged', 'updated' ] }
+
+##
+# @FdisbullRasterSource:
+#
+# @profile: qemu-vga-chain4-320x200-raster-v1.
+# @width: Native source pixels, 320.
+# @height: Native source rows, 200.
+# @source-bpp: Palette index width, 8.
+# @surface-width: Owned renderer surface width, 640.
+# @surface-height: Owned renderer surface height, 400.
+# @column-duplication: Proven horizontal duplication, 2.
+# @row-duplication: Proven vertical duplication, 2.
+# @start-address: Native VRAM byte origin, zero.
+# @line-offset: Native source row stride, 320 bytes.
+# @draw-handler: Exact admitted handler, vga_draw_line8d2.
+# @dac-8bit: False means QEMU's native c6_to_8 interpretation was used.
+# @rows-considered: Renderer rows visited, exactly 400.
+# @rows-redrawn: Renderer rows actually updated, 0..400.
+# @source-index-sha256: SHA-256 of the 64000 source palette indices.
+# @palette-rgb-sha256: SHA-256 of all 256 native-expanded RGB triples.
+# @source-rgb-sha256: SHA-256 of the owned 320x200 RGB888 source raster.
+# @surface-rgb-sha256: SHA-256 of the owned 640x400 RGB888 renderer raster.
+#
+# Every surface pixel is verified against the declared source palette index
+# and exact 2x2 duplication. Hashes exclude padding and alpha. No scanline
+# sampling, application drawing, input consumption or cadence claim is made.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullRasterSource',
+  'data': { 'profile': 'str', 'width': 'int', 'height': 'int',
+            'source-bpp': 'int', 'surface-width': 'int',
+            'surface-height': 'int', 'column-duplication': 'int',
+            'row-duplication': 'int', 'start-address': 'uint64',
+            'line-offset': 'uint64', 'draw-handler': 'str',
+            'dac-8bit': 'bool', 'rows-considered': 'int',
+            'rows-redrawn': 'int', 'source-index-sha256': 'str',
+            'palette-rgb-sha256': 'str', 'source-rgb-sha256': 'str',
+            'surface-rgb-sha256': 'str' } }
+
+##
+# @FdisbullRasterProof:
+#
+# @api-version: Private protocol version, 1.
+# @model: qemu-vga-raster-proof-v1.
+# @epoch: Actual native clock epoch at this passive stopped query.
+# @virtual-ns: Actual QEMU_CLOCK_VIRTUAL query timestamp.
+# @device: Canonical selected standard VGA device path.
+# @device-type: Exact native type VGA.
+# @console: Owned console zero.
+# @head: Owned head zero.
+# @outcome: Latest synchronous renderer attempt's typed result.
+# @reason: Explanation when unavailable; absent on success.
+# @attempted: Whether an attempt has occurred since invalidation.
+# @attempt-ns: Actual native timestamp of that attempt, when attempted.
+# @source: Full-source proof, present exactly for a successful admitted result.
+# @producing-configuration: Frozen configuration captured with the proof.
+# @current-configuration-matches: Current configuration still has the producing
+#     generation. This does not prove current VRAM/palette or game readiness.
+#
+# No frame IDs, mode IDs, display update IDs or state revisions are supplied.
+# A reset, load or renderer invalidation destroys the current proof. A passive
+# query never reconstitutes it from saved counters or current pixels.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullRasterProof',
+  'data': { 'api-version': 'int', 'model': 'str', 'epoch': 'uint64',
+            'virtual-ns': 'int', 'device': 'str', 'device-type': 'str',
+            'console': 'int', 'head': 'int',
+            'outcome': 'FdisbullRasterOutcome', '*reason': 'str',
+            'attempted': 'bool', '*attempt-ns': 'int',
+            '*source': 'FdisbullRasterSource',
+            '*producing-configuration': 'FdisbullVgaConfigurationSnapshot',
+            'current-configuration-matches': 'bool' } }
+
+##
+# @x-fdisbull-query-raster-proof:
+#
+# Read the latest actual synchronous renderer attempt. Requires the stopped
+# native clock, admitted exact primary precise VGA, and explicit
+# VGA.x-fdisbull-raster-proof=on. The query performs no rendering, guest I/O,
+# timer action, execution, pixel conversion, hashing or file creation, even
+# when the proof is empty or invalid. Existing display APIs are unchanged.
+#
+# Returns: Private raster evidence only; not a completed-frame capability.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-query-raster-proof',
+  'returns': 'FdisbullRasterProof' }
