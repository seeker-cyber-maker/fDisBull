+static void vga_fdisbull_raster_clear(VGACommonState *s, const char *reason,
+                                     bool attempted)
+{
+    if (!s->fdisbull_raster_proof) {
+        return;
+    }
+    g_clear_pointer(&s->fdisbull_raster_result, qapi_free_FdisbullRasterProof);
+    s->fdisbull_raster_result = g_new0(FdisbullRasterProof, 1);
+    s->fdisbull_raster_result->outcome = FDISBULL_RASTER_OUTCOME_UNAVAILABLE;
+    s->fdisbull_raster_result->reason = g_strdup(reason);
+    s->fdisbull_raster_result->attempted = attempted;
+    s->fdisbull_raster_result->has_attempt_ns = attempted;
+    if (attempted) {
+        s->fdisbull_raster_result->attempt_ns =
+            qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    }
+}
+
+static void vga_fdisbull_raster_invalidate(VGACommonState *s, const char *reason)
+{
+    if (s->fdisbull_raster_proof) {
+        s->fdisbull_raster_cache_valid = false;
+        s->fdisbull_raster_cache_configuration = 0;
+        vga_fdisbull_raster_clear(s, reason, false);
+    }
+}
+
+FdisbullRasterProof *vga_fdisbull_raster_query(VGACommonState *s, Error **errp)
+{
+    const FdisbullRasterProof *saved = s->fdisbull_raster_result;
+    FdisbullRasterProof *result;
+
+    assert(bql_locked());
+    if (!s->fdisbull_raster_proof) {
+        error_setg(errp, "Raster proof is not enabled");
+        return NULL;
+    }
+    result = g_new0(FdisbullRasterProof, 1);
+    if (!saved) {
+        result->outcome = FDISBULL_RASTER_OUTCOME_UNAVAILABLE;
+        result->reason = g_strdup("no-renderer-attempt");
+        return result;
+    }
+    result->outcome = saved->outcome;
+    result->reason = g_strdup(saved->reason);
+    result->attempted = saved->attempted;
+    result->has_attempt_ns = saved->has_attempt_ns;
+    result->attempt_ns = saved->attempt_ns;
+    if (saved->source) {
+        result->source = QAPI_CLONE(FdisbullRasterSource, saved->source);
+        result->producing_configuration = QAPI_CLONE(
+            FdisbullVgaConfigurationSnapshot, saved->producing_configuration);
+    }
+    return result;
+}
+
+static FdisbullChain4Geometry vga_fdisbull_chain4_geometry(
+    VGACommonState *s, int width, int height, int depth, int shift_control,
+    int multi_scan)
+{
+    return (FdisbullChain4Geometry) {
+        .display_enabled = !!(s->ar_index & 0x20),
+        .graphics = !!(s->gr[VGA_GFX_MISC] & VGA_GR06_GRAPHICS_MODE),
+        .vbe_enabled = vbe_enabled(s),
+        .chain4 = !!(sr(s, VGA_SEQ_MEMORY_MODE) & VGA_SR04_CHN_4M),
+        .width = width, .height = height, .depth = depth,
+        .shift_control = shift_control, .multi_scan = multi_scan,
+        .crtc_mode = s->cr[VGA_CRTC_MODE],
+        .attribute_mode = s->ar[VGA_ATC_MODE],
+        .plane_enable = s->ar[VGA_ATC_PLANE_ENABLE],
+        .hpel = s->params.hpel & 7,
+        .start_address = (uint64_t)s->params.start_addr * 4,
+        .line_offset = s->params.line_offset,
+        .line_compare = s->params.line_compare,
+        .vram_size = s->vbe_size,
+        .bank_offset = s->bank_offset,
+    };
+}
+
+static void vga_fdisbull_raster_complete(
+    VGACommonState *s, const FdisbullChain4Geometry *geometry,
+    int rows_considered, int rows_redrawn)
+{
+    g_autofree uint8_t *surface_rgb = NULL;
+    g_autofree uint8_t *source_rgb = NULL;
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    g_autoptr(FdisbullVgaConfigurationSnapshot) configuration = NULL;
+    DisplaySurface *surface = qemu_console_surface(s->con);
+    FdisbullRasterProof *result = s->fdisbull_raster_result;
+    FdisbullRasterSource *source;
+    const char *reason = fdisbull_chain4_admission(geometry);
+    uint8_t palette_rgb[256 * 3];
+    uint32_t palette[256];
+    Object *device;
+    int i, channel;
+
+    assert(bql_locked());
+    if (reason) {
+        goto unavailable;
+    }
+    if (fdisbull_instrumented_checkpoint_busy() ||
+        !qemu_console_can_update_headless_sync(s->con)) {
+        reason = "renderer-not-owned-headless-synchronous";
+        goto unavailable;
+    }
+    if (rows_considered != 400 || rows_redrawn < 0 || rows_redrawn > 400 ||
+        (!rows_redrawn && !s->fdisbull_raster_cache_valid)) {
+        reason = "incomplete-renderer-extent";
+        goto unavailable;
+    }
+    if (!surface || surface_is_placeholder(surface) ||
+        !surface_is_allocated(surface) || !surface_data(surface) ||
+        surface_width(surface) != 640 || surface_height(surface) != 400 ||
+        surface_format(surface) != qemu_default_pixman_format(32, true) ||
+        surface_stride(surface) != 640 * 4) {
+        reason = "unsupported-owned-surface";
+        goto unavailable;
+    }
+    /* Capture one owned complete RGB raster; never hash guest-shared pixels. */
+    surface_rgb = g_malloc(640 * 400 * 3);
+    source_rgb = g_malloc(320 * 200 * 3);
+    for (i = 0; i < 256; i++) {
+        for (channel = 0; channel < 3; channel++) {
+            uint8_t raw = s->palette[i * 3 + channel];
+            palette_rgb[i * 3 + channel] = s->dac_8bit ? raw : c6_to_8(raw);
+        }
+        palette[i] = rgb_to_pixel32(palette_rgb[i * 3],
+                                    palette_rgb[i * 3 + 1],
+                                    palette_rgb[i * 3 + 2]);
+        if (s->last_palette[i] != palette[i]) {
+            reason = "renderer-palette-cache-mismatch";
+            goto unavailable;
+        }
+    }
+    if (!fdisbull_chain4_copy_verify(surface_data(surface), 640 * 400 * 4,
+                                    s->vram_ptr, 320 * 200, palette,
+                                    surface_rgb, 640 * 400 * 3,
+                                    source_rgb, 320 * 200 * 3)) {
+        reason = "raster-source-or-duplication-mismatch";
+        goto unavailable;
+    }
+    clock = qmp_x_fdisbull_query_clock(NULL);
+    if (!clock || clock->api_version != 1 || !clock->budget_supported ||
+        clock->virtual_ns < 0) {
+        reason = "native-clock-profile-unavailable";
+        goto unavailable;
+    }
+    device = object_property_get_link(OBJECT(s->con), "device", NULL);
+    configuration = pci_std_vga_fdisbull_configuration_snapshot(
+        device, clock->epoch, clock->virtual_ns, NULL);
+    if (!configuration) {
+        reason = "producing-configuration-unavailable";
+        goto unavailable;
+    }
+    source = g_new0(FdisbullRasterSource, 1);
+    source->profile = g_strdup("qemu-vga-chain4-320x200-raster-v1");
+    source->width = 320;
+    source->height = 200;
+    source->source_bpp = 8;
+    source->surface_width = 640;
+    source->surface_height = 400;
+    source->column_duplication = 2;
+    source->row_duplication = 2;
+    source->line_offset = 320;
+    source->draw_handler = g_strdup("vga_draw_line8d2");
+    source->dac_8bit = s->dac_8bit;
+    source->rows_considered = rows_considered;
+    source->rows_redrawn = rows_redrawn;
+    source->source_index_sha256 = g_compute_checksum_for_data(
+        G_CHECKSUM_SHA256, s->vram_ptr, 64000);
+    source->palette_rgb_sha256 = g_compute_checksum_for_data(
+        G_CHECKSUM_SHA256, palette_rgb, sizeof(palette_rgb));
+    source->source_rgb_sha256 = g_compute_checksum_for_data(
+        G_CHECKSUM_SHA256, source_rgb, 320 * 200 * 3);
+    source->surface_rgb_sha256 = g_compute_checksum_for_data(
+        G_CHECKSUM_SHA256, surface_rgb, 640 * 400 * 3);
+    g_clear_pointer(&result->reason, g_free);
+    result->source = source;
+    result->producing_configuration = g_steal_pointer(&configuration);
+    result->attempt_ns = clock->virtual_ns;
+    result->outcome = rows_redrawn ? FDISBULL_RASTER_OUTCOME_UPDATED :
+                                   FDISBULL_RASTER_OUTCOME_VALID_UNCHANGED;
+    s->fdisbull_raster_cache_valid = true;
+    s->fdisbull_raster_cache_configuration =
+        result->producing_configuration->configuration_generation;
+    return;
+
+unavailable:
+    s->fdisbull_raster_cache_valid = false;
+    g_free(result->reason);
+    result->reason = g_strdup(reason);
+}
