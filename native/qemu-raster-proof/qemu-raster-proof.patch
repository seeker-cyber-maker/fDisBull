new file mode 100644
--- /dev/null
+++ b/hw/display/fdisbull-raster.h
@@ -0,0 +1,91 @@
+/* Bounded renderer-source admission; not a video frame or scanout model.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_FDISBULL_RASTER_H
+#define HW_FDISBULL_RASTER_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+typedef struct FdisbullChain4Geometry {
+    bool display_enabled;
+    bool graphics;
+    bool vbe_enabled;
+    bool chain4;
+    int width, height, depth, shift_control, multi_scan;
+    unsigned crtc_mode, attribute_mode, plane_enable, hpel;
+    uint64_t start_address, line_offset, line_compare, vram_size;
+    int64_t bank_offset;
+} FdisbullChain4Geometry;
+
+/* Keep this pure: admission must not repair renderer caches or guest state. */
+static inline const char *
+fdisbull_chain4_admission(const FdisbullChain4Geometry *g)
+{
+    if (!g->display_enabled || !g->graphics) {
+        return "display-disabled-or-not-graphics";
+    }
+    if (g->vbe_enabled || !g->chain4 || g->depth != 0 ||
+        g->shift_control != 2) {
+        return "unsupported-pixel-interpretation";
+    }
+    if (g->width != 640 || g->height != 400 || g->multi_scan != 1) {
+        return "unsupported-source-extent";
+    }
+    if ((g->crtc_mode & 3) != 3 || g->attribute_mode != 0x41 ||
+        (g->plane_enable & 15) != 15) {
+        return "unsupported-address-or-plane-mode";
+    }
+    if (g->start_address || g->bank_offset || g->line_offset != 320 ||
+        g->line_compare < 400 || g->hpel) {
+        return "unsupported-origin-pitch-split-or-panning";
+    }
+    if (g->vram_size < 64000) {
+        return "incomplete-source-storage";
+    }
+    return NULL;
+}
+
+/* Verify every pixel, including all duplication and the final source row.
+ * Inputs are the admitted native packed XRGB32 surface, actual source indices
+ * and native-expanded palette. Outputs are owned canonical RGB888 copies.
+ */
+static inline bool fdisbull_chain4_copy_verify(
+    const uint8_t *pixels, size_t pixel_bytes,
+    const uint8_t *indices, size_t index_bytes, const uint32_t *palette,
+    uint8_t *surface_rgb, size_t surface_bytes,
+    uint8_t *source_rgb, size_t source_bytes)
+{
+    unsigned x, y;
+
+    if (!pixels || !indices || !palette || !surface_rgb || !source_rgb ||
+        pixel_bytes != 640u * 400u * 4u || index_bytes != 320u * 200u ||
+        surface_bytes != 640u * 400u * 3u ||
+        source_bytes != 320u * 200u * 3u) {
+        return false;
+    }
+    for (y = 0; y < 400; y++) {
+        for (x = 0; x < 640; x++) {
+            uint32_t pixel;
+            uint32_t expected = palette[indices[(y / 2) * 320 + x / 2]];
+            uint8_t *rgb = surface_rgb + ((size_t)y * 640 + x) * 3;
+
+            memcpy(&pixel, pixels + ((size_t)y * 640 + x) * 4, sizeof(pixel));
+            if ((pixel & 0xffffff) != expected) {
+                return false;
+            }
+            rgb[0] = pixel >> 16;
+            rgb[1] = pixel >> 8;
+            rgb[2] = pixel;
+            if (!(x & 1) && !(y & 1)) {
+                memcpy(source_rgb + ((size_t)(y / 2) * 320 + x / 2) * 3,
+                       rgb, 3);
+            }
+        }
+    }
+    return true;
+}
+
+#endif
