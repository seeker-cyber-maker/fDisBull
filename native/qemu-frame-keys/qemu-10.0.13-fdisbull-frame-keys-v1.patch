+
+#define FRAME_KEYS_API 1
+#define FRAME_KEYS_MAX_EDGES 32
+#define FRAME_KEYS_MAX_HELD 64
+#define FRAME_KEYS_MAX_BYTES_PER_EDGE 8
+#define FRAME_KEYS_OBF 0x01
+#define FRAME_KEYS_KBD_DISABLED 0x10
+
+static void frame_keys_batch_free(FdisbullInputBatch *batch)
+{
+    qemu_input_fdisbull_free(batch);
+}
+G_DEFINE_AUTOPTR_CLEANUP_FUNC(FdisbullInputBatch, frame_keys_batch_free)
+
+typedef struct FrameKeyOwner {
+    PS2KbdState *keyboard;
+    char *token;
+    uint64_t epoch;
+    uint64_t generation;
+    uint64_t accepted_edges;
+    bool active;
+    bool valid;
+    bool dispatch_authorized;
+    PS2KbdState *dispatch_keyboard;
+    Error *migration_blocker;
+    bool held[Q_KEY_CODE__MAX];
+    bool foreign[Q_KEY_CODE__MAX];
+    char *fault;
+} FrameKeyOwner;
+
+static FrameKeyOwner frame_keys = { .valid = true };
+
+static bool key_valid(QKeyCode key)
+{
+    return key < Q_KEY_CODE__MAX &&
+           key != Q_KEY_CODE_UNMAPPED;
+}
+
+static bool bitmap_any(const bool *keys)
+{
+    unsigned i;
+
+    for (i = 0; i < Q_KEY_CODE__MAX; i++) {
+        if (keys[i]) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static int qcode_name_cmp(const void *a, const void *b)
+{
+    QKeyCode left = *(const QKeyCode *)a;
+    QKeyCode right = *(const QKeyCode *)b;
+
+    return strcmp(QKeyCode_str(left), QKeyCode_str(right));
+}
+
+static QKeyCodeList *key_list(const bool *keys)
+{
+    QKeyCode values[Q_KEY_CODE__MAX];
+    unsigned count = 0, i;
+    QKeyCodeList *head = NULL, **tail = &head;
+
+    for (i = 0; i < Q_KEY_CODE__MAX; i++) {
+        if (keys[i]) {
+            values[count++] = i;
+        }
+    }
+    qsort(values, count, sizeof(values[0]), qcode_name_cmp);
+    for (i = 0; i < count; i++) {
+        QKeyCodeList *node = g_new0(QKeyCodeList, 1);
+        node->value = values[i];
+        *tail = node;
+        tail = &node->next;
+    }
+    return head;
+}
+
+static bool list_to_bitmap(const QKeyCodeList *list, bool *keys,
+                           Error **errp)
+{
+    const QKeyCodeList *item;
+    const char *previous = NULL;
+    unsigned count = 0;
+
+    memset(keys, 0, sizeof(bool) * Q_KEY_CODE__MAX);
+    for (item = list; item; item = item->next) {
+        const char *name;
+
+        if (!key_valid(item->value) || keys[item->value] ||
+            ++count > FRAME_KEYS_MAX_HELD) {
+            error_setg(errp, "Invalid native frame-key held set");
+            return false;
+        }
+        name = QKeyCode_str(item->value);
+        if (previous && strcmp(previous, name) >= 0) {
+            error_setg(errp, "Native frame-key held set is not canonically ordered");
+            return false;
+        }
+        previous = name;
+        keys[item->value] = true;
+    }
+    return true;
+}
+
+static KBDState *frame_keyboard_controller(PS2KbdState *keyboard,
+                                          Error **errp)
+{
+    Object *parent;
+
+    if (!keyboard) {
+        error_setg(errp, "No selected PS/2 keyboard");
+        return NULL;
+    }
+    parent = OBJECT(keyboard)->parent;
+    if (!parent || !object_dynamic_cast(parent, TYPE_I8042)) {
+        error_setg(errp, "Frame keys require the ISA i8042 controller");
+        return NULL;
+    }
+    return &I8042(parent)->kbd;
+}
+
+static bool frame_keys_clock(FdisbullClockInfo **out, Error **errp)
+{
+    FdisbullClockInfo *clock = qmp_x_fdisbull_query_clock(errp);
+
+    if (!clock) {
+        return false;
+    }
+    if (clock->api_version != 1 || !clock->budget_supported ||
+        clock->running || clock->pending_stop ||
+        (clock->status != RUN_STATE_PRELAUNCH &&
+         clock->status != RUN_STATE_PAUSED &&
+         clock->status != RUN_STATE_DEBUG) ||
+        clock->budget_state == FDISBULL_CLOCK_BUDGET_STATE_ARMED) {
+        qapi_free_FdisbullClockInfo(clock);
+        error_setg(errp, "Frame-key operations require one stopped virtual-clock CPU with no armed budget");
+        return false;
+    }
+    if (fdisbull_display_frame_fence_blocks_control()) {
+        qapi_free_FdisbullClockInfo(clock);
+        error_setg(errp, "Frame-key operations cannot overlap a renderer fence");
+        return false;
+    }
+    *out = clock;
+    return true;
+}
+
+static void checksum_u64_le(GChecksum *checksum, uint64_t value)
+{
+    uint8_t bytes[8];
+    unsigned i;
+
+    for (i = 0; i < sizeof(bytes); i++) {
+        bytes[i] = (value >> (i * 8)) & 0xff;
+    }
+    g_checksum_update(checksum, bytes, sizeof(bytes));
+}
+
+static char *fifo_sha256(PS2KbdState *keyboard, KBDState *controller)
+{
+    PS2Queue *queue = &keyboard->parent_obj.queue;
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t flags[4] = {
+        keyboard->scan_enabled != 0,
+        keyboard->translate != 0,
+        keyboard->need_high_bit,
+        controller->extended_state,
+    };
+
+    /* Hash raw storage and each behavior-relevant scalar explicitly. */
+    g_checksum_update(checksum, queue->data, sizeof(queue->data));
+    checksum_u64_le(checksum, (uint64_t)(int64_t)queue->rptr);
+    checksum_u64_le(checksum, (uint64_t)(int64_t)queue->wptr);
+    checksum_u64_le(checksum, (uint64_t)(int64_t)queue->cwptr);
+    checksum_u64_le(checksum, (uint64_t)(int64_t)queue->count);
+    checksum_u64_le(checksum, (uint64_t)(int64_t)keyboard->parent_obj.write_cmd);
+    checksum_u64_le(checksum, (uint64_t)(int64_t)keyboard->scancode_set);
+    checksum_u64_le(checksum, (uint64_t)(int64_t)keyboard->ledstate);
+    checksum_u64_le(checksum, keyboard->modifiers);
+    g_checksum_update(checksum, flags, sizeof(flags));
+    checksum_u64_le(checksum, controller->write_cmd);
+    checksum_u64_le(checksum, controller->status);
+    checksum_u64_le(checksum, controller->mode);
+    checksum_u64_le(checksum, controller->outport);
+    checksum_u64_le(checksum, controller->obsrc);
+    checksum_u64_le(checksum, controller->pending);
+    checksum_u64_le(checksum, controller->obdata);
+    checksum_u64_le(checksum, controller->cbdata);
+    return g_strdup(g_checksum_get_string(checksum));
+}
+
+static bool frame_keys_capacity(PS2KbdState *keyboard, KBDState *controller)
+{
+    if ((controller->status & FRAME_KEYS_OBF) || controller->pending ||
+        (controller->mode & FRAME_KEYS_KBD_DISABLED) ||
+        (controller->throttle_timer && timer_pending(controller->throttle_timer))) {
+        return false;
+    }
+    return true;
+}
+
+static FdisbullFrameKeysInfo *frame_keys_info(PS2KbdState *keyboard,
+                                               KBDState *controller,
+                                               const FdisbullClockInfo *clock)
+{
+    FdisbullFrameKeysInfo *info = g_new0(FdisbullFrameKeysInfo, 1);
+    PS2Queue *queue = &keyboard->parent_obj.queue;
+    int64_t throttle = -1;
+
+    info->api_version = FRAME_KEYS_API;
+    info->epoch = clock->epoch;
+    info->active = frame_keys.active;
+    info->valid = frame_keys.valid;
+    info->generation = frame_keys.generation;
+    info->token = frame_keys.active && frame_keys.token ?
+        g_strdup(frame_keys.token) : NULL;
+    info->held = key_list(frame_keys.held);
+    info->foreign_held = key_list(frame_keys.foreign);
+    info->repeat_supported = false;
+    info->accepted_edges = frame_keys.accepted_edges;
+    info->device_path = object_get_canonical_path(OBJECT(keyboard));
+    info->device_type = g_strdup(object_get_typename(OBJECT(keyboard)));
+    info->scan_enabled = keyboard->scan_enabled;
+    info->scancode_set = keyboard->scancode_set;
+    info->translated = keyboard->translate;
+    info->modifier_mask = keyboard->modifiers;
+    info->fifo_count = queue->count;
+    info->fifo_sha256 = fifo_sha256(keyboard, controller);
+    info->fifo_read_pointer = queue->rptr;
+    info->fifo_write_pointer = queue->wptr;
+    info->fifo_command_pointer = queue->cwptr;
+    info->write_command = keyboard->parent_obj.write_cmd;
+    info->controller_status = controller->status;
+    info->controller_mode = controller->mode;
+    info->controller_pending = controller->pending;
+    info->controller_obsrc = controller->obsrc;
+    info->controller_obdata = controller->obdata;
+    if (controller->throttle_timer && timer_pending(controller->throttle_timer)) {
+        throttle = timer_expire_time_ns(controller->throttle_timer);
+    }
+    info->throttle_deadline_ns = throttle;
+    info->edge_capacity = frame_keys.valid && !bitmap_any(frame_keys.foreign) &&
+        frame_keys_capacity(keyboard, controller) ?
+        ps2_keyboard_frame_edge_capacity(keyboard) : 0;
+    return info;
+}
+
+static unsigned expected_modifier_mask(const bool *held)
+{
+    unsigned i, result = 0;
+
+    for (i = 0; i < Q_KEY_CODE__MAX; i++) {
+        if (held[i]) {
+            result |= ps2_keyboard_modifier_bit(i);
+        }
+    }
+    return result;
+}
+
+bool fdisbull_frame_keys_keyboard_event(PS2KbdState *keyboard,
+                                        QKeyCode key, bool down)
+{
+    assert(bql_locked());
+    if (!key_valid(key)) {
+        if (frame_keys.active) {
+            frame_keys.valid = false;
+            g_free(frame_keys.fault);
+            frame_keys.fault = g_strdup("unmapped external keyboard event");
+        }
+        return !frame_keys.active;
+    }
+    if (frame_keys.dispatch_authorized &&
+        frame_keys.dispatch_keyboard == keyboard) {
+        return true;
+    }
+    if (frame_keys.active) {
+        frame_keys.valid = false;
+        g_free(frame_keys.fault);
+        frame_keys.fault = g_strdup("unowned keyboard event while frame-key owner active");
+        return false;
+    }
+    if (keyboard == frame_keys.keyboard || !frame_keys.keyboard) {
+        frame_keys.foreign[key] = down;
+    }
+    return true;
+}
+
+void fdisbull_frame_keys_keyboard_reset(PS2KbdState *keyboard)
+{
+    assert(bql_locked());
+    if (frame_keys.active && frame_keys.keyboard == keyboard &&
+        !fdisbull_instrumented_checkpoint_busy()) {
+        frame_keys.active = false;
+        frame_keys.valid = true;
+        memset(frame_keys.held, 0, sizeof(frame_keys.held));
+        g_clear_pointer(&frame_keys.token, g_free);
+        frame_keys.epoch = 0;
+        if (frame_keys.generation != UINT64_MAX) {
+            frame_keys.generation++;
+        } else {
+            frame_keys.valid = false;
+            g_free(frame_keys.fault);
+            frame_keys.fault = g_strdup("frame-key generation exhausted at reset");
+        }
+        migrate_del_blocker(&frame_keys.migration_blocker);
+        object_unref(OBJECT(frame_keys.keyboard));
+        frame_keys.keyboard = NULL;
+    }
+    if (keyboard == frame_keys.keyboard || !frame_keys.keyboard) {
+        memset(frame_keys.foreign, 0, sizeof(frame_keys.foreign));
+    }
+}
+
+bool fdisbull_frame_keys_checkpoint_owns_blocker(const Error *reason)
+{
+    return reason && frame_keys.active && frame_keys.migration_blocker == reason;
+}
+
+static bool frame_keys_block_migration(Error **errp)
+{
+    if (!frame_keys.migration_blocker) {
+        error_setg(&frame_keys.migration_blocker,
+                   "fDisBull frame-key ownership does not support generic migration");
+        if (migrate_add_blocker(&frame_keys.migration_blocker, errp) < 0) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool frame_keys_input_schedule_clear(Error **errp)
+{
+    g_autoptr(FdisbullInputInfo) input = qmp_x_fdisbull_query_input(errp);
+
+    if (!input) {
+        return false;
+    }
+    if (input->state == FDISBULL_INPUT_STATE_ARMED ||
+        input->state == FDISBULL_INPUT_STATE_FAILED) {
+        error_setg(errp, "Frame keys cannot overlap an active or failed input schedule");
+        return false;
+    }
+    return true;
+}
+
+FdisbullFrameKeysInfo *qmp_x_fdisbull_query_frame_keys(Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    g_autoptr(PS2KbdState) selected = NULL;
+    g_autoptr(Error) local_err = NULL;
+    KBDState *controller;
+    PS2KbdState *keyboard;
+
+    assert(bql_locked());
+    if (!frame_keys_clock(&clock, errp) || !frame_keys_input_schedule_clear(errp)) {
+        return NULL;
+    }
+    if (frame_keys.active) {
+        selected = qemu_input_fdisbull_keyboard_target(&local_err);
+        if (!selected) {
+            error_propagate(errp, g_steal_pointer(&local_err));
+            return NULL;
+        }
+        keyboard = frame_keys.keyboard;
+        if (frame_keys.epoch != clock->epoch) {
+            frame_keys.valid = false;
+            g_free(frame_keys.fault);
+            frame_keys.fault = g_strdup("native clock epoch changed under frame-key owner");
+        }
+        if (selected != keyboard) {
+            error_setg(errp, "Selected PS/2 keyboard changed under frame-key owner");
+            return NULL;
+        }
+    } else {
+        selected = qemu_input_fdisbull_keyboard_target(&local_err);
+        if (!selected) {
+            error_propagate(errp, g_steal_pointer(&local_err));
+            return NULL;
+        }
+        keyboard = selected;
+    }
+    controller = frame_keyboard_controller(keyboard, errp);
+    if (!controller) {
+        return NULL;
+    }
+    return frame_keys_info(keyboard, controller, clock);
+}
+
+static bool frame_edge_batch_validate(FdisbullFrameKeyEdgeList *edges,
+                                      bool *next, unsigned *count,
+                                      Error **errp)
+{
+    FdisbullFrameKeyEdgeList *item;
+    bool seen[Q_KEY_CODE__MAX] = { 0 };
+    unsigned held_count = 0;
+
+    memcpy(next, frame_keys.held, sizeof(frame_keys.held));
+    *count = 0;
+    for (item = edges; item; item = item->next) {
+        QKeyCode key = item->value->key;
+
+        if (++*count > FRAME_KEYS_MAX_EDGES || !key_valid(key) || seen[key] ||
+            next[key] == item->value->pressed) {
+            error_setg(errp, "Frame-key edges must be distinct real state transitions in a batch of at most 32");
+            return false;
+        }
+        seen[key] = true;
+        next[key] = item->value->pressed;
+    }
+    if (!*count) {
+        error_setg(errp, "Frame-key edge batch must not be empty");
+        return false;
+    }
+    for (unsigned i = 0; i < Q_KEY_CODE__MAX; i++) {
+        held_count += next[i];
+    }
+    if (held_count > FRAME_KEYS_MAX_HELD) {
+        error_setg(errp, "Frame-key owner exceeds 64 held keys");
+        return false;
+    }
+    return true;
+}
+
+static InputEventList *frame_edge_events(FdisbullFrameKeyEdgeList *edges)
+{
+    InputEventList *head = NULL, **tail = &head;
+    FdisbullFrameKeyEdgeList *item;
+
+    for (item = edges; item; item = item->next) {
+        InputEventList *node = g_new0(InputEventList, 1);
+        InputEvent *event = g_new0(InputEvent, 1);
+        InputKeyEvent *key_event = g_new0(InputKeyEvent, 1);
+        KeyValue *value = g_new0(KeyValue, 1);
+
+        value->type = KEY_VALUE_KIND_QCODE;
+        value->u.qcode.data = item->value->key;
+        key_event->key = value;
+        key_event->down = item->value->pressed;
+        event->type = INPUT_EVENT_KIND_KEY;
+        event->u.key.data = key_event;
+        node->value = event;
+        *tail = node;
+        tail = &node->next;
+    }
+    return head;
+}
+
+FdisbullFrameKeysInfo *qmp_x_fdisbull_apply_frame_key_edges(
+    const char *token, uint64_t expected_generation,
+    FdisbullFrameKeyEdgeList *edges, Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    g_autoptr(PS2KbdState) selected = NULL;
+    g_autoptr(FdisbullInputBatch) batch = NULL;
+    g_autoptr(InputEventList) events = NULL;
+    g_autoptr(Error) local_err = NULL;
+    g_autofree char *generated_token = NULL;
+    bool next[Q_KEY_CODE__MAX];
+    unsigned count, capacity;
+    PS2KbdState *keyboard;
+    KBDState *controller;
+    bool starting = !frame_keys.active;
+
+    assert(bql_locked());
+    if (!token || !*token || strlen(token) > 128 ||
+        !frame_keys_clock(&clock, errp) || !frame_keys_input_schedule_clear(errp)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Frame-key owner token must contain 1..128 bytes");
+        }
+        return NULL;
+    }
+    if (starting) {
+        if (!frame_keys.valid || bitmap_any(frame_keys.foreign) ||
+            frame_keys.generation == UINT64_MAX || expected_generation != frame_keys.generation) {
+            error_setg(errp, "Frame-key owner admission requires released foreign keys and the current generation");
+            return NULL;
+        }
+        if (frame_keys.keyboard) {
+            selected = frame_keys.keyboard;
+            object_ref(OBJECT(selected));
+        } else {
+            selected = qemu_input_fdisbull_keyboard_target(&local_err);
+            if (!selected) {
+                error_propagate(errp, g_steal_pointer(&local_err));
+                return NULL;
+            }
+        }
+        keyboard = selected;
+    } else {
+        if (!frame_keys.valid || frame_keys.epoch != clock->epoch ||
+            !frame_keys.token || strcmp(token, frame_keys.token) ||
+            expected_generation != frame_keys.generation ||
+            frame_keys.generation == UINT64_MAX) {
+            error_setg(errp, "Frame-key owner token, epoch or generation is stale");
+            return NULL;
+        }
+        keyboard = frame_keys.keyboard;
+    }
+    controller = frame_keyboard_controller(keyboard, errp);
+    if (!controller || !frame_edge_batch_validate(edges, next, &count, errp)) {
+        return NULL;
+    }
+    capacity = frame_keys_capacity(keyboard, controller) ?
+        ps2_keyboard_frame_edge_capacity(keyboard) : 0;
+    if (count > capacity || frame_keys.accepted_edges > UINT64_MAX - count) {
+        error_setg(errp, "Frame-key batch exceeds the currently available PS/2 FIFO capacity");
+        return NULL;
+    }
+    events = frame_edge_events(edges);
+    batch = qemu_input_fdisbull_prepare(events, errp);
+    if (!batch) {
+        return NULL;
+    }
+    if (qemu_input_fdisbull_keyboard_from_batch(batch) != keyboard) {
+        error_setg(errp, "Selected PS/2 keyboard changed during frame-key preflight");
+        return NULL;
+    }
+    if (starting && !frame_keys_block_migration(errp)) {
+        return NULL;
+    }
+    frame_keys.dispatch_authorized = true;
+    frame_keys.dispatch_keyboard = keyboard;
+    /* The first owner's supplied token is not installed until dispatch succeeds. */
+    if (!qemu_input_fdisbull_dispatch_stopped_keys(batch, errp)) {
+        frame_keys.dispatch_authorized = false;
+        frame_keys.dispatch_keyboard = NULL;
+        if (starting) {
+            migrate_del_blocker(&frame_keys.migration_blocker);
+        }
+        return NULL;
+    }
+    frame_keys.dispatch_authorized = false;
+    frame_keys.dispatch_keyboard = NULL;
+    if (starting) {
+        frame_keys.keyboard = g_steal_pointer(&selected);
+        frame_keys.active = true;
+        frame_keys.valid = true;
+        frame_keys.epoch = clock->epoch;
+        frame_keys.token = g_strdup(token);
+    }
+    memcpy(frame_keys.held, next, sizeof(frame_keys.held));
+    frame_keys.generation++;
+    frame_keys.accepted_edges += count;
+    return frame_keys_info(keyboard, controller, clock);
+}
+
+FdisbullFrameKeysInfo *qmp_x_fdisbull_detach_frame_keys(
+    const char *token, uint64_t expected_generation, Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    g_autoptr(FdisbullInputInfo) input = NULL;
+    PS2KbdState *keyboard;
+    KBDState *controller;
+
+    assert(bql_locked());
+    if (!frame_keys_clock(&clock, errp) || !frame_keys.active ||
+        !frame_keys.valid || !token || !frame_keys.token ||
+        strcmp(token, frame_keys.token) ||
+        expected_generation != frame_keys.generation ||
+        bitmap_any(frame_keys.held) || bitmap_any(frame_keys.foreign) ||
+        frame_keys.generation == UINT64_MAX) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Frame-key detach requires its current empty owner and generation");
+        }
+        return NULL;
+    }
+    input = qmp_x_fdisbull_query_input(errp);
+    if (!input || input->state == FDISBULL_INPUT_STATE_ARMED ||
+        input->state == FDISBULL_INPUT_STATE_FAILED) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Frame-key detach cannot overlap a scheduled input plan");
+        }
+        return NULL;
+    }
+    keyboard = frame_keys.keyboard;
+    controller = frame_keyboard_controller(keyboard, errp);
+    if (!controller) {
+        return NULL;
+    }
+    frame_keys.active = false;
+    frame_keys.epoch = 0;
+    frame_keys.generation++;
+    g_clear_pointer(&frame_keys.token, g_free);
+    frame_keys.keyboard = NULL;
+    object_unref(OBJECT(keyboard));
+    migrate_del_blocker(&frame_keys.migration_blocker);
+    return frame_keys_info(keyboard, controller, clock);
+}
+
+bool fdisbull_frame_keys_checkpoint_allowed(void)
+{
+    return frame_keys.valid && !bitmap_any(frame_keys.foreign) &&
+        (!frame_keys.active || (frame_keys.token && frame_keys.keyboard));
+}
+
+bool fdisbull_frame_keys_active(void)
+{
+    return frame_keys.active;
+}
+
+bool fdisbull_frame_keys_checkpoint_safe(Error **errp)
+{
+    if (!fdisbull_frame_keys_checkpoint_allowed()) {
+        error_setg(errp, "Checkpoint requires released foreign input and a valid frame-key owner");
+        return false;
+    }
+    return true;
+}
+
+FdisbullFrameKeysCheckpointState *fdisbull_frame_keys_checkpoint_state(
+    uint64_t source_epoch, Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    g_autoptr(PS2KbdState) selected = NULL;
+    PS2KbdState *keyboard;
+    KBDState *controller;
+    FdisbullFrameKeysCheckpointState *state;
+    FdisbullFrameKeysInfo *info;
+
+    assert(bql_locked());
+    if (!fdisbull_frame_keys_checkpoint_safe(errp) ||
+        !frame_keys_clock(&clock, errp) || clock->epoch != source_epoch ||
+        (frame_keys.active && frame_keys.epoch != source_epoch)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Frame-key checkpoint source epoch differs from its owner");
+        }
+        return NULL;
+    }
+    if (frame_keys.active) {
+        keyboard = frame_keys.keyboard;
+    } else {
+        selected = qemu_input_fdisbull_keyboard_target(errp);
+        if (!selected) {
+            return NULL;
+        }
+        keyboard = selected;
+    }
+    controller = frame_keyboard_controller(keyboard, errp);
+    if (!controller) {
+        return NULL;
+    }
+    info = frame_keys_info(keyboard, controller, clock);
+    if (info->fifo_count < 0 || info->fifo_count > PS2_BUFFER_SIZE ||
+        (frame_keys.active && info->modifier_mask != expected_modifier_mask(frame_keys.held)) ||
+        (!frame_keys.active && info->modifier_mask)) {
+        qapi_free_FdisbullFrameKeysInfo(info);
+        error_setg(errp, "PS/2 modifier/FIFO state is not owned by the stopped frame-key ledger");
+        return NULL;
+    }
+    state = g_new0(FdisbullFrameKeysCheckpointState, 1);
+    state->active = frame_keys.active;
+    state->source_epoch = source_epoch;
+    state->generation = frame_keys.generation;
+    state->accepted_edges = frame_keys.accepted_edges;
+    state->held = key_list(frame_keys.held);
+    state->device_path = g_strdup(info->device_path);
+    state->device_type = g_strdup(info->device_type);
+    state->scan_enabled = info->scan_enabled;
+    state->scancode_set = info->scancode_set;
+    state->translated = info->translated;
+    state->modifier_mask = info->modifier_mask;
+    state->fifo_count = info->fifo_count;
+    state->fifo_sha256 = g_strdup(info->fifo_sha256);
+    state->fifo_read_pointer = info->fifo_read_pointer;
+    state->fifo_write_pointer = info->fifo_write_pointer;
+    state->fifo_command_pointer = info->fifo_command_pointer;
+    state->write_command = info->write_command;
+    state->controller_status = info->controller_status;
+    state->controller_mode = info->controller_mode;
+    state->controller_pending = info->controller_pending;
+    state->controller_obsrc = info->controller_obsrc;
+    state->controller_obdata = info->controller_obdata;
+    state->throttle_deadline_ns = info->throttle_deadline_ns;
+    qapi_free_FdisbullFrameKeysInfo(info);
+    return state;
+}
+
+static bool frame_keys_state_device_equal(
+    const FdisbullFrameKeysCheckpointState *state, PS2KbdState *keyboard,
+    KBDState *controller)
+{
+    g_autofree char *path = object_get_canonical_path(OBJECT(keyboard));
+    g_autofree char *fifo = fifo_sha256(keyboard, controller);
+    int64_t deadline = -1;
+
+    if (controller->throttle_timer && timer_pending(controller->throttle_timer)) {
+        deadline = timer_expire_time_ns(controller->throttle_timer);
+    }
+    return !strcmp(state->device_path, path) &&
+        !strcmp(state->device_type, object_get_typename(OBJECT(keyboard))) &&
+        state->scan_enabled == keyboard->scan_enabled &&
+        state->scancode_set == keyboard->scancode_set &&
+        state->translated == keyboard->translate &&
+        state->modifier_mask == keyboard->modifiers &&
+        state->fifo_count == keyboard->parent_obj.queue.count &&
+        state->fifo_read_pointer == keyboard->parent_obj.queue.rptr &&
+        state->fifo_write_pointer == keyboard->parent_obj.queue.wptr &&
+        state->fifo_command_pointer == keyboard->parent_obj.queue.cwptr &&
+        state->write_command == keyboard->parent_obj.write_cmd &&
+        !strcmp(state->fifo_sha256, fifo) &&
+        state->controller_status == controller->status &&
+        state->controller_mode == controller->mode &&
+        state->controller_pending == controller->pending &&
+        state->controller_obsrc == controller->obsrc &&
+        state->controller_obdata == controller->obdata &&
+        state->throttle_deadline_ns == deadline;
+}
+
+bool fdisbull_frame_keys_checkpoint_validate(
+    const FdisbullFrameKeysCheckpointState *state, uint64_t source_epoch,
+    Error **errp)
+{
+    g_autoptr(PS2KbdState) keyboard = NULL;
+    bool held[Q_KEY_CODE__MAX];
+    KBDState *controller;
+
+    assert(bql_locked());
+    if (!state || state->source_epoch != source_epoch ||
+        state->fifo_count < 0 || state->fifo_count > PS2_BUFFER_SIZE ||
+        !state->device_path || !*state->device_path ||
+        !state->device_type || !*state->device_type ||
+        !state->fifo_sha256 || strlen(state->fifo_sha256) != 64 ||
+        state->fifo_read_pointer < 0 || state->fifo_read_pointer >= PS2_BUFFER_SIZE ||
+        state->fifo_write_pointer < 0 || state->fifo_write_pointer >= PS2_BUFFER_SIZE ||
+        state->fifo_command_pointer < -1 || state->fifo_command_pointer >= PS2_BUFFER_SIZE ||
+        state->write_command < -1 || state->write_command > UINT8_MAX ||
+        state->throttle_deadline_ns < -1 ||
+        !list_to_bitmap(state->held, held, errp)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Invalid frame-key checkpoint envelope");
+        }
+        return false;
+    }
+    if ((!state->active && bitmap_any(held)) ||
+        (state->active && !state->accepted_edges) ||
+        expected_modifier_mask(held) != state->modifier_mask) {
+        error_setg(errp, "Frame-key checkpoint held set differs from its modifier/device proof");
+        return false;
+    }
+    keyboard = qemu_input_fdisbull_keyboard_target(errp);
+    if (!keyboard) {
+        return false;
+    }
+    controller = frame_keyboard_controller(keyboard, errp);
+    if (!controller || !frame_keys_state_device_equal(state, keyboard, controller)) {
+        error_setg(errp, "Restored PS/2/i8042 input state differs from its frame-key checkpoint proof");
+        return false;
+    }
+    return true;
+}
+
+bool fdisbull_frame_keys_checkpoint_restore(
+    const FdisbullFrameKeysCheckpointState *state, uint64_t epoch,
+    const char **new_token, uint64_t *generation, Error **errp)
+{
+    g_autoptr(PS2KbdState) keyboard = NULL;
+    bool held[Q_KEY_CODE__MAX];
+    char token[UUID_STR_LEN];
+
+    assert(bql_locked());
+    if (!fdisbull_frame_keys_checkpoint_validate(state, state->source_epoch,
+                                                 errp) ||
+        !epoch || !new_token || !generation ||
+        !list_to_bitmap(state->held, held, errp)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Invalid frame-key checkpoint restore request");
+        }
+        return false;
+    }
+    keyboard = qemu_input_fdisbull_keyboard_target(errp);
+    if (!keyboard) {
+        return false;
+    }
+    {
+        QemuUUID uuid;
+        qemu_uuid_generate(&uuid);
+        qemu_uuid_unparse(&uuid, token);
+    }
+    if (frame_keys.keyboard) {
+        object_unref(OBJECT(frame_keys.keyboard));
+    }
+    if (state->active && !frame_keys_block_migration(errp)) {
+        return false;
+    }
+    frame_keys.keyboard = state->active ? g_steal_pointer(&keyboard) : NULL;
+    if (!state->active) {
+        migrate_del_blocker(&frame_keys.migration_blocker);
+    }
+    frame_keys.active = state->active;
+    frame_keys.valid = true;
+    frame_keys.epoch = epoch;
+    frame_keys.generation = state->generation;
+    frame_keys.accepted_edges = state->accepted_edges;
+    memcpy(frame_keys.held, held, sizeof(frame_keys.held));
+    memset(frame_keys.foreign, 0, sizeof(frame_keys.foreign));
+    g_clear_pointer(&frame_keys.token, g_free);
+    if (state->active) {
+        frame_keys.token = g_strdup(token);
+        *new_token = g_strdup(frame_keys.token);
+    } else {
+        *new_token = NULL;
+    }
+    *generation = frame_keys.generation;
+    return true;
+}
+
+bool fdisbull_frame_keys_checkpoint_restore_legacy(uint64_t epoch,
+                                                    uint64_t *generation,
+                                                    Error **errp)
+{
+    g_autoptr(PS2KbdState) keyboard = NULL;
+    KBDState *controller;
+
+    assert(bql_locked());
+    if (!epoch || !generation) {
+        error_setg(errp, "Invalid legacy frame-key checkpoint restore request");
+        return false;
+    }
+    keyboard = qemu_input_fdisbull_keyboard_target(errp);
+    if (!keyboard) {
+        return false;
+    }
+    controller = frame_keyboard_controller(keyboard, errp);
+    if (!controller || keyboard->modifiers) {
+        error_setg(errp, "Legacy checkpoint cannot restore an untracked held keyboard modifier");
+        return false;
+    }
+    if (frame_keys.keyboard) {
+        object_unref(OBJECT(frame_keys.keyboard));
+    }
+    migrate_del_blocker(&frame_keys.migration_blocker);
+    frame_keys.keyboard = NULL;
+    frame_keys.active = false;
+    frame_keys.valid = true;
+    frame_keys.epoch = epoch;
+    frame_keys.generation = 0;
+    frame_keys.accepted_edges = 0;
+    memset(frame_keys.held, 0, sizeof(frame_keys.held));
+    memset(frame_keys.foreign, 0, sizeof(frame_keys.foreign));
+    g_clear_pointer(&frame_keys.token, g_free);
+    g_clear_pointer(&frame_keys.fault, g_free);
+    *generation = 0;
+    return true;
+}
