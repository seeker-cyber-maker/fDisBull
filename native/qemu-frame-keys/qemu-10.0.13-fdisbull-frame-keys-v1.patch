+PS2KbdState *qemu_input_fdisbull_keyboard_target(Error **errp)
+{
+    QemuInputHandlerState *handler, *selected = NULL;
+    unsigned matches = 0;
+
+    assert(bql_locked());
+    QTAILQ_FOREACH(handler, &handlers, node) {
+        if (handler->handler->mask & INPUT_EVENT_MASK_KEY) {
+            matches++;
+            selected = handler;
+        }
+    }
+    if (matches != 1 || !selected || !selected->dev ||
+        !selected->dev->realized ||
+        strcmp(object_get_typename(OBJECT(selected->dev)), TYPE_PS2_KBD_DEVICE) ||
+        selected->handler->mask != INPUT_EVENT_MASK_KEY ||
+        !selected->handler->event || selected->handler->sync) {
+        error_setg(errp, "Frame keys require exactly one realized PS/2 keyboard handler");
+        return NULL;
+    }
+    object_ref(OBJECT(selected->dev));
+    return PS2_KBD_DEVICE(selected->dev);
+}
+
+PS2KbdState *qemu_input_fdisbull_keyboard_from_batch(
+    const FdisbullInputBatch *batch)
+{
+    assert(bql_locked());
+    if (!batch || !batch->keyboard.dev ||
+        strcmp(object_get_typename(OBJECT(batch->keyboard.dev)),
+               TYPE_PS2_KBD_DEVICE)) {
+        return NULL;
+    }
+    return PS2_KBD_DEVICE(batch->keyboard.dev);
+}
+
+bool qemu_input_fdisbull_dispatch_stopped_keys(FdisbullInputBatch *batch,
+                                                Error **errp)
+{
+    InputEventList *event;
+
+    assert(bql_locked());
+    if (!batch || batch->dispatched || runstate_is_running() ||
+        (!runstate_check(RUN_STATE_PAUSED) &&
+         !runstate_check(RUN_STATE_DEBUG) &&
+         !runstate_check(RUN_STATE_PRELAUNCH))) {
+        error_setg(errp, "Stopped frame-key dispatch requires an owned paused/debug VM");
+        return false;
+    }
+    for (event = batch->events; event; event = event->next) {
+        InputEvent *evt = event->value;
+        if (!evt || evt->type != INPUT_EVENT_KIND_KEY || !evt->u.key.data ||
+            !evt->u.key.data->key ||
+            evt->u.key.data->key->type != KEY_VALUE_KIND_QCODE) {
+            error_setg(errp, "Stopped frame-key dispatch accepts only QCode key edges");
+            return false;
+        }
+    }
+    if (!fdisbull_input_preflight(batch, batch->events, false, errp)) {
+        return false;
+    }
+    batch->dispatched = true;
+    for (event = batch->events; event; event = event->next) {
+        /* This API is deliberately for an owned stopped VM.  The public
+         * qemu_input_event_send() wrapper drops events outside RUNNING or
+         * SUSPENDED, so invoke the exact handler captured and revalidated by
+         * preflight instead of silently acknowledging an ignored event. */
+        batch->keyboard.event(batch->keyboard.dev, NULL, event->value);
+    }
+    /* The selected PS/2 keyboard handler is validated to have no sync hook. */
+    return true;
+}
