+        JsonValue record = Object();
+        Add(&record, "physical_line", Number(row.physical_line));
+        Add(&record, "draw_address", Number(row.draw_address));
+        Add(&record, "address_line", Number(row.address_line));
+        Add(&record, "scheduled_ns", Number(row.scheduled_ns));
+        Add(&record, "actual", FrameSourceClockResult(row.actual));
+        rows.array.push_back(std::move(record));
+    }
+    Add(&result, "rows", rows);
     return result;
 }
 
