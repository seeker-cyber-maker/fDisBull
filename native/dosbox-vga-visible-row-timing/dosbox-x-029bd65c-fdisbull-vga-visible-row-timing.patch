+void AGENT_EnableVisibleRows(bool enabled)
+{
+    if (enabled != agent_visible_rows_enabled) {
+        agent_visible_rows_enabled = enabled;
+        pending_visible_rows = FrameVisibleRows();
+        agent_frame.visible_rows = FrameVisibleRows();
+    }
+}
+
+bool AGENT_VisibleRowsEnabled()
+{
+    return agent_visible_rows_enabled && agent_frame_capture_enabled;
+}
+
+void AGENT_BeginVisibleRows(FrameVisibleLayout layout, std::uint64_t latched_start,
+                            double frame_ms, double first_ms, double line_ms, double period_ms,
+                            double retrace_ms)
+{
+    FrameVisibleRows receipt;
+    if (!FrameSourceScheduledClock(frame_ms, &receipt.frame_scheduled_ns) ||
+        !FrameSourceScheduledClock(first_ms, &receipt.first_callback_scheduled_ns) ||
+        !FrameSourceScheduledClock(line_ms, &receipt.line_period_ns) ||
+        !FrameSourceScheduledClock(period_ms, &receipt.frame_period_ns) ||
+        !FrameSourceScheduledClock(retrace_ms, &receipt.retrace_scheduled_ns) ||
+        !receipt.line_period_ns || !receipt.frame_period_ns) {
+        return;
+    }
+    receipt.layout = layout;
+    receipt.latched_crtc_start = latched_start;
+    receipt.rows.reserve(FrameVisibleRows::height);
+    pending_visible_rows = std::move(receipt);
+}
+
+void AGENT_RecordVisibleRow(FrameVisibleLayout layout, std::uint32_t row, std::uint32_t physical_line,
+                            std::uint64_t address, std::uint32_t address_line)
+{
+    if (pending_visible_rows.layout == FrameVisibleLayout::None) {
+        return;
+    }
+    FrameVisibleRow stamp;
+    if (layout != pending_visible_rows.layout || row != pending_visible_rows.rows.size() ||
+        row >= FrameVisibleRows::height || row != physical_line ||
+        !FrameSourceActualClock(&stamp.actual) ||
+        !FrameSourceScheduledClock(PIC_GetCurrentEventTime(), &stamp.scheduled_ns)) {
+        pending_visible_rows = FrameVisibleRows();
+        return;
+    }
+    stamp.physical_line = physical_line;
+    stamp.draw_address = address;
+    stamp.address_line = address_line;
+    pending_visible_rows.rows.push_back(stamp);
 }
 
