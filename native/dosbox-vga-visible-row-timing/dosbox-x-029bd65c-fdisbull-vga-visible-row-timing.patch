+    Add(&result, "first_callback_scheduled_ns", Number(timing.first_callback_scheduled_ns));
+    Add(&result, "line_period_ns", Number(timing.line_period_ns));
+    Add(&result, "frame_period_ns", Number(timing.frame_period_ns));
+    Add(&result, "retrace_scheduled_ns", Number(timing.retrace_scheduled_ns));
+    Add(&result, "latched_crtc_start", Number(timing.latched_crtc_start));
