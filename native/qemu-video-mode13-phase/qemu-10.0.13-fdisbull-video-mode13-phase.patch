+           PCI_VGA(obj)->vga.fdisbull_mode13_phase;
+}
+
+bool pci_std_vga_fdisbull_mode13_pending(Object *obj)
+{
+    return pci_std_vga_fdisbull_mode13_selected(obj) &&
