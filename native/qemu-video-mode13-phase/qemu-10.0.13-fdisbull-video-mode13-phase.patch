+}
+
+bool pci_std_vga_fdisbull_mode13_setup(Object *obj, FdisbullVideoSetupStamp *out)
+{
+    if (!pci_std_vga_fdisbull_mode13_selected(obj)) {
+        return false;
+    }
+    VGACommonState *s = &PCI_VGA(obj)->vga;
+    if (!s->fdisbull_mode13_setup.configuration_generation ||
+        s->fdisbull_mode13_setup.configuration_generation !=
+            s->fdisbull_configuration_generation ||
+        s->fdisbull_mode13_setup.timing_generation != s->fdisbull_retrace_generation) {
+        return false;
+    }
+    *out = s->fdisbull_mode13_setup;
+    return true;
+}
+
+bool pci_std_vga_fdisbull_mode13_restore(Object *obj,
+                                 const FdisbullVideoSetupStamp *setup, Error **errp)
+{
+    VGACommonState *s;
+    FdisbullVideoFrameSource source;
+
+    if (!pci_std_vga_fdisbull_mode13_selected(obj)) {
+        error_setg(errp, "Mode-13 phase restore requires the selected VGA profile");
+        return false;
+    }
+    s = &PCI_VGA(obj)->vga;
+    s->fdisbull_mode13_prefix = 0;
+    s->fdisbull_mode13_setup = setup ? *setup : (FdisbullVideoSetupStamp) { 0 };
+    if (setup &&
+        (!vga_fdisbull_video_frame_sample(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+                                         -1, NULL, &source, errp) ||
+         !source.setup.configuration_generation)) {
+        s->fdisbull_mode13_setup = (FdisbullVideoSetupStamp) { 0 };
+        if (!errp || !*errp) {
+            error_setg(errp, "Restored mode-13 setup differs from live VGA");
+        }
+        return false;
+    }
+    return true;
+}
