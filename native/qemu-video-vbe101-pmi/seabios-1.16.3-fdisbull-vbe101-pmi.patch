 static void
 vbe_104f0a(struct bregs *regs)
 {
-    debug_stub(regs);
-    regs->ax = 0x0100;
+    extern const u8 fdisbull_pmi_table[], fdisbull_pmi_window[];
+    extern const u8 fdisbull_pmi_start[], fdisbull_pmi_palette[];
+    extern const u8 fdisbull_pmi_end[];
+    const u8 *start, *end;
+
+    // The dedicated ROM publishes the table before mode selection.
+    // Each copied entry independently checks for active banked 101h.
+    if (!CONFIG_VGA_BOCHS)
+        goto fail;
+    switch (regs->bl) {
+    case 0x00:
+        start = fdisbull_pmi_table;
+        end = fdisbull_pmi_end;
+        break;
+    case 0x01:
+        start = fdisbull_pmi_window;
+        end = fdisbull_pmi_start;
+        break;
+    case 0x02:
+        start = fdisbull_pmi_start;
+        end = fdisbull_pmi_palette;
+        break;
+    case 0x03:
+        start = fdisbull_pmi_palette;
+        end = fdisbull_pmi_end;
+        break;
+    default:
+        goto fail;
+    }
+    regs->es = get_global_seg();
+    regs->di = (u32)start;
+    regs->cx = (u32)end - (u32)start;
+    regs->ax = 0x004f;
+    return;
+fail:
+    regs->ax = 0x014f;
 }

