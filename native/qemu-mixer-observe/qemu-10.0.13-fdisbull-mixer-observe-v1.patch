+
+# Passive mixer observation; independent of capture-window ownership.
+
+##
+# @FdisbullMixerAudiodev:
+#
+# One actual initialized audiodev, with sorted current card/voice identities.
+#
+# @audiodev-id: Actual initialized audiodev ID.
+# @captures: Sorted existing capture descriptors; empty before capture registration.
+# @cards: Sorted existing registered card names.
+# @driver: Actual initialized backend driver name.
+# @mixing-engine: Actual audiodev output mixing-engine setting.
+# @voices: Sorted existing voices; an initially silent card may have none.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullMixerAudiodev',
+  'data': { 'audiodev-id': 'str',
+            'captures': ['FdisbullMixerCapture'],
+            'cards': ['str'],
+            'driver': 'str',
+            'mixing-engine': 'bool',
+            'voices': ['FdisbullMixerVoice'] } }
+
+##
+# @FdisbullMixerCapture:
+#
+# One existing observer tap; absent taps produce no fabricated descriptor.
+#
+# @enabled: Actual observer tap enabled flag.
+# @format: Actual software voice or tap PCM geometry.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullMixerCapture',
+  'data': { 'enabled': 'bool',
+            'format': 'FdisbullMixerFormat' } }
+
+##
+# @FdisbullMixerFormat:
+#
+# Actual integer PCM geometry; no sample conversion is performed by observation.
+#
+# @bits: Integer PCM sample bits, 8, 16 or 32.
+# @bytes-per-frame: Channels times bytes per sample.
+# @bytes-per-second: Rate times bytes per frame.
+# @channels: PCM channel count, one or two.
+# @is-signed: Whether integer PCM samples are signed.
+# @rate: PCM frames per second.
+# @swap-endianness: Whether samples use the non-native byte order.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullMixerFormat',
+  'data': { 'bits': 'int',
+            'bytes-per-frame': 'int',
+            'bytes-per-second': 'int',
+            'channels': 'int',
+            'is-signed': 'bool',
+            'rate': 'int',
+            'swap-endianness': 'bool' } }
+
+##
+# @FdisbullMixerGain:
+#
+# Actual software voice gain scalars; no guest mixer-register law is inferred.
+#
+# @left: Raw left software gain, 0 through gain-scale.
+# @mute: Actual software mute scalar.
+# @right: Raw right software gain, 0 through gain-scale.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullMixerGain',
+  'data': { 'left': 'uint64',
+            'mute': 'bool',
+            'right': 'uint64' } }
+
+##
+# @FdisbullMixerInfo:
+#
+# Bounded stopped mixer readback. There is no synthetic master gain.
+#
+# @api-version: Readback protocol version, one.
+# @audiodevs: Sorted actual audiodevs; at most eight.
+# @gain-scale: Integer gain denominator, 4294967296 for unity.
+# @mono-input: Existing channel law, duplicate-to-left-right.
+# @mono-output: Existing channel law, sum-then-clip.
+# @stereo-output: Existing channel law, clip-left-right.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullMixerInfo',
+  'data': { 'api-version': 'int',
+            'audiodevs': ['FdisbullMixerAudiodev'],
+            'gain-scale': 'uint64',
+            'mono-input': 'str',
+            'mono-output': 'str',
+            'stereo-output': 'str' } }
+
+##
+# @FdisbullMixerVoice:
+#
+# One existing guest output software voice with its actual card/name identity.
+#
+# @active: Actual current software voice active flag.
+# @card-id: Actual registered card name, unique within the audiodev.
+# @format: Actual software voice or tap PCM geometry.
+# @gain: Actual SWVoiceOut volume state.
+# @hardware-enabled: Actual output HW enabled flag.
+# @hardware-format: Actual associated output HW PCM geometry.
+# @hardware-pending-disable: Actual output HW draining/pending-disable flag.
+# @software-volume-applied: True only for mixeng with no backend volume callback.
+# @voice-id: Actual software voice name, unique within its card.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullMixerVoice',
+  'data': { 'active': 'bool',
+            'card-id': 'str',
+            'format': 'FdisbullMixerFormat',
+            'gain': 'FdisbullMixerGain',
+            'hardware-enabled': 'bool',
+            'hardware-format': 'FdisbullMixerFormat',
+            'hardware-pending-disable': 'bool',
+            'software-volume-applied': 'bool',
+            'voice-id': 'str' } }
+
+##
+# @x-fdisbull-query-mixer:
+#
+# Observe existing integer mixer gains and PCM formats under BQL while stopped.
+# Refuses running, ambiguous, malformed or oversized graphs. Does not flush,
+# activate voices, execute guest code, write gains, or alter timers. Limits are
+# eight audiodevs and 32 total cards, voices and capture taps; names are 128 bytes.
+#
+# Returns: Actual current output graph, with no synthetic master gain.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-query-mixer', 'returns': 'FdisbullMixerInfo' }
