+static JsonValue FrameSourceClockResult(const FrameSourceActualTime& clock)
+{
+    JsonValue time = Object();
+    Add(&time, "ticks", Number(clock.ticks));
+    Add(&time, "tick_cycles", Number(clock.tick_cycles));
+    Add(&time, "cycles_per_tick", Number(clock.cycles_per_tick));
+    return time;
+}
+
+static JsonValue FrameSourceRgb6Result(const std::array<std::uint8_t, 3>& colors)
+{
+    JsonValue rgb = JsonValue::Array();
+    for (const auto component : colors) {
+        rgb.array.push_back(Number(component));
+    }
+    return rgb;
+}
+
+static JsonValue FrameSourceTimingResult(const FrameSourceTiming& timing)
+{
+    JsonValue result = Object(), rows = JsonValue::Array(), commits = JsonValue::Array();
+    Add(&result, "model", String("dosbox-vga-chain4-row-timing-v1"));
+    Add(&result, "palette_index", Number(timing.palette_index));
+    Add(&result, "physical_phase", Number(timing.physical_phase));
+    Add(&result, "frame_scheduled_ns", Number(timing.frame_scheduled_ns));
+    Add(&result, "first_callback_scheduled_ns", Number(timing.first_callback_scheduled_ns));
+    Add(&result, "line_period_ns", Number(timing.line_period_ns));
+    Add(&result, "retrace_scheduled_ns", Number(timing.retrace_scheduled_ns));
+    Add(&result, "initial_rgb6", FrameSourceRgb6Result(timing.initial_rgb6));
+    for (const auto& row : timing.rows) {
+        JsonValue record = Object();
+        Add(&record, "physical_line", Number(row.physical_line));
+        Add(&record, "scheduled_ns", Number(row.scheduled_ns));
+        Add(&record, "actual", FrameSourceClockResult(row.actual));
+        rows.array.push_back(std::move(record));
+    }
+    for (const auto& commit : timing.commits) {
+        JsonValue record = Object();
+        Add(&record, "rgb6", FrameSourceRgb6Result(commit.rgb6));
+        Add(&record, "actual", FrameSourceClockResult(commit.actual));
+        commits.array.push_back(std::move(record));
+    }
+    Add(&result, "rows", rows);
+    Add(&result, "dac_commits", commits);
+    return result;
+}
