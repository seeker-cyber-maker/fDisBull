+static bool FrameSourceActualClock(FrameSourceActualTime *out)
+{
+    const Bits tick_cycles = PIC_TickIndexND();
+
+    if (tick_cycles < 0 || CPU_CycleMax <= 0) {
+        return false;
+    }
+    out->ticks = PIC_Ticks;
+    out->tick_cycles = static_cast<std::uint64_t>(tick_cycles);
+    out->cycles_per_tick = static_cast<std::uint64_t>(CPU_CycleMax);
+    return true;
+}
+
+static bool FrameSourceScheduledClock(double ms, std::uint64_t *out)
+{
+    if (!(ms >= 0.0 && ms < static_cast<double>(INT64_MAX / 1000000))) {
+        return false;
+    }
+    *out = static_cast<std::uint64_t>(std::llround(ms * 1000000.0));
+    return true;
+}
+
+void AGENT_BeginFrameSourceTiming(std::uint32_t phase, double frame_ms,
+                                 double first_callback_ms, double line_ms,
+                                 double retrace_ms, std::uint8_t red,
+                                 std::uint8_t green, std::uint8_t blue)
+{
+    FrameSourceTiming timing;
+
+    if (frame_source_timing_palette < 0 || !AGENT_FrameSourcePending() ||
+        phase > 1 || red > 63 || green > 63 || blue > 63 ||
+        !FrameSourceScheduledClock(frame_ms, &timing.frame_scheduled_ns) ||
+        !FrameSourceScheduledClock(first_callback_ms, &timing.first_callback_scheduled_ns) ||
+        !FrameSourceScheduledClock(line_ms, &timing.line_period_ns) ||
+        !FrameSourceScheduledClock(retrace_ms, &timing.retrace_scheduled_ns) ||
+        !timing.line_period_ns) {
+        return;
+    }
+    timing.palette_index = frame_source_timing_palette;
+    timing.physical_phase = phase;
+    timing.initial_rgb6 = {{red, green, blue}};
+    timing.rows.reserve(FrameSourceSnapshot::height);
+    pending_frame_source.timing = std::move(timing);
+}
+
+void AGENT_RecordFrameSourceDacCommit(std::uint32_t palette_index,
+                                     std::uint8_t red, std::uint8_t green,
+                                     std::uint8_t blue)
+{
+    auto& timing = pending_frame_source.timing;
+    FrameSourceDacCommit commit;
+
+    if (timing.palette_index < 0 || static_cast<std::uint32_t>(timing.palette_index) != palette_index) {
+        return;
+    }
+    if (timing.commits.size() >= FrameSourceTiming::max_commits ||
+        red > 63 || green > 63 || blue > 63 || !FrameSourceActualClock(&commit.actual)) {
+        timing = FrameSourceTiming();
+        return;
+    }
+    commit.rgb6 = {{red, green, blue}};
+    timing.commits.push_back(commit);
+}
