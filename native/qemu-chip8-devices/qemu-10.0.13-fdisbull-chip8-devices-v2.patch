+static char *chip8_get_pixels_sha256(Object *obj, Error **errp)
+{
+    CPUArchState *env = &CHIP8_CPU(obj)->env;
+    uint8_t *digest = NULL;
+    size_t digest_len = 0;
+    char *hex;
+    if (qcrypto_hash_bytes(QCRYPTO_HASH_ALGO_SHA256,
+                           (const char *)env->display,
+                           sizeof(env->display), &digest, &digest_len,
+                           errp) < 0) {
+        return NULL;
+    }
+    hex = g_malloc(digest_len * 2 + 1);
+    for (size_t i = 0; i < digest_len; i++) {
+        sprintf(hex + i * 2, "%02x", digest[i]);
+    }
+    g_free(digest);
+    return hex;
+}
