+
+void chip8_apply_ticks(CPUArchState *env, uint32_t count, bool manual)
+{
+    uint32_t n;
+    for (n = 0; n < count; n++) {
+        if (env->delay_timer) {
+            env->delay_timer--;
+        }
+        if (env->sound_timer) {
+            env->sound_timer--;
+        }
+    }
+    if (manual) {
+        env->manual_ticks += count;
+    } else {
+        env->virtual_ticks += count;
+    }
+    env->state_generation++;
+}
+
+static void chip8_set_keys_command(Object *obj, const char *value,
+                                   Error **errp)
+{
+    Chip8CPU *cpu = CHIP8_CPU(obj);
+    char *end;
+    unsigned long mask, generation;
+    if (runstate_is_running()) {
+        error_setg(errp, "CHIP-8 key updates require a stopped VM");
+        return;
+    }
+    errno = 0;
+    mask = strtoul(value, &end, 10);
+    if (errno || end == value || *end != ':') {
+        error_setg(errp, "Malformed CHIP-8 set-keys command");
+        return;
+    }
+    value = end + 1;
+    errno = 0;
+    generation = strtoul(value, &end, 10);
+    if (errno || end == value || *end || mask > 0xffff ||
+        generation != cpu->env.state_generation ||
+        cpu->env.state_generation == UINT64_MAX) {
+        error_setg(errp, "CHIP-8 key update generation or mask mismatch");
+        return;
+    }
+    cpu->env.key_mask = mask;
+    cpu->env.key_wait_stop_owned = false;
+    cpu->env.state_generation++;
+}
+
+static void chip8_debug_ticks_command(Object *obj, const char *value,
+                                      Error **errp)
+{
+    Chip8CPU *cpu = CHIP8_CPU(obj);
+    char *end;
+    unsigned long count, generation;
+    if (runstate_is_running()) {
+        error_setg(errp, "CHIP-8 manual ticks require a stopped VM");
+        return;
+    }
+    errno = 0;
+    count = strtoul(value, &end, 10);
+    if (errno || end == value || *end != ':') {
+        error_setg(errp, "Malformed CHIP-8 debug-ticks command");
+        return;
+    }
+    value = end + 1;
+    errno = 0;
+    generation = strtoul(value, &end, 10);
+    if (errno || end == value || *end || count < 1 || count > 65535 ||
+        generation != cpu->env.state_generation ||
+        count > UINT64_MAX - cpu->env.manual_ticks ||
+        cpu->env.state_generation == UINT64_MAX) {
+        error_setg(errp, "CHIP-8 manual tick generation or count mismatch");
+        return;
+    }
+    chip8_apply_ticks(&cpu->env, count, true);
+    cpu->env.key_wait_stop_owned = false;
+}
+
+static void chip8_tick_apply_cpu(CPUState *cs, run_on_cpu_data data)
+{
+    Chip8CPU *cpu = CHIP8_CPU(cs);
+    uint64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint64_t deadline = cpu->env.next_deadline_ns;
+    uint32_t due = 0;
+    do {
+        uint64_t interval;
+        if (cpu->env.phase_numerator >= 20) {
+            cpu->env.phase_numerator -= 20;
+            interval = 16666667;
+        } else {
+            cpu->env.phase_numerator += 40;
+            interval = 16666666;
+        }
+        if (deadline > INT64_MAX - interval) {
+            deadline = INT64_MAX;
+            break;
+        }
+        deadline += interval;
+        due++;
+    } while (deadline <= now && due < 1000000);
+    if (due) {
+        chip8_apply_ticks(&cpu->env, due, false);
+    }
+    cpu->env.next_deadline_ns = deadline;
+}
+
+static void chip8_tick_timer_cb(void *opaque)
+{
+    Chip8CPU *cpu = opaque;
+    CPUState *cs = CPU(cpu);
+    run_on_cpu(cs, chip8_tick_apply_cpu, RUN_ON_CPU_NULL);
+    timer_mod_ns(cpu->tick_timer, cpu->env.next_deadline_ns);
+}
+
+static void chip8_cpu_exec_enter(CPUState *cs)
+{
+    CHIP8_CPU(cs)->env.key_wait_stop_owned = false;
 }
 
