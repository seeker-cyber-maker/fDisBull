+static Chip8EnvironmentInfo *chip8_environment(Error **errp)
+{
+    CPUState *cs = qemu_get_cpu(0);
+    Object *obj;
+    Error *local_err = NULL;
+    Chip8EnvironmentInfo *info;
+    if (!cs) {
+        error_setg(errp, "CHIP-8 CPU is unavailable");
+        return NULL;
+    }
+    if (runstate_is_running()) {
+        error_setg(errp, "CHIP-8 environment query requires a stopped VM");
+        return NULL;
+    }
+    obj = OBJECT(cs);
+    info = g_new0(Chip8EnvironmentInfo, 1);
+#define GET_STR(field, prop) do { \
+    info->field = object_property_get_str(obj, prop, &local_err); \
+    if (local_err) goto fail; \
+} while (0)
+#define GET_U64(field, prop) do { \
+    info->field = object_property_get_uint(obj, prop, &local_err); \
+    if (local_err) goto fail; \
+} while (0)
+#define GET_U32(field, prop) do { \
+    info->field = object_property_get_uint(obj, prop, &local_err); \
+    if (local_err) goto fail; \
+} while (0)
+#define GET_BOOL(field, prop) do { \
+    info->field = object_property_get_bool(obj, prop, &local_err); \
+    if (local_err) goto fail; \
+} while (0)
+    GET_STR(profile, "chip8-profile");
+    GET_STR(cpu_subset, "chip8-device-subset");
+    GET_STR(env_model, "chip8-env-model");
+    info->width = 64;
+    info->height = 32;
+    GET_STR(pixels_hex, "display-pixels-hex");
+    GET_STR(pixels_sha256, "display-pixels-sha256");
+    GET_U64(frame_generation, "frame-generation");
+    GET_U32(key_mask, "key-mask");
+    GET_BOOL(key_wait, "key-wait");
+    GET_BOOL(key_wait_stop_owned, "key-wait-stop-owned");
+    GET_U32(delay_timer, "delay-timer");
+    GET_U32(sound_timer, "sound-timer");
+    GET_BOOL(sound_active, "sound-active");
+    GET_U64(virtual_ticks, "virtual-ticks");
+    GET_U64(manual_ticks, "manual-ticks");
+    GET_U32(phase_numerator, "phase-numerator");
+    info->virtual_now_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    GET_U64(next_deadline_ns, "next-deadline-ns");
+    GET_U64(state_generation, "state-generation");
+#undef GET_STR
+#undef GET_U64
+#undef GET_U32
+#undef GET_BOOL
+    return info;
+fail:
+    error_propagate(errp, local_err);
+    qapi_free_Chip8EnvironmentInfo(info);
+    return NULL;
+}
+
+Chip8EnvironmentInfo *qmp_query_chip8_environment(Error **errp)
+{
+    return chip8_environment(errp);
+}
+
+Chip8EnvironmentInfo *qmp_x_chip8_set_keys(uint16_t key_mask,
+                                            uint64_t expected_generation,
+                                            Error **errp)
+{
+    CPUState *cs = qemu_get_cpu(0);
+    Error *local_err = NULL;
+    char *cmd;
+    if (!cs) {
+        error_setg(errp, "CHIP-8 CPU is unavailable");
+        return NULL;
+    }
+    cmd = g_strdup_printf("%u:%" PRIu64, key_mask, expected_generation);
+    object_property_set_str(OBJECT(cs), "set-keys-command", cmd, &local_err);
+    g_free(cmd);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        return NULL;
+    }
+    return chip8_environment(errp);
+}
+
+Chip8EnvironmentInfo *qmp_x_chip8_debug_ticks(uint32_t count,
+                                               uint64_t expected_generation,
+                                               Error **errp)
+{
+    CPUState *cs = qemu_get_cpu(0);
+    Error *local_err = NULL;
+    char *cmd;
+    if (!cs) {
+        error_setg(errp, "CHIP-8 CPU is unavailable");
+        return NULL;
+    }
+    cmd = g_strdup_printf("%u:%" PRIu64, count, expected_generation);
+    object_property_set_str(OBJECT(cs), "debug-ticks-command", cmd,
+                            &local_err);
+    g_free(cmd);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        return NULL;
+    }
+    return chip8_environment(errp);
+}
