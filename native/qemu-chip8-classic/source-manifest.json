    "added_instructions": [
      "Bnnn",
      "Cxkk",
      "Fx1e",
      "Fx33"
    ],
    "Bnnn": "PC = nnn + V0 without 12-bit wrapping; odd and out-of-RAM destinations preserve existing sticky fault behavior on attempted fetch",
    "Cxkk": "state = (1664525*state + 1013904223) mod 2^32; Vx = (state >> 24) & kk; consumes a draw for kk=0; VF is preserved unless x=F",
    "Fx1e": "I = (I + Vx) mod 2^16; reads Vx before updating I; does not modify VF",
    "Fx33": "Preflight a three-byte extent, then write hundreds/tens/ones; leaves Vx, VF, and I unchanged",
    "rng_model": "fdisbull-lcg32-high8-v1",
    "rng_qmp_command": "x-chip8-seed-rng(seed:uint32,expected-generation:uint64), stopped CAS returning full environment",
    "rng_seed_effect": "Sets seed and state to seed, clears draw count, increments state generation once, clears only ephemeral key-wait-stop attribution",
    "vmstate": "Version 3/minimum 3, same-binary only; includes RNG seed/state/draw count"
