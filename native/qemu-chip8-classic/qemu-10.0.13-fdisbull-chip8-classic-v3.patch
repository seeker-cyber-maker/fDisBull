+Chip8EnvironmentInfo *qmp_x_chip8_seed_rng(uint32_t seed,
+                                           uint64_t expected_generation,
+                                           Error **errp)
+{
+    CPUState *cs = qemu_get_cpu(0);
+    Error *local_err = NULL;
+    char *cmd;
+    if (!cs) {
+        error_setg(errp, "CHIP-8 CPU is unavailable");
+        return NULL;
+    }
+    cmd = g_strdup_printf("%u:%" PRIu64, seed, expected_generation);
+    object_property_set_str(OBJECT(cs), "seed-rng-command", cmd, &local_err);
+    g_free(cmd);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        return NULL;
+    }
+    return chip8_environment(errp);
+}
