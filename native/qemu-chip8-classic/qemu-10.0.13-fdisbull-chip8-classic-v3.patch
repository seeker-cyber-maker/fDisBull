+static inline void chip8_counter_add_saturating(uint64_t *value,
+                                                uint64_t amount)
+{
+    if (UINT64_MAX - *value < amount) {
+        *value = UINT64_MAX;
+    } else {
+        *value += amount;
+    }
+}
+
+static inline void chip8_state_generation_advance(CPUArchState *env)
+{
+    chip8_counter_add_saturating(&env->state_generation, 1);
+}
