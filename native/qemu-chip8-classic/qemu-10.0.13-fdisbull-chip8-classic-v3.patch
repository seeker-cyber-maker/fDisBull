+static void chip8_seed_rng_command(Object *obj, const char *value,
+                                   Error **errp)
+{
+    Chip8CPU *cpu = CHIP8_CPU(obj);
+    char *end;
+    unsigned long seed, generation;
+    if (runstate_is_running()) {
+        error_setg(errp, "CHIP-8 RNG seeding requires a stopped VM");
+        return;
+    }
+    errno = 0;
+    seed = strtoul(value, &end, 10);
+    if (errno || end == value || *end != ':') {
+        error_setg(errp, "Malformed CHIP-8 RNG seed command");
+        return;
+    }
+    value = end + 1;
+    errno = 0;
+    generation = strtoul(value, &end, 10);
+    if (errno || end == value || *end || seed > UINT32_MAX ||
+        generation != cpu->env.state_generation ||
+        cpu->env.state_generation == UINT64_MAX) {
+        error_setg(errp, "CHIP-8 RNG seed generation or seed mismatch");
+        return;
+    }
+    cpu->env.rng_seed = seed;
+    cpu->env.rng_state = seed;
+    cpu->env.rng_draws = 0;
+    cpu->env.key_wait_stop_owned = false;
+    chip8_state_generation_advance(&cpu->env);
+}
