+static unsigned task_pic_collect_outstanding(TaskPicOutstandingRef *refs,
+                                             unsigned capacity)
+{
+    unsigned count = 0;
+    for (unsigned ti = 0; ti < TASK_MAX; ti++) {
+        TaskState *task = &tasks[ti];
+        if (!task->used || !task->cpu_bound) {
+            continue;
+        }
+        for (unsigned fi = 0; fi < task->frame_depth; fi++) {
+            TaskFrameState *frame = &task->frames[fi];
+            if (!frame->pic_irq_valid ||
+                frame->pic_seen_eoi_mask == frame->pic_required_eoi_mask) {
+                continue;
+            }
+            if (count < capacity) {
+                refs[count] = (TaskPicOutstandingRef) { ti, frame };
+            }
+            count++;
+        }
+    }
+    /* Frame sequences and acknowledgement sequences are both monotone, but
+     * sort explicitly because a task can resume a completed frame while a
+     * later hardware IRQ is accepted in another native frame. */
+    unsigned bounded = MIN(count, capacity);
+    for (unsigned i = 1; i < bounded; i++) {
+        TaskPicOutstandingRef value = refs[i];
+        unsigned j = i;
+        while (j && refs[j - 1].frame->pic_ack_sequence >
+                    value.frame->pic_ack_sequence) {
+            refs[j] = refs[j - 1];
+            j--;
+        }
+        refs[j] = value;
+    }
+    return count;
