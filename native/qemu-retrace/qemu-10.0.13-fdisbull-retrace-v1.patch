diff --git a/qapi/fdisbull-retrace.json b/qapi/fdisbull-retrace.json
new file mode 100644
--- /dev/null
+++ b/qapi/fdisbull-retrace.json
@@ -0,0 +1,125 @@
+# Experimental opt-in fDisBull precise VGA model observation, API/model 1.
+{ 'include': 'run-state.json' }
+
+##
+# @FdisbullRetraceRaw:
+#
+# Registers defining the selected QEMU retrace model and VBE eligibility.
+# These are stored register values, not values read through guest I/O ports.
+#
+# @msr: Miscellaneous output register.
+# @sr1: Effective sequencer clock-mode register; sr_vbe[1] in VBE mode.
+# @cr00: Horizontal total register.
+# @cr04: Horizontal retrace start register.
+# @cr05: Horizontal retrace end and skew register.
+# @cr06: Vertical total register.
+# @cr07: CRTC overflow register.
+# @cr10: Vertical retrace start register.
+# @cr11: Vertical retrace end register.
+# @vbe-enable: Bochs VBE enable register; enabled VBE has no supported phase.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullRetraceRaw',
+  'data': { 'msr': 'uint8', 'sr1': 'uint8', 'cr00': 'uint8',
+            'cr04': 'uint8', 'cr05': 'uint8', 'cr06': 'uint8',
+            'cr07': 'uint8', 'cr10': 'uint8', 'cr11': 'uint8',
+            'vbe-enable': 'uint16' } }
+
+##
+# @FdisbullRetraceTiming:
+#
+# Exact cached parameters used by QEMU's selected precise retrace model.
+# The entire tuple is zero before initialization.  Initialized model 1 uses
+# the existing integer formulas, including their approximations and inclusive
+# endpoints; it does not implement a physical VGA raster model.
+#
+# @ticks-per-char: Integer virtual nanoseconds per modeled character.
+# @total-chars: Modeled characters per complete timing period.
+# @htotal: Modeled characters per line.
+# @hstart: Inclusive horizontal retrace start character.
+# @hend: Inclusive horizontal retrace end character.
+# @vstart: Inclusive vertical retrace start line.
+# @vend: Inclusive vertical retrace end line.
+# @freq: Native frequency override; zero in model 1.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullRetraceTiming',
+  'data': { 'ticks-per-char': 'int', 'total-chars': 'int', 'htotal': 'int',
+            'hstart': 'int', 'hend': 'int', 'vstart': 'int',
+            'vend': 'int', 'freq': 'int' } }
+
+##
+# @FdisbullRetracePhase:
+#
+# Pure calculation at the returned QEMU_CLOCK_VIRTUAL timestamp.  This is a
+# modeled retrace phase, not all of VBlank, visible scanout or guest completion.
+#
+# @period-ns: ticks-per-char multiplied by total-chars.
+# @phase-ns: Virtual timestamp modulo period-ns.
+# @character: phase-ns divided by ticks-per-char, rounded down.
+# @line: character divided by htotal, rounded down.
+# @line-character: character modulo htotal.
+# @vertical-retrace: vstart <= line <= vend.
+# @horizontal-retrace: hstart <= line-character <= hend.
+# @status1-timing-bits: Native status bits 3 and 0 only.  Bit 3 is vertical
+#     retrace; bit 0 is set during vertical or horizontal retrace.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullRetracePhase',
+  'data': { 'period-ns': 'int', 'phase-ns': 'int', 'character': 'int',
+            'line': 'int', 'line-character': 'int',
+            'vertical-retrace': 'bool', 'horizontal-retrace': 'bool',
+            'status1-timing-bits': 'uint8' } }
+
+##
+# @FdisbullRetraceInfo:
+#
+# @api-version: Private observation protocol version, one.
+# @model: qemu-vga-precise-fdisbull-v1.
+# @epoch: Native virtual-clock epoch.
+# @virtual-ns: Actual stopped QEMU_CLOCK_VIRTUAL timestamp.
+# @device: Exact canonical QOM path of the pinned primary VGA device.
+# @device-type: Exact type name, VGA.
+# @console: Console index, zero.
+# @head: Display head, zero.
+# @timing-generation: Monotone identity for changes to the returned raw or
+#     cached timing tuple and initialization/eligibility.  Write-time tracking
+#     detects A-to-B-to-A changes even without intervening queries.
+# @phase-supported: Whether the current initialized model has a supported phase.
+# @raw: Current stored timing registers and VBE eligibility.
+# @timing: Current cached native model parameters.
+# @unsupported-reason: Present only without phase support: uninitialized,
+#     vbe-enabled or invalid-timing, in that precedence order.
+# @phase: Present only when phase-supported is true.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullRetraceInfo',
+  'data': { 'api-version': 'int', 'model': 'str', 'epoch': 'uint64',
+            'virtual-ns': 'int', 'device': 'str', 'device-type': 'str',
+            'console': 'int', 'head': 'int', 'timing-generation': 'uint64',
+            'phase-supported': 'bool', 'raw': 'FdisbullRetraceRaw',
+            'timing': 'FdisbullRetraceTiming', '*unsupported-reason': 'str',
+            '*phase': 'FdisbullRetracePhase' } }
+
+##
+# @x-fdisbull-query-retrace:
+#
+# Observe the explicitly selected precise VGA model without rendering,
+# advancing time, executing guest instructions or reading guest I/O ports.
+# Requires native clock API 1, one stopped vCPU, and exactly one primary VGA
+# device with x-fdisbull-retrace=on and retrace=precise.  First successful
+# admission pins the device and blocks migration for the process lifetime.
+#
+# VBE and zero/wrapped timing are valid unsupported results.  Unsupported
+# property/model, reset/epoch change, cache incoherence and generation overflow
+# are errors.  No timing synchronization, edge wait or guest-frame boundary is
+# provided by this command.
+#
+# Returns: A model-versioned retrace observation.
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-query-retrace', 'returns': 'FdisbullRetraceInfo' }
