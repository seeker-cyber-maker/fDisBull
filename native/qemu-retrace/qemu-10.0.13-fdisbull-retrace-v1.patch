@@ -0,0 +1,138 @@
+/*
+ * Passive opt-in fDisBull precise VGA model observation, protocol version 1.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * BQL serializes admission and reads.  This command never starts a renderer,
+ * timer or CPU and never performs a guest I/O read.  Device pinning and a
+ * process-lifetime migration blocker protect the returned identity.
+ */
+#include "qemu/osdep.h"
+#include "hw/core/cpu.h"
+#include "hw/display/vga.h"
+#include "hw/qdev-core.h"
+#include "migration/blocker.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-fdisbull-retrace.h"
+#include "qapi/qapi-commands-run-state.h"
+#include "qemu/main-loop.h"
+#include "system/reset.h"
+
+static struct {
+    bool invalidated;
+    uint64_t epoch;
+    Object *device;
+    char *device_path;
+    Error *migration_blocker;
+} retrace_owner;
+
+typedef struct PrimaryVGASearch {
+    unsigned count;
+    Object *device;
+} PrimaryVGASearch;
+
+static int retrace_find_primary(Object *obj, void *opaque)
+{
+    PrimaryVGASearch *search = opaque;
+
+    if (!strcmp(object_get_typename(obj), "VGA") &&
+        qdev_is_realized(DEVICE(obj))) {
+        search->count++;
+        search->device = obj;
+    }
+    return 0;
+}
+
+static void retrace_reset(void *opaque)
+{
+    assert(bql_locked());
+    retrace_owner.invalidated = true;
+}
+
+static bool retrace_guard(FdisbullClockInfo *clock, Error **errp)
+{
+    CPUState *cpu;
+
+    if (retrace_owner.invalidated ||
+        (retrace_owner.device && retrace_owner.epoch != clock->epoch)) {
+        error_setg(errp, "Retrace observation epoch invalidated; close the VM");
+        return false;
+    }
+    if (clock->api_version != 1 || !clock->budget_supported ||
+        clock->virtual_ns < 0 ||
+        clock->running || clock->pending_stop ||
+        (clock->status != RUN_STATE_PRELAUNCH &&
+         clock->status != RUN_STATE_PAUSED && clock->status != RUN_STATE_DEBUG) ||
+        clock->budget_state == FDISBULL_CLOCK_BUDGET_STATE_ARMED ||
+        clock->budget_state == FDISBULL_CLOCK_BUDGET_STATE_FIRED) {
+        error_setg(errp, "Retrace observation requires a valid stopped native "
+                   "clock API 1 epoch");
+        return false;
+    }
+    CPU_FOREACH(cpu) {
+        if (!cpu->stopped) {
+            error_setg(errp, "Retrace observation requires one stopped vCPU");
+            return false;
+        }
+    }
+    return true;
+}
+
+FdisbullRetraceInfo *qmp_x_fdisbull_query_retrace(Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    g_autoptr(FdisbullRetraceInfo) info = NULL;
+    g_autofree char *path = NULL;
+    PrimaryVGASearch search = { 0 };
+
+    assert(bql_locked());
+    clock = qmp_x_fdisbull_query_clock(errp);
+    if (!clock || !retrace_guard(clock, errp)) {
+        return NULL;
+    }
+    object_child_foreach_recursive(object_get_root(),
+                                   retrace_find_primary, &search);
+    if (search.count != 1) {
+        if (retrace_owner.device) {
+            retrace_owner.invalidated = true;
+        }
+        error_setg(errp, "Retrace observation requires exactly one primary VGA");
+        return NULL;
+    }
+    path = object_get_canonical_path(search.device);
+    if (!path || (retrace_owner.device &&
+        (retrace_owner.device != search.device ||
+         strcmp(retrace_owner.device_path, path)))) {
+        retrace_owner.invalidated = true;
+        error_setg(errp, "Retrace observation device identity changed; close VM");
+        return NULL;
+    }
+    info = g_new0(FdisbullRetraceInfo, 1);
+    if (!pci_std_vga_fdisbull_retrace_query(search.device, clock->virtual_ns,
+                                           info, errp)) {
+        if (retrace_owner.device) {
+            retrace_owner.invalidated = true;
+        }
+        return NULL;
+    }
+    if (!retrace_owner.migration_blocker) {
+        error_setg(&retrace_owner.migration_blocker,
+                   "fDisBull precise retrace ownership does not support migration");
+        if (migrate_add_blocker(&retrace_owner.migration_blocker, errp) < 0) {
+            return NULL;
+        }
+    }
+    if (!retrace_owner.device) {
+        object_ref(search.device);
+        retrace_owner.device = search.device;
+        retrace_owner.device_path = g_strdup(path);
+        retrace_owner.epoch = clock->epoch;
+        qemu_register_reset(retrace_reset, NULL);
+    }
+    info->api_version = 1;
+    info->model = g_strdup("qemu-vga-precise-fdisbull-v1");
+    info->epoch = clock->epoch;
+    info->virtual_ns = clock->virtual_ns;
+    info->device = g_steal_pointer(&path);
+    info->device_type = g_strdup("VGA");
+    return g_steal_pointer(&info);
+}
