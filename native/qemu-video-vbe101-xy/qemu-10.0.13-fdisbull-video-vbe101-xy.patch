+/* The optional paired port reports the programmed position to the BIOS.
+ * Neither the live scanout nor its pending latches enter the I/O payload. */
+static uint32_t vbe_fdisbull_xy_read(void *opaque, uint32_t addr)
+{
+    VGACommonState *s = opaque;
+
+    if (!vga_fdisbull_vbe101_sync(s)) {
+        return UINT32_MAX;
+    }
+    return (uint32_t)s->vbe_regs[VBE_DISPI_INDEX_Y_OFFSET] << 16 |
+           s->vbe_regs[VBE_DISPI_INDEX_X_OFFSET];
+}
+
+static void vbe_fdisbull_xy_write(void *opaque, uint32_t addr, uint32_t value)
+{
+    VGACommonState *s = opaque;
+    const unsigned x = value & UINT16_MAX;
+    const unsigned y = value >> 16;
+    const unsigned pitch = s->vbe_line_offset;
+    const uint64_t start = (uint64_t)y * pitch + x;
+    FdisbullRetraceBefore before = { 0 };
+
+    assert(bql_locked());
+    if (!vga_fdisbull_vbe101_sync(s) ||
+        x + FDISBULL_VIDEO_WIDE_WIDTH > pitch || y > VBE_DISPI_MAX_YRES ||
+        start + (uint64_t)FDISBULL_VIDEO_WIDE_HEIGHT * pitch >
+            MIN(s->vram_size, s->vbe_size)) {
+        return;
+    }
+
+    /* Validate the entire position before altering raw or pending state.
+     * Both coordinates share this guest I/O boundary and one census. */
+    vga_fdisbull_retrace_before(s, &before);
+    s->vbe_regs[VBE_DISPI_INDEX_X_OFFSET] = x;
+    s->vbe_regs[VBE_DISPI_INDEX_Y_OFFSET] = y;
+    vbe_fixup_regs(s);
+    vbe_update_vgaregs(s);
+    vga_fdisbull_retrace_after(s, &before);
     vga_fdisbull_configuration_commit(s, false);
 }

