@@ -149,6 +149,25 @@
     irq_disable();
 }

+#define FDISBULL_XY_INDEX 0xf2
+#define FDISBULL_XY_ID 0xfb02
+#define FDISBULL_XY_PORT 0x01d4
+
+int
+bochsvga_fdisbull_xy_available(void)
+{
+    return bochsvga_dispi_enabled() && dispi_read(FDISBULL_XY_INDEX) == FDISBULL_XY_ID;
+}
+
+int
+bochsvga_fdisbull_set_xy(u16 x, u16 y)
+{
+    u32 pair = ((u32)y << 16) | x;
+
+    outl(pair, FDISBULL_XY_PORT);
+    return inl(FDISBULL_XY_PORT) == pair ? 0 : -1;
+}
+
 int
