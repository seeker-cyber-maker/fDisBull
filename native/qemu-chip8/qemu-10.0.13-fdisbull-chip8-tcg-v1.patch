+#include "qemu/osdep.h"
+#include "gdbstub/helpers.h"
+#include "cpu.h"
+
+int chip8_cpu_gdb_read_register(CPUState *cs, GByteArray *buf, int reg)
+{
+    CPUArchState *env = cpu_env(cs);
+    if (reg < 16) {
+        return gdb_get_reg8(buf, env->v[reg]);
+    }
+    if (reg == 16) {
+        return gdb_get_reg16(buf, env->i & 0xffff);
+    }
+    if (reg == 17) {
+        return gdb_get_reg16(buf, env->pc & 0xffff);
+    }
+    if (reg == 18) {
+        return gdb_get_reg8(buf, env->sp & 0xff);
+    }
+    if (reg >= 19 && reg < 19 + CHIP8_STACK_SIZE) {
+        unsigned index = reg - 19;
+        return gdb_get_reg16(buf, index < env->sp ? env->stack[index] : 0);
+    }
+    return 0;
+}
+
+int chip8_cpu_gdb_write_register(CPUState *cs, uint8_t *buf, int reg)
+{
+    CPUArchState *env = cpu_env(cs);
+    if (reg < 16) {
+        env->v[reg] = buf[0];
+        return 1;
+    }
+    if (reg == 16) {
+        env->i = lduw_le_p(buf);
+        return 2;
+    }
+    if (reg == 17) {
+        env->pc = lduw_le_p(buf);
+        return 2;
+    }
+    if (reg == 18) {
+        if (buf[0] > CHIP8_STACK_SIZE) {
+            return 0;
+        }
+        if (buf[0] < env->sp) {
+            memset(&env->stack[buf[0]], 0,
+                   (env->sp - buf[0]) * sizeof(env->stack[0]));
+        }
+        env->sp = buf[0];
+        return 1;
+    }
+    if (reg >= 19 && reg < 19 + CHIP8_STACK_SIZE) {
+        unsigned index = reg - 19;
+        uint16_t value = lduw_le_p(buf);
+        if (index >= env->sp && value) {
+            return 0;
+        }
+        env->stack[index] = value;
+        return 2;
+    }
+    return 0;
+}
