+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "hw/boards.h"
+#include "hw/loader.h"
+#include "hw/qdev-core.h"
+#include "system/reset.h"
+#include "exec/address-spaces.h"
+#include "target/chip8/cpu-qom.h"
+#include "target/chip8/cpu.h"
+
+#define TYPE_CHIP8_TEST_MACHINE MACHINE_TYPE_NAME("chip8-test")
+OBJECT_DECLARE_SIMPLE_TYPE(Chip8TestMachineState, CHIP8_TEST_MACHINE)
+
+struct Chip8TestMachineState {
+    MachineState parent_obj;
+};
+
+static ram_addr_t chip8_fixup_ram_size(ram_addr_t size)
+{
+    /* CHIP-8 memory is a fixed 4 KiB address space. */
+    return CHIP8_RAM_SIZE;
+}
+
+static void chip8_test_init(MachineState *machine)
+{
+    MachineClass *mc = MACHINE_GET_CLASS(machine);
+    CPUState *cs;
+    ssize_t size;
+
+    if (machine->ram_size != CHIP8_RAM_SIZE) {
+        error_report("CHIP-8 test machine requires exactly 4096 bytes of RAM");
+        exit(1);
+    }
+    memory_region_add_subregion(get_system_memory(), 0, machine->ram);
+    cs = cpu_create(mc->default_cpu_type);
+    if (!machine->kernel_filename) {
+        error_report("CHIP-8 test machine requires a raw ROM via -kernel");
+        exit(1);
+    }
+    size = load_image_targphys(machine->kernel_filename, CHIP8_ROM_BASE,
+                               CHIP8_RAM_SIZE - CHIP8_ROM_BASE);
+    if (size < 2) {
+        error_report("CHIP-8 ROM must contain at least one 16-bit instruction");
+        exit(1);
+    }
+    CHIP8_CPU(cs)->env.pc = CHIP8_ROM_BASE;
+}
+
+static void chip8_test_class_init(ObjectClass *oc, void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    mc->desc = "Bounded classic CHIP-8 CPU smoke machine";
+    mc->init = chip8_test_init;
+    mc->default_cpu_type = TYPE_CHIP8_CPU;
+    mc->default_ram_size = CHIP8_RAM_SIZE;
+    mc->default_ram_id = "chip8.ram";
+    mc->fixup_ram_size = chip8_fixup_ram_size;
+    mc->no_cdrom = true;
+    mc->no_floppy = true;
+    mc->no_parallel = true;
+}
+
+static const TypeInfo chip8_test_type = {
+    .name = TYPE_CHIP8_TEST_MACHINE,
+    .parent = TYPE_MACHINE,
+    .instance_size = sizeof(Chip8TestMachineState),
+    .class_init = chip8_test_class_init,
+};
+
+static void chip8_test_register_types(void)
+{
+    type_register_static(&chip8_test_type);
+}
+
+type_init(chip8_test_register_types)
