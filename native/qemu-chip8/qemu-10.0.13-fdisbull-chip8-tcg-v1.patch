+/* Generic QMP bridge to read-only CHIP-8 CPU QOM properties. */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-misc.h"
+#include "hw/core/cpu.h"
+#include "qom/object.h"
+
+Chip8FaultInfo *qmp_query_chip8_fault(Error **errp)
+{
+    CPUState *cs = qemu_get_cpu(0);
+    Object *obj;
+    Error *local_err = NULL;
+    Chip8FaultInfo *info;
+
+    if (!cs) {
+        error_setg(errp, "CHIP-8 CPU is unavailable");
+        return NULL;
+    }
+    obj = OBJECT(cs);
+    info = g_new0(Chip8FaultInfo, 1);
+    info->profile = object_property_get_str(obj, "chip8-profile", &local_err);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        qapi_free_Chip8FaultInfo(info);
+        return NULL;
+    }
+    info->cpu_subset = object_property_get_str(obj, "cpu-subset", &local_err);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        qapi_free_Chip8FaultInfo(info);
+        return NULL;
+    }
+    info->faulted = object_property_get_bool(obj, "faulted", &local_err);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        qapi_free_Chip8FaultInfo(info);
+        return NULL;
+    }
+    info->fault_code = object_property_get_uint(obj, "fault-code", &local_err);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        qapi_free_Chip8FaultInfo(info);
+        return NULL;
+    }
+    info->fault_pc = object_property_get_uint(obj, "fault-pc", &local_err);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        qapi_free_Chip8FaultInfo(info);
+        return NULL;
+    }
+    info->fault_opcode = object_property_get_uint(obj, "fault-opcode", &local_err);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        qapi_free_Chip8FaultInfo(info);
+        return NULL;
+    }
+    return info;
+}
