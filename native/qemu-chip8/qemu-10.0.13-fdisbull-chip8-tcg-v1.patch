+#include "qemu/osdep.h"
+#include "tcg/tcg.h"
+#include "cpu.h"
+#include "exec/translator.h"
+#include "exec/helper-gen.h"
+#include "exec/helper-proto.h"
+#include "tcg/tcg-op.h"
+
+#define HELPER_H "helper.h"
+#include "exec/helper-info.c.inc"
+#undef HELPER_H
+
+typedef struct DisasContext {
+    DisasContextBase base;
+    CPUArchState *env;
+} DisasContext;
+
+static void chip8_tb_start(DisasContextBase *db, CPUState *cs)
+{
+    /* This target has no per-TB architectural state to initialize. */
+}
+
+static void chip8_init_disas_context(DisasContextBase *db, CPUState *cs)
+{
+    DisasContext *ctx = container_of(db, DisasContext, base);
+    ctx->env = cpu_env(cs);
+}
+
+static void chip8_insn_start(DisasContextBase *db, CPUState *cs)
+{
+    tcg_gen_insn_start(db->pc_next);
+}
+
+static void chip8_translate_insn(DisasContextBase *db, CPUState *cs)
+{
+    DisasContext *ctx = container_of(db, DisasContext, base);
+    uint32_t pc = db->pc_next;
+    uint16_t opcode;
+
+    if (pc & 1) {
+        gen_helper_chip8_fault(tcg_env, tcg_constant_i32(pc),
+                               tcg_constant_i32(0),
+                               tcg_constant_i32(CHIP8_FAULT_ODD_PC));
+    } else if (pc + 1 >= CHIP8_RAM_SIZE) {
+        gen_helper_chip8_fault(tcg_env, tcg_constant_i32(pc),
+                               tcg_constant_i32(0),
+                               tcg_constant_i32(CHIP8_FAULT_FETCH_OOB));
+    } else {
+        opcode = translator_lduw_swap(ctx->env, db, pc, true);
+        gen_helper_chip8_step(tcg_env, tcg_constant_i32(pc),
+                              tcg_constant_i32(opcode));
+    }
+    db->pc_next = pc + 2;
+    db->is_jmp = DISAS_TOO_MANY;
+}
+
+static void chip8_tb_stop(DisasContextBase *db, CPUState *cs)
+{
+    /* Every translated instruction returns to the outer CPU loop. */
+    tcg_gen_exit_tb(NULL, 0);
+}
+
+static const TranslatorOps chip8_translator_ops = {
+    .init_disas_context = chip8_init_disas_context,
+    .tb_start = chip8_tb_start,
+    .insn_start = chip8_insn_start,
+    .translate_insn = chip8_translate_insn,
+    .tb_stop = chip8_tb_stop,
+};
+
+void chip8_tcg_init(void)
+{
+}
+
+void chip8_cpu_translate_code(CPUState *cs, TranslationBlock *tb,
+                              int *max_insns, vaddr pc, void *host_pc)
+{
+    DisasContext dc = { 0 };
+    translator_loop(cs, tb, max_insns, pc, host_pc,
+                    &chip8_translator_ops, &dc.base);
+}
