+#include "qemu/osdep.h"
+#include "migration/vmstate.h"
+#include "cpu.h"
+
+static int chip8_cpu_post_load(void *opaque, int version_id)
+{
+    Chip8CPU *cpu = opaque;
+    CPUArchState *env = &cpu->env;
+    unsigned i;
+
+    if (env->i > 0xffff || env->pc > 0xffff || env->sp > CHIP8_STACK_SIZE ||
+        env->fault_code > CHIP8_FAULT_ODD_PC ||
+        (!env->faulted && (env->fault_code || env->fault_pc ||
+                           env->fault_opcode)) ||
+        (env->faulted && (env->fault_code == CHIP8_FAULT_NONE ||
+                          env->fault_pc > 0xffff ||
+                          env->fault_opcode > 0xffff))) {
+        return -EINVAL;
+    }
+    for (i = 0; i < ARRAY_SIZE(env->v); i++) {
+        if (env->v[i] > 0xff) {
+            return -EINVAL;
+        }
+    }
+    for (i = 0; i < ARRAY_SIZE(env->stack); i++) {
+        if (env->stack[i] > 0xffff || (i >= env->sp && env->stack[i])) {
+            return -EINVAL;
+        }
+    }
+    return 0;
+}
+
+const VMStateDescription vmstate_chip8_cpu = {
+    .name = "chip8-cpu",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = chip8_cpu_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(env.v, Chip8CPU, 16),
+        VMSTATE_UINT32(env.i, Chip8CPU),
+        VMSTATE_UINT32(env.pc, Chip8CPU),
+        VMSTATE_UINT32(env.sp, Chip8CPU),
+        VMSTATE_UINT32_ARRAY(env.stack, Chip8CPU, CHIP8_STACK_SIZE),
+        VMSTATE_BOOL(env.faulted, Chip8CPU),
+        VMSTATE_UINT32(env.fault_code, Chip8CPU),
+        VMSTATE_UINT32(env.fault_pc, Chip8CPU),
+        VMSTATE_UINT32(env.fault_opcode, Chip8CPU),
+        VMSTATE_END_OF_LIST()
+    }
+};
