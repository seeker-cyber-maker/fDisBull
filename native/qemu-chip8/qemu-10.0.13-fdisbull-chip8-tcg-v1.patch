+static hwaddr chip8_get_phys_page_debug(CPUState *cs, vaddr addr)
+{
+    return addr < CHIP8_RAM_SIZE ? addr : (hwaddr)-1;
+}
+
+static bool chip8_tlb_fill(CPUState *cs, vaddr addr, int size,
+                           MMUAccessType access_type, int mmu_idx,
+                           bool probe, uintptr_t retaddr)
+{
+    if (addr >= CHIP8_RAM_SIZE || size < 1 ||
+        (vaddr)size > CHIP8_RAM_SIZE - addr) {
+        if (!probe) {
+            uint32_t fault = access_type == MMU_INST_FETCH ?
+                             CHIP8_FAULT_FETCH_OOB : CHIP8_FAULT_DATA_OOB;
+            helper_chip8_fault(cpu_env(cs), cpu_env(cs)->pc, 0, fault);
+        }
+        return false;
+    }
+    tlb_set_page(cs, 0, 0, PAGE_READ | PAGE_WRITE | PAGE_EXEC,
+                 mmu_idx, TARGET_PAGE_SIZE);
+    return true;
+}
+
+static void chip8_cpu_reset_hold(Object *obj, ResetType type)
+{
+    CPUState *cs = CPU(obj);
+    Chip8CPU *cpu = CHIP8_CPU(cs);
+    Chip8CPUClass *mcc = CHIP8_CPU_GET_CLASS(obj);
+
+    if (mcc->parent_phases.hold) {
+        mcc->parent_phases.hold(obj, type);
+    }
+    memset(&cpu->env, 0, sizeof(cpu->env));
+    cpu->env.pc = CHIP8_ROM_BASE;
+}
+
+static void chip8_cpu_realize(DeviceState *dev, Error **errp)
+{
+    CPUState *cs = CPU(dev);
+    Chip8CPUClass *mcc = CHIP8_CPU_GET_CLASS(dev);
+    Error *local_err = NULL;
+
+    cpu_exec_realizefn(cs, &local_err);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        return;
+    }
+    qemu_init_vcpu(cs);
+    cpu_reset(cs);
+    mcc->parent_realize(dev, errp);
