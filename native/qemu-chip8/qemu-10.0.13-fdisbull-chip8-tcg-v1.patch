+#include "qemu/osdep.h"
+#include "exec/exec-all.h"
+#include "exec/cpu_ldst.h"
+#include "exec/helper-proto.h"
+#include "cpu.h"
+
+static G_NORETURN void chip8_raise(CPUArchState *env, uint32_t pc,
+                                   uint32_t opcode, uint32_t code)
+{
+    CPUState *cs = env_cpu(env);
+
+    env->pc = pc;
+    env->faulted = true;
+    env->fault_code = code;
+    env->fault_pc = pc;
+    env->fault_opcode = opcode;
+    cs->exception_index = EXCP_DEBUG;
+    cpu_loop_exit(cs);
+}
+
+void helper_chip8_fault(CPUArchState *env, uint32_t pc, uint32_t opcode,
+                        uint32_t code)
+{
+    if (env->faulted) {
+        chip8_raise(env, env->fault_pc, env->fault_opcode, env->fault_code);
+    }
+    chip8_raise(env, pc, opcode, code);
+}
+
+void helper_chip8_step(CPUArchState *env, uint32_t pc, uint32_t opcode)
+{
+    uint32_t x = (opcode >> 8) & 0xf;
+    uint32_t y = (opcode >> 4) & 0xf;
+    uint32_t kk = opcode & 0xff;
+    uint32_t nnn = opcode & 0xfff;
+    uint32_t next = pc + 2;
+    uint32_t sum, a, b, count, k;
+    uint8_t temp[16];
+
+    if (env->faulted) {
+        chip8_raise(env, env->fault_pc, env->fault_opcode, env->fault_code);
+    }
+    switch (opcode >> 12) {
+    case 0x0:
+        if (opcode == 0x00ee) {
+            if (env->sp == 0) {
+                chip8_raise(env, pc, opcode, CHIP8_FAULT_STACK_UNDERFLOW);
+            }
+            if (env->sp > CHIP8_STACK_SIZE) {
+                chip8_raise(env, pc, opcode, CHIP8_FAULT_STACK_UNDERFLOW);
+            }
+            env->sp--;
+            next = env->stack[env->sp];
+            env->stack[env->sp] = 0;
+        } else {
+            chip8_raise(env, pc, opcode, CHIP8_FAULT_UNSUPPORTED);
+        }
+        break;
+    case 0x1:
+        next = nnn;
+        break;
+    case 0x2:
+        if (env->sp >= CHIP8_STACK_SIZE) {
+            chip8_raise(env, pc, opcode, CHIP8_FAULT_STACK_OVERFLOW);
+        }
+        env->stack[env->sp] = pc + 2;
+        env->sp++;
+        next = nnn;
+        break;
+    case 0x3:
+        if ((env->v[x] & 0xff) == kk) {
+            next += 2;
+        }
+        break;
+    case 0x4:
+        if ((env->v[x] & 0xff) != kk) {
+            next += 2;
+        }
+        break;
+    case 0x5:
+        if ((opcode & 0xf) != 0) {
+            chip8_raise(env, pc, opcode, CHIP8_FAULT_UNSUPPORTED);
+        }
+        if ((env->v[x] & 0xff) == (env->v[y] & 0xff)) {
+            next += 2;
+        }
+        break;
+    case 0x6:
+        env->v[x] = kk;
+        break;
+    case 0x7:
+        env->v[x] = (env->v[x] + kk) & 0xff;
+        break;
+    case 0x8:
+        a = env->v[x] & 0xff;
+        b = env->v[y] & 0xff;
+        switch (opcode & 0xf) {
+        case 0x0:
+            env->v[x] = b;
+            break;
+        case 0x1:
+            env->v[x] = a | b;
+            env->v[0xf] = 0;
+            break;
+        case 0x2:
+            env->v[x] = a & b;
+            env->v[0xf] = 0;
+            break;
+        case 0x3:
+            env->v[x] = a ^ b;
+            env->v[0xf] = 0;
+            break;
+        case 0x4:
+            sum = a + b;
+            env->v[x] = sum & 0xff;
+            env->v[0xf] = sum > 0xff;
+            break;
+        case 0x5:
+            env->v[x] = (a - b) & 0xff;
+            env->v[0xf] = a >= b;
+            break;
+        case 0x6:
+            env->v[x] = b >> 1;
+            env->v[0xf] = b & 1;
+            break;
+        case 0x7:
+            env->v[x] = (b - a) & 0xff;
+            env->v[0xf] = b >= a;
+            break;
+        case 0xe:
+            env->v[x] = (b << 1) & 0xff;
+            env->v[0xf] = (b >> 7) & 1;
+            break;
+        default:
+            chip8_raise(env, pc, opcode, CHIP8_FAULT_UNSUPPORTED);
+        }
+        break;
+    case 0x9:
+        if ((opcode & 0xf) != 0) {
+            chip8_raise(env, pc, opcode, CHIP8_FAULT_UNSUPPORTED);
+        }
+        if ((env->v[x] & 0xff) != (env->v[y] & 0xff)) {
+            next += 2;
+        }
+        break;
+    case 0xa:
+        env->i = nnn;
+        break;
+    case 0xf:
+        if (kk != 0x55 && kk != 0x65) {
+            chip8_raise(env, pc, opcode, CHIP8_FAULT_UNSUPPORTED);
+        }
+        count = x + 1;
+        if (env->i > CHIP8_RAM_SIZE || count > CHIP8_RAM_SIZE - env->i) {
+            chip8_raise(env, pc, opcode, CHIP8_FAULT_DATA_OOB);
+        }
+        if (kk == 0x55) {
+            for (k = 0; k < count; k++) {
+                temp[k] = env->v[k] & 0xff;
+            }
+            for (k = 0; k < count; k++) {
+                cpu_stb_data(env, env->i + k, temp[k]);
+            }
+        } else {
+            for (k = 0; k < count; k++) {
+                temp[k] = cpu_ldub_data(env, env->i + k);
+            }
+            for (k = 0; k < count; k++) {
+                env->v[k] = temp[k];
+            }
+        }
+        env->i += count;
+        break;
+    default:
+        chip8_raise(env, pc, opcode, CHIP8_FAULT_UNSUPPORTED);
+    }
+    env->pc = next;
+}
