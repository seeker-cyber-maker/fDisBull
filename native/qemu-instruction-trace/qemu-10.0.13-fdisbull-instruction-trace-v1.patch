@@ -0,0 +1,272 @@
+/* Bounded before-execution TCG instruction dispatch trace. */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-fdisbull-instruction-trace.h"
+#include "qemu/thread.h"
+#include "qemu/main-loop.h"
+#include "exec/tb-flush.h"
+#include "hw/core/cpu.h"
+#include "system/cpus.h"
+#include "system/runstate.h"
+#include "system/tcg.h"
+#include "system/fdisbull-instruction-trace.h"
+
+#define TRACE_MAX_CAPACITY 65536
+#define TRACE_MAX_PAGE 4096
+
+typedef struct TraceRecord {
+    uint64_t sequence;
+    uint32_t vcpu;
+    uint64_t pc;
+    FdisbullTraceOrigin origin;
+} TraceRecord;
+
+typedef struct InstructionTrace {
+    QemuMutex lock;
+    TraceRecord *records;
+    uint64_t epoch;
+    uint64_t requested;
+    uint64_t count;
+    uint32_t capacity;
+    bool active;
+    bool stop_pending;
+    char *stopped_reason;
+} InstructionTrace;
+
+static InstructionTrace trace;
+static gsize trace_initialized;
+
+static void instruction_trace_init(void)
+{
+    if (g_once_init_enter(&trace_initialized)) {
+        qemu_mutex_init(&trace.lock);
+        trace.epoch = 1;
+        g_once_init_leave(&trace_initialized, 1);
+    }
+}
+
+bool fdisbull_instruction_trace_active(void)
+{
+    bool active;
+
+    instruction_trace_init();
+    qemu_mutex_lock(&trace.lock);
+    active = trace.active;
+    qemu_mutex_unlock(&trace.lock);
+    return active;
+}
+
+bool fdisbull_instruction_trace_record(uint32_t vcpu, uint64_t pc,
+                                       FdisbullTraceOrigin origin)
+{
+    bool stop = false;
+
+    instruction_trace_init();
+    qemu_mutex_lock(&trace.lock);
+    if (trace.active) {
+        TraceRecord *record = &trace.records[trace.count % trace.capacity];
+        record->sequence = trace.count + 1;
+        record->vcpu = vcpu;
+        record->pc = pc;
+        record->origin = origin;
+        trace.count++;
+        if (trace.count == trace.requested) {
+            trace.active = false;
+            trace.stop_pending = true;
+            g_free(trace.stopped_reason);
+            trace.stopped_reason = g_strdup("instruction-count");
+            stop = true;
+        }
+    }
+    qemu_mutex_unlock(&trace.lock);
+    return stop;
+}
+
+void fdisbull_instruction_trace_handle_stop_request(void)
+{
+    instruction_trace_init();
+    assert(bql_locked());
+    qemu_mutex_lock(&trace.lock);
+    if (trace.stop_pending) {
+        trace.stop_pending = false;
+        qemu_mutex_unlock(&trace.lock);
+        if (runstate_is_running()) {
+            vm_stop(RUN_STATE_PAUSED);
+        }
+        return;
+    }
+    qemu_mutex_unlock(&trace.lock);
+}
+
+void fdisbull_instruction_trace_invalidate(const char *reason)
+{
+    instruction_trace_init();
+    qemu_mutex_lock(&trace.lock);
+    trace.active = false;
+    trace.stop_pending = false;
+    trace.count = 0;
+    if (trace.epoch != UINT64_MAX) {
+        trace.epoch++;
+    }
+    g_free(trace.stopped_reason);
+    trace.stopped_reason = g_strdup(reason ? reason : "invalidated");
+    qemu_mutex_unlock(&trace.lock);
+}
+
+static void trace_precondition(Error **errp)
+{
+    CPUState *cpu;
+    unsigned count = 0;
+
+#ifndef CONFIG_PLUGIN
+    error_setg(errp, "instruction trace requires a QEMU build with TCG plugins");
+    return;
+#endif
+    if (!tcg_enabled() || (runstate_get() != RUN_STATE_PAUSED &&
+                           runstate_get() != RUN_STATE_DEBUG &&
+                           runstate_get() != RUN_STATE_PRELAUNCH)) {
+        error_setg(errp, "instruction trace requires stopped system-mode TCG");
+        return;
+    }
+    CPU_FOREACH(cpu) {
+        count++;
+        if (count > 1 || !cpu->stopped) {
+            error_setg(errp, "instruction trace requires one stopped vCPU");
+            return;
+        }
+    }
+    if (count != 1) {
+        error_setg(errp, "instruction trace requires one stopped vCPU");
+    }
+}
+
+static FdisbullInstructionTraceInfo *trace_info(uint64_t epoch,
+                                                uint64_t after,
+                                                uint32_t max_events,
+                                                Error **errp)
+{
+    FdisbullInstructionTraceInfo *info;
+    uint64_t oldest, first, end, seq;
+
+    instruction_trace_init();
+    if (max_events == 0 || max_events > TRACE_MAX_PAGE) {
+        error_setg(errp, "max-events must be between 1 and %u", TRACE_MAX_PAGE);
+        return NULL;
+    }
+    qemu_mutex_lock(&trace.lock);
+    if (epoch != trace.epoch) {
+        qemu_mutex_unlock(&trace.lock);
+        error_setg(errp, "instruction trace epoch mismatch");
+        return NULL;
+    }
+    if (after > trace.count) {
+        qemu_mutex_unlock(&trace.lock);
+        error_setg(errp, "instruction trace cursor is ahead of the producer");
+        return NULL;
+    }
+
+    oldest = trace.count > trace.capacity ? trace.count - trace.capacity + 1 :
+                                            (trace.count ? 1 : 0);
+    first = MAX(after + 1, oldest);
+    end = MIN(trace.count + 1, first + max_events);
+    info = g_new0(FdisbullInstructionTraceInfo, 1);
+    info->epoch = trace.epoch;
+    info->instruction_count = trace.requested;
+    info->capacity = trace.capacity;
+    info->active = trace.active;
+    info->stopped_reason = g_strdup(trace.stopped_reason ? trace.stopped_reason : "none");
+    info->captured_count = trace.count;
+    info->oldest_sequence = oldest;
+    info->next_sequence = trace.count + 1;
+    info->dropped_count = trace.count > trace.capacity ? trace.count - trace.capacity : 0;
+    info->events = NULL;
+    for (seq = end; seq > first; ) {
+        seq--;
+        TraceRecord *record = &trace.records[(seq - 1) % trace.capacity];
+        FdisbullInstructionTraceEventList *node =
+            g_new0(FdisbullInstructionTraceEventList, 1);
+        node->value = g_new0(FdisbullInstructionTraceEvent, 1);
+        node->value->sequence = record->sequence;
+        node->value->vcpu = record->vcpu;
+        node->value->pc = record->pc;
+        node->value->reason = g_strdup("before-execution");
+        node->value->origin = g_strdup(
+            record->origin == FDISBULL_TRACE_BREAKPOINT_PRE_DISPATCH ?
+            "breakpoint-pre-dispatch" : "tcg-dispatch");
+        node->next = info->events;
+        info->events = node;
+    }
+    qemu_mutex_unlock(&trace.lock);
+    return info;
+}
+
+FdisbullInstructionTraceInfo *qmp_x_fdisbull_trace_start(
+    uint64_t instruction_count, Error **errp)
+{
+    trace_precondition(errp);
+    if (errp && *errp) {
+        return NULL;
+    }
+    if (instruction_count == 0 || instruction_count > UINT64_C(10000000)) {
+        error_setg(errp, "instruction-count must be between 1 and 10000000");
+        return NULL;
+    }
+    instruction_trace_init();
+    qemu_mutex_lock(&trace.lock);
+    if (trace.active || trace.stop_pending) {
+        qemu_mutex_unlock(&trace.lock);
+        error_setg(errp, "instruction trace is already active or awaiting stop");
+        return NULL;
+    }
+    if (trace.epoch == UINT64_MAX) {
+        qemu_mutex_unlock(&trace.lock);
+        error_setg(errp, "instruction trace epoch exhausted");
+        return NULL;
+    }
+    g_free(trace.records);
+    trace.capacity = MIN(instruction_count, TRACE_MAX_CAPACITY);
+    trace.records = g_new0(TraceRecord, trace.capacity);
+    trace.epoch++;
+    trace.requested = instruction_count;
+    trace.count = 0;
+    trace.active = true;
+    trace.stop_pending = false;
+    g_free(trace.stopped_reason);
+    trace.stopped_reason = g_strdup("recording");
+    qemu_mutex_unlock(&trace.lock);
+
+    tb_flush(first_cpu);
+    return trace_info(trace.epoch, 0, 1, errp);
+}
+
+FdisbullInstructionTraceInfo *qmp_x_fdisbull_trace_read(
+    uint64_t epoch, uint64_t after_sequence, uint32_t max_events,
+    Error **errp)
+{
+    return trace_info(epoch, after_sequence, max_events, errp);
+}
+
+FdisbullInstructionTraceInfo *qmp_x_fdisbull_trace_stop(
+    uint64_t epoch, uint64_t after_sequence, uint32_t max_events,
+    Error **errp)
+{
+    trace_precondition(errp);
+    if (errp && *errp) {
+        return NULL;
+    }
+    instruction_trace_init();
+    qemu_mutex_lock(&trace.lock);
+    if (epoch != trace.epoch) {
+        qemu_mutex_unlock(&trace.lock);
+        error_setg(errp, "instruction trace epoch mismatch");
+        return NULL;
+    }
+    trace.active = false;
+    if (g_strcmp0(trace.stopped_reason, "recording") == 0) {
+        g_free(trace.stopped_reason);
+        trace.stopped_reason = g_strdup("user-stop");
+    }
+    qemu_mutex_unlock(&trace.lock);
+    return trace_info(epoch, after_sequence, max_events, errp);
+}
