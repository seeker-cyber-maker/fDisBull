+##
+# Bounded TCG instruction dispatch trace.
+##
+
+##
+# @FdisbullInstructionTraceEvent:
+# One pre-instruction boundary observation. The origin distinguishes normal
+# TCG instruction dispatch from a debugger breakpoint before TB dispatch.
+# Neither origin attests instruction completion or retirement.
+#
+# @sequence: Monotonic sequence within the current producer epoch.
+# @vcpu: vCPU index.
+# @pc: Guest virtual instruction address.
+# @origin: tcg-dispatch or breakpoint-pre-dispatch; the latter records a
+#     matched breakpoint boundary reached before TB dispatch.
+# @reason: Always "before-execution".
+##
+{ 'struct': 'FdisbullInstructionTraceEvent',
+  'data': { 'sequence': 'uint64', 'vcpu': 'uint32', 'pc': 'uint64', 'origin': 'str',
+            'reason': 'str' } }
+
+##
+# @FdisbullInstructionTraceInfo:
+# Bounded trace status and one page of retained dispatch events.
+#
+# @epoch: Producer generation; changes on start and invalidation.
+# @instruction-count: Requested exact dispatch limit.
+# @capacity: Number of retained events, capped at 65536.
+# @active: Whether callbacks are still recording.
+# @stopped-reason: recording, instruction-count, user-stop, or invalidation cause.
+# @captured-count: Total records captured in this epoch.
+# @oldest-sequence: Oldest retained sequence, or zero when empty.
+# @next-sequence: Next sequence that would be assigned.
+# @dropped-count: Number of overwritten records.
+# @events: One bounded page of events after the supplied cursor.
+##
+{ 'struct': 'FdisbullInstructionTraceInfo',
+  'data': { 'epoch': 'uint64', 'instruction-count': 'uint64',
+            'capacity': 'uint32', 'active': 'bool', 'stopped-reason': 'str',
+            'captured-count': 'uint64', 'oldest-sequence': 'uint64',
+            'next-sequence': 'uint64', 'dropped-count': 'uint64',
+            'events': ['FdisbullInstructionTraceEvent'] } }
+
+##
+# @x-fdisbull-trace-start:
+# Begin a bounded trace on a stopped, single-vCPU system-mode TCG machine.
+#
+# @instruction-count: Exact number of callbacks to capture before stopping.
+# The trace records instruction dispatch callbacks before instruction bodies.
+# The callback can observe a faulting instruction; records do not attest
+# completion or retirement. Exactly @instruction-count boundaries are recorded
+# before a stop is requested. The retained ring is capped at 65536 records.
+##
+{ 'command': 'x-fdisbull-trace-start',
+  'data': { 'instruction-count': 'uint64' },
+  'returns': 'FdisbullInstructionTraceInfo' }
+
+##
+# @x-fdisbull-trace-read:
+# Read at most @max-events records with sequence greater than
+# @after-sequence. A stale cursor is accepted; compare it with
+# @oldest-sequence and @dropped-count to detect overwritten records. The
+# returned @next-sequence is the next sequence that would be assigned.
+#
+# @epoch: Producer epoch returned by start.
+# @after-sequence: Exclusive sequence cursor.
+# @max-events: Maximum number of events to return, from 1 through 4096.
+##
+{ 'command': 'x-fdisbull-trace-read',
+  'data': { 'epoch': 'uint64', 'after-sequence': 'uint64',
+            'max-events': 'uint32' },
+  'returns': 'FdisbullInstructionTraceInfo' }
+
+##
+# @x-fdisbull-trace-stop:
+# Stop recording and return one bounded page, using the same cursor semantics
+# as x-fdisbull-trace-read.
+#
+# @epoch: Producer epoch returned by start.
+# @after-sequence: Exclusive sequence cursor.
+# @max-events: Maximum number of events to return, from 1 through 4096.
+##
+{ 'command': 'x-fdisbull-trace-stop',
+  'data': { 'epoch': 'uint64', 'after-sequence': 'uint64',
+            'max-events': 'uint32' },
+  'returns': 'FdisbullInstructionTraceInfo' }
