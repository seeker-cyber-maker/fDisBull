+static bool chip8_layer_append_patches(GString *command,
+                                       Chip8LayerPatchList *items,
+                                       size_t *range_count, Error **errp)
+{
+    Chip8LayerPatchList *item;
+
+    for (item = items; item; item = item->next) {
+        const char *expected = item->value->expected_hex;
+        const char *data = item->value->data_hex;
+        size_t expected_len, data_len, i;
+
+        if (++*range_count > 256 || !expected || !data) {
+            error_setg(errp,
+                       "CHIP8_LAYER_PRECONDITION: malformed or excessive ranges");
+            return false;
+        }
+        expected_len = strlen(expected);
+        data_len = strlen(data);
+        if (!expected_len || (expected_len & 1) ||
+            expected_len != data_len || expected_len > 8192) {
+            error_setg(errp,
+                       "CHIP8_LAYER_PRECONDITION: invalid guarded hex lengths");
+            return false;
+        }
+        for (i = 0; i < expected_len; i++) {
+            if (!g_ascii_isdigit(expected[i]) &&
+                !(expected[i] >= 'a' && expected[i] <= 'f')) {
+                error_setg(errp,
+                           "CHIP8_LAYER_PRECONDITION: guarded hex must be lowercase hexadecimal");
+                return false;
+            }
+            if (!g_ascii_isdigit(data[i]) &&
+                !(data[i] >= 'a' && data[i] <= 'f')) {
+                error_setg(errp,
+                           "CHIP8_LAYER_PRECONDITION: guarded hex must be lowercase hexadecimal");
+                return false;
+            }
+        }
+        g_string_append_printf(command, "%u,%s,%s;", item->value->address,
+                               expected, data);
+    }
+    return true;
+}
+
+Chip8LayersInfo *qmp_x_chip8_configure_layers(
+    uint64_t expected_generation, uint64_t expected_state_generation,
+    Chip8LayerPatchList *ram, Chip8LayerPatchList *execute, Error **errp)
+{
+    CPUState *cs = qemu_get_cpu(0);
+    GString *command;
+    Error *local_err = NULL;
+    size_t range_count = 0;
+
+    if (!cs || runstate_is_running()) {
+        error_setg(errp, "CHIP-8 layer configuration requires a stopped CPU");
+        return NULL;
+    }
+    command = g_string_new(NULL);
+    g_string_append_printf(command, "%" PRIu64 ",%" PRIu64 "|",
+                           expected_generation, expected_state_generation);
+    if (!chip8_layer_append_patches(command, ram, &range_count, errp)) {
+        g_string_free(command, true);
+        return NULL;
+    }
+    g_string_append_c(command, '|');
+    if (!chip8_layer_append_patches(command, execute, &range_count, errp)) {
+        g_string_free(command, true);
+        return NULL;
+    }
+    object_property_set_str(OBJECT(cs), "configure-layers-command",
+                            command->str, &local_err);
+    g_string_free(command, true);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        return NULL;
+    }
+    return chip8_layers_info(errp);
+}
