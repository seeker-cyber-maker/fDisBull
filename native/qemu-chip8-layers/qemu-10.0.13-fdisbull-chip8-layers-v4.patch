+static bool chip8_layer_backing(Object *obj, uint16_t *mismatch,
+                                Error **errp)
+{
+    CPUArchState *env = &CHIP8_CPU(obj)->env;
+    unsigned i;
+
+    for (i = 0; i < CHIP8_RAM_SIZE; i++) {
+        uint8_t actual;
+        if (!env->execute_mask[i]) {
+            continue;
+        }
+        if (address_space_read(&address_space_memory, i,
+                              MEMTXATTRS_UNSPECIFIED, &actual, 1) != MEMTX_OK) {
+            error_setg(errp, "CHIP-8 layer backing could not be read");
+            return false;
+        }
+        if (actual != env->execute_base[i]) {
+            if (mismatch) {
+                *mismatch = i;
+            }
+            return false;
+        }
+    }
+    if (mismatch) {
+        *mismatch = 0;
+    }
+    return true;
+}
+
+static bool chip8_get_layer_backing_valid(Object *obj, Error **errp)
+{
+    return chip8_layer_backing(obj, NULL, errp);
+}
+
+static void chip8_get_layer_mismatch_address(Object *obj, Visitor *v,
+                                             const char *name, void *opaque,
+                                             Error **errp)
+{
+    uint16_t mismatch = 0;
+
+    chip8_layer_backing(obj, &mismatch, errp);
