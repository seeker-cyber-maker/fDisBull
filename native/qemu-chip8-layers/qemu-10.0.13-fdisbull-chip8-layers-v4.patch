+static char *chip8_layer_array_hex(const uint8_t *data, size_t size)
+{
+    static const char digits[] = "0123456789abcdef";
+    char *hex = g_malloc(size * 2 + 1);
+    size_t i;
+
+    for (i = 0; i < size; i++) {
+        hex[i * 2] = digits[data[i] >> 4];
+        hex[i * 2 + 1] = digits[data[i] & 0x0f];
+    }
+    hex[size * 2] = '\0';
+    return hex;
+}
