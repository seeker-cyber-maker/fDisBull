+static Chip8LayersInfo *chip8_layers_info(Error **errp)
+{
+    CPUState *cs = qemu_get_cpu(0);
+    Object *obj;
+    Error *local_err = NULL;
+    Chip8LayersInfo *info;
+
+    if (!cs || runstate_is_running()) {
+        error_setg(errp, "CHIP-8 layer query requires a stopped CPU");
+        return NULL;
+    }
+    obj = OBJECT(cs);
+    info = g_new0(Chip8LayersInfo, 1);
+#define CHIP8_LAYER_GET_STR(field, prop) do { \
+    info->field = object_property_get_str(obj, prop, &local_err); \
+    if (local_err) goto fail; \
+} while (0)
+#define CHIP8_LAYER_GET_U64(field, prop) do { \
+    info->field = object_property_get_uint(obj, prop, &local_err); \
+    if (local_err) goto fail; \
+} while (0)
+#define CHIP8_LAYER_GET_U16(field, prop) do { \
+    info->field = object_property_get_uint(obj, prop, &local_err); \
+    if (local_err) goto fail; \
+} while (0)
+#define CHIP8_LAYER_GET_BOOL(field, prop) do { \
+    info->field = object_property_get_bool(obj, prop, &local_err); \
+    if (local_err) goto fail; \
+} while (0)
+    CHIP8_LAYER_GET_STR(model, "chip8-layer-model");
+    CHIP8_LAYER_GET_U64(generation, "layer-generation");
+    CHIP8_LAYER_GET_STR(execute_mask_hex, "execute-mask-hex");
+    CHIP8_LAYER_GET_STR(execute_bytes_hex, "execute-bytes-hex");
+    CHIP8_LAYER_GET_STR(execute_base_hex, "execute-base-hex");
+    CHIP8_LAYER_GET_U64(execution_bytes, "layer-execution-bytes");
+    CHIP8_LAYER_GET_BOOL(faulted, "layer-faulted");
+    CHIP8_LAYER_GET_U16(fault_address, "layer-fault-address");
+    CHIP8_LAYER_GET_U16(fault_pc, "layer-fault-pc");
+    CHIP8_LAYER_GET_BOOL(stop_owned, "layer-stop-owned");
+    CHIP8_LAYER_GET_BOOL(backing_valid, "layer-backing-valid");
+    CHIP8_LAYER_GET_U16(mismatch_address, "layer-mismatch-address");
+#undef CHIP8_LAYER_GET_STR
+#undef CHIP8_LAYER_GET_U64
+#undef CHIP8_LAYER_GET_U16
+#undef CHIP8_LAYER_GET_BOOL
+    if (!info->model || strcmp(info->model, CHIP8_LAYER_MODEL) ||
+        !info->execute_mask_hex ||
+        strlen(info->execute_mask_hex) != CHIP8_LAYER_HEX_SIZE ||
+        !info->execute_bytes_hex ||
+        strlen(info->execute_bytes_hex) != CHIP8_LAYER_HEX_SIZE ||
+        !info->execute_base_hex ||
+        strlen(info->execute_base_hex) != CHIP8_LAYER_HEX_SIZE) {
+        error_setg(errp, "CHIP-8 layer properties are inconsistent");
+        qapi_free_Chip8LayersInfo(info);
+        return NULL;
+    }
+    return info;
+fail:
+    error_propagate(errp, local_err);
+    qapi_free_Chip8LayersInfo(info);
+    return NULL;
+}
