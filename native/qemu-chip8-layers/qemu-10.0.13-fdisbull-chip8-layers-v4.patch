+
+static int chip8_layer_hex_nibble(char value)
+{
+    if (value >= '0' && value <= '9') {
+        return value - '0';
+    }
+    if (value >= 'a' && value <= 'f') {
+        return value - 'a' + 10;
+    }
+    return -1;
+}
+
+static bool chip8_layer_parse_u64(char *text, uint64_t *value)
+{
+    char *end;
+    unsigned long long parsed;
+
+    if (!text || !*text || *text == '-') {
+        return false;
+    }
+    errno = 0;
+    parsed = g_ascii_strtoull(text, &end, 10);
+    if (errno || *end) {
+        return false;
+    }
+    *value = parsed;
+    return true;
+}
+
+static bool chip8_layer_parse_patches(
+    const char *spec, uint8_t present[CHIP8_RAM_SIZE],
+    uint8_t expected[CHIP8_RAM_SIZE], uint8_t data[CHIP8_RAM_SIZE],
+    size_t *total_bytes, size_t *range_count, Error **errp)
+{
+    gchar **entries = g_strsplit(spec, ";", -1);
+    unsigned entry_index;
+    bool valid = true;
+
+    for (entry_index = 0; entries[entry_index] && valid; entry_index++) {
+        gchar **fields;
+        uint64_t address64;
+        size_t expected_chars, data_chars, length, i;
+
+        if (!entries[entry_index][0]) {
+            continue;
+        }
+        fields = g_strsplit(entries[entry_index], ",", 4);
+        if (g_strv_length(fields) != 3 || ++*range_count > 256 ||
+            !chip8_layer_parse_u64(fields[0], &address64) ||
+            address64 >= CHIP8_RAM_SIZE || !fields[1] || !fields[2]) {
+            valid = false;
+            g_strfreev(fields);
+            break;
+        }
+        expected_chars = strlen(fields[1]);
+        data_chars = strlen(fields[2]);
+        if (!expected_chars || (expected_chars & 1) ||
+            expected_chars != data_chars ||
+            expected_chars > CHIP8_RAM_SIZE * 2) {
+            valid = false;
+            g_strfreev(fields);
+            break;
+        }
+        length = expected_chars / 2;
+        if (length > CHIP8_RAM_SIZE - address64 ||
+            length > CHIP8_RAM_SIZE - *total_bytes) {
+            valid = false;
+            g_strfreev(fields);
+            break;
+        }
+        for (i = 0; i < length; i++) {
+            int e0 = chip8_layer_hex_nibble(fields[1][i * 2]);
+            int e1 = chip8_layer_hex_nibble(fields[1][i * 2 + 1]);
+            int d0 = chip8_layer_hex_nibble(fields[2][i * 2]);
+            int d1 = chip8_layer_hex_nibble(fields[2][i * 2 + 1]);
+            unsigned address = address64 + i;
+
+            if (e0 < 0 || e1 < 0 || d0 < 0 || d1 < 0 || present[address]) {
+                valid = false;
+                break;
+            }
+            present[address] = 1;
+            expected[address] = (e0 << 4) | e1;
+            data[address] = (d0 << 4) | d1;
+        }
+        if (valid) {
+            *total_bytes += length;
+        }
+        g_strfreev(fields);
+    }
+    g_strfreev(entries);
+    if (!valid) {
+        chip8_layer_precondition(errp,
+                                 "malformed, overlapping, or oversized ranges");
+    }
+    return valid;
+}
