+static void chip8_configure_layers_command(Object *obj, const char *value,
+                                           Error **errp)
+{
+    CPUState *cs = CPU(obj);
+    Chip8CPU *cpu = CHIP8_CPU(obj);
+    CPUArchState *env = &cpu->env;
+    gchar **parts = NULL;
+    char *comma;
+    uint64_t expected_generation, expected_state_generation;
+    uint8_t ram_present[CHIP8_RAM_SIZE] = { 0 };
+    uint8_t ram_expected[CHIP8_RAM_SIZE] = { 0 };
+    uint8_t ram_data[CHIP8_RAM_SIZE] = { 0 };
+    uint8_t exec_present[CHIP8_RAM_SIZE] = { 0 };
+    uint8_t exec_expected[CHIP8_RAM_SIZE] = { 0 };
+    uint8_t exec_data[CHIP8_RAM_SIZE] = { 0 };
+    uint8_t ram_before[CHIP8_RAM_SIZE];
+    uint8_t ram_after[CHIP8_RAM_SIZE];
+    uint8_t new_mask[CHIP8_RAM_SIZE] = { 0 };
+    uint8_t new_bytes[CHIP8_RAM_SIZE] = { 0 };
+    uint8_t new_base[CHIP8_RAM_SIZE] = { 0 };
+    size_t ram_total = 0, exec_total = 0, range_count = 0, i;
+    MemTxResult tx_result;
+
+    if (!tcg_enabled() || runstate_is_running() ||
+        qemu_get_cpu(0) != cs || qemu_get_cpu(1)) {
+        chip8_layer_precondition(errp,
+                                 "layer operations require one stopped TCG CPU");
+        return;
+    }
+    parts = g_strsplit(value, "|", 3);
+    if (g_strv_length(parts) != 3 || !(comma = strchr(parts[0], ','))) {
+        chip8_layer_precondition(errp, "malformed generation or patch list");
+        goto out;
+    }
+    *comma++ = '\0';
+    if (!chip8_layer_parse_u64(parts[0], &expected_generation) ||
+        !chip8_layer_parse_u64(comma, &expected_state_generation) ||
+        !chip8_layer_parse_patches(parts[1], ram_present, ram_expected,
+                                   ram_data, &ram_total, &range_count, errp) ||
+        !chip8_layer_parse_patches(parts[2], exec_present, exec_expected,
+                                   exec_data, &exec_total, &range_count, errp)) {
+        if (!errp || !*errp) {
+            chip8_layer_precondition(errp, "malformed generation or patch list");
+        }
+        goto out;
+    }
+    if (expected_generation != env->layer_generation ||
+        expected_state_generation != env->state_generation ||
+        env->layer_generation == UINT64_MAX ||
+        env->state_generation == UINT64_MAX) {
+        chip8_layer_precondition(errp,
+                                 "layer or CPU generation changed/exhausted");
+        goto out;
+    }
+    tx_result = address_space_read(&address_space_memory, 0,
+                                   MEMTXATTRS_UNSPECIFIED, ram_before,
+                                   CHIP8_RAM_SIZE);
+    if (tx_result != MEMTX_OK) {
+        chip8_layer_precondition(errp, "flat RAM is not readable");
+        goto out;
+    }
+    memcpy(ram_after, ram_before, sizeof(ram_after));
+    for (i = 0; i < CHIP8_RAM_SIZE; i++) {
+        if (ram_present[i]) {
+            if (ram_before[i] != ram_expected[i]) {
+                chip8_layer_precondition(errp, "RAM expected bytes differ");
+                goto out;
+            }
+            ram_after[i] = ram_data[i];
+        }
+        if (exec_present[i] && ram_after[i] != exec_expected[i]) {
