+static void input_click_dispatch(int64_t now)
+{
+    FdisbullInputClickStepList *node = input_schedule.click_next;
+    FdisbullInputClickStep *step;
+    uint64_t index = input_schedule.click->dispatched_count;
+    int64_t actual;
+    Error *err = NULL;
+
+    if (!node || index >= input_schedule.event_count ||
+        index >= INPUT_MAX_CLICK_STEPS ||
+        !input_schedule.click_batches[index]) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "mouse click lost its next owned step");
+        return;
+    }
+    step = node->value;
+    if (!step->has_deadline_ns || step->has_dispatch_ns ||
+        now < step->deadline_ns) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "mouse click timer preceded its current deadline");
+        return;
+    }
+    /* Check overflow before the synchronous callback, preserving its prefix. */
+    if (node->next && now > INT64_MAX - node->next->value->delay_ns) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "mouse click next deadline would overflow");
+        return;
+    }
+    if (!qemu_input_fdisbull_dispatch(input_schedule.click_batches[index],
+                                     &err)) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     err ? error_get_pretty(err) :
+                           "mouse click dispatch failed");
+        error_free(err);
+        return;
+    }
+
+    actual = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    step->has_dispatch_ns = true;
+    step->dispatch_ns = actual;
+    input_schedule.click->dispatched_count++;
+    qemu_input_fdisbull_free(input_schedule.click_batches[index]);
+    input_schedule.click_batches[index] = NULL;
+    if (actual != now) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "virtual time changed inside synchronous mouse callback");
+        return;
+    }
+    if (!node->next) {
+        input_finish(FDISBULL_INPUT_STATE_DISPATCHED, "dispatch-complete");
+        return;
+    }
+    input_schedule.click_next = node->next;
+    step = node->next->value;
+    step->has_deadline_ns = true;
+    step->deadline_ns = actual + step->delay_ns;
+    timer_mod_ns(&input_schedule.timer, step->deadline_ns);
+}
