+static FdisbullInputBatch *input_click_prepare_step(InputButton button,
+                                                    bool down, Error **errp)
+{
+    InputBtnEvent button_event = { .button = button, .down = down };
+    InputEvent event = { .type = INPUT_EVENT_KIND_BTN,
+                         .u.btn = { .data = &button_event } };
+    InputEventList events = { .value = &event };
+
+    /* Each edge owns a separate batch so its mouse sync cannot be collapsed. */
+    return qemu_input_fdisbull_prepare(&events, errp);
+}
+
+FdisbullInputInfo *qmp_x_fdisbull_arm_mouse_click(
+    const char *token, InputButton button, int64_t hold_ms, Error **errp)
+{
+    g_autoptr(FdisbullInputClick) click = NULL;
+    FdisbullInputBatch *batches[INPUT_MAX_CLICK_STEPS] = { 0 };
+    FdisbullInputClickStepList **tail;
+    unsigned i;
+    int64_t now, horizon;
+
+    if (!input_arm_guard(token, errp)) {
+        return NULL;
+    }
+    if (button != INPUT_BUTTON_LEFT && button != INPUT_BUTTON_MIDDLE &&
+        button != INPUT_BUTTON_RIGHT) {
+        error_setg(errp, "Mouse click button must be left, middle or right");
+        return NULL;
+    }
+    if (hold_ms < 1 || hold_ms > 1000) {
+        error_setg(errp, "Mouse click hold-ms must be 1..1000");
+        return NULL;
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    horizon = INPUT_CLICK_EDGE_DELAY_NS + hold_ms * SCALE_MS;
+    if (now < 0 || now > INT64_MAX - horizon) {
+        error_setg(errp, "Mouse click nominal horizon exceeds signed time");
+        return NULL;
+    }
+
+    click = g_new0(FdisbullInputClick, 1);
+    click->button = button;
+    click->hold_ms = hold_ms;
+    tail = &click->steps;
+    for (i = 0; i < INPUT_MAX_CLICK_STEPS; i++) {
+        FdisbullInputClickStepList *node =
+            g_new0(FdisbullInputClickStepList, 1);
+        FdisbullInputClickStep *step = g_new0(FdisbullInputClickStep, 1);
+
+        *tail = node;
+        node->value = step;
+        tail = &node->next;
+        step->button = button;
+        step->down = i == 0;
+        step->delay_ns = i == 0 ? INPUT_CLICK_EDGE_DELAY_NS :
+                                 hold_ms * SCALE_MS;
+        if (i == 0) {
+            step->has_deadline_ns = true;
+            step->deadline_ns = now + step->delay_ns;
+        }
+        batches[i] = input_click_prepare_step(button, step->down, errp);
+        if (!batches[i]) {
+            goto fail;
+        }
+    }
+    if (!input_block_migration(errp)) {
+        goto fail;
+    }
+
+    input_schedule.batch = NULL;
+    g_clear_pointer(&input_schedule.retrace, qapi_free_FdisbullInputRetrace);
+    input_keyboard_free_batches();
+    g_clear_pointer(&input_schedule.press, qapi_free_FdisbullInputPress);
+    g_clear_pointer(&input_schedule.typing, qapi_free_FdisbullInputType);
+    input_click_free_batches();
+    qapi_free_FdisbullInputClick(input_schedule.click);
+    input_schedule.click = g_steal_pointer(&click);
+    input_schedule.click_next = input_schedule.click->steps;
+    for (i = 0; i < INPUT_MAX_CLICK_STEPS; i++) {
+        input_schedule.click_batches[i] = batches[i];
+        batches[i] = NULL;
+    }
+    input_arm_commit(token, now,
+                     input_schedule.click_next->value->deadline_ns,
+                     INPUT_MAX_CLICK_STEPS);
+    return input_info();
+
+fail:
+    for (i = 0; i < INPUT_MAX_CLICK_STEPS; i++) {
+        qemu_input_fdisbull_free(batches[i]);
+    }
+    return NULL;
+}
+
 FdisbullInputInfo *qmp_x_fdisbull_cancel_input(const char *token, Error **errp)
 {
     if (!input_guard(errp)) {
