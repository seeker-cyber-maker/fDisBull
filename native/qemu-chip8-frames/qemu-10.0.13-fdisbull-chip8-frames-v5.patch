+static bool chip8_frame_token_valid(const char *token)
+{
+    size_t i;
+    if (!token || strlen(token) != 32) {
+        return false;
+    }
+    for (i = 0; i < 32; i++) {
+        if (!((token[i] >= '0' && token[i] <= '9') ||
+              (token[i] >= 'a' && token[i] <= 'f'))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool chip8_frame_parse_u64(const char *text, uint64_t *value)
+{
+    const char *p;
+    char *end;
+    unsigned long long parsed;
+
+    if (!text || !*text) {
+        return false;
+    }
+    for (p = text; *p; p++) {
+        if (*p < '0' || *p > '9') {
+            return false;
+        }
+    }
+    errno = 0;
+    parsed = g_ascii_strtoull(text, &end, 10);
+    if (errno || *end) {
+        return false;
+    }
+    *value = parsed;
+    return true;
+}
