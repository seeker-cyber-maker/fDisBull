+static void chip8_frame_clear(CPUArchState *env)
+{
+    env->frame_fence_state = CHIP8_FRAME_IDLE;
+    memset(env->frame_fence_token, 0, sizeof(env->frame_fence_token));
+    env->frame_baseline_virtual_ticks = 0;
+    env->frame_baseline_deadline_ns = 0;
+    env->frame_completed_virtual_ticks = 0;
+    env->frame_completed_deadline_ns = 0;
+    env->frame_sampled_virtual_now_ns = 0;
+    env->frame_sample_state_generation = 0;
+    env->frame_sample_frame_generation = 0;
+    env->frame_sample_phase_numerator = 0;
+    memset(env->frame_sample_pixels, 0, sizeof(env->frame_sample_pixels));
+    env->frame_stop_pending = false;
+    env->frame_stop_owned = false;
+    env->frame_stop_consumed = false;
+}
