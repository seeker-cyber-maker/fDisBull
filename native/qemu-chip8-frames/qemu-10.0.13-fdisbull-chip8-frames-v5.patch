+static void chip8_frame_arm_command(Object *obj, const char *value,
+                                    Error **errp)
+{
+    Chip8CPU *cpu = CHIP8_CPU(obj);
+    CPUArchState *env = &cpu->env;
+    g_auto(GStrv) parts = g_strsplit(value, ":", 4);
+    uint64_t state_generation, virtual_ticks, deadline_ns;
+    Error *local_err = NULL;
+
+    if (!tcg_enabled() || runstate_is_running() ||
+        qemu_get_cpu(0) != CPU(obj) || qemu_get_cpu(1)) {
+        error_setg(errp, "CHIP-8 frame fence requires one stopped CPU");
+        return;
+    }
+    if (!parts[0] || !parts[1] || !parts[2] || !parts[3] ||
+        !chip8_frame_token_valid(parts[0]) ||
+        !chip8_frame_parse_u64(parts[1], &state_generation) ||
+        !chip8_frame_parse_u64(parts[2], &virtual_ticks) ||
+        !chip8_frame_parse_u64(parts[3], &deadline_ns) ||
+        env->frame_fence_state != CHIP8_FRAME_IDLE ||
+        state_generation != env->state_generation ||
+        virtual_ticks != env->virtual_ticks ||
+        deadline_ns != env->next_deadline_ns ||
+        env->state_generation == UINT64_MAX ||
+        env->virtual_ticks == UINT64_MAX ||
+        env->next_deadline_ns > INT64_MAX - 16666667 ||
+        env->frame_control_generation > UINT64_MAX - 2 ||
+        env->faulted || env->key_wait || env->key_wait_stop_owned ||
+        env->layer_faulted || env->layer_stop_owned) {
+        error_setg(errp, "CHIP8_FRAME_PRECONDITION: stale, invalid, or unsafe frame arm");
+        return;
+    }
+    if (!chip8_layer_backing(obj, NULL, &local_err)) {
+        if (local_err) {
+            error_propagate(errp, local_err);
+        } else {
+            error_setg(errp, "CHIP8_FRAME_PRECONDITION: execute backing differs");
+        }
+        return;
+    }
+
+    chip8_frame_clear(env);
+    g_strlcpy(env->frame_fence_token, parts[0],
+              sizeof(env->frame_fence_token));
+    env->frame_baseline_virtual_ticks = env->virtual_ticks;
+    env->frame_baseline_deadline_ns = env->next_deadline_ns;
+    env->frame_fence_state = CHIP8_FRAME_ARMED;
+    env->frame_control_generation++;
+    memset(env->frame_last_cancelled_token, 0,
+           sizeof(env->frame_last_cancelled_token));
+    env->frame_last_cancel_expected_generation = 0;
+}
+
+static void chip8_frame_cancel_command(Object *obj, const char *value,
+                                       Error **errp)
+{
+    Chip8CPU *cpu = CHIP8_CPU(obj);
+    CPUArchState *env = &cpu->env;
+    g_auto(GStrv) parts = g_strsplit(value, ":", 3);
+    uint64_t generation;
+    char token[sizeof(env->frame_fence_token)];
+
+    if (runstate_is_running()) {
+        error_setg(errp, "CHIP-8 frame cancellation requires a stopped VM");
+        return;
+    }
+    if (!parts[0] || !parts[1] || !chip8_frame_token_valid(parts[0]) ||
+        !chip8_frame_parse_u64(parts[1], &generation)) {
+        error_setg(errp, "CHIP8_FRAME_PRECONDITION: malformed frame cancellation");
+        return;
+    }
+    if (env->frame_fence_state == CHIP8_FRAME_IDLE &&
+        !strcmp(parts[0], env->frame_last_cancelled_token) &&
+        generation == env->frame_last_cancel_expected_generation) {
+        return;
+    }
+    if (env->frame_fence_state == CHIP8_FRAME_IDLE ||
+        generation != env->frame_control_generation ||
+        strcmp(parts[0], env->frame_fence_token) ||
+        env->frame_control_generation == UINT64_MAX) {
+        error_setg(errp, "CHIP8_FRAME_PRECONDITION: stale frame cancellation");
+        return;
+    }
+
+    g_strlcpy(token, env->frame_fence_token, sizeof(token));
+    g_strlcpy(env->frame_last_cancelled_token, token,
+              sizeof(env->frame_last_cancelled_token));
+    env->frame_last_cancel_expected_generation = generation;
+    env->frame_control_generation++;
+    chip8_frame_clear(env);
+    if (cpu->tick_timer) {
+        timer_mod_ns(cpu->tick_timer, env->next_deadline_ns);
+    }
+}
