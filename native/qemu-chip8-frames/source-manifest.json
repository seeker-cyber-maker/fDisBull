    ],
    "receipt_semantics": {
      "state": "idle, armed, or completed",
      "pending_sample": "Timer callback consumes one due tick, latches pixels and clock fields, then suppresses further tick processing until cancel. state stays armed; stop-pending=true; ownership/consumed=false.",
      "completed_sample": "Next CHIP-8 helper entry first checks layer/backing, sticky fault, and key-wait stop ownership; if clear it consumes the pending fence and raises EXCP_DEBUG before the next instruction takes effect.",
      "deadline": "completed-deadline-ns is the consumed deadline and equals baseline-deadline-ns. next-deadline advances by the rational phase. sampled-virtual-now-ns is the actual timer callback time and may be later.",
      "generation": "state-generation is the sample-latched CPU state generation while pending/completed; arm/cancel change frame control generation only.",
      "higher_priority_stop": "A user breakpoint/hook before the helper can win. Such a stop leaves the fence unconsumed; host must cancel before dispatch. GDB signal alone never proves a frame.",
      "cancel": "Requires matching token/control generation; increments control generation, clears public fence fields without reverting clock/pixels, and rearms existing absolute deadline. Same cancellation is idempotent."
    },
    "checkpoint": "VMState version 5/minimum 5. pre-save and pre-load refuse any non-idle fence; fence/token/control state are not serialized. post-load clears ephemeral frame ownership and retains existing v5 architectural display/timer/tick state.",
    "scope_limits": [
      "One stopped TCG vCPU only.",
      "No additional display device, renderer publication, VBlank model, wall-time claim, or guest-frame completion claim.",
      "Host owns hook and breakpoint dispatch.",
      "Cross-binary VMState compatibility is not claimed."
    ]
  },
