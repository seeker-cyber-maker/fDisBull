+static bool chip8_frame_keys_state_valid(Chip8CPU *cpu)
+{
+    CPUArchState *env = &cpu->env;
+
+    if (cpu->frame_keys_needs_adoption) {
+        return env->frame_keys_active && !cpu->frame_keys_valid &&
+               !cpu->frame_keys_token[0] &&
+               env->frame_keys_generation > 0 &&
+               env->frame_keys_accepted_edges > 0 &&
+               env->frame_keys_held_mask == env->key_mask;
+    }
+    if (!cpu->frame_keys_valid) {
