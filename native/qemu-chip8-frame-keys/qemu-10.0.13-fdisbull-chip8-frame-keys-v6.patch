+Chip8FrameKeysInfo *qmp_x_chip8_apply_frame_key_edges(
+    const char *token, uint64_t expected_generation,
+    uint64_t expected_state_generation, Chip8FrameKeyEdgeList *edges,
+    Error **errp)
+{
+    CPUState *cs = qemu_get_cpu(0);
+    Chip8FrameKeyEdgeList *item;
+    Error *local_err = NULL;
+    GString *command;
+    unsigned int count = 0;
+    uint16_t seen = 0;
+
+    if (!cs || runstate_is_running()) {
+        error_setg(errp, "CHIP8_KEY_OWNER_PRECONDITION: stopped CPU required");
+        return NULL;
+    }
+    if (!chip8_frame_keys_token_ok(token)) {
+        error_setg(errp, "CHIP8_KEY_OWNER_PRECONDITION: invalid owner token");
+        return NULL;
+    }
+    for (item = edges; item; item = item->next) {
+        const char *key = item->value ? item->value->key : NULL;
+        unsigned int digit;
+        if (++count > 16 || !key || strlen(key) != 1 ||
+            !(g_ascii_isdigit(key[0]) || (key[0] >= 'a' && key[0] <= 'f'))) {
+            error_setg(errp, "CHIP8_KEY_OWNER_PRECONDITION: invalid key batch");
+            return NULL;
+        }
+        digit = g_ascii_xdigit_value(key[0]);
+        if (seen & (1u << digit)) {
+            error_setg(errp, "CHIP8_KEY_OWNER_PRECONDITION: duplicate key");
+            return NULL;
+        }
+        seen |= 1u << digit;
+    }
+    if (!count) {
+        error_setg(errp, "CHIP8_KEY_OWNER_PRECONDITION: empty key batch");
+        return NULL;
+    }
+    command = g_string_new(NULL);
+    g_string_append_printf(command, "%s:%" PRIu64 ":%" PRIu64 ":",
+                           token, expected_generation, expected_state_generation);
+    for (item = edges; item; item = item->next) {
+        g_string_append_c(command, item->value->key[0]);
+        g_string_append_c(command, item->value->pressed ? '+' : '-');
+    }
+    object_property_set_str(OBJECT(cs), "apply-frame-key-edges-command",
+                            command->str, &local_err);
+    g_string_free(command, true);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        return NULL;
+    }
+    return chip8_frame_keys_info(errp);
+}
