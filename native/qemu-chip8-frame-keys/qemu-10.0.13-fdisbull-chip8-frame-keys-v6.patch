+    }
+    if (env->frame_keys_active) {
+        return env->frame_keys_held_mask == env->key_mask &&
+               env->frame_keys_generation > 0 &&
+               env->frame_keys_accepted_edges > 0 &&
+               chip8_frame_keys_token_valid(cpu->frame_keys_token);
+    }
+    return !cpu->frame_keys_token[0] && !env->frame_keys_held_mask;
