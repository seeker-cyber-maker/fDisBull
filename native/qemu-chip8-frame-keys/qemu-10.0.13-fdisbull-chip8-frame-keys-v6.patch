+void chip8_frame_keys_rotate_epoch(Chip8CPU *cpu)
+{
+    QemuUUID uuid;
+    uint64_t epoch;
+
+    qemu_uuid_generate(&uuid);
+    memcpy(&epoch, uuid.data, sizeof(epoch));
+    epoch &= INT64_MAX;
+    if (!epoch) {
+        epoch = 1;
+    }
+    if (epoch == cpu->frame_keys_epoch) {
+        epoch = (epoch + 1) & INT64_MAX;
+        if (!epoch) {
+            epoch = 1;
+        }
+    }
+    cpu->frame_keys_epoch = epoch;
+}
