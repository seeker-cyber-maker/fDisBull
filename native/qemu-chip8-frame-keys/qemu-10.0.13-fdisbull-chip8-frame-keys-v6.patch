+static Chip8FrameKeysInfo *chip8_frame_keys_info(Error **errp)
+{
+    CPUState *cs = qemu_get_cpu(0);
+    Chip8FrameKeysInfo *info;
+    Error *local_err = NULL;
+    Object *obj;
+    strList **tail;
+    unsigned int i;
+
+    if (!cs || runstate_is_running()) {
+        error_setg(errp, "CHIP-8 frame key query requires a stopped CPU");
+        return NULL;
+    }
+    obj = OBJECT(cs);
+    info = g_new0(Chip8FrameKeysInfo, 1);
+    info->model = g_strdup(CHIP8_FRAME_KEYS_MODEL);
+#define KEY_GET_STR(field, prop) do { \
+    info->field = object_property_get_str(obj, prop, &local_err); \
+    if (local_err) goto fail; \
+} while (0)
+#define KEY_GET_UINT(field, prop) do { \
+    info->field = object_property_get_uint(obj, prop, &local_err); \
+    if (local_err) goto fail; \
+} while (0)
+#define KEY_GET_BOOL(field, prop) do { \
+    info->field = object_property_get_bool(obj, prop, &local_err); \
+    if (local_err) goto fail; \
+} while (0)
+    KEY_GET_STR(subset, "cpu-subset");
+    KEY_GET_STR(environment_model, "chip8-env-model");
+    KEY_GET_UINT(epoch, "frame-keys-epoch");
+    KEY_GET_BOOL(active, "frame-keys-active");
+    KEY_GET_BOOL(valid, "frame-keys-valid");
+    KEY_GET_BOOL(needs_adoption, "frame-keys-needs-adoption");
+    KEY_GET_UINT(generation, "frame-keys-generation");
+    KEY_GET_UINT(accepted_edges, "frame-keys-accepted-edges");
+    KEY_GET_UINT(held_mask, "frame-keys-held-mask");
+    KEY_GET_UINT(key_mask, "key-mask");
+    KEY_GET_UINT(state_generation, "state-generation");
+    KEY_GET_STR(token, "frame-keys-token");
+#undef KEY_GET_STR
+#undef KEY_GET_UINT
+#undef KEY_GET_BOOL
+    tail = &info->held;
+    for (i = 0; i < 16; i++) {
+        if (info->held_mask & (1u << i)) {
+            QAPI_LIST_APPEND(tail, g_strdup_printf("%x", i));
+        }
+    }
+    info->edge_capacity = 16;
+    info->repeat_supported = false;
+    return info;
+fail:
+    error_propagate(errp, local_err);
+    qapi_free_Chip8FrameKeysInfo(info);
+    return NULL;
