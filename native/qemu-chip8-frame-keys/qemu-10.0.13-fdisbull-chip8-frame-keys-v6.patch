+static int chip8_key_hex_value(char ch)
+{
+    if (ch >= '0' && ch <= '9') {
+        return ch - '0';
+    }
+    if (ch >= 'a' && ch <= 'f') {
+        return ch - 'a' + 10;
+    }
+    return -1;
+}
+
+static bool chip8_frame_keys_mutation_admitted(Chip8CPU *cpu, bool adoption,
+                                               Error **errp)
+{
+    if (!tcg_enabled() || runstate_is_running() ||
+        qemu_get_cpu(0) != CPU(cpu) || qemu_get_cpu(1)) {
+        error_setg(errp,
+                   "CHIP8_KEY_OWNER_PRECONDITION: key ownership requires one stopped CPU");
+        return false;
+    }
+    if (cpu->env.frame_fence_state != CHIP8_FRAME_IDLE) {
+        error_setg(errp,
+                   "CHIP8_FRAME_PRECONDITION: cancel frame fence before key ownership changes");
+        return false;
+    }
+    if (!adoption &&
+        (!cpu->frame_keys_valid || cpu->frame_keys_needs_adoption)) {
+        error_setg(errp,
+                   "CHIP8_KEY_OWNER_PRECONDITION: frame-key state is invalid or needs adoption");
+        return false;
+    }
+    return true;
+}
