+#define CHIP8_FRAME_KEYS_MODEL "fdisbull-chip8-frame-keys-1"
+
+/* The QOM command interface uses ':' as a delimiter.  Never forward an
+ * unvalidated token or edge string across that boundary. */
+static bool chip8_frame_keys_token_ok(const char *token)
+{
+    size_t i;
+
+    if (!token || strlen(token) != 32) {
+        return false;
+    }
+    for (i = 0; i < 32; i++) {
+        if (!g_ascii_isdigit(token[i]) &&
+            !(token[i] >= 'a' && token[i] <= 'f')) {
+            return false;
+        }
+    }
+    return true;
 }
