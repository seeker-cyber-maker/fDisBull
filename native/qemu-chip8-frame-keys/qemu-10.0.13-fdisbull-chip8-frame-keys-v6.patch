+static void chip8_frame_keys_apply_command(Object *obj, const char *value,
+                                           Error **errp)
+{
+    Chip8CPU *cpu = CHIP8_CPU(obj);
+    CPUArchState *env = &cpu->env;
+    g_auto(GStrv) parts = g_strsplit(value, ":", 4);
+    uint64_t generation, state_generation, edge_count;
+    uint16_t next_mask;
+    bool seen[16] = { false };
+    const char *edges;
+    size_t n;
+
+    if (!chip8_frame_keys_mutation_admitted(cpu, false, errp)) {
+        return;
+    }
+    if (g_strv_length(parts) != 4 ||
+        !parts[0] || !parts[1] || !parts[2] || !parts[3] ||
+        !chip8_frame_keys_token_valid(parts[0]) ||
+        !chip8_frame_parse_u64(parts[1], &generation) ||
+        !chip8_frame_parse_u64(parts[2], &state_generation) ||
+        !parts[3][0] || strlen(parts[3]) > 32 ||
+        (strlen(parts[3]) & 1)) {
+        error_setg(errp,
+                   "CHIP8_KEY_OWNER_PRECONDITION: malformed token, generation, or edge batch");
+        return;
+    }
+    edges = parts[3];
+    edge_count = strlen(edges) / 2;
+    if (!edge_count || edge_count > 16 ||
+        generation != env->frame_keys_generation ||
+        state_generation != env->state_generation ||
+        env->frame_keys_generation == UINT64_MAX ||
+        env->state_generation == UINT64_MAX ||
+        env->frame_keys_accepted_edges > UINT64_MAX - edge_count) {
+        error_setg(errp,
+                   "CHIP8_KEY_OWNER_PRECONDITION: stale generation or invalid edge count");
+        return;
+    }
+
+    if (env->frame_keys_active) {
+        if (strcmp(parts[0], cpu->frame_keys_token) ||
+            env->frame_keys_held_mask != env->key_mask) {
+            error_setg(errp,
+                       "CHIP8_KEY_OWNER_PRECONDITION: owner token or held set differs");
+            return;
+        }
+        next_mask = env->frame_keys_held_mask;
+    } else {
+        if (cpu->frame_keys_token[0] || env->frame_keys_held_mask ||
+            env->key_mask) {
+            error_setg(errp,
+                       "CHIP8_KEY_OWNER_PRECONDITION: manual keys must be released before claiming ownership");
+            return;
+        }
+        next_mask = 0;
+    }
+
+    for (n = 0; n < (size_t)edge_count; n++) {
+        int key = chip8_key_hex_value(edges[n * 2]);
+        char transition = edges[n * 2 + 1];
+        uint16_t bit;
+
+        if (key < 0 || (transition != '+' && transition != '-') ||
+            seen[key]) {
+            error_setg(errp,
+                       "CHIP8_KEY_OWNER_PRECONDITION: edge keys must be unique lowercase hex transitions");
+            return;
+        }
+        seen[key] = true;
+        bit = 1u << key;
+        if ((transition == '+' && (next_mask & bit)) ||
+            (transition == '-' && !(next_mask & bit))) {
+            error_setg(errp,
+                       "CHIP8_KEY_OWNER_PRECONDITION: edge does not change the held set");
+            return;
+        }
+        if (transition == '+') {
+            next_mask |= bit;
+        } else {
+            next_mask &= ~bit;
+        }
+    }
+
+    env->frame_keys_active = true;
+    env->frame_keys_held_mask = next_mask;
+    env->key_mask = next_mask;
+    g_strlcpy(cpu->frame_keys_token, parts[0], sizeof(cpu->frame_keys_token));
+    env->frame_keys_accepted_edges += edge_count;
+    env->frame_keys_generation++;
+    env->key_wait_stop_owned = false;
+    chip8_state_generation_advance(env);
+}
+
+static void chip8_frame_keys_detach_command(Object *obj, const char *value,
+                                            Error **errp)
+{
+    Chip8CPU *cpu = CHIP8_CPU(obj);
+    CPUArchState *env = &cpu->env;
+    g_auto(GStrv) parts = g_strsplit(value, ":", 3);
+    uint64_t generation;
+
+    if (!chip8_frame_keys_mutation_admitted(cpu, false, errp)) {
+        return;
+    }
+    if (g_strv_length(parts) != 2 || !parts[0] || !parts[1] ||
+        !chip8_frame_keys_token_valid(parts[0]) ||
+        !chip8_frame_parse_u64(parts[1], &generation) ||
+        !env->frame_keys_active || strcmp(parts[0], cpu->frame_keys_token) ||
+        generation != env->frame_keys_generation ||
+        env->frame_keys_generation == UINT64_MAX || env->key_mask ||
+        env->frame_keys_held_mask) {
+        error_setg(errp,
+                   "CHIP8_KEY_OWNER_PRECONDITION: detach requires a matching empty owner");
+        return;
+    }
+    env->frame_keys_active = false;
+    env->frame_keys_held_mask = 0;
+    env->frame_keys_generation++;
+    memset(cpu->frame_keys_token, 0, sizeof(cpu->frame_keys_token));
+}
+
+static void chip8_frame_keys_adopt_command(Object *obj, const char *value,
