  "target": {
    "checkpoint": "VMState version 6/minimum 6. Logical active/held set, owner generation and accepted-edge count are serialized. Tokens/epoch are process-local. On restore an active owner is validly represented as needs-adoption with a fresh epoch and empty token; host adoption is required before execution/frame arming. Cross-version VMState restore is not claimed.",
    "commands": {
      "adopt": "x-chip8-adopt-frame-keys(token:str,expected-generation:uint64,expected-state-generation:uint64,held-mask:uint16)",
      "apply": "x-chip8-apply-frame-key-edges(token:str,expected-generation:uint64,expected-state-generation:uint64,edges:[Chip8FrameKeyEdge])",
      "detach": "x-chip8-detach-frame-keys(token:str,expected-generation:uint64)",
      "query": "query-chip8-frame-keys"
    },
    "cpu_model": "chip8-cpu",
    "cpu_subset": "fdisbull-chip8-frame-keys-6",
    "edge": {
      "batch": "1-16 unique keys; stopped-state atomic compare-and-swap",
      "key": "one lowercase hexadecimal digit 0-f",
      "pressed": "boolean"
    },
    "environment_model": "fdisbull-chip8-display-keypad-timers-rng-layers-frames-keys-5",
    "frame_model": "fdisbull-chip8-native-frame-sample-1",
    "key_model": "fdisbull-chip8-frame-keys-1",
    "machine": "chip8-test",
    "profile": "chip8-classic-pilot-default-v1",
    "qemu_target": "chip8-softmmu",
    "receipt_fields": [
      "model",
      "subset",
      "environment-model",
      "epoch",
      "active",
      "valid",
      "needs-adoption",
      "generation",
      "accepted-edges",
      "held-mask",
      "key-mask",
      "state-generation",
      "token",
      "held",
      "edge-capacity",
      "repeat-supported"
    ],
    "receipt_semantics": {
      "adopt": "after restore, binds a new token and increments owner generation only; it does not inject events or change CPU state generation",
      "claim": "first nonempty owned edge claims the lease only when no manually held keys exist; accepted batch increments owner and CPU state generations once",
      "detach": "requires active matching owner and an empty held/key mask; increments owner generation only and retains accepted-edge count",
      "epoch": "positive process-local random value rotated on reset and after restore; it is not serialized",
      "frame_fence": "frame arm and key-owner mutations are mutually exclusive; arming refuses invalid or unadopted restored owner state",
      "fx0a": "accepted input clears stop attribution but does not clear architectural wait; the guest consumes a held key only after explicit resume",
      "manual_input": "legacy manual keypad mutation is rejected while the owner is active, including an active empty owner",
      "repeat": "not supported"
    }
  },
