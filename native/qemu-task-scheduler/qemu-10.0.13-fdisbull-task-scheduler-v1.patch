+static bool write_scheduler_anchor(int selected, Error **errp)
+{
+    uint8_t bytes[TASK_ANCHOR_SIZE] = {0};
+    hwaddr offset;
+    uint64_t backing;
+    MemoryRegion *mr;
+    if (!migration_state.anchor_address ||
+        !direct_ram(migration_state.anchor_address, TASK_ANCHOR_SIZE,
+                    &mr, &offset, &backing, NULL, errp)) return false;
+    for (int ti = 0; ti < TASK_MAX; ti++) {
+        for (unsigned p = 0; p < tasks[ti].page_count; p++) {
+            if (tasks[ti].pages[p].backing_page ==
+                (backing & ~(TASK_PAGE_SIZE - 1))) {
+                task_error(errp, "scheduler anchor must remain in shared base RAM");
+                return false;
+            }
+        }
+    }
+    memcpy(bytes, "FDBTASK1", 8);
+    if (selected >= 0 && selected < TASK_MAX) {
+        const char *uuid = tasks[selected].uuid;
+        for (unsigned i = 0; i < 16; i++) {
+            bytes[8 + i] = (g_ascii_xdigit_value(uuid[2 * i]) << 4) |
+                           g_ascii_xdigit_value(uuid[2 * i + 1]);
+        }
+        if (migration_state.sequence > UINT64_MAX - 2) {
+            task_error(errp, "scheduler anchor sequence exhausted");
+            return false;
+        }
+        migration_state.sequence += 2;
+        stq_le_p(bytes + 24, migration_state.sequence);
+        stq_le_p(bytes + 32, tasks[selected].cookie);
+        stq_le_p(bytes + 40, tasks[selected].incarnation);
+        stl_le_p(bytes + 48, 1);
+    } else {
+        /* State zero records a native idle stop without assigning a guest task. */
+        migration_state.sequence += migration_state.sequence <= UINT64_MAX - 2 ? 2 : 0;
+        stq_le_p(bytes + 24, migration_state.sequence);
+        stl_le_p(bytes + 48, 0);
+    }
+    MemTxResult tx = address_space_write(&address_space_memory,
+                                         migration_state.anchor_address,
+                                         MEMTXATTRS_UNSPECIFIED,
+                                         bytes, sizeof(bytes));
+    if (tx != MEMTX_OK) {
+        task_error(errp, "failed to publish native scheduler anchor");
+        return false;
+    }
+    memory_region_set_dirty(mr, offset, sizeof(bytes));
     return true;
