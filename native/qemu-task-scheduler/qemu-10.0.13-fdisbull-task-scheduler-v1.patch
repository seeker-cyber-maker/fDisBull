+static FdisbullTaskSchedulerStatusInfo *scheduler_status_new(void)
+{
+    FdisbullTaskSchedulerStatusInfo *out = g_new0(FdisbullTaskSchedulerStatusInfo, 1);
+    out->model = g_strdup("qemu-pc-task-scheduler-v1"); out->api_version = 1;
+    out->epoch = epoch_highwater; out->generation = generation_highwater;
+    out->enabled = scheduler_enabled; out->yield_vector = 0x60; out->block_vector = 0x62;
+    out->pending_switch = scheduler_switch_pending;
+    if (scheduler_fault) out->fault = g_strdup(scheduler_fault);
+    out->runqueue_generation = scheduler_generation;
+    CPUState *owner = NULL; CPU_FOREACH(owner) { break; }
+    if (owner) {
+        uint32_t pending = owner->interrupt_request &
+            (CPU_INTERRUPT_HARD | CPU_INTERRUPT_NMI | CPU_INTERRUPT_SMI |
+             CPU_INTERRUPT_MCE | CPU_INTERRUPT_VIRQ);
+        while (pending) { out->pending_irq_count++; pending &= pending - 1; }
+    }
+    out->selected_uuid = g_strdup("");
