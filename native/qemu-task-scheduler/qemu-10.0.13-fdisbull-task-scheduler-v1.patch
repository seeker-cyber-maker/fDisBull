+                                  Error **errp)
+{
+    uint64_t sp_mask = (ctx->segments[R_SS].flags & DESC_B_MASK) ? UINT32_MAX : UINT16_MAX;
+    uint64_t linear = ctx->segments[R_SS].base + (ctx->registers[R_ESP] & sp_mask);
+    uint64_t physical = linear & (uint64_t)(uint32_t)ctx->a20_mask;
