+        out->selected_cookie = selected->cookie; out->selected_incarnation = selected->incarnation;
+    }
+    FdisbullTaskSchedulerSlotList **tail = &out->tasks;
+    for (int i = 0; i < TASK_MAX; i++) {
+        TaskState *task = &tasks[i];
+        if (!task->cpu_bound) continue;
+        TaskCpuContext live_ctx;
+        TaskCpuContext *ctx = &task->cpu;
+        if (scheduler_enabled && scheduler_selected == i) {
+            CPUState *cpu = NULL; CPU_FOREACH(cpu) { break; }
+            if (cpu) { task_cpu_context_capture(&live_ctx, &X86_CPU(cpu)->env, false, 0); ctx = &live_ctx; }
+        }
+        FdisbullTaskSchedulerSlot *slot = g_new0(FdisbullTaskSchedulerSlot, 1);
+        slot->uuid = g_strdup(task->uuid); slot->cookie = task->cookie;
+        slot->incarnation = task->incarnation; slot->slot = i;
+        slot->runnable = task->runnable; slot->blocked = task->blocked;
+        slot->retired = task->retired; slot->context_valid = task->cpu_valid;
+        slot->context_sha256 = task->cpu_valid ? task_context_digest(ctx) : g_strdup("");
+        slot->frame_sha256 = task_frame_digest(task); slot->interrupt_depth = task->frame_depth;
+        if (task->cpu_valid) {
+            slot->eip = ctx->eip; slot->esp = ctx->registers[R_ESP];
+            slot->eflags = ctx->eflags; slot->mode = g_strdup(task_context_mode(ctx));
+            slot->cs_selector = ctx->segments[R_CS].selector;
+            slot->ss_selector = ctx->segments[R_SS].selector;
+        } else { slot->mode = g_strdup("unknown"); }
+        slot->execution_bytes = g_hash_table_size(task->execute);
+        slot->execution_sha256 = task_exec_digest(task);
+        FdisbullTaskPageInfoList **ptail = &slot->pages;
+        for (unsigned p = 0; p < task->page_count; p++) {
+            FdisbullTaskPageInfoList *node = g_new0(FdisbullTaskPageInfoList, 1);
+            node->value = page_info_new(&task->pages[p]); *ptail = node; ptail = &node->next;
+        }
+        FdisbullTaskSchedulerSlotList *node = g_new0(FdisbullTaskSchedulerSlotList, 1);
+        node->value = slot; *tail = node; tail = &node->next;
+    }
+    return out;
+}
+
+static FdisbullTaskInterruptFrame *task_frame_info(const TaskFrameState *frame)
+{
+    FdisbullTaskInterruptFrame *out = g_new0(FdisbullTaskInterruptFrame, 1);
+    out->sequence = frame->sequence; out->vector = frame->vector;
+    out->kind = g_strdup(frame->kind == 1 ? "hardware" : frame->kind == 2 ? "software" : "exception");
+    out->pre_cs = frame->pre_cs; out->pre_eip = frame->pre_eip;
+    out->pre_ss = frame->pre_ss; out->pre_sp = frame->pre_sp;
+    out->frame_sp = frame->frame_sp; out->width = frame->width;
+    out->frame_ss_selector = frame->frame_ss_selector;
+    out->frame_ss_base = frame->frame_ss_base;
+    out->frame_sp_mask = frame->frame_sp_mask;
+    out->frame_size = frame->frame_size;
+    out->backing_count = frame->backing_count;
+    uint64List **btail = &out->backing_pages;
+    for (unsigned b = 0; b < frame->backing_count; b++) {
+        uint64List *n = g_new0(uint64List, 1); n->value = frame->backing_page[b];
+        *btail = n; btail = &n->next;
+    }
+    out->error_code_present = frame->error_code_present;
+    out->error_code = frame->error_code;
+    return out;
+}
+
+static FdisbullTaskCpuContextInfo *task_cpu_context_info(TaskState *task,
+                                                          bool live,
+                                                          const TaskCpuContext *ctx)
+{
+    FdisbullTaskCpuContextInfo *out = g_new0(FdisbullTaskCpuContextInfo, 1);
+    out->uuid = g_strdup(task->uuid); out->cookie = task->cookie;
+    out->incarnation = task->incarnation; out->live = live;
+    uint64List **regtail = &out->registers;
+    for (unsigned i = 0; i < 16; i++) {
+        uint64List *reg = g_new0(uint64List, 1); reg->value = ctx->registers[i];
+        *regtail = reg; regtail = &reg->next;
+    }
+    out->eip = ctx->eip; out->eflags = ctx->eflags;
+    out->mode = g_strdup(task_context_mode(ctx));
+    FdisbullTaskCpuSegmentList **tail = &out->segments;
+    for (unsigned i = 0; i < 6; i++) {
+        FdisbullTaskCpuSegmentList *n = g_new0(FdisbullTaskCpuSegmentList, 1);
+        n->value = qapi_segment(&ctx->segments[i]); *tail = n; tail = &n->next;
+    }
+    const TaskCpuSegment *system[4] = { &ctx->ldt, &ctx->tr, &ctx->gdt, &ctx->idt };
+    tail = &out->system_segments;
+    for (unsigned i = 0; i < 4; i++) {
+        FdisbullTaskCpuSegmentList *n = g_new0(FdisbullTaskCpuSegmentList, 1);
+        n->value = qapi_segment(system[i]); *tail = n; tail = &n->next;
+    }
+    out->cr0 = ctx->cr[0]; out->cr2 = ctx->cr[2];
+    out->cr3 = ctx->cr[3]; out->cr4 = ctx->cr[4];
+    out->efer = ctx->efer; out->a20_mask = ctx->a20_mask;
+    out->xstate_sha256 = task_xstate_digest(ctx);
+    out->context_sha256 = task_context_digest(ctx);
+    out->interrupt_depth = task->frame_depth;
+    FdisbullTaskInterruptFrameList **ftail = &out->frames;
+    for (unsigned i = 0; i < task->frame_depth; i++) {
+        FdisbullTaskInterruptFrameList *n = g_new0(FdisbullTaskInterruptFrameList, 1);
+        n->value = task_frame_info(&task->frames[i]); *ftail = n; ftail = &n->next;
+    }
+    return out;
+}
