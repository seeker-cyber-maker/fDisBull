+static const char *task_context_mode(const TaskCpuContext *ctx)
+{
+    if (ctx->eflags & VM_MASK) return "v86";
+    if (!(ctx->cr[0] & CR0_PE_MASK)) return "real";
+    if (ctx->hflags & HF_LMA_MASK) return "long";
+    return "protected";
+}
