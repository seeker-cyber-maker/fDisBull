+static bool task_cpu_context_restore(TaskCpuContext *ctx, X86CPU *cpu,
+                                     bool materialize_eflags, Error **errp)
+{
+    CPUX86State *env = &cpu->env;
+    if (!ctx->valid || (ctx->hflags & HF_LMA_MASK) ||
+        (ctx->cr[4] & CR4_PAE_MASK)) {
+        task_error(errp, "saved CPU context is invalid or outside the supported mode set");
+        return false;
+    }
+    for (unsigned i = 0; i < 16; i++) env->regs[i] = ctx->registers[i];
+    env->eip = ctx->eip;
+    env->eflags = materialize_eflags ? ctx->eflags :
+        ctx->eflags & ~(DF_MASK | CC_C | CC_P | CC_A | CC_Z | CC_S | CC_O);
+    env->cc_dst = ctx->cc_dst; env->cc_src = ctx->cc_src;
+    env->cc_src2 = ctx->cc_src2; env->cc_op = ctx->cc_op; env->df = ctx->df;
+    /* DR7's fast path only tracks enable-bit changes. Disable old guest hooks
+     * before replacing their address registers so an equal DR7 still rebinds. */
+    cpu_x86_update_dr7(env, env->dr[7] &
+                       ~(DR7_GLOBAL_BP_MASK | DR7_LOCAL_BP_MASK));
+    for (unsigned i = 0; i < 4; i++) env->dr[i] = ctx->debug_registers[i];
+    env->dr[6] = ctx->debug_registers[4];
+    cpu_x86_update_dr7(env, ctx->debug_registers[5]);
+    cpu_x86_update_cr0(env, ctx->cr[0]);
+    cpu_x86_update_cr4(env, ctx->cr[4]);
+    cpu_x86_update_cr3(env, ctx->cr[3]);
+    env->cr[2] = ctx->cr[2]; env->cr[1] = 0;
+    env->pdptrs_valid = ctx->pdptrs_valid;
+    memcpy(env->pdptrs, ctx->pdptrs, sizeof(ctx->pdptrs));
+    cpu_load_efer(env, ctx->efer);
+    env->a20_mask = ctx->a20_mask;
+    for (unsigned i = 0; i < 6; i++) {
+        cpu_x86_load_seg_cache(env, i, ctx->segments[i].selector,
+                               ctx->segments[i].base, ctx->segments[i].limit,
+                               ctx->segments[i].flags);
+    }
+    task_segment_to_cache(&env->ldt, &ctx->ldt);
+    task_segment_to_cache(&env->tr, &ctx->tr);
+    task_segment_to_cache(&env->gdt, &ctx->gdt);
+    task_segment_to_cache(&env->idt, &ctx->idt);
+    env->hflags = ctx->hflags; env->hflags2 = ctx->hflags2;
+    env->fpstt = ctx->fpstt; env->fpus = ctx->fpus; env->fpuc = ctx->fpuc;
+    memcpy(env->fptags, ctx->fptags, sizeof(ctx->fptags));
+    for (unsigned i = 0; i < 8; i++) {
+        env->fpregs[i].d = make_floatx80(ctx->fp_high[i], ctx->fp_low[i]);
+    }
+    env->fpop = ctx->fpop; env->fpcs = ctx->fpcs; env->fpds = ctx->fpds;
+    env->fpip = ctx->fpip; env->fpdp = ctx->fpdp;
+    env->mxcsr = ctx->mxcsr;
+    memcpy(env->xmm_regs, ctx->xstate_qwords, sizeof(ctx->xstate_qwords));
+    env->xcr0 = ctx->xcr0; env->xstate_bv = ctx->xstate_bv;
+    env->sysenter_cs = ctx->sysenter_cs; env->sysenter_esp = ctx->sysenter_esp;
+    env->sysenter_eip = ctx->sysenter_eip; env->star = ctx->star;
+#ifdef TARGET_X86_64
+    env->lstar = ctx->lstar; env->cstar = ctx->cstar;
+    env->fmask = ctx->fmask; env->kernelgsbase = ctx->kernelgsbase;
+#endif
+    env->interrupt_injected = ctx->interrupt_injected;
+    env->soft_interrupt = ctx->soft_interrupt;
+    env->nmi_injected = ctx->nmi_injected; env->nmi_pending = ctx->nmi_pending;
+    update_fp_status(env); update_mxcsr_status(env);
+    return true;
+}
