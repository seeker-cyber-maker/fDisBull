+static void digest_u64(GChecksum *sum, uint64_t value)
+{
+    uint8_t bytes[8]; stq_le_p(bytes, value); g_checksum_update(sum, bytes, sizeof(bytes));
+}
+
+static void digest_u32(GChecksum *sum, uint32_t value)
+{
+    uint8_t bytes[4]; stl_le_p(bytes, value); g_checksum_update(sum, bytes, sizeof(bytes));
+}
+
+static void digest_segment(GChecksum *sum, const TaskCpuSegment *seg)
+{
+    digest_u32(sum, seg->selector); digest_u64(sum, seg->base);
+    digest_u32(sum, seg->limit); digest_u32(sum, seg->flags);
+}
