+    for (unsigned i = 0; i < 8; i++) { digest_u64(sum, ctx->fp_low[i]); digest_u32(sum, ctx->fp_high[i]); digest_u32(sum, ctx->fptags[i]); }
+    digest_u32(sum, ctx->fpop); digest_u32(sum, ctx->fpcs); digest_u32(sum, ctx->fpds);
+    digest_u64(sum, ctx->fpip); digest_u64(sum, ctx->fpdp); digest_u32(sum, ctx->mxcsr);
+    for (unsigned i = 0; i < ARRAY_SIZE(ctx->xstate_qwords); i++) digest_u64(sum, ctx->xstate_qwords[i]);
+    digest_u64(sum, ctx->xcr0); digest_u64(sum, ctx->xstate_bv);
