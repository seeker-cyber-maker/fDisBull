+static TaskCpuSegment task_segment_from_cache(const SegmentCache *sc)
+{
+    return (TaskCpuSegment) { sc->selector, sc->base, sc->limit, sc->flags };
+}
+
+static void task_segment_to_cache(SegmentCache *sc, const TaskCpuSegment *src)
+{
+    sc->selector = src->selector;
+    sc->base = src->base;
+    sc->limit = src->limit;
+    sc->flags = src->flags;
+}
+
+static const char *task_cpu_mode(const CPUX86State *env)
+{
+    if (env->eflags & VM_MASK) return "v86";
+    if (!(env->cr[0] & CR0_PE_MASK)) return "real";
+    if (env->hflags & HF_LMA_MASK) return "long";
+    return "protected";
+}
+
+static bool task_cpu_mode_supported(const CPUX86State *env, Error **errp)
+{
+    if (!strcmp(task_cpu_mode(env), "long") || (env->cr[4] & CR4_PAE_MASK) ||
+        (env->hflags & (HF_SMM_MASK | HF_GUEST_MASK)) ||
+        (env->cr[4] & (CR4_PKE_MASK | CR4_PKS_MASK)) ||
+        (env->xcr0 & ~UINT64_C(3)) || (env->xstate_bv & ~UINT64_C(3))) {
+        task_error(errp, "native task contexts support only real, V86, and non-PAE 32-bit protected modes");
+        return false;
+    }
+    return true;
+}
+
+static void task_cpu_context_capture(TaskCpuContext *ctx, CPUX86State *env,
+                                     bool use_next_eip, target_ulong next_eip)
+{
+    memset(ctx, 0, sizeof(*ctx));
+    for (unsigned i = 0; i < 16; i++) ctx->registers[i] = env->regs[i];
+    for (unsigned i = 0; i < 4; i++) ctx->debug_registers[i] = env->dr[i];
+    ctx->debug_registers[4] = env->dr[6];
+    ctx->debug_registers[5] = env->dr[7];
+    ctx->eip = use_next_eip ? next_eip : env->eip;
+    ctx->eflags = cpu_compute_eflags(env);
+    /* QEMU migration may canonicalize lazy flags; store only their architectural value. */
+    ctx->cc_dst = 0; ctx->cc_src = ctx->eflags & (CC_C | CC_P | CC_A | CC_Z | CC_S | CC_O);
+    ctx->cc_src2 = 0; ctx->cc_op = CC_OP_EFLAGS;
+    ctx->df = (ctx->eflags & DF_MASK) ? -1 : 1;
+    ctx->hflags = env->hflags; ctx->hflags2 = env->hflags2;
+    for (unsigned i = 0; i < 6; i++) ctx->segments[i] = task_segment_from_cache(&env->segs[i]);
+    ctx->ldt = task_segment_from_cache(&env->ldt);
+    ctx->tr = task_segment_from_cache(&env->tr);
+    ctx->gdt = task_segment_from_cache(&env->gdt);
+    ctx->idt = task_segment_from_cache(&env->idt);
+    for (unsigned i = 0; i < 5; i++) ctx->cr[i] = env->cr[i];
+    ctx->pdptrs_valid = env->pdptrs_valid;
+    memcpy(ctx->pdptrs, env->pdptrs, sizeof(ctx->pdptrs));
+    ctx->a20_mask = env->a20_mask; ctx->efer = env->efer;
+    ctx->fpstt = env->fpstt; ctx->fpus = env->fpus; ctx->fpuc = env->fpuc;
+    memcpy(ctx->fptags, env->fptags, sizeof(ctx->fptags));
+    for (unsigned i = 0; i < 8; i++) {
+        ctx->fp_low[i] = env->fpregs[i].d.low;
+        ctx->fp_high[i] = env->fpregs[i].d.high;
+    }
+    ctx->fpop = env->fpop; ctx->fpcs = env->fpcs; ctx->fpds = env->fpds;
+    ctx->fpip = env->fpip; ctx->fpdp = env->fpdp;
+    ctx->mxcsr = env->mxcsr;
+    memcpy(ctx->xstate_qwords, env->xmm_regs, sizeof(ctx->xstate_qwords));
+    ctx->xcr0 = env->xcr0; ctx->xstate_bv = env->xstate_bv;
+    ctx->sysenter_cs = env->sysenter_cs; ctx->sysenter_esp = env->sysenter_esp;
+    ctx->sysenter_eip = env->sysenter_eip; ctx->star = env->star;
+#ifdef TARGET_X86_64
+    ctx->lstar = env->lstar; ctx->cstar = env->cstar;
+    ctx->fmask = env->fmask; ctx->kernelgsbase = env->kernelgsbase;
+#endif
+    ctx->interrupt_injected = env->interrupt_injected;
+    ctx->soft_interrupt = env->soft_interrupt;
+    ctx->nmi_injected = env->nmi_injected; ctx->nmi_pending = env->nmi_pending;
+    ctx->valid = true;
+}
