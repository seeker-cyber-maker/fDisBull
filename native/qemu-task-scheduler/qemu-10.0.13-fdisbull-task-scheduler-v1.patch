+static FdisbullTaskCpuSegment *qapi_segment(const TaskCpuSegment *seg)
+{
+    FdisbullTaskCpuSegment *out = g_new0(FdisbullTaskCpuSegment, 1);
+    out->selector = seg->selector; out->base = seg->base;
+    out->limit = seg->limit; out->flags = seg->flags;
+    return out;
+}
