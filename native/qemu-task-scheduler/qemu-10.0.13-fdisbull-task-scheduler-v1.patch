+    digest_u64(sum, ctx->eip); digest_u64(sum, ctx->eflags);
+    digest_u64(sum, ctx->cc_dst); digest_u64(sum, ctx->cc_src);
+    digest_u64(sum, ctx->cc_src2); digest_u32(sum, ctx->cc_op);
+    digest_u32(sum, ctx->df); digest_u32(sum, ctx->hflags);
+    digest_u32(sum, ctx->hflags2);
+    for (unsigned i = 0; i < 6; i++) digest_segment(sum, &ctx->segments[i]);
+    digest_segment(sum, &ctx->ldt); digest_segment(sum, &ctx->tr);
+    digest_segment(sum, &ctx->gdt); digest_segment(sum, &ctx->idt);
+    for (unsigned i = 0; i < 5; i++) digest_u64(sum, ctx->cr[i]);
