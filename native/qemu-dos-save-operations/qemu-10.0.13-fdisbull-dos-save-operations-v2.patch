+FdisbullDosSaveWitnessInfo *qmp_x_fdisbull_arm_dos_save_operations(
+    const char *token, uint16_t child_psp,
+    FdisbullDosSaveWitnessRangeList *source_ranges, const char *dos_path,
+    uint32_t int21_vector, bool initial_exists,
+    const char *initial_payload_hex, const char *temporary_path,
+    Error **errp)
+{
+    CPUState *cpu;
+    CPUX86State *env;
+    DosWitnessRange ranges[DOS_WITNESS_MAX_RANGES] = {0};
+    uint8_t initial[DOS_WITNESS_MAX_BYTES] = {0};
+    uint32_t count = 0, initial_size = 0;
+    char normalized[16] = {0}, temp[16] = {0};
+
+    if (!stopped_cpu(&cpu, &env, true, errp) || !witness_register_vmstate(errp)) {
+        return NULL;
+    }
+    if (witness.active || (witness.token[0] && witness.phase != 6)) {
+        error_setg(errp, "A DOS save witness is already active or unresolved");
+        return NULL;
+    }
+    if (!token_valid(token) || !child_psp || !int21_vector ||
+        !parse_ranges(source_ranges, ranges, &count, true, errp) ||
+        !normalize_dos_path(dos_path, normalized, errp) ||
+        !decode_initial_payload(initial_payload_hex, initial_exists, initial,
+                                &initial_size, errp)) {
+        if (errp && !*errp) error_setg(errp, "Invalid DOS save-operations identity");
+        return NULL;
+    }
+    if (temporary_path && temporary_path[0]) {
+        if (!normalize_dos_path(temporary_path, temp, errp) ||
+            !strcmp(temp, normalized)) {
+            if (errp && !*errp) error_setg(errp, "Temporary and final DOS paths must differ");
+            return NULL;
+        }
+    }
