+static bool decode_initial_payload(const char *hex, bool exists,
+                                   uint8_t *payload, uint32_t *size,
+                                   Error **errp)
+{
+    size_t n, i;
+    if (!hex) {
+        error_setg(errp, "Initial DOS payload is required");
+        return false;
+    }
+    n = strlen(hex);
+    if ((n & 1) || n / 2 > DOS_WITNESS_MAX_BYTES || (!exists && n)) {
+        error_setg(errp, "Initial DOS payload exceeds the bound or conflicts with existence");
+        return false;
+    }
+    for (i = 0; i < n; i += 2) {
+        int hi = g_ascii_xdigit_value(hex[i]);
+        int lo = g_ascii_xdigit_value(hex[i + 1]);
+        if (hi < 0 || lo < 0) {
+            error_setg(errp, "Initial DOS payload is not hexadecimal");
+            return false;
+        }
+        payload[i / 2] = (hi << 4) | lo;
+    }
+    *size = n / 2;
+    if (!exists && *size) {
+        error_setg(errp, "Absent initial DOS file must have an empty payload");
+        return false;
+    }
+    return true;
+}
