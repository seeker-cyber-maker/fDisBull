+        uint32_t actual_vector;
+        if (!read_int21_vector(cpu, &actual_vector) ||
+            actual_vector != int21_vector) {
+            error_setg(errp, "INT 21h vector differs from trusted kernel baseline");
+            return NULL;
+        }
+    }
+    memset(&witness, 0, sizeof(witness));
+    witness.epoch = epoch_highwater;
+    witness.child_psp = child_psp;
+    witness.int21_vector = int21_vector;
+    witness.created_handle = DOS_WITNESS_HANDLE_NONE;
+    witness.pending_handle = DOS_WITNESS_HANDLE_NONE;
+    witness.current_handle = DOS_WITNESS_HANDLE_NONE;
+    witness.range_count = count;
+    memcpy(witness.ranges, ranges, count * sizeof(ranges[0]));
+    memcpy(witness.initial_payload, initial, initial_size);
+    witness.initial_size = initial_size;
+    witness.initial_exists = initial_exists;
+    witness.final_exists = initial_exists;
+    g_strlcpy((char *)witness.token, token, sizeof(witness.token));
+    g_strlcpy((char *)witness.dos_path, normalized, sizeof(witness.dos_path));
+    g_strlcpy((char *)witness.temporary_path, temp, sizeof(witness.temporary_path));
