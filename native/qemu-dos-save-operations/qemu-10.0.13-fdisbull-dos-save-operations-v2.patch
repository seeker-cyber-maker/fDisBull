+        } else if (v2_path_is_temp((const char *)witness.pending_path)) {
+            witness.temporary_exists = false;
+        }
+        if (v2_path_is_final((const char *)witness.pending_destination)) {
+            witness.final_exists = true;
+        } else if (v2_path_is_temp((const char *)witness.pending_destination)) {
+            witness.temporary_exists = true;
