+/*
+ * Capture actual stored/native fields, without calling the renderer, reading
+ * guest ports or refreshing any cache.  Both sequencer banks are included:
+ * sr() alone would omit inactive configuration and derived VBE changes.
+ */
+static void vga_fdisbull_configuration_raw(VGACommonState *s,
+                                          VGAConfigurationState *raw)
+{
+    QEMU_BUILD_BUG_ON(VBE_DISPI_INDEX_NB != 10);
+    memset(raw, 0, sizeof(*raw));
+    memcpy(raw->sequencer, s->sr, sizeof(raw->sequencer));
+    memcpy(raw->sequencer_vbe, s->sr_vbe, sizeof(raw->sequencer_vbe));
+    memcpy(raw->graphics, s->gr, sizeof(raw->graphics));
+    memcpy(raw->crtc, s->cr, sizeof(raw->crtc));
+    memcpy(raw->attribute_controls, &s->ar[VGA_ATC_MODE],
+           sizeof(raw->attribute_controls));
+    memcpy(raw->vbe, s->vbe_regs, sizeof(raw->vbe));
+    raw->misc_output = s->msr;
+    raw->feature_control = s->fcr;
+    raw->display_enabled = (s->ar_index & 0x20) != 0;
+    raw->vbe_start_address = s->vbe_start_addr;
+    raw->vbe_line_offset = s->vbe_line_offset;
+    raw->vbe_bank_mask = s->vbe_bank_mask;
+    raw->bank_offset = s->bank_offset;
+    raw->dac_8bit = s->dac_8bit != 0;
+    raw->big_endian_framebuffer = s->big_endian_fb;
+    raw->vram_size = s->vram_size;
+    raw->vbe_size = s->vbe_size;
+    raw->vbe_size_mask = s->vbe_size_mask;
+}
+
+static void vga_fdisbull_configuration_init(VGACommonState *s)
+{
+    if (!s->fdisbull_retrace) {
+        return;
+    }
+    assert(!s->fdisbull_configuration_initialized);
+    s->fdisbull_configuration_generation = 1;
+    s->fdisbull_configuration_initialized = true;
+    vga_fdisbull_configuration_raw(s, &s->fdisbull_configuration_committed);
+}
+
+void vga_fdisbull_configuration_commit(VGACommonState *s, bool force)
+{
+    VGAConfigurationState raw;
+
+    /* QOM setters may run before realization; setup establishes identity. */
+    if (!s->fdisbull_retrace || !s->fdisbull_configuration_initialized) {
+        return;
+    }
+    assert(bql_locked());
+    if (s->fdisbull_configuration_invalidated && !force) {
+        return;
+    }
+    vga_fdisbull_configuration_raw(s, &raw);
+    if (!force && !memcmp(&raw, &s->fdisbull_configuration_committed,
+                          sizeof(raw))) {
+        return;
+    }
+    if (s->fdisbull_configuration_generation == UINT64_MAX) {
+        s->fdisbull_configuration_invalidated = true;
+        return;
+    }
+    s->fdisbull_configuration_generation++;
+    memcpy(&s->fdisbull_configuration_committed, &raw, sizeof(raw));
+}
+
+static uint8List *vga_fdisbull_configuration_bytes(const uint8_t *data,
+                                                 size_t length)
+{
+    uint8List *head = NULL;
+    uint8List **tail = &head;
+    size_t i;
+
+    for (i = 0; i < length; i++) {
+        QAPI_LIST_APPEND(tail, data[i]);
+    }
+    return head;
+}
+
+bool vga_fdisbull_configuration_query(
+    VGACommonState *s, FdisbullVgaConfigurationSnapshot *info, Error **errp)
+{
+    VGAConfigurationState observed;
+    const VGAConfigurationState *raw = &s->fdisbull_configuration_committed;
+    FdisbullVgaConfigurationRaw *result;
+    uint16List **tail;
+    unsigned i;
+
+    assert(bql_locked());
+    if (!s->fdisbull_retrace || s->retrace != vga_precise_retrace ||
+        s->update_retrace_info != vga_precise_update_retrace_info ||
+        !s->fdisbull_configuration_initialized) {
+        error_setg(errp, "VGA configuration requires initialized exact primary "
+                   "VGA with x-fdisbull-retrace=on and retrace=precise");
+        return false;
+    }
+    if (s->fdisbull_configuration_invalidated ||
+        !s->fdisbull_configuration_generation) {
+        error_setg(errp, "VGA configuration identity invalidated by overflow "
