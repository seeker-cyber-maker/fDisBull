+    g_autoptr(FdisbullRetraceInfo) retrace = NULL;
+    g_autoptr(FdisbullVgaConfigurationSnapshot) current = NULL;
+    FdisbullVgaConfigurationSnapshot *published;
+    FdisbullVgaConfigurationInfo *info;
+    Object *device;
+
+    assert(bql_locked());
+    /* Existing admission pins exactly one selected primary VGA and its epoch. */
+    retrace = qmp_x_fdisbull_query_retrace(errp);
+    if (!retrace || !display_guard(errp)) {
+        return NULL;
+    }
+    device = object_resolve_path(retrace->device, NULL);
+    if (!device || (display_window.device && display_window.device != device)) {
+        display_invalidate("configuration device differs from display owner");
+        error_setg(errp, "VGA configuration and display device identity differ");
+        return NULL;
+    }
+    current = pci_std_vga_fdisbull_configuration_snapshot(
+        device, retrace->epoch, retrace->virtual_ns, errp);
+    if (!current) {
+        return NULL;
+    }
+    if (current->epoch != display_window.epoch ||
+        current->virtual_ns != qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL)) {
+        display_invalidate("configuration clock differs from stopped display");
+        error_setg(errp, "VGA configuration clock changed across stopped query");
+        return NULL;
+    }
+    published = display_window.published_configuration;
+    if (!!display_window.rgb != !!published ||
+        (published && (published->epoch != current->epoch ||
+          published->virtual_ns != display_window.published_ns ||
+          published->virtual_ns > current->virtual_ns ||
+          published->configuration_generation > current->configuration_generation ||
+          strcmp(published->device, current->device)))) {
+        display_invalidate("retained configuration stamp is missing or incoherent");
+        error_setg(errp, "Retained VGA configuration identity is unavailable; "
+                   "current state cannot replace a publication stamp");
+        return NULL;
+    }
+    info = g_new0(FdisbullVgaConfigurationInfo, 1);
+    info->display = display_info();
+    info->current = g_steal_pointer(&current);
+    info->published = QAPI_CLONE(FdisbullVgaConfigurationSnapshot, published);
+    return info;
+}
