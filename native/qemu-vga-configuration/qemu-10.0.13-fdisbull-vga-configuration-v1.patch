+    info->configuration_generation = s->fdisbull_configuration_generation;
+    result = info->raw = g_new0(FdisbullVgaConfigurationRaw, 1);
+    result->sequencer = vga_fdisbull_configuration_bytes(
+        raw->sequencer, sizeof(raw->sequencer));
+    result->sequencer_vbe = vga_fdisbull_configuration_bytes(
+        raw->sequencer_vbe, sizeof(raw->sequencer_vbe));
+    result->graphics = vga_fdisbull_configuration_bytes(
