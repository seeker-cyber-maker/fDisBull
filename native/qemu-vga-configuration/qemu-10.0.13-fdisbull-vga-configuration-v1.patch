+    result->crtc = vga_fdisbull_configuration_bytes(raw->crtc, sizeof(raw->crtc));
+    result->attribute_controls = vga_fdisbull_configuration_bytes(
+        raw->attribute_controls, sizeof(raw->attribute_controls));
+    tail = &result->vbe;
+    for (i = 0; i < ARRAY_SIZE(raw->vbe); i++) {
+        QAPI_LIST_APPEND(tail, raw->vbe[i]);
+    }
+    result->misc_output = raw->misc_output;
+    result->feature_control = raw->feature_control;
+    result->display_enabled = raw->display_enabled;
+    result->vbe_start_address = raw->vbe_start_address;
+    result->vbe_line_offset = raw->vbe_line_offset;
+    result->vbe_bank_mask = raw->vbe_bank_mask;
+    result->bank_offset = raw->bank_offset;
+    result->dac_8bit = raw->dac_8bit;
+    result->big_endian_framebuffer = raw->big_endian_framebuffer;
+    result->vram_size = raw->vram_size;
+    result->vbe_size = raw->vbe_size;
+    result->vbe_size_mask = raw->vbe_size_mask;
+    return true;
+}
