+# Experimental bounded standard VGA configuration observations, API/model 1.
+{ 'include': 'fdisbull-display.json' }
+
+##
+# @FdisbullVgaConfigurationRaw:
+#
+# Conservative stored configuration vector for exact primary standard VGA.
+# DAC and attribute palette entries, VRAM/fonts, ordinary index selectors,
+# flip-flops, status/latch values, renderer caches and cursor blink are excluded.
+# These bytes do not constitute a BIOS mode number or guest cursor mapping.
+#
+# @sequencer: Eight stored legacy sequencer bytes, indices 0..7.
+# @sequencer-vbe: Eight stored VBE sequencer bytes, indices 0..7.
+# @graphics: Sixteen stored graphics-controller bytes, indices 0..15.
+# @crtc: All 256 stored CRTC bytes, conservatively including cursor and unused
+#     controls even when a changed byte does not alter the current geometry.
+# @attribute-controls: Five stored attribute controls, indices 0x10..0x14.
+#     Attribute palette entries 0x00..0x0f are deliberately excluded.
+# @vbe: Ten stored Bochs VBE words, indices 0..9.  Read-only video-memory-size
+#     index 0x0a is outside this array.
+# @misc-output: Stored miscellaneous output byte.
+# @feature-control: Stored feature-control byte.
+# @display-enabled: Attribute index bit 5, which controls display blanking.
+# @vbe-start-address: Derived VBE start address in native four-byte units.
+# @vbe-line-offset: Derived VBE line offset in bytes.
+# @vbe-bank-mask: Native VBE bank mask.
+# @bank-offset: Native banked legacy-aperture byte offset.
+# @dac-8bit: Whether the 256-color DAC uses full eight-bit values.
+# @big-endian-framebuffer: Native framebuffer byte interpretation.
+# @vram-size: Allocated native VRAM bytes.
+# @vbe-size: Native VBE addressing size in bytes.
+# @vbe-size-mask: Native VBE address-wrap mask.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullVgaConfigurationRaw',
+  'data': { 'sequencer': [ 'uint8' ], 'sequencer-vbe': [ 'uint8' ],
+            'graphics': [ 'uint8' ], 'crtc': [ 'uint8' ],
+            'attribute-controls': [ 'uint8' ], 'vbe': [ 'uint16' ],
+            'misc-output': 'uint8', 'feature-control': 'uint8',
+            'display-enabled': 'bool', 'vbe-start-address': 'uint32',
+            'vbe-line-offset': 'uint32', 'vbe-bank-mask': 'uint32',
+            'bank-offset': 'int32', 'dac-8bit': 'bool',
+            'big-endian-framebuffer': 'bool', 'vram-size': 'uint32',
+            'vbe-size': 'uint32', 'vbe-size-mask': 'uint32' } }
+
+##
+# @FdisbullVgaConfigurationSnapshot:
+#
+# A bounded configuration observation, independent of renderer window IDs.
+# It describes configuration observed at its timestamp; it does not prove
+# that retained RGB pixels were freshly rendered using that configuration.
+#
+# @api-version: Private configuration protocol version, one.
+# @model: qemu-vga-configuration-fdisbull-v1.
+# @epoch: Native virtual-clock epoch.
+# @virtual-ns: QEMU_CLOCK_VIRTUAL observation timestamp.
+# @device: Exact canonical QOM path of the primary VGA device.
+# @device-type: Exact native type name, VGA.
+# @console: Console index, zero.
+# @head: Display head, zero.
+# @configuration-generation: Positive process/device-local identity for the
+#     committed tracked vector.  Each effective mutator change advances it;
+#     reset always advances it.  A-to-B-to-A changes cannot reuse identity.
+# @raw: Exact committed bounded configuration vector.
+#
+# Palette and VRAM content can change without changing this generation.
+# A generation is not a guest frame, BIOS mode ID or coordinate-mapping proof.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullVgaConfigurationSnapshot',
+  'data': { 'api-version': 'int', 'model': 'str', 'epoch': 'uint64',
+            'virtual-ns': 'int', 'device': 'str', 'device-type': 'str',
+            'console': 'int', 'head': 'int',
+            'configuration-generation': 'uint64',
+            'raw': 'FdisbullVgaConfigurationRaw' } }
+
+##
+# @FdisbullVgaConfigurationInfo:
+#
+# One atomic stopped observation of current configuration and display history.
+#
+# @display: Existing renderer observer receipt, without changes to its schema.
+# @current: Configuration observed at this stopped query.
+# @published: Configuration observed alongside the retained RGB publication.
+#     Present exactly when a publication exists on the selected precise path.
+#     This is a frozen observation, never reconstructed from current state.
+#
+# A renderer callback can preserve older surface pixels in transient modes.
+# Even matching current and published configuration does not prove raster
+# coherence, complete guest drawing, VBlank or a guest mouse mapping.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullVgaConfigurationInfo',
+  'data': { 'display': 'FdisbullDisplayInfo',
+            'current': 'FdisbullVgaConfigurationSnapshot',
+            '*published': 'FdisbullVgaConfigurationSnapshot' } }
+
+##
+# @x-fdisbull-query-vga-configuration:
+#
+# Observe current configuration and the optional retained publication stamp
+# under BQL.  Requires the stopped native virtual-clock and precise retrace
+# profile, including admission of exactly one primary VGA device.  Reuses
+# the existing stopped retrace ownership/migration guard and display guard.
+#
+# This command performs no guest I/O, rendering, timer action, execution,
+# sleeping, image/file export or implicit synchronization.  Missing retained
+# stamps, unexplained raw changes, overflow or restored identity are errors;
+# querying never repairs state or assigns current configuration to old pixels.
+# Existing display query/export/probe responses remain unchanged.
+#
+# Returns: Current and retained configuration observations.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-query-vga-configuration',
+  'returns': 'FdisbullVgaConfigurationInfo' }
