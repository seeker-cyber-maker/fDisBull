+##
+# Experimental physical RAM layering for a stopped, single-vCPU TCG machine.
+##
+
+##
+# @FdisbullLayerPatch:
+# One guarded physical RAM byte range.
+#
+# @address: guest physical start address
+# @before: expected lowercase hex bytes
+# @after: replacement lowercase hex bytes
+##
+{ 'struct': 'FdisbullLayerPatch',
+  'data': { 'address': 'uint64', 'before': 'str', 'after': 'str' } }
+
+##
+# @FdisbullLayerConfigureInfo:
+# Result of one atomic layer transition.
+#
+# @generation: new layer generation
+# @ram-bytes: number of real RAM bytes changed
+# @execution-bytes: number of active fetch-overlay bytes
+# @fault: optional fail-closed guest self-modification report
+##
+{ 'struct': 'FdisbullLayerConfigureInfo',
+  'data': { 'generation': 'uint64', 'ram-bytes': 'uint64',
+            'execution-bytes': 'uint64', '*fault': 'str' } }
+
+##
+# @FdisbullLayerObserveInfo:
+# Current layer ownership and optional effective fetch bytes.
+#
+# @generation: current layer generation
+# @execution-bytes: number of active fetch-overlay bytes
+# @data-hex: optional effective instruction-fetch bytes
+# @fault: optional fail-closed guest self-modification report
+##
+{ 'struct': 'FdisbullLayerObserveInfo',
+  'data': { 'generation': 'uint64', 'execution-bytes': 'uint64',
+            '*data-hex': 'str', '*fault': 'str' } }
+
+##
+# @x-fdisbull-layer-configure:
+# Atomically guarded, stopped-machine RAM writes and physical-RAM instruction
+# fetch overlays. Addresses are guest physical. RAM changes are real guest RAM;
+# execute bytes affect only TCG translation and are never exposed by data reads.
+#
+# @generation: expected current generation
+# @ram: guarded real-RAM writes
+# @execute: guarded physical instruction-fetch overlays
+##
+{ 'command': 'x-fdisbull-layer-configure',
+  'data': { 'generation': 'uint64', 'ram': [ 'FdisbullLayerPatch' ],
+            'execute': [ 'FdisbullLayerPatch' ] },
+  'returns': 'FdisbullLayerConfigureInfo' }
+
+##
+# @x-fdisbull-layer-observe:
+# Report current generation and execution overlay size. With address and length,
+# also return the effective TCG fetch view for that physical RAM span.
+#
+# @address: optional guest physical address to observe
+# @length: optional byte count to return
+##
+{ 'command': 'x-fdisbull-layer-observe',
+  'data': { '*address': 'uint64', '*length': 'uint16' },
+  'returns': 'FdisbullLayerObserveInfo' }
