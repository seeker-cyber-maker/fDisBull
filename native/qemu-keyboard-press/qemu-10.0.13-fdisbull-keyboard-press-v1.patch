+static FdisbullInputBatch *input_press_prepare_step(QKeyCode code, bool down,
+                                                    Error **errp)
+{
+    KeyValue key = { .type = KEY_VALUE_KIND_QCODE,
+                     .u.qcode = { .data = code } };
+    InputKeyEvent key_event = { .key = &key, .down = down };
+    InputEvent event = { .type = INPUT_EVENT_KIND_KEY,
+                         .u.key = { .data = &key_event } };
+    InputEventList events = { .value = &event };
+
+    /* prepare() pins the handler and deep-copies this temporary one-event list. */
+    return qemu_input_fdisbull_prepare(&events, errp);
+}
+
+FdisbullInputInfo *qmp_x_fdisbull_arm_keyboard_press(
+    const char *token, QKeyCode key, QKeyCodeList *modifiers,
+    int64_t hold_ms, int64_t gap_ms, Error **errp)
+{
+    g_autoptr(FdisbullInputPress) press = NULL;
+    FdisbullInputBatch *batches[INPUT_MAX_PRESS_STEPS] = { 0 };
+    FdisbullInputPressStepList **tail;
+    QKeyCodeList *modifier;
+    QKeyCode order[3];
+    unsigned modifier_count = 0, count, i, j;
+    int64_t now, horizon;
+
+    if (!input_arm_guard(token, errp)) {
+        return NULL;
+    }
+    if (hold_ms < 1 || hold_ms > 1000 || gap_ms < 1 || gap_ms > 1000) {
+        error_setg(errp, "Keyboard press hold-ms and gap-ms must be 1..1000");
+        return NULL;
+    }
+    for (modifier = modifiers; modifier; modifier = modifier->next) {
+        if (modifier_count == G_N_ELEMENTS(order) ||
+            (modifier->value != Q_KEY_CODE_CTRL &&
+             modifier->value != Q_KEY_CODE_ALT &&
+             modifier->value != Q_KEY_CODE_SHIFT) || modifier->value == key) {
+            error_setg(errp, "Keyboard press requires at most three distinct "
+                       "ctrl/alt/shift modifiers, excluding the main key");
+            return NULL;
+        }
+        for (j = 0; j < modifier_count; j++) {
+            if (order[j] == modifier->value) {
+                error_setg(errp, "Keyboard press modifiers must be distinct");
+                return NULL;
+            }
+        }
+        order[modifier_count++] = modifier->value;
+    }
+
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    horizon = (2 * modifier_count + 1) * INPUT_PRESS_EDGE_DELAY_NS +
+              hold_ms * SCALE_MS;
+    if (now < 0 || now > INT64_MAX - horizon) {
+        error_setg(errp, "Keyboard press nominal horizon exceeds signed time");
+        return NULL;
+    }
+    count = 2 * (modifier_count + 1);
+    press = g_new0(FdisbullInputPress, 1);
+    press->key = key;
+    press->modifiers = QAPI_CLONE(QKeyCodeList, modifiers);
+    press->hold_ms = hold_ms;
+    press->gap_ms = gap_ms;
+    tail = &press->steps;
+    for (i = 0; i < count; i++) {
+        FdisbullInputPressStepList *node = g_new0(FdisbullInputPressStepList, 1);
+        FdisbullInputPressStep *step = g_new0(FdisbullInputPressStep, 1);
+
+        *tail = node;
+        node->value = step;
+        tail = &node->next;
+        step->down = i <= modifier_count;
+        step->key = i < modifier_count ? order[i] :
+                    i <= modifier_count + 1 ? key : order[count - 1 - i];
+        step->delay_ns = i == modifier_count + 1 ? hold_ms * SCALE_MS :
+                                                 INPUT_PRESS_EDGE_DELAY_NS;
+        if (i == 0) {
+            step->has_deadline_ns = true;
+            step->deadline_ns = now + step->delay_ns;
+        }
+        batches[i] = input_press_prepare_step(step->key, step->down, errp);
+        if (!batches[i]) {
+            goto fail;
+        }
+    }
+    if (!input_block_migration(errp)) {
+        goto fail;
+    }
+
+    input_schedule.batch = NULL;
+    g_clear_pointer(&input_schedule.retrace, qapi_free_FdisbullInputRetrace);
+    input_press_free_batches();
+    qapi_free_FdisbullInputPress(input_schedule.press);
+    input_schedule.press = g_steal_pointer(&press);
+    input_schedule.press_next = input_schedule.press->steps;
+    for (i = 0; i < count; i++) {
+        input_schedule.press_batches[i] = batches[i];
+        batches[i] = NULL;
+    }
+    input_arm_commit(token, now,
+                     input_schedule.press_next->value->deadline_ns, count);
+    return input_info();
+
+fail:
+    for (i = 0; i < INPUT_MAX_PRESS_STEPS; i++) {
+        qemu_input_fdisbull_free(batches[i]);
+    }
+    return NULL;
+}
+
 FdisbullInputInfo *qmp_x_fdisbull_cancel_input(const char *token, Error **errp)
 {
     if (!input_guard(errp)) {
