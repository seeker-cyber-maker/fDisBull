+static void input_press_dispatch(int64_t now)
+{
+    FdisbullInputPress *press = input_schedule.press;
+    FdisbullInputPressStepList *node = input_schedule.press_next;
+    FdisbullInputPressStep *step;
+    uint64_t index = press->dispatched_count;
+    int64_t actual;
+    Error *err = NULL;
+
+    if (!node || index >= input_schedule.event_count ||
+        index >= INPUT_MAX_PRESS_STEPS || !input_schedule.press_batches[index]) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "keyboard press lost its next owned step");
+        return;
+    }
+    step = node->value;
+    if (!step->has_deadline_ns || step->has_dispatch_ns ||
+        now < step->deadline_ns) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "keyboard press timer preceded its current deadline");
+        return;
+    }
+    /*
+     * No guest instruction executes during the synchronous handler/sync pair.
+     * Check the following deadline before this callback so overflow preserves
+     * the already known prefix and immediate next step without dispatch.
+     */
+    if (node->next && now > INT64_MAX - node->next->value->delay_ns) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "keyboard press next deadline would overflow");
+        return;
+    }
+    if (!qemu_input_fdisbull_dispatch(input_schedule.press_batches[index], &err)) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     err ? error_get_pretty(err) : "keyboard press dispatch failed");
+        error_free(err);
+        return;
+    }
+
+    actual = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    step->has_dispatch_ns = true;
+    step->dispatch_ns = actual;
+    press->dispatched_count++;
+    qemu_input_fdisbull_free(input_schedule.press_batches[index]);
+    input_schedule.press_batches[index] = NULL;
+    if (actual != now) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "virtual time changed inside synchronous press callback");
+        return;
+    }
+    if (!node->next) {
+        input_finish(FDISBULL_INPUT_STATE_DISPATCHED, "dispatch-complete");
+        return;
+    }
+    input_schedule.press_next = node->next;
+    step = node->next->value;
+    step->has_deadline_ns = true;
+    step->deadline_ns = actual + step->delay_ns;
+    timer_mod_ns(&input_schedule.timer, step->deadline_ns);
+}
