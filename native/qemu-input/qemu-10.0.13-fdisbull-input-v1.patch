+
+static QemuInputHandlerState *
+fdisbull_input_target(FdisbullInputTarget *target, InputEventKind kind,
+                     bool capture, Error **errp)
+{
+    bool keyboard = kind == INPUT_EVENT_KIND_KEY;
+    const char *type = keyboard ? TYPE_PS2_KBD_DEVICE : TYPE_PS2_MOUSE_DEVICE;
+    uint32_t mask = keyboard ? INPUT_EVENT_MASK_KEY :
+        INPUT_EVENT_MASK_BTN | INPUT_EVENT_MASK_REL;
+    QemuInputHandlerState *s = qemu_input_find_handler(1U << kind, NULL);
+
+    if (!s || !s->dev || !s->dev->realized ||
+        strcmp(object_get_typename(OBJECT(s->dev)), type) ||
+        s->handler->mask != mask || !s->handler->event ||
+        (keyboard ? s->handler->sync != NULL : s->handler->sync == NULL)) {
+        error_setg(errp, "fDisBull input requires the selected %s handler",
+                   type);
+        return NULL;
+    }
+
+    if (capture && !target->dev) {
+        target->dev = s->dev;
+        object_ref(OBJECT(target->dev));
+        target->handler_id = s->id;
+        target->event = s->handler->event;
+        target->sync = s->handler->sync;
+    }
+
+    /* Reselect live handler state; never retain its unregisterable pointer. */
+    if (target->dev != s->dev || target->handler_id != s->id ||
+        target->event != s->handler->event ||
+        target->sync != s->handler->sync) {
+        error_setg(errp, "fDisBull input selected %s handler changed", type);
+        return NULL;
+    }
+    return s;
+}
+
+static bool fdisbull_input_key_mapped(PS2KbdState *kbd, InputKeyEvent *key,
+                                      Error **errp)
+{
+    const guint16 *map;
+    guint length;
+    int qcode = key->key->u.qcode.data;
+
+    if (qcode < 0 || qcode >= Q_KEY_CODE__MAX) {
+        error_setg(errp, "fDisBull input requires a valid qcode");
+        return false;
+    }
+    if (qcode == Q_KEY_CODE_SYSRQ) {
+        qcode = Q_KEY_CODE_PRINT;
+    }
+    switch (kbd->scancode_set) {
+    case 1:
+        map = qemu_input_map_qcode_to_atset1;
+        length = qemu_input_map_qcode_to_atset1_len;
+        break;
+    case 2:
+        map = qemu_input_map_qcode_to_atset2;
+        length = qemu_input_map_qcode_to_atset2_len;
+        break;
+    case 3:
+        map = qemu_input_map_qcode_to_atset3;
+        length = qemu_input_map_qcode_to_atset3_len;
+        break;
+    default:
+        error_setg(errp, "fDisBull input PS/2 scancode set is unsupported");
+        return false;
+    }
+    if ((guint)qcode >= length || !map[qcode]) {
+        error_setg(errp, "fDisBull input qcode has no PS/2 scancode mapping");
+        return false;
+    }
+    return true;
+}
+
+static bool fdisbull_input_preflight(FdisbullInputBatch *batch,
+                                    InputEventList *events, bool capture,
+                                    Error **errp)
+{
+    QemuInputHandlerState *s;
+    InputEventList *e;
+    unsigned count = 0;
+    unsigned buttons = 0;
+    bool have_mouse = false;
+    int64_t mouse_dx = 0;
+    int64_t mouse_dy = 0;
+
+    assert(bql_locked());
+    if (replay_mode != REPLAY_MODE_NONE) {
+        error_setg(errp, "fDisBull input does not support replay");
+        return false;
+    }
+    if (!events) {
+        error_setg(errp, "fDisBull input batch must not be empty");
+        return false;
+    }
+    if (!QTAILQ_EMPTY(&kbd_queue) || queue_count ||
+        (kbd_timer && timer_pending(kbd_timer))) {
+        error_setg(errp, "fDisBull input requires an empty keyboard queue");
+        return false;
+    }
+    QTAILQ_FOREACH(s, &handlers, node) {
+        if (s->events) {
+            error_setg(errp, "fDisBull input requires synchronized handlers");
+            return false;
+        }
+    }
+
+    for (e = events; e; e = e->next) {
+        InputEvent *evt = e->value;
+        InputMoveEvent *move;
+        InputBtnEvent *button;
+        PS2MouseState *mouse;
+
+        if (++count > FDISBULL_INPUT_MAX_EVENTS) {
+            error_setg(errp, "fDisBull input batch exceeds %d events",
+                       FDISBULL_INPUT_MAX_EVENTS);
+            return false;
+        }
+        if (!evt) {
+            error_setg(errp, "fDisBull input event must not be null");
+            return false;
+        }
+        switch (evt->type) {
+        case INPUT_EVENT_KIND_KEY:
+            if (!evt->u.key.data || !evt->u.key.data->key ||
+                evt->u.key.data->key->type != KEY_VALUE_KIND_QCODE) {
+                error_setg(errp, "fDisBull input keys must use qcodes");
+                return false;
+            }
+            s = fdisbull_input_target(&batch->keyboard, evt->type,
+                                      capture, errp);
+            if (!s || !fdisbull_input_key_mapped(PS2_KBD_DEVICE(s->dev),
+                                               evt->u.key.data, errp)) {
+                return false;
+            }
+            break;
+        case INPUT_EVENT_KIND_REL:
+        case INPUT_EVENT_KIND_BTN:
+            s = fdisbull_input_target(&batch->mouse, evt->type, capture, errp);
+            if (!s) {
+                return false;
+            }
+            if (!have_mouse) {
+                mouse = PS2_MOUSE_DEVICE(s->dev);
+                mouse_dx = mouse->mouse_dx;
+                mouse_dy = mouse->mouse_dy;
+                have_mouse = true;
+            }
+            if (evt->type == INPUT_EVENT_KIND_BTN) {
+                button = evt->u.btn.data;
+                if (!button ||
+                    (button->button != INPUT_BUTTON_LEFT &&
+                     button->button != INPUT_BUTTON_MIDDLE &&
+                     button->button != INPUT_BUTTON_RIGHT)) {
+                    error_setg(errp, "fDisBull input requires ordinary "
+                               "PS/2 mouse buttons");
+                    return false;
+                }
+                if (buttons & (1U << button->button)) {
+                    error_setg(errp, "fDisBull input allows one edge per "
+                               "mouse button in a batch");
+                    return false;
+                }
+                buttons |= 1U << button->button;
+                break;
+            }
+            move = evt->u.rel.data;
+            if (!move ||
+                (move->axis != INPUT_AXIS_X && move->axis != INPUT_AXIS_Y) ||
+                move->value < -FDISBULL_INPUT_REL_LIMIT ||
+                move->value > FDISBULL_INPUT_REL_LIMIT) {
+                error_setg(errp, "fDisBull input requires relative X/Y "
+                           "values in -32767..32767");
+                return false;
+            }
+            if (move->axis == INPUT_AXIS_X) {
+                mouse_dx += move->value;
+            } else {
+                mouse_dy -= move->value;
+            }
+            if (mouse_dx < INT_MIN || mouse_dx > INT_MAX ||
+                mouse_dy < INT_MIN || mouse_dy > INT_MAX) {
+                error_setg(errp, "fDisBull input mouse accumulator overflow");
+                return false;
+            }
+            break;
+        default:
+            error_setg(errp, "fDisBull input supports only qcode keys, "
+                       "relative X/Y motion and ordinary mouse buttons");
+            return false;
+        }
+    }
+    if (capture) {
+        batch->count = count;
+    }
+    return true;
+}
+
+FdisbullInputBatch *qemu_input_fdisbull_prepare(InputEventList *events,
+                                             Error **errp)
+{
+    FdisbullInputBatch *batch = g_new0(FdisbullInputBatch, 1);
+
+    if (!fdisbull_input_preflight(batch, events, true, errp)) {
+        qemu_input_fdisbull_free(batch);
+        return NULL;
+    }
+    batch->events = QAPI_CLONE(InputEventList, events);
+    return batch;
+}
+
+bool qemu_input_fdisbull_dispatch(FdisbullInputBatch *batch, Error **errp)
+{
+    InputEventList *e;
+
+    assert(bql_locked());
+    if (!batch || batch->dispatched) {
+        error_setg(errp, "fDisBull input batch is absent or already dispatched");
+        return false;
+    }
+    if (!runstate_is_running()) {
+        error_setg(errp, "fDisBull input dispatch requires a running VM");
+        return false;
+    }
+    if (!fdisbull_input_preflight(batch, batch->events, false, errp)) {
+        return false;
+    }
+
+    /* All failure checks precede the first callback; no delayed key helper. */
+    batch->dispatched = true;
+    for (e = batch->events; e; e = e->next) {
+        qemu_input_event_send(NULL, e->value);
+    }
+    qemu_input_event_sync();
+    return true;
+}
+
+void qemu_input_fdisbull_free(FdisbullInputBatch *batch)
+{
+    assert(bql_locked());
+    if (!batch) {
+        return;
+    }
+    qapi_free_InputEventList(batch->events);
+    if (batch->keyboard.dev) {
+        object_unref(OBJECT(batch->keyboard.dev));
+    }
+    if (batch->mouse.dev) {
+        object_unref(OBJECT(batch->mouse.dev));
+    }
+    g_free(batch);
+}
+
+unsigned qemu_input_fdisbull_count(const FdisbullInputBatch *batch)
+{
+    return batch ? batch->count : 0;
 }
 
