+# Experimental fDisBull one-shot physical input scheduling, API 1.
+{ 'include': 'ui.json' }
+
+##
+# @FdisbullInputState:
+#
+# @idle: No schedule has been armed.
+# @armed: One owned batch is waiting for its virtual deadline.
+# @dispatched: All selected PS/2 handler callbacks and final sync completed.
+# @cancelled: The batch was disarmed without dispatch.
+# @failed: Pre-dispatch revalidation failed; close the VM.
+#
+# Since: 10.0
+##
+{ 'enum': 'FdisbullInputState',
+  'data': [ 'idle', 'armed', 'dispatched', 'cancelled', 'failed' ] }
+
+##
+# @FdisbullInputInfo:
+#
+# @api-version: Scheduling protocol version, one.
+# @epoch: Native clock epoch bound to this scheduler.
+# @state: State of the most recent owned schedule.
+# @virtual-ns: Stopped observation time.
+# @event-count: Number of events in this batch; zero before the first arm.
+# @token: Owning token, absent before the first successful arm.
+# @start-ns: Virtual time at arm, absent before the first successful arm.
+# @deadline-ns: Requested virtual deadline, absent before the first arm.
+# @terminal-ns: Actual terminal transition time; absent while idle or armed.
+# @dispatch-ns: Actual handler/sync completion time; only present if dispatched.
+# @reason: Terminal reason of at most 256 bytes; absent while idle or armed.
+#
+# Terminal fields are retained unchanged until a new token is accepted.
+# Dispatch does not establish PS/2 queue acceptance, guest consumption, or
+# physical release of an earlier held input.  A full or disabled device can
+# ignore an event even though its handler callback completed.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullInputInfo',
+  'data': { 'api-version': 'int', 'epoch': 'uint64',
+            'state': 'FdisbullInputState', 'virtual-ns': 'int',
+            'event-count': 'uint64', '*token': 'str', '*start-ns': 'int',
+            '*deadline-ns': 'int', '*terminal-ns': 'int',
+            '*dispatch-ns': 'int', '*reason': 'str' } }
+
+##
+# @x-fdisbull-query-input:
+#
+# Observe the latest schedule without dispatching input or running the VM.
+# Requires the valid stopped native virtual-clock API 1 profile.
+#
+# Returns: Schedule receipt.
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-query-input', 'returns': 'FdisbullInputInfo' }
+
+##
+# @x-fdisbull-arm-input:
+#
+# @token: Unused owner token of 1..128 bytes.
+# @delta-ns: Virtual delay, 1..60000000000 nanoseconds, without signed overflow.
+# @events: Owned batch of 1..256 qcode key, relative X/Y, or ordinary button
+#     events.  Relative values are bounded to -32767..32767.  Only left, middle
+#     and right buttons are admitted, with at most one edge per button.
+#
+# Validate and copy one batch while stopped.  Arm does not run the VM or emit
+# input.  At the deadline, revalidate the same PS/2 device/handler identities,
+# empty legacy keyboard queue, absence of earlier unsynchronized input, and
+# cumulative mouse arithmetic before dispatching any event and one final sync.
+# A pending stop or reached clock-budget deadline takes precedence.  The first
+# actual VM stop cancels an unfired batch, so later execution cannot replay it.
+# Cancellation never synthesizes releases or changes existing held input.
+#
+# Reset, an unsupported VM state or native epoch/profile loss invalidates the
+# scheduler and makes subsequent commands fail.  Migration stays blocked after
+# the first successful arm.  Tokens cannot be reused; a bounded process-lifetime
+# history permits 4096 successful arms, after which a new VM is required.
+#
+# Returns: Armed receipt.
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-arm-input',
+  'data': { 'token': 'str', 'delta-ns': 'int', 'events': ['InputEvent'] },
+  'returns': 'FdisbullInputInfo' }
+
+##
+# @x-fdisbull-cancel-input:
+#
+# @token: Current owner token.
+#
+# Disarm the current unfired schedule while stopped.  Cancellation is idempotent
+# and preserves an already terminal receipt.  It cannot undo dispatched events,
+# release held input, clear device queues, or run the VM.
+#
+# Returns: Retained schedule receipt.
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-cancel-input', 'data': { 'token': 'str' },
+  'returns': 'FdisbullInputInfo' }
