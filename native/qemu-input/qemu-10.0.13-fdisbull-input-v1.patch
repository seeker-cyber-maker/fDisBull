+/*
+ * Explicit one-shot fDisBull physical input scheduling, protocol version 1.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * All live accesses are serialized by BQL.  The virtual timer dispatches an
+ * owned batch through the selected PS/2 input handlers.  It never resumes or
+ * stops the VM, releases held input, or claims that the guest consumed input.
+ */
+#include "qemu/osdep.h"
+#include "hw/core/cpu.h"
+#include "migration/blocker.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-fdisbull-input.h"
+#include "qapi/qapi-commands-run-state.h"
+#include "qemu/main-loop.h"
+#include "qemu/timer.h"
+#include "system/cpus.h"
+#include "system/fdisbull-clock.h"
+#include "system/reset.h"
+#include "system/runstate.h"
+#include "ui/input.h"
+
+#define INPUT_MAX_DELTA_NS INT64_C(60000000000)
+#define INPUT_MAX_TOKEN_BYTES 128
+#define INPUT_MAX_USED_TOKENS 4096
+#define INPUT_MAX_REASON_BYTES 256
+
+static struct {
+    bool initialized;
+    bool invalidated;
+    uint64_t epoch;
+    FdisbullInputState state;
+    QEMUTimer timer;
+    Error *migration_blocker;
+    GHashTable *used_tokens;
+    FdisbullInputBatch *batch;
+    char *token;
+    char *reason;
+    uint64_t event_count;
+    int64_t start_ns;
+    int64_t deadline_ns;
+    bool has_terminal;
+    int64_t terminal_ns;
+    bool has_dispatch;
+    int64_t dispatch_ns;
+} input_schedule = {
+    .state = FDISBULL_INPUT_STATE_IDLE,
+};
+
+static void input_timer_cb(void *opaque);
+
+static bool input_safe_state(RunState state)
+{
+    return state == RUN_STATE_PRELAUNCH || state == RUN_STATE_PAUSED ||
+           state == RUN_STATE_DEBUG;
+}
+
+static void input_finish(FdisbullInputState state, const char *reason)
+{
+    assert(bql_locked());
+    if (input_schedule.state != FDISBULL_INPUT_STATE_ARMED) {
+        return;
+    }
+    timer_del(&input_schedule.timer);
+    input_schedule.state = state;
+    input_schedule.has_terminal = true;
+    input_schedule.terminal_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    input_schedule.has_dispatch = state == FDISBULL_INPUT_STATE_DISPATCHED;
+    if (input_schedule.has_dispatch) {
+        input_schedule.dispatch_ns = input_schedule.terminal_ns;
+    }
+    g_free(input_schedule.reason);
+    input_schedule.reason = g_strndup(reason, INPUT_MAX_REASON_BYTES);
+    qemu_input_fdisbull_free(input_schedule.batch);
+    input_schedule.batch = NULL;
+}
+
+static void input_invalidate(const char *reason)
+{
+    assert(bql_locked());
+    if (input_schedule.invalidated) {
+        return;
+    }
+    input_finish(FDISBULL_INPUT_STATE_FAILED, reason);
+    if (input_schedule.initialized) {
+        timer_del(&input_schedule.timer);
+    }
+    input_schedule.invalidated = true;
+}
+
+static void input_reset(void *opaque)
+{
+    input_invalidate("machine reset invalidated scheduled input");
+}
+
+static void input_vm_state_change(void *opaque, bool running, RunState state)
+{
+    assert(bql_locked());
+    if (running) {
+        return;
+    }
+    if (!input_safe_state(state)) {
+        input_invalidate("unsupported VM state invalidated scheduled input");
+        return;
+    }
+    /* An actual stop consumes the schedule, even before its deadline. */
+    input_finish(FDISBULL_INPUT_STATE_CANCELLED, "machine-stop");
+}
+
+static bool input_guard(Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    CPUState *cpu;
+    unsigned cpus = 0;
+
+    assert(bql_locked());
+    clock = qmp_x_fdisbull_query_clock(errp);
+    if (!clock) {
+        return false;
+    }
+    if (input_schedule.invalidated) {
+        error_setg(errp, "Scheduled input invalidated; close the VM");
+        return false;
+    }
+    if (clock->api_version != 1 || !clock->budget_supported ||
+        (input_schedule.initialized && input_schedule.epoch != clock->epoch)) {
+        if (input_schedule.initialized) {
+            input_invalidate("native clock profile or epoch changed");
+        }
+        error_setg(errp, "Scheduled input requires a valid native clock API 1 "
+                   "epoch; close an invalidated VM");
+        return false;
+    }
+    if (clock->running || clock->pending_stop ||
+        !input_safe_state(clock->status) ||
+        clock->budget_state == FDISBULL_CLOCK_BUDGET_STATE_FIRED) {
+        error_setg(errp, "Scheduled input commands require a safe stopped "
+                   "native clock with no pending stop");
+        return false;
+    }
+    CPU_FOREACH(cpu) {
+        cpus++;
+        if (!cpu->stopped) {
+            error_setg(errp, "Scheduled input requires one stopped vCPU");
+            return false;
+        }
+    }
+    if (cpus != 1) {
+        error_setg(errp, "Scheduled input requires one stopped vCPU");
+        return false;
+    }
+    if (!input_schedule.initialized) {
+        input_schedule.initialized = true;
+        input_schedule.epoch = clock->epoch;
+        input_schedule.used_tokens = g_hash_table_new_full(g_str_hash,
+                                                          g_str_equal,
+                                                          g_free, NULL);
+        /* Ordinary virtual timers participate in no-sleep icount HLT warp. */
+        timer_init_ns(&input_schedule.timer, QEMU_CLOCK_VIRTUAL,
+                      input_timer_cb, NULL);
+        qemu_register_reset(input_reset, NULL);
+        qemu_add_vm_change_state_handler(input_vm_state_change, NULL);
+    }
+    return true;
+}
+
+static FdisbullInputInfo *input_info(void)
+{
+    FdisbullInputInfo *info = g_new0(FdisbullInputInfo, 1);
+
+    info->api_version = 1;
+    info->epoch = input_schedule.epoch;
+    info->state = input_schedule.state;
+    info->virtual_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    info->event_count = input_schedule.event_count;
+    info->token = g_strdup(input_schedule.token);
+    info->has_start_ns = input_schedule.token != NULL;
+    info->start_ns = input_schedule.start_ns;
+    info->has_deadline_ns = input_schedule.token != NULL;
+    info->deadline_ns = input_schedule.deadline_ns;
+    info->has_terminal_ns = input_schedule.has_terminal;
+    info->terminal_ns = input_schedule.terminal_ns;
+    info->has_dispatch_ns = input_schedule.has_dispatch;
+    info->dispatch_ns = input_schedule.dispatch_ns;
+    info->reason = g_strdup(input_schedule.reason);
+    return info;
+}
+
+static void input_timer_cb(void *opaque)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    Error *err = NULL;
+
+    assert(bql_locked());
+    assert(qemu_in_vcpu_thread());
+    if (input_schedule.state != FDISBULL_INPUT_STATE_ARMED ||
+        input_schedule.invalidated) {
+        return;
+    }
+    clock = qmp_x_fdisbull_query_clock(NULL);
+    if (!clock || clock->api_version != 1 || !clock->budget_supported ||
+        input_schedule.epoch != clock->epoch) {
+        input_invalidate("native clock profile or epoch changed");
+        return;
+    }
+    /* A debugger/native stop wins before the main loop changes runstate. */
+    if (!clock->running || clock->pending_stop ||
+        fdisbull_clock_stop_pending()) {
+        input_finish(FDISBULL_INPUT_STATE_CANCELLED, "stop-pending");
+        return;
+    }
+    /* Equal timer deadlines otherwise depend on insertion order. */
+    if (clock->budget_state == FDISBULL_CLOCK_BUDGET_STATE_FIRED ||
+        (clock->budget_state == FDISBULL_CLOCK_BUDGET_STATE_ARMED &&
+         clock->has_budget_deadline_ns &&
+         clock->budget_deadline_ns <= clock->virtual_ns)) {
+        input_finish(FDISBULL_INPUT_STATE_CANCELLED, "budget-deadline");
+        return;
+    }
+    if (clock->virtual_ns < input_schedule.deadline_ns) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "virtual input timer fired before its deadline");
+        return;
+    }
+    if (!qemu_input_fdisbull_dispatch(input_schedule.batch, &err)) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     err ? error_get_pretty(err) : "input dispatch failed");
+        error_free(err);
+        return;
+    }
+    input_finish(FDISBULL_INPUT_STATE_DISPATCHED, "dispatch-complete");
+}
+
+FdisbullInputInfo *qmp_x_fdisbull_query_input(Error **errp)
+{
+    return input_guard(errp) ? input_info() : NULL;
+}
+
+FdisbullInputInfo *qmp_x_fdisbull_arm_input(const char *token,
+                                          int64_t delta_ns,
+                                          InputEventList *events, Error **errp)
+{
+    FdisbullInputBatch *batch;
+    int64_t now;
+
+    if (!input_guard(errp)) {
+        return NULL;
+    }
+    if (input_schedule.state == FDISBULL_INPUT_STATE_ARMED) {
+        error_setg(errp, "A scheduled input batch is already armed");
+        return NULL;
+    }
+    if (input_schedule.state == FDISBULL_INPUT_STATE_FAILED) {
+        error_setg(errp, "Scheduled input failed; close the VM");
+        return NULL;
+    }
+    if (!token[0] || strlen(token) > INPUT_MAX_TOKEN_BYTES ||
+        g_hash_table_contains(input_schedule.used_tokens, token)) {
+        error_setg(errp, "Scheduled input requires an unused token of "
+                   "1..128 bytes");
+        return NULL;
+    }
+    if (g_hash_table_size(input_schedule.used_tokens) >=
+        INPUT_MAX_USED_TOKENS) {
+        error_setg(errp, "Scheduled input exhausted its 4096-token history; "
+                   "close the VM");
+        return NULL;
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (delta_ns < 1 || delta_ns > INPUT_MAX_DELTA_NS || now < 0 ||
+        now > INT64_MAX - delta_ns) {
+        error_setg(errp, "Scheduled input delta must be 1..60000000000 ns "
+                   "without signed clock overflow");
+        return NULL;
+    }
+    batch = qemu_input_fdisbull_prepare(events, errp);
+    if (!batch) {
+        return NULL;
+    }
+    if (!input_schedule.migration_blocker) {
+        error_setg(&input_schedule.migration_blocker,
+                   "fDisBull scheduled input does not support migration");
+        if (migrate_add_blocker(&input_schedule.migration_blocker, errp) < 0) {
+            qemu_input_fdisbull_free(batch);
+            return NULL;
+        }
+    }
+
+    g_hash_table_add(input_schedule.used_tokens, g_strdup(token));
+    g_free(input_schedule.token);
+    g_clear_pointer(&input_schedule.reason, g_free);
+    input_schedule.token = g_strdup(token);
+    input_schedule.batch = batch;
+    input_schedule.event_count = qemu_input_fdisbull_count(batch);
+    input_schedule.start_ns = now;
+    input_schedule.deadline_ns = now + delta_ns;
+    input_schedule.has_terminal = false;
+    input_schedule.has_dispatch = false;
+    input_schedule.terminal_ns = 0;
+    input_schedule.dispatch_ns = 0;
+    input_schedule.state = FDISBULL_INPUT_STATE_ARMED;
+    timer_mod_ns(&input_schedule.timer, input_schedule.deadline_ns);
+    return input_info();
+}
+
+FdisbullInputInfo *qmp_x_fdisbull_cancel_input(const char *token, Error **errp)
+{
+    if (!input_guard(errp)) {
+        return NULL;
+    }
+    if (!input_schedule.token || strcmp(input_schedule.token, token)) {
+        error_setg(errp, "Input token does not own the current schedule");
+        return NULL;
+    }
+    input_finish(FDISBULL_INPUT_STATE_CANCELLED, "caller");
+    return input_info();
+}
