+static bool input_retrace_identity_equal(const FdisbullRetraceInfo *a,
+                                         const FdisbullRetraceInfo *b)
+{
+    return a->api_version == b->api_version && a->epoch == b->epoch &&
+           !g_strcmp0(a->model, b->model) &&
+           !g_strcmp0(a->device, b->device) &&
+           !g_strcmp0(a->device_type, b->device_type) &&
+           a->console == b->console && a->head == b->head;
+}
+
+static bool input_retrace_model_equal(const FdisbullRetraceInfo *a,
+                                      const FdisbullRetraceInfo *b)
+{
+    const FdisbullRetraceRaw *ar = a->raw, *br = b->raw;
+    const FdisbullRetraceTiming *at = a->timing, *bt = b->timing;
+
+    return a->phase_supported == b->phase_supported &&
+           !g_strcmp0(a->unsupported_reason, b->unsupported_reason) &&
+           ar->msr == br->msr && ar->sr1 == br->sr1 &&
+           ar->cr00 == br->cr00 && ar->cr04 == br->cr04 &&
+           ar->cr05 == br->cr05 && ar->cr06 == br->cr06 &&
+           ar->cr07 == br->cr07 && ar->cr10 == br->cr10 &&
+           ar->cr11 == br->cr11 && ar->vbe_enable == br->vbe_enable &&
+           at->ticks_per_char == bt->ticks_per_char &&
+           at->total_chars == bt->total_chars && at->htotal == bt->htotal &&
+           at->hstart == bt->hstart && at->hend == bt->hend &&
+           at->vstart == bt->vstart && at->vend == bt->vend &&
+           at->freq == bt->freq;
+}
