+
+static bool input_retrace_window(const FdisbullRetraceInfo *armed,
+                                 FdisbullInputRetraceEdge edge,
+                                 int64_t *target_ns, int64_t *window_end_ns,
+                                 Error **errp)
+{
+    const FdisbullRetraceTiming *timing = armed->timing;
+    int64_t period, line_ns, entry, exit_ns, width, phase, position, delta, target;
+
+    if (!armed->phase_supported || !armed->phase) {
+        error_setg(errp, "Retrace input requires supported timing: %s",
+                   armed->unsupported_reason ? armed->unsupported_reason
+                                             : "no phase");
+        return false;
+    }
+    /*
+     * The coherent model query already checked positive divisors, the period
+     * product and nonwrapped intervals inside that period.  These products
+     * are bounded by that checked period and cannot overflow signed time.
+     */
+    period = armed->phase->period_ns;
+    line_ns = timing->ticks_per_char * timing->htotal;
+    entry = line_ns * timing->vstart;
+    exit_ns = line_ns * (timing->vend + 1);
+    width = exit_ns - entry;
+    if (entry == 0 && exit_ns == period) {
+        error_setg(errp, "Retrace input timing has no vertical transition");
+        return false;
+    }
+    phase = edge == FDISBULL_INPUT_RETRACE_EDGE_ENTER ? entry : exit_ns % period;
+    if (edge == FDISBULL_INPUT_RETRACE_EDGE_EXIT) {
+        width = period - width;
+    }
+    position = armed->virtual_ns % period;
+    /* C's signed remainder is not Python's modulo.  Keep both terms positive
+     * and select one complete period when already exactly at the edge. */
+    delta = phase > position ? phase - position : period - (position - phase);
+    if (delta < 1 || delta > INPUT_MAX_DELTA_NS ||
+        armed->virtual_ns > INT64_MAX - delta) {
+        error_setg(errp, "Retrace input target exceeds its delay or signed "
+                   "clock bound");
+        return false;
+    }
+    target = armed->virtual_ns + delta;
+    if (width <= 0 || target > INT64_MAX - width) {
+        error_setg(errp, "Retrace input window exceeds signed clock bounds");
+        return false;
+    }
+    *target_ns = target;
+    *window_end_ns = target + width;
+    return true;
+}
+
+FdisbullInputInfo *qmp_x_fdisbull_arm_input_retrace(
+    const char *token, InputEventList *events, FdisbullInputRetraceEdge edge,
+    uint64_t expected_epoch, const char *expected_device,
+    const char *expected_model, uint64_t expected_generation,
+    int64_t expected_virtual_ns, Error **errp)
+{
+    g_autoptr(FdisbullRetraceInfo) armed = NULL;
+    g_autoptr(FdisbullInputRetrace) retrace = NULL;
+    int64_t target_ns, window_end_ns;
+
+    if (!input_arm_guard(token, errp)) {
+        return NULL;
+    }
+    if (edge != FDISBULL_INPUT_RETRACE_EDGE_ENTER &&
+        edge != FDISBULL_INPUT_RETRACE_EDGE_EXIT) {
+        error_setg(errp, "Retrace input edge must be enter or exit");
+        return NULL;
+    }
+    armed = fdisbull_retrace_snapshot_owned(errp);
+    if (!armed) {
+        return NULL;
+    }
+    if (armed->epoch != input_schedule.epoch || armed->epoch != expected_epoch ||
+        strcmp(armed->device, expected_device) ||
+        strcmp(armed->model, expected_model) ||
+        armed->timing_generation != expected_generation ||
+        armed->virtual_ns != expected_virtual_ns) {
+        error_setg(errp, "Retrace input expectations differ from the owned "
+                   "model snapshot");
+        return NULL;
+    }
+    if (!input_retrace_window(armed, edge, &target_ns, &window_end_ns, errp)) {
+        return NULL;
+    }
+    retrace = g_new0(FdisbullInputRetrace, 1);
+    retrace->edge = edge;
+    retrace->target_ns = target_ns;
+    retrace->window_end_ns = window_end_ns;
+    retrace->armed = g_steal_pointer(&armed);
+    return input_arm(token, retrace->armed->virtual_ns, target_ns, events,
+                     retrace, errp);
+}
