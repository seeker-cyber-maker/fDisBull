+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Internal snapshots of the already admitted fDisBull precise VGA owner. */
+#ifndef SYSTEM_FDISBULL_RETRACE_H
+#define SYSTEM_FDISBULL_RETRACE_H
+
+#include "qapi/qapi-types-fdisbull-retrace.h"
+
+/*
+ * Requires BQL and a previously admitted/pinned owner.  This is not the public
+ * stopped-only query: native input may sample while running or with an armed
+ * clock budget.  It validates the current clock profile/epoch and device/model
+ * identity, performs no guest I/O or timing update, and never admits a new owner.
+ * The caller owns the returned immutable snapshot.
+ */
+FdisbullRetraceInfo *fdisbull_retrace_snapshot_owned(Error **errp);
+
+#endif
