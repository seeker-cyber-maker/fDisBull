+         clock->status != RUN_STATE_PAUSED && clock->status != RUN_STATE_DEBUG) ||
+        clock->running != (clock->status == RUN_STATE_RUNNING)) {
+        retrace_owner.invalidated = true;
+        error_setg(errp, "Retrace snapshot clock profile or epoch invalidated; "
+                   "close the VM");
+        return NULL;
+    }
+    return retrace_snapshot(clock, false, errp);
+}
