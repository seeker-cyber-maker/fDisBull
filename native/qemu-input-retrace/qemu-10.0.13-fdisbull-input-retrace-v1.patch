+static bool input_retrace_check(int64_t now)
+{
+    FdisbullInputRetrace *retrace = input_schedule.retrace;
+    FdisbullRetraceInfo *armed, *checked;
+    Error *err = NULL;
+
+    if (!retrace) {
+        return true;
+    }
+    if (retrace->checked) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "retrace input already has a callback snapshot");
+        return false;
+    }
+    armed = retrace->armed;
+    checked = fdisbull_retrace_snapshot_owned(&err);
+    if (!checked) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     err ? error_get_pretty(err) : "retrace snapshot failed");
+        error_free(err);
+        return false;
+    }
+    /* Preserve the actual check even when it refuses this one-shot attempt. */
+    retrace->checked = checked;
+    if (checked->virtual_ns != now ||
+        !input_retrace_identity_equal(armed, checked) ||
+        checked->timing_generation < armed->timing_generation) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "retrace input clock, identity or generation regressed");
+        return false;
+    }
+    if (checked->timing_generation != armed->timing_generation) {
+        input_finish(FDISBULL_INPUT_STATE_CANCELLED,
+                     "retrace-timing-changed");
+        return false;
+    }
+    if (!checked->phase_supported || !checked->phase ||
+        !input_retrace_model_equal(armed, checked)) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "retrace input model changed without a generation");
+        return false;
+    }
+    if (now < retrace->target_ns) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "retrace input callback preceded its target");
+        return false;
+    }
+    if (now >= retrace->window_end_ns) {
+        input_finish(FDISBULL_INPUT_STATE_CANCELLED,
+                     "retrace-missed-window");
+        return false;
+    }
+    if (checked->phase->vertical_retrace !=
+        (retrace->edge == FDISBULL_INPUT_RETRACE_EDGE_ENTER)) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "retrace input phase contradicts its original window");
+        return false;
+    }
+    return true;
 }

