 static void
+vbe_104f06_fdisbull(struct bregs *regs, struct vgamode_s *vmode_g)
+{
+    int pitch;
+    switch (regs->bl) {
+    case 0x00:
+    case 0x02: {
+        // Packed 8-bit mode uses the same byte and pixel count.
+        int max_pitch = bochsvga_fdisbull_max_pitch();
+        int requested = ALIGN((int)regs->cx, 8);
+        if (!requested || !max_pitch) {
+            regs->ax = 0x024f;
+            return;
+        }
+        bochsvga_fdisbull_set_pitch(requested > max_pitch ? max_pitch : requested);
+        // Report the pitch actually accepted by the device.
+    }
+    // fall through
+    case 0x01:
+        pitch = vgahw_get_linelength(vmode_g);
+        break;
+    case 0x03:
+        pitch = bochsvga_fdisbull_max_pitch();
+        break;
+    default:
+        regs->ax = 0xff4f;
+        return;
+    }
+    if (pitch <= 0) {
+        regs->ax = 0x024f;
+        return;
+    }
+    regs->bx = pitch;
+    regs->cx = pitch;
+    u32 lines = GET_GLOBAL(VBE_total_memory) / pitch;
+    regs->dx = lines > 0xffff ? 0xffff : lines;
+    regs->ax = 0x004f;
+}
