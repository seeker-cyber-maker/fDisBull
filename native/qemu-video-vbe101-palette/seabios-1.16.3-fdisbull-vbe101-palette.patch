+
+#define FDISBULL_PALETTE_INDEX 0xf3
+#define FDISBULL_PALETTE_ID 0xfb03
+#define FDISBULL_MAX_PITCH_INDEX 0xf4
+
+int
+bochsvga_fdisbull_palette_available(void)
+{
+    return (GET_BDA_EXT(vbe_mode) & ~MF_NOCLEARMEM) == 0x101
+        && dispi_read(FDISBULL_PALETTE_INDEX) == FDISBULL_PALETTE_ID;
+}
+
+u16
+bochsvga_fdisbull_max_pitch(void)
+{
+    return dispi_read(FDISBULL_MAX_PITCH_INDEX);
+}
+
+void
+bochsvga_fdisbull_set_pitch(u16 pitch)
+{
+    dispi_write(VBE_DISPI_INDEX_VIRT_WIDTH, pitch);
 }

