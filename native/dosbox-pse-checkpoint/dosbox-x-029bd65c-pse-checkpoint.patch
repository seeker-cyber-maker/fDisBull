     POD_Load_CPU_Flags(stream);
 	POD_Load_CPU_Paging(stream);
+
+    // Never mask an error in the original CPU component prefix.
+    if (stream.fail()) return;
+
+    // zip_istreambuf implements bulk extraction, not underflow/peek. Read one
+    // byte beyond the extension so an unknown suffix cannot be accepted.
+    uint32_t cr4_extension[3] = {};
