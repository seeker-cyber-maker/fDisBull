+    if (extension_size == 0) {
+        // Exact legacy entry: retain its historical CR4 behavior.
+    } else if (extension_size != 8 || cr4_extension[0] != 0x31455350u) {
+        stream.setstate(std::ios::failbit);
+    } else {
+        // Paging load has already invalidated cached translations.
+        cpu.cr4 = cr4_extension[1];
+        do_pse = enable_pse && ((cpu.cr4 & 0x10u) != 0);
