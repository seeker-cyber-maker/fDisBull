+/* Private same-ABI debugger checkpoint. Resource storage and host pointers
+ * remain owned by the new runtime. Only retained events are serialized. */
+typedef struct AgiDebugRuntimeHeader {
+    char magic[8], resource_sha256[65];
+    uint32_t endian, version, state_size, event_size, count;
+    uint32_t mask, capacity, limit;
+    uint64_t eligible[2], dropped[2], calls, epoch, run_retired;
+    AgiSoundJournalState sound;
+    AgiRuntimeState state;
+} AgiDebugRuntimeHeader;
+
+static bool agi_debug_events_valid(const AgiRuntime *r,
+    const AgiRuntimeEvent *events, uint32_t count, const uint64_t eligible[2],
+    const uint64_t dropped[2])
+{
+    uint64_t stored[2] = {0, 0}, previous = 0, total;
+    uint32_t i;
+    if (UINT64_MAX - eligible[0] < eligible[1]) return false;
+    total = eligible[0] + eligible[1];
+    for (i = 0; i < count; i++) {
+        const AgiRuntimeEvent *e = &events[i];
+        const AgiRuntimeBlob *code, *next;
+        if (e->channel > 1 || e->size == 0 || e->size > AGI_DECODE_BYTES_MAX ||
+            e->logic > 255 || e->next_logic > 255 || e->kind > 1 ||
+            (e->kind == 1 ? e->actor >= 256 : e->actor > 256) ||
+            !e->seq || e->seq <= previous || e->seq > total) return false;
+        code = &r->resources->logics[e->logic].code;
+        next = &r->resources->logics[e->next_logic].code;
+        if (!code->data || !next->data || e->pc > code->size ||
+            e->size > code->size - e->pc || e->next_pc > next->size ||
+            memcmp(e->bytes, code->data + e->pc, e->size) ||
+            e->opcode != e->bytes[0]) return false;
+        stored[e->channel]++;
+        previous = e->seq;
+    }
+    for (i = 0; i < 2; i++) {
+        if (UINT64_MAX - stored[i] < dropped[i] ||
+            stored[i] + dropped[i] != eligible[i]) return false;
+    }
+    return true;
+}
+
+static bool agi_debug_sound_valid(const AgiSoundJournalState *j,
+                                  const AgiCapturedSound *events)
+{
+    uint32_t i;
+    uint64_t previous = 0;
+    if (j->count > AGI_RUNTIME_SOUND_CAPACITY ||
+        UINT64_MAX - j->count < j->dropped ||
+        j->eligible != (uint64_t)j->count + j->dropped) return false;
+    for (i = 0; i < j->count; i++) {
+        const AgiCapturedSound *c = &events[i];
+        const AgiRuntimeSoundEvent *e = &c->event;
+        if (!c->seq || c->seq <= previous || c->seq > j->last_seq ||
+            c->native_epoch > j->native_epoch || !e->sequence ||
+            e->kind < AGI_SOUND_SPEAKER || e->kind > AGI_SOUND_COMMAND ||
+            e->channel >= AGI_SOUND_CHANNELS || e->enabled > 1 ||
+            e->value > (e->kind == AGI_SOUND_SPEAKER ? 12276u : 255u)) return false;
+        previous = c->seq;
+    }
+    return true;
+}
+
+GBytes *agi_debug_runtime_save(const AgiRuntime *r, Error **errp)
+{
+    AgiOwnedRuntime *owned = sound_owner(r);
+    AgiDebugRuntimeHeader h = {0};
+    g_autofree uint8_t *out = NULL;
+    size_t size;
+    if (!runtime_valid(r, errp)) return NULL;
+    if (!owned || !owned->sound_storage || !agi_debug_sound_valid(&owned->sound_journal, owned->sound_storage) ||
+        !agi_runtime_debug_state_valid(r, &r->state) || r->obs_mask > 3 ||
+        !agi_debug_events_valid(r, r->events, r->obs_count, r->obs_eligible, r->obs_dropped)) {
+        error_setg(errp, "AGI_DEBUG_CHECKPOINT: unsupported runtime state or sound journal");
+        return NULL;
+    }
+    memcpy(h.magic, "FDBAGID1", 8);
+    memcpy(h.resource_sha256, r->resources->sha256, 65);
+    h.endian = 0x01020304; h.version = 1;
+    h.state_size = sizeof(h.state); h.event_size = sizeof(AgiRuntimeEvent);
+    h.count = r->obs_count; h.mask = r->obs_mask;
+    h.capacity = r->obs_capacity; h.limit = r->obs_limit;
+    memcpy(h.eligible, r->obs_eligible, sizeof(h.eligible));
+    memcpy(h.dropped, r->obs_dropped, sizeof(h.dropped));
+    h.calls = r->obs_calls; h.epoch = r->epoch; h.run_retired = r->run_retired;
+    h.sound = owned->sound_journal; h.state = r->state;
+    size = sizeof(h) + (size_t)h.count * sizeof(AgiRuntimeEvent) +
+           (size_t)h.sound.count * sizeof(AgiCapturedSound);
+    if (size > 16u * 1024u * 1024u) {
+        error_setg(errp, "AGI_DEBUG_CHECKPOINT: runtime checkpoint exceeds limit");
+        return NULL;
+    }
+    out = g_try_malloc(size);
+    if (!out) { error_setg(errp, "AGI_DEBUG_CHECKPOINT: allocation failed"); return NULL; }
+    memcpy(out, &h, sizeof(h));
+    if (h.count) memcpy(out + sizeof(h), r->events, (size_t)h.count * sizeof(AgiRuntimeEvent));
+    if (h.sound.count) memcpy(out + sizeof(h) + (size_t)h.count * sizeof(AgiRuntimeEvent),
+                              owned->sound_storage, (size_t)h.sound.count * sizeof(AgiCapturedSound));
+    return g_bytes_new_take(g_steal_pointer(&out), size);
+}
+
+bool agi_debug_runtime_load(AgiRuntime *r, const uint8_t *data, size_t size,
+                            uint64_t expected_retired, uint64_t expected_run_retired,
+                            Error **errp)
+{
+    AgiOwnedRuntime *owned = sound_owner(r);
+    g_autofree AgiDebugRuntimeHeader *h = NULL;
+    g_autofree AgiRuntimeEvent *events = NULL;
+    g_autofree AgiCapturedSound *sound = NULL;
+    size_t event_bytes, sound_bytes;
+    if (!runtime_valid(r, errp)) return false;
+    if (!owned || !owned->sound_storage || !data || size < sizeof(*h)) goto invalid;
+    h = g_try_malloc(sizeof(*h));
+    if (!h) goto invalid;
+    memcpy(h, data, sizeof(*h));
+    if (memcmp(h->magic, "FDBAGID1", 8) || h->endian != 0x01020304 ||
+        h->version != 1 || h->state_size != sizeof(h->state) ||
+        h->event_size != sizeof(AgiRuntimeEvent) ||
+        memcmp(h->resource_sha256, r->resources->sha256, 65) ||
+        h->limit != r->obs_limit || h->limit > AGI_RT_EVENTS_MAX ||
+        h->capacity > h->limit || h->count > h->capacity || h->mask > 3 ||
+        h->capacity != r->obs_capacity || h->mask != r->obs_mask ||
+        h->sound.count > AGI_RUNTIME_SOUND_CAPACITY ||
+        h->state.retired != expected_retired || h->run_retired != expected_run_retired ||
+        !agi_runtime_debug_state_valid(r, &h->state)) goto invalid;
+    event_bytes = (size_t)h->count * sizeof(AgiRuntimeEvent);
+    sound_bytes = (size_t)h->sound.count * sizeof(AgiCapturedSound);
+    if (size > 16u * 1024u * 1024u || size != sizeof(*h) + event_bytes + sound_bytes) goto invalid;
+    if (event_bytes) {
+        events = g_try_malloc(event_bytes);
+        if (!events) goto invalid;
+        memcpy(events, data + sizeof(*h), event_bytes);
+
+    }
+    if (sound_bytes) {
+        sound = g_try_malloc(sound_bytes);
+        if (!sound) goto invalid;
+        memcpy(sound, data + sizeof(*h) + event_bytes, sound_bytes);
+    }
+    if (!agi_debug_events_valid(r, events, h->count, h->eligible, h->dropped) ||
+        !agi_debug_sound_valid(&h->sound, sound)) goto invalid;
+    /* No mutations before all validation succeeds. */
+    r->state = h->state; r->obs_mask = h->mask; r->obs_capacity = h->capacity;
+    r->obs_count = h->count;
+    memcpy(r->obs_eligible, h->eligible, sizeof(h->eligible));
+    memcpy(r->obs_dropped, h->dropped, sizeof(h->dropped));
+    r->obs_calls = h->calls; r->epoch = h->epoch; r->run_retired = h->run_retired;
+    owned->sound_journal = h->sound;
+    if (event_bytes) memcpy(r->events, events, event_bytes);
+    if (sound_bytes) memcpy(owned->sound_storage, sound, sound_bytes);
+    return true;
+invalid:
+    error_setg(errp, "AGI_DEBUG_CHECKPOINT: invalid or unsupported runtime checkpoint");
+    return false;
+}
