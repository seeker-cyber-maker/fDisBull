+/* Validate without normalizing the persisted state. Pending effects, faults and
+ * terminal quit need separate qualification and are deliberately refused. */
+bool agi_runtime_debug_state_valid(const AgiRuntime *r, const AgiRuntimeState *s)
+{
+    AgiRuntimeState checked = *s;
+    if (s->status == AGI_RT_RUNNING || s->status == AGI_RT_BUDGET)
+        checked.status = AGI_RT_READY;
+    else if (s->status != AGI_RT_READY && s->status != AGI_RT_RETURN)
+        return false;
+    return valid_snapshot(r, &checked);
+}
