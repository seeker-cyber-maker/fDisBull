+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Stopped, same-ABI debugger checkpoints. Private data, not game saves. */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "cpu.h"
+#include "runtime_qom.h"
+
+#define AGI_DEBUG_LIMIT (16u * 1024u * 1024u)
+typedef struct AgiDebugHeader {
+    char magic[8], source[65];
+    uint32_t version, endian, env_size, event_size, count, runtime_size;
+} AgiDebugHeader;
+
+static bool position_actor(const AgiActor *a)
+{
+    AgiActor clean = {0};
+    if (a->x > 255 || a->y > 255 || a->prev_x > 255 || a->prev_y > 255) {
+        return false;
+    }
+    clean.x = a->x;
+    clean.y = a->y;
+    clean.prev_x = a->prev_x;
+    clean.prev_y = a->prev_y;
+    return !memcmp(a, &clean, sizeof(clean));
+}
+
+static bool valid_env(const AgiCPU *cpu, const CPUArchState *e, const AgiEvent *events)
+{
+    uint32_t i;
+    if (e->timer_active || e->segment_start_ns || e->code_size != cpu->env.code_size ||
+        e->pc > e->code_size || e->status > AGI_EFFECT ||
+        (!cpu->runtime && e->status == AGI_EFFECT) ||
+        e->fault_code > AGI_FAULT_CONTEXTUAL_LAYOUT ||
+        e->fault_pc > e->code_size || e->fault_opcode > 255 || e->obs_mask != 2 ||
+        e->obs_capacity != 4096 || e->obs_count > e->obs_capacity ||
+        !e->step_budget || e->step_budget > 1000000000 || e->binding_profile ||
+        e->draw_intent || e->pending_kind || e->runtime_profile != (cpu->runtime != NULL) ||
+        e->obs_eligible[0] || e->obs_stored[0] || e->obs_dropped[0] ||
+        e->obs_stored[1] != e->obs_count || e->obs_dropped[1] > e->obs_eligible[1] ||
+        e->obs_stored[1] != e->obs_eligible[1] - e->obs_dropped[1] ||
+        e->run_retired > e->retired || e->control_generation == UINT64_MAX ||
+        e->trace_epoch == UINT64_MAX) {
+        return false;
+    }
+    for (i = 0; i < 256; i++) {
+        if (e->v[i] > 255 || e->f[i] > 1 || e->loaded_views[i]) {
+            return false;
+        }
+    }
+    for (i = 0; i < AGI_ACTORS; i++) {
+        if (!position_actor(&e->actors[i])) {
+            return false;
+        }
+    }
+    if (!position_actor(&e->observed_actor) || e->observed_loaded || e->horizon) {
+        return false;
+    }
+    if (cpu->runtime && (e->pc != 0 || e->obs_count || e->obs_eligible[1])) {
+        return false;
+    }
+    for (i = 0; i < e->obs_count; i++) {
+        const AgiEvent *v = &events[i];
+        if (v->kind != AGI_EVENT_POSITION || v->actor >= AGI_ACTORS || v->seq != (uint64_t)i + 1 ||
+            !v->retired || v->retired > e->retired || v->control_generation > e->control_generation ||
+            v->pc >= e->code_size || v->length != 4 || v->length > e->code_size - v->pc ||
+            v->next_pc != v->pc + v->length || v->opcode != cpu->code[v->pc] ||
+            (v->opcode != 37 && v->opcode != 38) || v->actor != cpu->code[v->pc + 1] ||
+            !position_actor(&v->before) || !position_actor(&v->after) ||
+            v->resolved_value || v->resolved_x || v->resolved_y ||
+            v->before_loaded || v->after_loaded) {
+            return false;
+        }
+    }
+    return true;
+}
+
+char *agi_debug_checkpoint_get(AgiCPU *cpu, Error **errp)
+{
+    AgiDebugHeader h = {0};
+    CPUArchState env = cpu->env;
+    g_autoptr(GBytes) runtime = NULL;
+    g_autofree uint8_t *bytes = NULL;
+    const uint8_t *runtime_data = NULL;
+    size_t runtime_size = 0, event_size, size, i;
+    char *hex;
+    if (env.timer_active) {
+        goto invalid;
+    }
+    /* A stopped clock has no live segment. Its old host timestamp cannot
+     * carry meaning across owners; keep the serialized field canonical. */
+    env.segment_start_ns = 0;
+    if (!valid_env(cpu, &env, cpu->events)) {
+        goto invalid;
+    }
+    if (cpu->runtime) {
+        runtime = agi_debug_runtime_save(cpu->runtime, errp);
+        if (!runtime) {
+            return NULL;
+        }
+        runtime_data = g_bytes_get_data(runtime, &runtime_size);
+    }
+    event_size = (size_t)env.obs_count * sizeof(AgiEvent);
+    if (runtime_size > AGI_DEBUG_LIMIT ||
+        sizeof(h) + sizeof(env) + event_size > AGI_DEBUG_LIMIT - runtime_size) {
+        goto invalid;
+    }
+    size = sizeof(h) + sizeof(env) + event_size + runtime_size;
+    memcpy(h.magic, "FDBAGIC1", 8);
+    memcpy(h.source, cpu->source_sha256, sizeof(h.source));
+    h.version = 1;
+    h.endian = 0x01020304;
+    h.env_size = sizeof(env);
+    h.event_size = sizeof(AgiEvent);
+    h.count = env.obs_count;
+    h.runtime_size = runtime_size;
+    bytes = g_malloc(size);
+    memcpy(bytes, &h, sizeof(h));
+    memcpy(bytes + sizeof(h), &env, sizeof(env));
+    memcpy(bytes + sizeof(h) + sizeof(env), cpu->events, event_size);
+    if (runtime_size) {
+        memcpy(bytes + sizeof(h) + sizeof(env) + event_size, runtime_data, runtime_size);
+    }
+    hex = g_malloc(size * 2 + 1);
+    for (i = 0; i < size; i++) {
+        static const char digits[] = "0123456789abcdef";
+        hex[i * 2] = digits[bytes[i] >> 4];
+        hex[i * 2 + 1] = digits[bytes[i] & 15];
+    }
+    hex[size * 2] = 0;
+    return hex;
+invalid:
+    error_setg(errp, "AGI_DEBUG_CHECKPOINT: unsupported CPU state");
+    return NULL;
+}
+
+bool agi_debug_checkpoint_set(AgiCPU *cpu, const char *hex, Error **errp)
+{
+    AgiDebugHeader h;
+    CPUArchState env;
+    g_autofree uint8_t *bytes = NULL;
+    g_autofree AgiEvent *events = NULL;
+    size_t n, size, event_size, i;
+    if (!hex || cpu->debug_checkpoint_loaded || cpu->env.invocation || cpu->env.retired ||
+        cpu->env.status != AGI_READY || cpu->env.control_generation != 2 || cpu->env.trace_epoch != 1 ||
+        cpu->env.obs_mask != 2 || cpu->env.obs_capacity != 4096 ||
+        cpu->catalog || cpu->draw_intent) {
+        goto invalid;
+    }
+    n = strlen(hex);
+    if (!n || n % 2 || n > 2 * AGI_DEBUG_LIMIT) {
+        goto invalid;
+    }
+    size = n / 2;
+    if (size < sizeof(h) + sizeof(env)) {
+        goto invalid;
+    }
+    bytes = g_malloc(size);
+    for (i = 0; i < size; i++) {
+        char first = hex[2 * i];
+        char second = hex[2 * i + 1];
+        int hi = g_ascii_xdigit_value(first);
+        int lo = g_ascii_xdigit_value(second);
+        if (hi < 0 || lo < 0 || (first >= 'A' && first <= 'F') ||
+            (second >= 'A' && second <= 'F')) {
+            goto invalid;
+        }
+        bytes[i] = (hi << 4) | lo;
+    }
+    memcpy(&h, bytes, sizeof(h));
+    if (memcmp(h.magic, "FDBAGIC1", 8) || memcmp(h.source, cpu->source_sha256, 65) ||
+        h.version != 1 || h.endian != 0x01020304 || h.env_size != sizeof(env) ||
+        h.event_size != sizeof(AgiEvent) || h.count > 4096 ||
+        (!!h.runtime_size != !!cpu->runtime)) {
+        goto invalid;
+    }
+    event_size = (size_t)h.count * sizeof(AgiEvent);
+    if (size != sizeof(h) + sizeof(env) + event_size + h.runtime_size ||
+        bytes[sizeof(h) + offsetof(CPUArchState, timer_active)] != 0) {
+        goto invalid;
+    }
+    memcpy(&env, bytes + sizeof(h), sizeof(env));
+    if (env.obs_count != h.count) {
+        goto invalid;
+    }
+    events = g_malloc0(event_size ? event_size : 1);
+    memcpy(events, bytes + sizeof(h) + sizeof(env), event_size);
+    /* Validate the whole outer envelope before the atomic runtime load. The
+     * host still verifies native readback before adopting this fresh owner. */
+    if (!valid_env(cpu, &env, events)) {
+        goto invalid;
+    }
+    if (cpu->runtime &&
+        !agi_debug_runtime_load(cpu->runtime,
+                                bytes + sizeof(h) + sizeof(env) + event_size,
+                                h.runtime_size, env.retired, env.run_retired, errp)) {
+        return false;
+    }
+    cpu->env = env;
+    memcpy(cpu->events, events, event_size);
+    cpu->debug_checkpoint_loaded = true;
+    CPU(cpu)->exception_index = -1;
+    CPU(cpu)->halted = 0;
+    return true;
+invalid:
+    error_setg(errp, "AGI_DEBUG_CHECKPOINT: invalid checkpoint or nonfresh owner");
+    return false;
+}
