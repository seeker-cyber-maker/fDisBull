+/* This provider is registered before frontend construction. Common-monitor
+ * users without the system provider keep the command explicitly unsupported. */
+static FdisbullPendingEventsGuard pending_events_guard;
+static bool pending_events_frontends_started;
+static bool pending_events_registry_invalid;
+static uint64_t pending_events_registered;
+static uint64_t pending_events_ever_registered;
+
+void fdisbull_pending_events_register_guard(FdisbullPendingEventsGuard guard)
+{
+    assert(guard && !pending_events_guard && !pending_events_frontends_started);
+    pending_events_guard = guard;
+}
+
+void monitor_pending_events_init(MonitorQMP *mon, Chardev *chr, bool pretty)
+{
+    QemuUUID uuid;
+
+    QEMU_LOCK_GUARD(&monitor_lock);
+    pending_events_frontends_started = true;
+    if (pending_events_registered == UINT64_MAX ||
+        pending_events_ever_registered == UINT64_MAX) {
+        pending_events_registry_invalid = true;
+        mon->pending_events_invalid = true;
+        return;
+    }
+    pending_events_registered++;
+    pending_events_ever_registered++;
+    pending_events_registry_invalid |= pending_events_ever_registered != 1;
+    mon->pending_events_registered = true;
+    mon->pending_events_invalid = !pending_events_guard || pretty ||
+        !object_dynamic_cast(OBJECT(chr), TYPE_CHARDEV_STDIO);
+    qemu_uuid_generate(&uuid);
+    qemu_uuid_unparse(&uuid, mon->pending_events_id);
+}
+
+void monitor_pending_events_destroy(MonitorQMP *mon)
+{
+    QEMU_LOCK_GUARD(&monitor_lock);
+    mon->pending_events_invalid = true;
+    mon->pending_events_ready = mon->pending_events_open = false;
+    if (mon->pending_events_registered) {
+        assert(pending_events_registered);
+        pending_events_registered--;
+        mon->pending_events_registered = false;
+    }
+    qobject_unref(mon->pending_events_request);
+    mon->pending_events_request = NULL;
+}
+
+void monitor_pending_events_channel(MonitorQMP *mon, QEMUChrEvent event)
+{
+    QEMU_LOCK_GUARD(&monitor_lock);
+    if (event == CHR_EVENT_OPENED) {
+        mon->pending_events_invalid |= mon->pending_events_open ||
+                                       mon->pending_events_epoch != 0;
+        mon->pending_events_open = true;
+    } else if (event == CHR_EVENT_CLOSED) {
+        mon->pending_events_open = false;
+        mon->pending_events_invalid = true;
+    } else if (event == CHR_EVENT_MUX_IN || event == CHR_EVENT_MUX_OUT) {
+        mon->pending_events_invalid = true;
+    } else {
+        return;
+    }
+    if (mon->pending_events_epoch == UINT64_MAX) {
+        mon->pending_events_invalid = true;
+    } else {
+        mon->pending_events_epoch++;
+    }
+}
+
+void monitor_pending_events_dispatch(MonitorQMP *mon, QObject *request)
+{
+    QEMU_LOCK_GUARD(&monitor_lock);
+    if (mon->pending_events_request) {
+        mon->pending_events_invalid = true;
+        return;
+    }
+    mon->pending_events_request = qobject_ref(request);
+    mon->pending_events_invalid |= mon->capab[QMP_CAPABILITY_OOB];
+}
+
+void monitor_pending_events_dispatched(MonitorQMP *mon)
+{
+    QEMU_LOCK_GUARD(&monitor_lock);
+    mon->pending_events_invalid |= mon->capab[QMP_CAPABILITY_OOB];
+    qobject_unref(mon->pending_events_request);
+    mon->pending_events_request = NULL;
+}
+
+typedef struct PendingEventBudget {
+    size_t nodes;
+    size_t strings;
+    const QObject *parents[8];
+} PendingEventBudget;
+
+static bool pending_event_string(const char *text, size_t limit,
+                                 PendingEventBudget *budget, size_t *size)
+{
+    size_t i, length = strnlen(text, limit + 1), encoded = 2;
+
+    if (length > limit || budget->strings + length > 32768) {
+        return false;
+    }
+    for (i = 0; i < length; i++) {
+        unsigned char ch = text[i];
+
+        if (ch >= 128) {
+            return false;
+        }
+        if (ch == '"' || ch == '\\' || ch == '\b' || ch == '\f' ||
+            ch == '\n' || ch == '\r' || ch == '\t') {
+            encoded += 2;
+        } else {
+            encoded += ch < 32 || ch == 127 ? 6 : 1;
+        }
+    }
+    budget->strings += length;
+    *size = encoded;
+    return true;
+}
+
+/* Count before serialization. Depth, nodes and child iterations are bounded;
+ * no unbounded qlist_size(), recursive copy or JSON conversion is used. */
+static bool pending_event_value(const QObject *obj, unsigned depth,
+                                PendingEventBudget *budget,
+                                size_t first_node, size_t *size)
+{
+    const QDictEntry *dict_entry;
+    const QListEntry *list_entry;
+    unsigned count = 0, i;
+    size_t total = 2, part;
+    const QNum *number;
+    char digits[32];
+
+    if (!obj || depth > 8 || ++budget->nodes > 4096 ||
+        budget->nodes - first_node > 256) {
+        return false;
+    }
+    switch (qobject_type(obj)) {
+    case QTYPE_QNULL:
+        *size = 4;
+        return true;
+    case QTYPE_QBOOL:
+        *size = qbool_get_bool(qobject_to(QBool, obj)) ? 4 : 5;
+        return true;
+    case QTYPE_QNUM:
+        number = qobject_to(QNum, obj);
+        if (number->kind == QNUM_I64) {
+            *size = snprintf(digits, sizeof(digits), "%" PRId64, number->u.i64);
+        } else if (number->kind == QNUM_U64) {
+            *size = snprintf(digits, sizeof(digits), "%" PRIu64, number->u.u64);
+        } else {
+            return false;
+        }
+        return true;
+    case QTYPE_QSTRING:
+        return pending_event_string(qstring_get_str(qobject_to(QString, obj)),
+                                    4096, budget, size);
+    case QTYPE_QDICT:
+    case QTYPE_QLIST:
+        for (i = 0; i + 1 < depth; i++) {
+            if (budget->parents[i] == obj) {
+                return false;
+            }
+        }
+        budget->parents[depth - 1] = obj;
+        break;
+    default:
+        return false;
+    }
+    if (qobject_type(obj) == QTYPE_QDICT) {
+        const QDict *dict = qobject_to(QDict, obj);
+
+        if (qdict_size(dict) > 64) {
+            return false;
+        }
+        for (dict_entry = qdict_first(dict); dict_entry;
+             dict_entry = qdict_next(dict, dict_entry)) {
+            if (++count > 64 ||
+                !pending_event_string(qdict_entry_key(dict_entry), 128,
+                                      budget, &part)) {
+                return false;
+            }
+            total += (count > 1 ? 2 : 0) + part + 2;
+            if (!pending_event_value(qdict_entry_value(dict_entry), depth + 1,
+                                     budget, first_node, &part)) {
+                return false;
+            }
+            total += part;
+            if (total > 16384) {
+                return false;
+            }
+        }
+    } else {
+        for (list_entry = qlist_first(qobject_to(QList, obj)); list_entry;
+             list_entry = qlist_next(list_entry)) {
+            if (++count > 256 ||
+                !pending_event_value(qlist_entry_obj(list_entry), depth + 1,
+                                     budget, first_node, &part)) {
+                return false;
+            }
+            total += (count > 1 ? 2 : 0) + part;
+            if (total > 16384) {
+                return false;
+            }
+        }
+    }
+    *size = total;
+    return true;
+}
+
+static bool pending_event_uint(const QDict *dict, const char *key,
+                               uint64_t maximum)
+{
+    QNum *number = qobject_to(QNum, qdict_get(dict, key));
+    uint64_t value;
+
+    return number && number->kind != QNUM_DOUBLE &&
+           qnum_get_try_uint(number, &value) && value <= maximum;
+}
+
+static bool pending_event_valid(const QDict *event, PendingEventBudget *budget,
+                                size_t *size)
+{
+    const QDictEntry *entry;
+    const char *name = qdict_get_try_str(event, "event");
+    QObject *data = qdict_get(event, "data");
+    QObject *raw_time = qdict_get(event, "timestamp");
+    QDict *stamp = qobject_to(QDict, raw_time);
+    size_t first_node = budget->nodes;
+
+    if (!name || !name[0] || strnlen(name, 129) > 128 ||
+        (data && !qobject_to(QDict, data)) ||
+        (raw_time && (!stamp || qdict_size(stamp) != 2 ||
+          !pending_event_uint(stamp, "seconds", INT64_MAX) ||
+          !pending_event_uint(stamp, "microseconds", 999999)))) {
+        return false;
+    }
+    if (qdict_size(event) > 3) {
+        return false;
+    }
+    for (entry = qdict_first(event); entry; entry = qdict_next(event, entry)) {
+        const char *key = qdict_entry_key(entry);
+
+        if (strcmp(key, "event") && strcmp(key, "data") &&
+            strcmp(key, "timestamp")) {
+            return false;
+        }
+    }
+    return pending_event_value(QOBJECT(event), 1, budget, first_node, size) &&
+           *size <= 16384;
+}
+
+static char *pending_events_copy_label(const char *value)
+{
+    size_t size = strlen(value) + 1;
+    char *copy = g_try_malloc(size);
+
+    if (copy) {
+        memcpy(copy, value, size);
+    }
+    return copy;
+}
+
+/* Called with monitor_lock held. The system GDB stub creates one private,
+ * non-interactive HMP frontend even with -monitor none. It cannot be selected
+ * by -chardev: char_get_class() rejects the internal chardev-gdb type. Do not
+ * confuse its presence with an active HMP/GDB command (checked by the system
+ * provider), or admit an externally addressable HMP or another QMP monitor. */
+static bool pending_events_monitor_layout(Monitor *original)
+{
+    Monitor *current;
+    bool original_seen = false, gdb_seen = false;
+    unsigned int visited = 0;
+
+    QTAILQ_FOREACH(current, &mon_list, entry) {
+        Chardev *chr;
+
+        if (++visited > 2) {
+            return false;
+        }
+        if (current == original) {
+            original_seen = true;
+            continue;
+        }
+        if (gdb_seen || monitor_is_qmp(current) ||
+            container_of(current, MonitorHMP, common)->use_readline) {
+            return false;
+        }
+        chr = qemu_chr_fe_get_driver(&current->chr);
+        if (!chr || !CHARDEV_GET_CLASS(chr)->internal ||
+            strcmp(object_get_typename(OBJECT(chr)), "chardev-gdb")) {
+            return false;
+        }
+        gdb_seen = true;
+    }
+    return original_seen;
+}
+
+FdisbullPendingEventsInfo *qmp_x_fdisbull_take_pending_events(Error **errp)
+{
+    /* monitor_cur() locks monitor_lock internally: read it first. */
+    Monitor *original = monitor_cur();
+    MonitorQMP *mon;
+    MonitorQAPIEventState *selected[64];
+    PendingEventBudget budget = { 0 };
+    FdisbullPendingEventsInfo *info = NULL;
+    anyList **tail;
+    GHashTableIter iterator;
+    gpointer entry;
+    RunState state;
+    QDict *request;
+    QNum *id;
+    uint64_t request_id;
+    size_t visited = 0, count = 0, list_size = 2, size, i;
+
+    if (!pending_events_guard) {
+        error_setg(errp, "Pending events are unsupported by this producer");
+        return NULL;
+    }
+    /* Provider checks BQL, stopped CPU and the sole unarmed dispatcher. No
+     * monitor lock or strict-control mutex is held across this callback. */
+    if (!pending_events_guard(&state, errp)) {
+        return NULL;
+    }
+    if (!original || !monitor_is_qmp(original)) {
+        error_setg(errp, "Pending events require their original QMP monitor");
+        return NULL;
+    }
+    mon = container_of(original, MonitorQMP, common);
+    QEMU_LOCK_GUARD(&monitor_lock);
+    if (pending_events_registry_invalid || pending_events_registered != 1 ||
+        !mon->pending_events_registered || !mon->pending_events_ready ||
+        !mon->pending_events_open || mon->pending_events_invalid ||
+        !mon->pending_events_epoch || mon->pretty ||
+        mon->capab[QMP_CAPABILITY_OOB] || mon->commands != &qmp_commands ||
+        !pending_events_monitor_layout(original) || monitor_destroyed) {
+        error_setg(errp, "Pending-event monitor lifetime or setup is ineligible");
+        return NULL;
+    }
+    request = qobject_to(QDict, mon->pending_events_request);
+    id = request ? qobject_to(QNum, qdict_get(request, "id")) : NULL;
+    if (!id || id->kind == QNUM_DOUBLE ||
+        !qnum_get_try_uint(id, &request_id) || !request_id) {
+        error_setg(errp, "Pending events require an exact positive integer ID");
+        return NULL;
+    }
+    /* Enqueue uses monitor_lock before the queue lock, so releasing the
+     * latter cannot admit another queued command during this transfer. */
+    WITH_QEMU_LOCK_GUARD(&mon->qmp_queue_lock) {
+        if (!g_queue_is_empty(mon->qmp_requests)) {
+            error_setg(errp, "Pending events require no other queued control");
+            return NULL;
+        }
+    }
+    QEMU_LOCK_GUARD(&original->mon_lock);
+    if (original->mux_out || !monitor_qapi_event_state) {
+        error_setg(errp, "Pending events require their unmuxed monitor");
+        return NULL;
+    }
+    /* Count every timed state, including an empty qdict waiting for removal.
+     * On excess, refuse permanently without traversing or consuming a prefix. */
+    if (g_hash_table_size(monitor_qapi_event_state) > 64) {
+        mon->pending_events_invalid = true;
+        error_setg(errp, "Pending-event throttle table exceeds 64 states");
+        return NULL;
+    }
+    g_hash_table_iter_init(&iterator, monitor_qapi_event_state);
+    while (g_hash_table_iter_next(&iterator, &entry, NULL)) {
+        MonitorQAPIEventState *current = entry;
+
+        if (++visited > 64) {
+            goto overflow;
+        }
+        if (!current->qdict) {
+            continue;
+        }
+        if (count == 64 || !pending_event_valid(current->qdict, &budget, &size)) {
+            goto overflow;
+        }
+        list_size += (count ? 2 : 0) + size;
+        if (list_size > 131072) {
+            goto overflow;
+        }
+        selected[count++] = current;
+    }
+    /* Fixed metadata plus uint64 ID/epoch is <512 bytes. Thus the complete
+     * non-pretty response including newline stays well below 256 KiB. */
+    info = g_try_new0(FdisbullPendingEventsInfo, 1);
+    if (!info) {
+        goto allocation;
+    }
+    info->model = pending_events_copy_label("stopped-pending-qmp-events-v1");
+    info->boundary = pending_events_copy_label("matching-response-event-batch");
+    info->monitor_id = pending_events_copy_label(mon->pending_events_id);
+    if (!info->model || !info->boundary || !info->monitor_id) {
+        goto allocation;
+    }
+    info->monitor_epoch = mon->pending_events_epoch;
+    info->status = state;
+    info->event_count = count;
+    tail = &info->events;
+    for (i = 0; i < count; i++) {
+        anyList *node = g_try_new0(anyList, 1);
+
+        if (!node) {
+            goto allocation;
+        }
+        node->value = QOBJECT(qobject_ref(selected[i]->qdict));
+        *tail = node;
+        tail = &node->next;
+    }
+    /* All validation/allocation/ref acquisition preceded the first consume.
+     * Keep throttle keys, data, timers and coalescing phase exactly intact. */
+    for (i = 0; i < count; i++) {
+        qobject_unref(selected[i]->qdict);
+        selected[i]->qdict = NULL;
+    }
+    return info;
+
+overflow:
+    mon->pending_events_invalid = true;
+    error_setg(errp, "Pending-event object or batch exceeds its bounded schema");
+    return NULL;
+allocation:
+    qapi_free_FdisbullPendingEventsInfo(info);
+    error_setg(errp, "Pending-event batch allocation failed without consumption");
+    return NULL;
+}
 
