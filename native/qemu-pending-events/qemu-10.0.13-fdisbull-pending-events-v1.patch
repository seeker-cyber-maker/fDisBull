+static bool control_pending_events_boundary(RunState *state, Error **errp)
+{
+    bool sole_unarmed;
+
+    assert(bql_locked());
+    /* Do not use control_arm_boundary: its idle keyboard and generic taint
+     * policy is stronger than this nonconsuming delivery boundary. A stable
+     * frame-key owner, with held keys or an empty held set, remains eligible. */
+    if (!control_stopped_cpu() || replay_mode != REPLAY_MODE_NONE ||
+        migration_is_running() || fdisbull_instrumented_checkpoint_busy() ||
+        qemu_system_dump_in_progress() ||
+        fdisbull_stopped_control_system_pending() ||
+        fdisbull_clock_budget_active() ||
+        fdisbull_display_frame_fence_blocks_control() ||
+        fdisbull_video_frame_fence_blocks_control() ||
+        fdisbull_video_frame_stop_pending()) {
+        error_setg(errp, "Pending events require one stopped CPU without "
+                   "pending native controllers");
+        return false;
+    }
+    control_lock();
+    sole_unarmed = !control.armed && control.qmp_active == 1 &&
+                   !control.gdb_active && !control.hmp_active;
+    control_unlock();
+    if (!sole_unarmed) {
+        error_setg(errp, "Pending events require the sole unarmed dispatcher");
+        return false;
+    }
+    *state = runstate_get();
+    return true;
+}
