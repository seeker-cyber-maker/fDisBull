+    } else if (display_window.token && display_frame_fence.display_token &&
+               !strcmp(display_window.token, display_frame_fence.display_token)) {
+        updates = display_window.updates;
+    }
+
+    info->api_version = 1;
+    info->epoch = display_frame_fence.epoch;
+    info->state = g_strdup(display_frame_fence.completed ? "completed" :
+                           display_frame_fence.armed ? "armed" : "cancelled");
+    info->token = g_strdup(display_frame_fence.token);
+    info->display_token = g_strdup(display_frame_fence.display_token);
+    info->baseline_update_id = display_frame_fence.baseline_update_id;
+    info->updates = updates;
+    info->stop_pending = display_frame_fence.stop_pending;
+    info->stop_consumed = display_frame_fence.stop_consumed;
+    info->has_completed_update_id = display_frame_fence.completed;
+    info->completed_update_id = display_frame_fence.completed_update_id;
+    info->has_published_ns = display_frame_fence.completed;
+    info->published_ns = display_frame_fence.published_ns;
