+FdisbullDisplayFrameFenceInfo *qmp_x_fdisbull_arm_display_frame(
+    const char *token, const char *display_token, Error **errp)
+{
+    if (fdisbull_instrumented_checkpoint_busy()) {
+        error_setg(errp, "Instrumented checkpoint transaction is in progress");
+        return NULL;
+    }
+    if (!display_guard(errp)) {
+        return NULL;
+    }
+    if (!display_window.observing || !display_window.token ||
+        strcmp(display_token, display_window.token)) {
+        error_setg(errp, "Display-frame fence requires the current active display observer");
+        return NULL;
+    }
+    if (fdisbull_display_frame_fence_blocks_control() ||
+        display_frame_fence.stop_pending) {
+        error_setg(errp, "A display-frame fence is already active or unconsumed");
+        return NULL;
+    }
+    if (!token[0] || strlen(token) > 128 ||
+        (display_frame_fence.token && !strcmp(token, display_frame_fence.token))) {
+        error_setg(errp, "Display-frame fence requires a new token of 1..128 bytes");
+        return NULL;
+    }
+    g_free(display_frame_fence.token);
+    g_free(display_frame_fence.display_token);
+    display_frame_fence.initialized = true;
+    display_frame_fence.armed = true;
+    display_frame_fence.completed = false;
+    display_frame_fence.cancelled = false;
+    display_frame_fence.stop_pending = false;
+    display_frame_fence.stop_consumed = false;
+    display_frame_fence.epoch = display_window.epoch;
+    display_frame_fence.token = g_strdup(token);
+    display_frame_fence.display_token = g_strdup(display_token);
+    display_frame_fence.baseline_update_id = display_window.updates;
+    display_frame_fence.completed_update_id = 0;
+    display_frame_fence.published_ns = 0;
+    return display_frame_fence_info();
+}
+
+FdisbullDisplayFrameFenceInfo *qmp_x_fdisbull_query_display_frame(
+    const char *token, Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+
+    if (fdisbull_instrumented_checkpoint_busy()) {
+        error_setg(errp, "Instrumented checkpoint transaction is in progress");
+        return NULL;
+    }
+    if (!display_frame_fence.token || strcmp(token, display_frame_fence.token)) {
+        error_setg(errp, "Display-frame fence token does not own the current receipt");
+        return NULL;
+    }
+    clock = qmp_x_fdisbull_query_clock(errp);
+    if (!clock) {
+        return NULL;
+    }
+    if (clock->running || clock->pending_stop ||
+        clock->epoch != display_frame_fence.epoch) {
+        error_setg(errp, "Display-frame receipt requires its stopped clock epoch");
+        return NULL;
+    }
+    if (display_frame_fence.armed) {
+        if (!display_guard(errp) ||
+            !display_window.token ||
+            strcmp(display_frame_fence.display_token, display_window.token)) {
+            if (errp && !*errp) {
+                error_setg(errp, "Display-frame fence owner window changed");
+            }
+            return NULL;
+        }
+    }
+    return display_frame_fence_info();
+}
+
+FdisbullDisplayFrameFenceInfo *qmp_x_fdisbull_cancel_display_frame(
+    const char *token, Error **errp)
+{
+    if (fdisbull_instrumented_checkpoint_busy()) {
+        error_setg(errp, "Instrumented checkpoint transaction is in progress");
+        return NULL;
+    }
+    if (!display_frame_fence.token || strcmp(token, display_frame_fence.token)) {
+        error_setg(errp, "Display-frame fence token does not own the current receipt");
+        return NULL;
+    }
+    if (!display_window.invalidated &&
+        (display_frame_fence.armed || !display_frame_fence.cancelled) &&
+        !display_guard(errp)) {
+        return NULL;
+    }
+    if (display_frame_fence.armed &&
+        (display_frame_fence.epoch != display_window.epoch ||
+         !display_window.token ||
+         strcmp(display_frame_fence.display_token, display_window.token))) {
+        error_setg(errp, "Display-frame fence owner epoch/window changed");
+        return NULL;
+    }
+    display_frame_fence.armed = false;
+    display_frame_fence.cancelled = true;
+    return display_frame_fence_info();
 }
 
