+bool fdisbull_display_frame_checkpoint_safe(Error **errp)
+{
+    assert(bql_locked());
+    if (fdisbull_display_frame_fence_blocks_control() ||
+        display_frame_fence.stop_pending) {
+        error_setg(errp, "Cancel the native display-frame fence before checkpointing");
+        return false;
+    }
+    return true;
+}
+
+void fdisbull_display_frame_handle_stop_request(void)
+{
+    assert(bql_locked());
+    if (!display_frame_fence.stop_pending) {
+        return;
+    }
+    if (runstate_is_running()) {
+        /* Match the ordinary interrupt-class stop used by the clock budget. */
+        vm_stop(RUN_STATE_PAUSED);
+        display_frame_fence.stop_consumed = true;
+    }
+    /* A prior debugger or external stop wins and is not attributed to us. */
+    if (!runstate_is_running()) {
+        display_frame_fence.stop_pending = false;
+    }
 }
 
