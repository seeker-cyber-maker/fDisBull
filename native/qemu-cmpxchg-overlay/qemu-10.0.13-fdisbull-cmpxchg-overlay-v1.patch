+void HELPER(fdisbull_cmpxchg_failed_store)(CPUArchState *env, target_ulong addr,
+                                          target_ulong val, uint32_t oi)
+{
+    CPUState *cpu = env_cpu(env);
+    uintptr_t ra = GETPC();
+    switch (get_memop(oi) & MO_SIZE) {
+    case MO_8: do_st1_mmu_impl(cpu, addr, val, oi, ra, false); break;
+    case MO_16: do_st2_mmu_impl(cpu, addr, val, oi, ra, false); break;
+    case MO_32: do_st4_mmu_impl(cpu, addr, val, oi, ra, false); break;
+    case MO_64: do_st8_mmu_impl(cpu, addr, val, oi, ra, false); break;
+    default: g_assert_not_reached();
+    }
+    if (cpu_plugin_mem_cbs_enabled(cpu)) {
+        qemu_plugin_vcpu_mem_cb(cpu, addr, val, 0, oi, QEMU_PLUGIN_MEM_W);
+    }
+}
