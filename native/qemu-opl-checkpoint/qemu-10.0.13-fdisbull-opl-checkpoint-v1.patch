+static int checkpoint_rate_index(int32_t *ptr, int32_t *table, bool zero)
+{
+    int i;
+    for (i = 0; i < 16; i++) {
+        if (ptr == ((zero && !i) ? RATE_0 : &table[i * 4])) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static int checkpoint_depth(int32_t *ptr, int32_t *table, int count)
+{
+    if (ptr == table) return 0;
+    if (ptr == table + count) return 1;
+    return -1;
+}
+
+static int checkpoint_wave(int32_t **ptr)
+{
+    int i;
+    for (i = 0; i < 4; i++) {
+        if (ptr == &SIN_TABLE[i * SIN_ENT]) return i;
+    }
+    return -1;
+}
