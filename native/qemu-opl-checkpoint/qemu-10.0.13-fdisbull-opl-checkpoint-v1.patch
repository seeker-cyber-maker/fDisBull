+bool OPLCheckpointGet(FM_OPL *opl, OPLCheckpointState *state)
+{
+    int c, n;
+    if (!opl || !state || !opl->checkpoint_enabled || opl->max_ch != 9) {
+        return false;
+    }
+    memset(state, 0, sizeof(*state));
+    state->version = 1;
+    state->clock = opl->clock;
+    state->rate = opl->rate;
+    state->address = opl->address;
+    state->status = opl->status;
+    state->statusmask = opl->statusmask;
+    state->mode = opl->mode;
+    state->T0 = opl->T[0];
+    state->T1 = opl->T[1];
+    state->st0 = opl->st[0];
+    state->st1 = opl->st[1];
+    state->rhythm = opl->rhythm;
+    state->amsCnt = opl->amsCnt;
+    state->vibCnt = opl->vibCnt;
+    state->wavesel = opl->wavesel;
+    state->noise = opl->checkpoint_noise;
+    state->ams_depth = checkpoint_depth(opl->ams_table, AMS_TABLE, AMS_ENT);
+    state->vib_depth = checkpoint_depth(opl->vib_table, VIB_TABLE, VIB_ENT);
+    state->cache_ready = cur_chip == opl;
+    if (state->cache_ready) {
+        state->cache_ams_depth = checkpoint_depth(ams_table, AMS_TABLE, AMS_ENT);
+        state->cache_vib_depth = checkpoint_depth(vib_table, VIB_TABLE, VIB_ENT);
+    }
+    memcpy(state->registers, opl->checkpoint_registers, sizeof(state->registers));
+    for (c = 0; c < 9; c++) {
+        OPL_CH *ch = &opl->P_CH[c];
+        OPLCheckpointChannel *out = &state->channel[c];
+        out->CON = ch->CON;
+        out->FB = ch->FB;
+        out->op1_out0 = ch->op1_out[0];
+        out->op1_out1 = ch->op1_out[1];
+        out->block_fnum = ch->block_fnum;
+        out->kcode = ch->kcode;
+        out->fc = ch->fc;
+        out->ksl_base = ch->ksl_base;
+        out->keyon = ch->keyon;
+        if (ch->connect1 != (ch->CON ? outd : &feedback2) || ch->connect2 != outd) {
+            return false;
+        }
+        for (n = 0; n < 2; n++) {
+            OPL_SLOT *in = &ch->SLOT[n];
+            OPLCheckpointSlot *dst = &out->slot[n];
+            dst->TL = in->TL;
+            dst->TLL = in->TLL;
+            dst->KSR = in->KSR;
+            dst->SL = in->SL;
+            dst->ksl = in->ksl;
+            dst->ksr = in->ksr;
+            dst->mul = in->mul;
+            dst->Cnt = in->Cnt;
+            dst->Incr = in->Incr;
+            dst->eg_typ = in->eg_typ;
+            dst->evm = in->evm;
+            dst->evc = in->evc;
+            dst->eve = in->eve;
+            dst->evs = in->evs;
+            dst->evsa = in->evsa;
+            dst->evsd = in->evsd;
+            dst->evsr = in->evsr;
+            dst->ams = in->ams;
+            dst->vib = in->vib;
+            dst->ar_index = checkpoint_rate_index(in->AR, opl->AR_TABLE, true);
+            dst->dr_index = checkpoint_rate_index(in->DR, opl->DR_TABLE, true);
