+bool OPLCheckpointValidate(FM_OPL *opl, const OPLCheckpointState *state)
+{
+    int c, n;
+    if (!opl || !state || !opl->checkpoint_enabled || opl->max_ch != 9 ||
+        state->version != 1 || state->clock != opl->clock ||
+        state->rate != opl->rate || state->clock != 3579545 || state->rate != 32000 ||
+        state->address > 255 || state->status > 255 || state->statusmask > 255 ||
+        state->mode != 0 || !state->T0 || state->T0 > 1024 || state->T0 % 4 ||
+        !state->T1 || state->T1 > 4096 || state->T1 % 16 ||
+        state->st0 > 1 || state->st1 > 1 || state->rhythm > 63 ||
+        (state->wavesel != 0 && state->wavesel != 32) || !state->noise ||
+        state->ams_depth > 1 || state->vib_depth > 1 || state->cache_ready > 1 ||
+        state->cache_ams_depth > 1 || state->cache_vib_depth > 1 ||
+        (!state->cache_ready && (state->cache_ams_depth || state->cache_vib_depth))) {
+        return false;
+    }
+    for (c = 0; c < 9; c++) {
+        const OPLCheckpointChannel *ch = &state->channel[c];
+        if (ch->CON > 1 || (ch->FB && (ch->FB < 2 || ch->FB > 8)) ||
+            ch->block_fnum > 0x1fff || ch->kcode > 15 || ch->keyon > 1 ||
+            (int32_t)ch->op1_out0 < -(1 << TL_BITS) ||
+            (int32_t)ch->op1_out0 > (1 << TL_BITS) ||
+            (int32_t)ch->op1_out1 < -(1 << TL_BITS) ||
+            (int32_t)ch->op1_out1 > (1 << TL_BITS)) return false;
+        for (n = 0; n < 2; n++) {
+            const OPLCheckpointSlot *s = &ch->slot[n];
+            bool known_mul = false, known_sl = false;
+            int i;
+            for (i = 0; i < 16; i++) {
+                known_mul |= s->mul == MUL_TABLE[i];
+                known_sl |= s->SL == SL_TABLE[i];
+            }
+            if (!known_mul || !known_sl || s->TL > 2016 || s->TLL > 65535 ||
+                (s->KSR != 0 && s->KSR != 2) || s->ksr > 15 ||
+                (s->ksl != 0 && s->ksl != 1 && s->ksl != 2 && s->ksl != 31) ||
+                s->eg_typ > 1 || s->evm > 2 || s->evc > EG_OFF ||
+                s->eve > EG_OFF + 1 || s->evs > EG_AED - 1 ||
+                s->evsa > EG_AED - 1 || s->evsd > EG_AED - 1 || s->evsr > EG_AED - 1 ||
+                (s->ams != 0 && s->ams != 128) || (s->vib != 0 && s->vib != 64) ||
+                s->ar_index > 15 || s->dr_index > 15 || s->rr_index > 15 ||
+                s->wave_index > 3) return false;
+        }
+    }
+    return true;
+}
