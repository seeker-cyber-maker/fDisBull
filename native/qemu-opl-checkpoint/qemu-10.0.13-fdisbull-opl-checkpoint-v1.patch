--- a/audio/audio.c
+++ b/audio/audio.c
@@ -1426,6 +1426,526 @@
     return true;
 }
 
+/* The opt-in mixed graph has one HW/capture path and named, independently
+ * checkpointed software voices. Neither the v1 nor v2 wire format changes. */
+#define FDISBULL_OPL_CORE_MAGIC UINT64_C(0x4644424155443033)
+#define FDISBULL_OPL_ADLIB 0
+#define FDISBULL_OPL_SB16 1
+#define FDISBULL_OPL_VOICES 2
+
+typedef struct FdisbullOplVoice {
+    uint64_t present, freq, channels, bits, is_signed, swap;
+    uint64_t total, active, empty, size, pos, mute;
+    int64_t l, r;
+    uint64_t rate_opos, rate_increment, rate_ipos;
+    int64_t rate_last_l, rate_last_r;
+} FdisbullOplVoice;
+
+typedef struct FdisbullOplCore {
+    uint64_t magic, version, sample_size, byte_order;
+    uint64_t first_voice, has_capture;
+    uint64_t hw_size, hw_pos, hw_timestamp, hw_enabled, hw_pending_disable;
+    uint64_t emul_size, emul_pos, emul_pending;
+    FdisbullOplVoice voice[FDISBULL_OPL_VOICES];
+    uint64_t cap_size, cap_pos, cap_timestamp, cap_enabled;
+    uint64_t csw_total, csw_active, csw_empty, csw_mute;
+    int64_t csw_l, csw_r;
+} FdisbullOplCore;
+
+typedef struct FdisbullOplGraph {
+    AudioState *state;
+    HWVoiceOut *hw;
+    SWVoiceOut *voice[FDISBULL_OPL_VOICES];
+    unsigned first_voice;
+    CaptureVoiceOut *cap;
+    SWVoiceOut *csw;
+} FdisbullOplGraph;
+
+static bool fdisbull_opl_samples_valid(const uint8_t *bytes, uint64_t frames)
+{
+    uint64_t i;
+
+#ifdef FLOAT_MIXENG
+    return false;
+#endif
+    /* Source buffers retain one conversion's range; an HW/capture ring can
+     * contain the sum of both admitted voices, including a draining prefix. */
+    for (i = 0; i < frames; i++) {
+        st_sample value;
+        memcpy(&value, bytes + i * sizeof(value), sizeof(value));
+        if (value.l < -INT64_C(4294967296) ||
+            value.l > INT64_C(4294967296) ||
+            value.r < -INT64_C(4294967296) ||
+            value.r > INT64_C(4294967296)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool fdisbull_opl_activity_valid(uint64_t enabled, uint64_t pending,
+                                       bool active)
+{
+    return enabled <= 1 && pending <= 1 &&
+           (active ? enabled && !pending : enabled == pending);
+}
+
+static bool fdisbull_opl_voice_info(const struct audio_pcm_info *info,
+                                   unsigned identity)
+{
+    if (identity == FDISBULL_OPL_ADLIB) {
+        return info->freq == 32000 && info->nchannels == 1 &&
+               info->bits == 16 && info->is_signed && !info->is_float &&
+               !info->swap_endianness && info->bytes_per_frame == 2 &&
+               info->bytes_per_second == 64000;
+    }
+    return fdisbull_sb16_pcm_valid(info);
+}
+
+static bool fdisbull_opl_graph(FdisbullOplGraph *g, Error **errp)
+{
+    QEMUSoundCard *card, *cards[FDISBULL_OPL_VOICES] = { NULL };
+    SWVoiceOut *sw, *first;
+    SWVoiceCap *sc;
+    FdisbullRateState rate;
+    unsigned count = 0;
+    bool active = false;
+
+    assert(bql_locked());
+    memset(g, 0, sizeof(*g));
+#ifdef FLOAT_MIXENG
+    error_setg(errp, "Mixed OPL checkpoint requires the pinned integer mixer");
+    return false;
+#endif
+    if (audio_state_by_name("fdisbull-pc", NULL) ||
+        audio_state_by_name("fdisbull-sb16", NULL)) {
+        error_setg(errp, "Mixed OPL checkpoint requires an exclusive audio profile");
+        return false;
+    }
+    g->state = audio_state_by_name("fdisbull-sb16-opl", errp);
+    if (!g->state) {
+        return false;
+    }
+    if (!g->state->drv || strcmp(g->state->drv->name, "none") ||
+        !g->state->dev || g->state->vm_running ||
+        !audio_get_pdo_out(g->state->dev)->mixing_engine ||
+        !QLIST_EMPTY(&g->state->hw_head_in)) {
+        error_setg(errp, "Mixed OPL checkpoint requires its stopped none backend");
+        return false;
+    }
+    QLIST_FOREACH(card, &g->state->card_head, entries) {
+        unsigned id;
+        if (!card->name || card->state != g->state) {
+            goto graph_error;
+        }
+        if (!strcmp(card->name, "adlib")) {
+            id = FDISBULL_OPL_ADLIB;
+        } else if (!strcmp(card->name, "sb16")) {
+            id = FDISBULL_OPL_SB16;
+        } else {
+            goto graph_error;
+        }
+        if (cards[id]) {
+            goto graph_error;
+        }
+        cards[id] = card;
+    }
+    g->hw = QLIST_FIRST(&g->state->hw_head_out);
+    if (!cards[0] || !cards[1] || !g->hw || QLIST_NEXT(g->hw, entries) ||
+        g->hw->s != g->state || g->hw->poll_mode ||
+        !fdisbull_audio_info_supported(&g->hw->info) ||
+        !fdisbull_audio_buffer_valid(&g->hw->mix_buf) ||
+        !fdisbull_opl_samples_valid((uint8_t *)g->hw->mix_buf.buffer,
+                                   g->hw->mix_buf.size)) {
+        goto graph_error;
+    }
+    first = QLIST_FIRST(&g->hw->sw_head);
+    QLIST_FOREACH(sw, &g->hw->sw_head, entries) {
+        unsigned id;
+        if (!sw->name) {
+            goto graph_error;
+        }
+        if (!strcmp(sw->name, "adlib")) {
+            id = FDISBULL_OPL_ADLIB;
+        } else if (!strcmp(sw->name, "sb16")) {
+            id = FDISBULL_OPL_SB16;
+        } else {
+            goto graph_error;
+        }
+        if (++count > 2 || g->voice[id] || sw->card != cards[id] ||
+            sw->s != g->state || sw->hw != g->hw || !sw->conv ||
+            !sw->callback.fn || !sw->callback.opaque ||
+            !fdisbull_opl_voice_info(&sw->info, id) ||
+            sw->active < 0 || sw->active > 1 ||
+            sw->total_hw_samples_mixed > g->hw->mix_buf.size ||
+            sw->empty != (sw->total_hw_samples_mixed == 0) ||
+            !sw->resample_buf.buffer || sw->resample_buf.pos > 1 ||
+            !sw->resample_buf.size || sw->resample_buf.size > FDISBULL_SB16_SW_MAX ||
+            sw->resample_buf.size !=
+                ((uint64_t)g->hw->mix_buf.size * sw->info.freq / 32000) + 1 ||
+            !st_rate_checkpoint_get(sw->rate, sw->info.freq, 32000, &rate) ||
+            !fdisbull_sb16_volume_valid(sw->vol.mute, sw->vol.l, sw->vol.r) ||
+            !fdisbull_sb16_samples_valid((uint8_t *)sw->resample_buf.buffer,
+                                       sw->resample_buf.size)) {
+            goto graph_error;
+        }
+        g->voice[id] = sw;
+        active |= sw->active;
+    }
+    if (!g->voice[FDISBULL_OPL_ADLIB] ||
+        !fdisbull_opl_activity_valid(g->hw->enabled, g->hw->pending_disable,
+                                     active)) {
+        goto graph_error;
+    }
+    g->first_voice = first == g->voice[FDISBULL_OPL_ADLIB] ?
+                     FDISBULL_OPL_ADLIB : FDISBULL_OPL_SB16;
+    if ((g->hw->buf_emul && (!g->hw->size_emul || g->hw->size_emul > 65536 ||
+            g->hw->pos_emul >= g->hw->size_emul ||
+            g->hw->pending_emul > g->hw->size_emul)) ||
+        (!g->hw->buf_emul && (g->hw->size_emul || g->hw->pos_emul ||
+                            g->hw->pending_emul))) {
+        goto graph_error;
+    }
+    sc = QLIST_FIRST(&g->hw->cap_head);
+    g->cap = QLIST_FIRST(&g->state->cap_head);
+    if (g->cap) {
+        struct capture_callback *cb = QLIST_FIRST(&g->cap->cb_head);
+        g->csw = QLIST_FIRST(&g->cap->hw.sw_head);
+        if (QLIST_NEXT(g->cap, entries) || g->cap->hw.s != g->state ||
+            !cb || QLIST_NEXT(cb, entries) || !cb->ops.capture || !cb->ops.notify ||
+            !fdisbull_audio_info_supported(&g->cap->hw.info) ||
+            !fdisbull_audio_buffer_valid(&g->cap->hw.mix_buf) ||
+            g->cap->hw.pending_disable || g->cap->hw.poll_mode ||
+            g->cap->hw.buf_emul || g->cap->hw.size_emul ||
+            g->cap->hw.pos_emul || g->cap->hw.pending_emul || !g->cap->buf ||
+            !fdisbull_opl_samples_valid((uint8_t *)g->cap->hw.mix_buf.buffer,
+                                       g->cap->hw.mix_buf.size) ||
+            !sc || QLIST_NEXT(sc, entries) || sc->cap != g->cap ||
+            g->csw != &sc->sw || QLIST_NEXT(g->csw, entries) ||
+            g->csw->hw != &g->cap->hw ||
+            g->csw->total_hw_samples_mixed > g->cap->hw.mix_buf.size ||
+            g->csw->empty != (g->csw->total_hw_samples_mixed == 0) ||
+            g->csw->active != g->hw->enabled ||
+            g->cap->hw.enabled != g->hw->enabled || g->csw->resample_buf.pos ||
+            !fdisbull_audio_info_supported(&g->csw->info) ||
+            !st_rate_checkpoint_get(g->csw->rate, 32000, 32000, &rate) ||
+            !fdisbull_sb16_volume_valid(g->csw->vol.mute,
+                                       g->csw->vol.l, g->csw->vol.r)) {
+            goto graph_error;
+        }
+    } else if (sc) {
+        goto graph_error;
+    }
+    return true;
+
+graph_error:
+    error_setg(errp, "Mixed OPL checkpoint graph, voice or bounded buffers differ");
+    return false;
+}
+
+static void fdisbull_opl_voice_export(SWVoiceOut *sw, FdisbullOplVoice *v)
+{
+    FdisbullRateState rate;
+
+    if (!sw) {
+        return;
+    }
+    st_rate_checkpoint_get(sw->rate, sw->info.freq, 32000, &rate);
+    v->present = 1; v->freq = sw->info.freq; v->channels = sw->info.nchannels;
+    v->bits = sw->info.bits; v->is_signed = sw->info.is_signed;
+    v->swap = sw->info.swap_endianness;
+    v->total = sw->total_hw_samples_mixed; v->active = sw->active;
+    v->empty = sw->empty; v->size = sw->resample_buf.size;
+    v->pos = sw->resample_buf.pos; v->mute = sw->vol.mute;
+    v->l = sw->vol.l; v->r = sw->vol.r;
+    v->rate_opos = rate.opos; v->rate_increment = rate.opos_inc;
+    v->rate_ipos = rate.ipos;
+    v->rate_last_l = rate.ilast.l; v->rate_last_r = rate.ilast.r;
+}
+
+static char *fdisbull_opl_export(Error **errp)
+{
+    FdisbullOplGraph g;
+    FdisbullOplCore h = { 0 };
+    g_autofree uint8_t *blob = NULL;
+    uint8_t *p;
+    size_t len;
+    unsigned i;
+
+    if (!fdisbull_opl_graph(&g, errp)) {
+        return NULL;
+    }
+    h.magic = FDISBULL_OPL_CORE_MAGIC; h.version = 3;
+    h.sample_size = sizeof(st_sample); h.byte_order = G_BYTE_ORDER;
+    h.first_voice = g.first_voice; h.has_capture = g.cap != NULL;
+    h.hw_size = g.hw->mix_buf.size; h.hw_pos = g.hw->mix_buf.pos;
+    h.hw_timestamp = g.hw->ts_helper; h.hw_enabled = g.hw->enabled;
+    h.hw_pending_disable = g.hw->pending_disable;
+    h.emul_size = g.hw->size_emul; h.emul_pos = g.hw->pos_emul;
+    h.emul_pending = g.hw->pending_emul;
+    len = sizeof(h) + h.hw_size * sizeof(st_sample) + h.emul_size;
+    for (i = 0; i < 2; i++) {
+        fdisbull_opl_voice_export(g.voice[i], &h.voice[i]);
+        len += h.voice[i].size * sizeof(st_sample);
+    }
+    if (g.cap) {
+        h.cap_size = g.cap->hw.mix_buf.size; h.cap_pos = g.cap->hw.mix_buf.pos;
+        h.cap_timestamp = g.cap->hw.ts_helper; h.cap_enabled = g.cap->hw.enabled;
+        h.csw_total = g.csw->total_hw_samples_mixed; h.csw_active = g.csw->active;
+        h.csw_empty = g.csw->empty; h.csw_mute = g.csw->vol.mute;
+        h.csw_l = g.csw->vol.l; h.csw_r = g.csw->vol.r;
+        len += h.cap_size * sizeof(st_sample);
+    }
+    if (4 * ((len + 2) / 3) > FDISBULL_SB16_CORE_MAX) {
+        error_setg(errp, "Mixed OPL checkpoint encoding exceeds its byte budget");
+        return NULL;
+    }
+    blob = g_malloc0(len); p = blob;
+    memcpy(p, &h, sizeof(h)); p += sizeof(h);
+    memcpy(p, g.hw->mix_buf.buffer, h.hw_size * sizeof(st_sample));
+    p += h.hw_size * sizeof(st_sample);
+    for (i = 0; i < 2; i++) {
+        if (g.voice[i]) {
+            memcpy(p, g.voice[i]->resample_buf.buffer, h.voice[i].size * sizeof(st_sample));
+            p += h.voice[i].size * sizeof(st_sample);
+        }
+    }
+    if (g.cap) {
+        memcpy(p, g.cap->hw.mix_buf.buffer, h.cap_size * sizeof(st_sample));
+        p += h.cap_size * sizeof(st_sample);
+    }
+    if (h.emul_pending) {
+        size_t first = audio_ring_posb(h.emul_pos, h.emul_pending, h.emul_size);
+        size_t count = MIN(h.emul_pending, h.emul_size - first);
+        memcpy(p + first, g.hw->buf_emul + first, count);
+        if (count < h.emul_pending) {
+            memcpy(p, g.hw->buf_emul, h.emul_pending - count);
+        }
+    }
+    return g_base64_encode(blob, len);
+}
+
+static bool fdisbull_opl_voice_valid(const FdisbullOplVoice *v,
+                                    uint64_t hw_size, unsigned id,
+                                    FdisbullRateState *rate)
+{
+    if (!v->present) {
+        return id == FDISBULL_OPL_SB16 &&
+               !memcmp(v, &(FdisbullOplVoice){ 0 }, sizeof(*v));
+    }
+    if (v->present != 1 || v->freq < 5000 || v->freq > 45000 ||
+        (v->channels != 1 && v->channels != 2) ||
+        (v->bits != 8 && v->bits != 16) || v->is_signed > 1 ||
+        v->swap > 1 || v->total > hw_size || v->active > 1 ||
+        v->empty != (v->total == 0) || v->pos > 1 ||
+        !v->size || v->size > FDISBULL_SB16_SW_MAX ||
+        v->size != hw_size * v->freq / 32000 + 1 ||
+        !fdisbull_sb16_volume_valid(v->mute, v->l, v->r) ||
+        v->rate_ipos > UINT32_MAX ||
+        (id == FDISBULL_OPL_ADLIB &&
+            (v->freq != 32000 || v->channels != 1 || v->bits != 16 ||
+             !v->is_signed || v->swap)) ||
+        (id == FDISBULL_OPL_SB16 && v->swap != (AUDIO_HOST_ENDIANNESS != 0))) {
+        return false;
+    }
+    rate->opos = v->rate_opos; rate->opos_inc = v->rate_increment;
+    rate->ipos = v->rate_ipos;
+    rate->ilast.l = v->rate_last_l; rate->ilast.r = v->rate_last_r;
+    return st_rate_checkpoint_validate(rate, v->freq, 32000);
+}
+
+static bool fdisbull_opl_import(const char *base64, Error **errp)
+{
+    FdisbullOplCore h;
+    FdisbullOplGraph g;
+    FdisbullRateState rates[2];
+    g_autofree guchar *blob = NULL;
+    g_autofree char *canonical = NULL;
+    g_autofree uint8_t *emul = NULL;
+    const uint8_t *hw_data, *sw_data[2], *cap_data, *p;
+    gsize len;
+    size_t expected;
+    unsigned i;
+    bool active;
+
+    if (!base64 || !*base64 || strlen(base64) > FDISBULL_SB16_CORE_MAX) {
+        error_setg(errp, "Mixed OPL checkpoint encoding is missing or oversized");
+        return false;
+    }
+    blob = g_base64_decode(base64, &len);
+    canonical = g_base64_encode(blob, len);
+    if (strcmp(canonical, base64) || len < sizeof(h)) {
+        error_setg(errp, "Mixed OPL checkpoint encoding is not canonical");
+        return false;
+    }
+    memcpy(&h, blob, sizeof(h));
+    active = h.voice[0].active || h.voice[1].active;
+    if (h.magic != FDISBULL_OPL_CORE_MAGIC || h.version != 3 ||
+        h.sample_size != sizeof(st_sample) || h.byte_order != G_BYTE_ORDER ||
+        !h.hw_size || h.hw_size > FDISBULL_SB16_HW_MAX || h.hw_pos >= h.hw_size ||
+        h.first_voice > 1 || (h.first_voice == 1 && !h.voice[1].present) ||
+        h.has_capture > 1 || h.cap_size > FDISBULL_SB16_HW_MAX ||
+        h.emul_size > 65536 || h.emul_pending > h.emul_size ||
+        (h.emul_size ? h.emul_pos >= h.emul_size : h.emul_pos != 0) ||
+        !fdisbull_opl_activity_valid(h.hw_enabled, h.hw_pending_disable, active) ||
+        !fdisbull_opl_voice_valid(&h.voice[0], h.hw_size, 0, &rates[0]) ||
+        !fdisbull_opl_voice_valid(&h.voice[1], h.hw_size, 1, &rates[1])) {
+        error_setg(errp, "Mixed OPL checkpoint header or software state is invalid");
+        return false;
+    }
+    if (h.has_capture) {
+        if (!h.cap_size || h.cap_pos >= h.cap_size || h.csw_total > h.cap_size ||
+            h.csw_empty != (h.csw_total == 0) || h.csw_active != h.hw_enabled ||
+            h.cap_enabled != h.hw_enabled ||
+            !fdisbull_sb16_volume_valid(h.csw_mute, h.csw_l, h.csw_r)) {
+            error_setg(errp, "Mixed OPL checkpoint capture state is invalid");
+            return false;
+        }
+    } else if (h.cap_size || h.cap_pos || h.cap_timestamp || h.cap_enabled ||
+               h.csw_total || h.csw_active || h.csw_empty || h.csw_mute ||
+               h.csw_l || h.csw_r) {
+        error_setg(errp, "Mixed OPL checkpoint retains an absent capture");
+        return false;
+    }
+    expected = sizeof(h) + (h.hw_size + h.voice[0].size + h.voice[1].size +
+                            h.cap_size) * sizeof(st_sample) + h.emul_size;
+    if (len != expected || !fdisbull_opl_graph(&g, errp)) {
+        if (len != expected) {
+            error_setg(errp, "Mixed OPL checkpoint payload length differs");
+        }
+        return false;
+    }
+    if (g.hw->mix_buf.size != h.hw_size || !!g.cap != h.has_capture ||
+        (g.cap && g.cap->hw.mix_buf.size != h.cap_size)) {
+        goto destination_error;
+    }
+    for (i = 0; i < 2; i++) {
+        SWVoiceOut *sw = g.voice[i];
+        FdisbullOplVoice *v = &h.voice[i];
+        if (!!sw != v->present || (sw &&
+            (sw->info.freq != v->freq || sw->info.nchannels != v->channels ||
+             sw->info.bits != v->bits || sw->info.is_signed != v->is_signed ||
+             sw->info.swap_endianness != v->swap || sw->resample_buf.size != v->size))) {
+            goto destination_error;
+        }
+    }
+    p = blob + sizeof(h); hw_data = p; p += h.hw_size * sizeof(st_sample);
+    if (!fdisbull_opl_samples_valid(hw_data, h.hw_size)) {
+        goto sample_error;
+    }
+    for (i = 0; i < 2; i++) {
+        sw_data[i] = p; p += h.voice[i].size * sizeof(st_sample);
+        if (!fdisbull_sb16_samples_valid(sw_data[i], h.voice[i].size)) {
+            goto sample_error;
+        }
+    }
+    cap_data = p; p += h.cap_size * sizeof(st_sample);
+    if (!fdisbull_opl_samples_valid(cap_data, h.cap_size)) {
+        goto sample_error;
+    }
+    if (h.emul_size) {
+        size_t first = audio_ring_posb(h.emul_pos, h.emul_pending, h.emul_size);
+        for (i = 0; i < h.emul_size; i++) {
+            if ((i + h.emul_size - first) % h.emul_size >= h.emul_pending && p[i]) {
+                error_setg(errp, "Mixed OPL unused backend bytes are not canonical");
+                return false;
+            }
+        }
+        emul = g_memdup2(p, h.emul_size);
+    }
+    /* The entire input, graph and allocation are validated before mutation. */
+    memcpy(g.hw->mix_buf.buffer, hw_data, h.hw_size * sizeof(st_sample));
+    g.hw->mix_buf.pos = h.hw_pos; g.hw->ts_helper = h.hw_timestamp;
+    g.hw->enabled = h.hw_enabled; g.hw->pending_disable = h.hw_pending_disable;
+    g_free(g.hw->buf_emul); g.hw->buf_emul = g_steal_pointer(&emul);
+    g.hw->size_emul = h.emul_size; g.hw->pos_emul = h.emul_pos;
+    g.hw->pending_emul = h.emul_pending;
+    for (i = 0; i < 2; i++) {
+        SWVoiceOut *sw = g.voice[i];
+        FdisbullOplVoice *v = &h.voice[i];
+        if (!sw) {
+            continue;
+        }
+        memcpy(sw->resample_buf.buffer, sw_data[i], v->size * sizeof(st_sample));
+        sw->total_hw_samples_mixed = v->total;
+        sw->active = v->active; sw->empty = v->empty; sw->resample_buf.pos = v->pos;
+        sw->vol.mute = v->mute; sw->vol.l = v->l; sw->vol.r = v->r;
+        st_rate_checkpoint_import(sw->rate, v->freq, 32000, &rates[i]);
+    }
+    if (g.voice[1]) {
+        /* Preserve callback sequencing by named identity, not fresh list order. */
+        QLIST_REMOVE(g.voice[0], entries); QLIST_REMOVE(g.voice[1], entries);
+        QLIST_INSERT_HEAD(&g.hw->sw_head, g.voice[1 - h.first_voice], entries);
+        QLIST_INSERT_HEAD(&g.hw->sw_head, g.voice[h.first_voice], entries);
+    }
+    if (g.cap) {
+        memcpy(g.cap->hw.mix_buf.buffer, cap_data, h.cap_size * sizeof(st_sample));
+        g.cap->hw.mix_buf.pos = h.cap_pos; g.cap->hw.ts_helper = h.cap_timestamp;
+        g.cap->hw.enabled = h.cap_enabled;
+        g.csw->total_hw_samples_mixed = h.csw_total;
+        g.csw->active = h.csw_active; g.csw->empty = h.csw_empty;
+        g.csw->vol.mute = h.csw_mute; g.csw->vol.l = h.csw_l; g.csw->vol.r = h.csw_r;
+        audio_notify_capture(g.cap, h.cap_enabled ? AUD_CNOTIFY_ENABLE : AUD_CNOTIFY_DISABLE);
+    }
+    return true;
+
+destination_error:
+    error_setg(errp, "Mixed OPL checkpoint differs from reconstructed voice geometry");
+    return false;
+sample_error:
+    error_setg(errp, "Mixed OPL checkpoint sample range is invalid");
+    return false;
+}
+
+static bool fdisbull_opl_timer(int64_t *timer_ns, bool restore, Error **errp)
+{
+    FdisbullOplGraph g;
+    bool needed, pending;
+    int64_t now;
+    uint64_t expiry;
+
+    if (!timer_ns || !fdisbull_opl_graph(&g, errp)) {
+        return false;
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    needed = audio_is_timer_needed(g.state);
+    if (g.state->period_ticks <= 0 || now < 0 ||
+        g.state->period_ticks > INT64_MAX - now) {
+        error_setg(errp, "Mixed OPL checkpoint timer range is invalid");
+        return false;
+    }
+    if (!restore) {
+        pending = timer_pending(g.state->ts);
+        if (pending != g.state->timer_running || pending != needed) {
+            error_setg(errp, "Mixed OPL checkpoint timer is not reconstructible");
+            return false;
+        }
+        if (!pending) {
+            *timer_ns = -1;
+            return true;
+        }
+        expiry = timer_expire_time_ns(g.state->ts);
+        if (expiry > (uint64_t)(now + g.state->period_ticks)) {
+            error_setg(errp, "Mixed OPL checkpoint deadline would change on resume");
+            return false;
+        }
+        *timer_ns = expiry;
+        return true;
+    }
+    if (*timer_ns < -1 || (*timer_ns >= 0) != needed ||
+        (*timer_ns >= 0 && *timer_ns > now + g.state->period_ticks)) {
+        error_setg(errp, "Restored mixed OPL timer differs from output activity");
+        return false;
+    }
+    if (*timer_ns < 0) {
+        timer_del(g.state->ts); g.state->timer_running = false;
+    } else {
+        timer_mod_ns(g.state->ts, *timer_ns); g.state->timer_running = true;
+        g.state->timer_last = now;
+    }
+    return true;
+}
