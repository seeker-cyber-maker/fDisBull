+static AdlibState *checkpoint_adlib(Error **errp)
+{
+    bool ambiguous = false;
+    Object *obj = object_resolve_path_type("", TYPE_ADLIB, &ambiguous);
+    AdlibState *s;
+    if (ambiguous || !obj || !DEVICE(obj)->realized) {
+        error_setg(errp, "OPL checkpoint requires exactly one realized AdLib");
+        return NULL;
+    }
+    s = ADLIB(obj);
+    if (!s->fdisbull_checkpoint ||
+        strcmp(audio_get_id(&s->card), "fdisbull-sb16-opl")) {
+        error_setg(errp, "OPL checkpoint profile/property is not selected");
+        return NULL;
+    }
+    return s;
+}
+
+static bool checkpoint_wrapper_safe(AdlibState *s, Error **errp)
+{
+    OPLCheckpointState state;
+    if (runstate_is_running() || !s->opl || !s->voice || !s->mixbuf ||
+        s->freq != 32000 || s->port != 0x220 || s->samples != 1025 ||
+        s->left < 0 || s->left > s->samples || s->pos < 0 || s->pos >= s->samples ||
+        s->left > s->samples - s->pos ||
+        s->bufpos != 0 || (s->enabled != 0 && s->enabled != 1) ||
+        (s->active != 0 && s->active != 1) ||
+        s->ticking[0] < 0 || s->ticking[0] > 1 ||
+        s->ticking[1] < 0 || s->ticking[1] > 1 ||
+        s->dexp[0] > 100000 || s->dexp[1] > 100000 ||
+        s->voice->info.freq != 32000 || s->voice->info.nchannels != 1 ||
+        s->voice->info.bits != 16 || !s->voice->info.is_signed ||
+        s->voice->info.is_float || s->voice->info.swap_endianness ||
+        s->voice->active < 0 || s->voice->active > 1 ||
+        !OPLCheckpointGet(s->opl, &state)) {
+        error_setg(errp, "OPL checkpoint wrapper, voice or synth state is unsupported");
+        return false;
+    }
+    return true;
+}
+
+bool fdisbull_opl_checkpoint_safe(Error **errp)
+{
+    AdlibState *s = checkpoint_adlib(errp);
+    int64_t deadline;
+    return s && checkpoint_wrapper_safe(s, errp) &&
+        fdisbull_audio_output_checkpoint_safe(&deadline, errp);
+}
+
+static bool adlib_checkpoint_needed(void *opaque)
+{
+    AdlibState *s = opaque;
+    return s->fdisbull_checkpoint && fdisbull_instrumented_checkpoint_busy() &&
+        !strcmp(audio_get_id(&s->card), "fdisbull-sb16-opl");
+}
+
+static int adlib_checkpoint_pre_save(void *opaque)
+{
+    AdlibState *s = opaque;
+    g_autoptr(Error) err = NULL;
+    if (s != checkpoint_adlib(&err) || !checkpoint_wrapper_safe(s, &err) ||
+        !fdisbull_audio_output_checkpoint_safe(&s->checkpoint_audio_deadline, &err) ||
+        !OPLCheckpointGet(s->opl, &s->checkpoint_synth)) {
+        if (err) error_report_err(g_steal_pointer(&err));
+        return -EINVAL;
+    }
+    s->checkpoint_voice_active = s->voice->active;
+    memcpy(s->checkpoint_mixbuf, s->mixbuf, sizeof(s->checkpoint_mixbuf));
+    return 0;
+}
+
+static int adlib_checkpoint_pre_load(void *opaque)
+{
+    AdlibState *s = opaque;
+    s->checkpoint_loaded = false;
+    return 0;
+}
+
+static int adlib_checkpoint_post_load(void *opaque, int version_id)
+{
+    AdlibState *s = opaque;
+    if (!fdisbull_instrumented_checkpoint_busy() ||
+        s != checkpoint_adlib(NULL) || s->checkpoint_audio_deadline < -1 ||
+        !checkpoint_wrapper_safe(s, NULL) ||
+        !OPLCheckpointValidate(s->opl, &s->checkpoint_synth)) {
+        return -EINVAL;
+    }
+    if (!OPLCheckpointPut(s->opl, &s->checkpoint_synth)) return -EINVAL;
+    memcpy(s->mixbuf, s->checkpoint_mixbuf, sizeof(s->checkpoint_mixbuf));
+    AUD_set_active_out(s->voice, s->checkpoint_voice_active);
+    s->checkpoint_loaded = true;
+    return 0;
+}
+
+bool fdisbull_opl_checkpoint_rearm(Error **errp)
+{
+    AdlibState *s = checkpoint_adlib(errp);
+    OPLCheckpointState current;
+    int64_t current_deadline;
+    if (!s) return false;
+    if (!fdisbull_instrumented_checkpoint_busy() || !s->checkpoint_loaded ||
+        !checkpoint_wrapper_safe(s, errp) ||
+        !!s->voice->active != s->checkpoint_voice_active ||
+        !OPLCheckpointGet(s->opl, &current) ||
+        memcmp(&current, &s->checkpoint_synth, sizeof(current))) {
+        if (!errp || !*errp) error_setg(errp, "OPL scoped restored state is absent or changed");
+        return false;
+    }
+    /* SB16 rearms this shared graph first. Its independently saved deadline
+     * must agree; a contradictory wrapper must never win by loading last. */
+    if (!fdisbull_audio_output_checkpoint_safe(&current_deadline, errp)) {
+        return false;
+    }
+    if (current_deadline != s->checkpoint_audio_deadline) {
+        error_setg(errp, "OPL and shared audio checkpoint deadlines disagree");
+        return false;
+    }
+    if (!fdisbull_audio_output_checkpoint_restore_timer(s->checkpoint_audio_deadline, errp)) {
+        return false;
+    }
+    s->checkpoint_loaded = false;
+    return true;
+}
