+bool OPLCheckpointPut(FM_OPL *opl, const OPLCheckpointState *state)
+{
+    int c, n;
+    if (!OPLCheckpointValidate(opl, state)) return false;
+    opl->clock = state->clock;
+    opl->rate = state->rate;
+    opl->address = state->address;
+    opl->status = state->status;
+    opl->statusmask = state->statusmask;
+    opl->mode = state->mode;
+    opl->T[0] = state->T0;
+    opl->T[1] = state->T1;
+    opl->st[0] = state->st0;
+    opl->st[1] = state->st1;
+    opl->rhythm = state->rhythm;
+    opl->amsCnt = state->amsCnt;
+    opl->vibCnt = state->vibCnt;
+    opl->wavesel = state->wavesel;
+    opl->checkpoint_noise = state->noise;
+    opl->ams_table = &AMS_TABLE[state->ams_depth * AMS_ENT];
+    opl->vib_table = &VIB_TABLE[state->vib_depth * VIB_ENT];
+    memcpy(opl->checkpoint_registers, state->registers, sizeof(state->registers));
+    for (c = 0; c < 9; c++) {
+        OPL_CH *ch = &opl->P_CH[c];
+        const OPLCheckpointChannel *in = &state->channel[c];
+        ch->CON = in->CON;
+        ch->FB = in->FB;
+        ch->op1_out[0] = in->op1_out0;
+        ch->op1_out[1] = in->op1_out1;
+        ch->block_fnum = in->block_fnum;
+        ch->kcode = in->kcode;
+        ch->fc = in->fc;
+        ch->ksl_base = in->ksl_base;
+        ch->keyon = in->keyon;
+        set_algorithm(ch);
+        for (n = 0; n < 2; n++) {
+            OPL_SLOT *out = &ch->SLOT[n];
+            const OPLCheckpointSlot *src = &in->slot[n];
+            out->TL = src->TL;
+            out->TLL = src->TLL;
+            out->KSR = src->KSR;
+            out->SL = src->SL;
+            out->ksl = src->ksl;
+            out->ksr = src->ksr;
+            out->mul = src->mul;
+            out->Cnt = src->Cnt;
+            out->Incr = src->Incr;
+            out->eg_typ = src->eg_typ;
+            out->evm = src->evm;
+            out->evc = src->evc;
+            out->eve = src->eve;
+            out->evs = src->evs;
+            out->evsa = src->evsa;
+            out->evsd = src->evsd;
+            out->evsr = src->evsr;
+            out->ams = src->ams;
+            out->vib = src->vib;
+            out->AR = src->ar_index ? &opl->AR_TABLE[src->ar_index * 4] : RATE_0;
+            out->DR = src->dr_index ? &opl->DR_TABLE[src->dr_index * 4] : RATE_0;
+            out->RR = &opl->DR_TABLE[src->rr_index * 4];
+            out->wavetable = &SIN_TABLE[src->wave_index * SIN_ENT];
+        }
+    }
+    /* Rebuild the actual cached selectors, even if a prior BD write made
+     * them differ from the per-chip selectors. Do not write/key-on registers. */
+    cur_chip = NULL;
+    if (state->cache_ready) {
+        cur_chip = opl;
+        S_CH = opl->P_CH; E_CH = &S_CH[9];
+        SLOT7_1 = &S_CH[7].SLOT[0]; SLOT7_2 = &S_CH[7].SLOT[1];
+        SLOT8_1 = &S_CH[8].SLOT[0]; SLOT8_2 = &S_CH[8].SLOT[1];
+        amsIncr = opl->amsIncr; vibIncr = opl->vibIncr;
+        ams_table = &AMS_TABLE[state->cache_ams_depth * AMS_ENT];
+        vib_table = &VIB_TABLE[state->cache_vib_depth * VIB_ENT];
+    }
+    return true;
+}
