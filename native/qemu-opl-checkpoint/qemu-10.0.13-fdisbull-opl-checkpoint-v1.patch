+FdisbullOplInfo *qmp_x_fdisbull_query_opl(Error **errp)
+{
+    AdlibState *s = checkpoint_adlib(errp);
+    OPLCheckpointState state;
+    FdisbullOplInfo *r;
+    GChecksum *sum;
+    uint64_t wrapper[14];
+    int c, n;
+    if (!s || !checkpoint_wrapper_safe(s, errp) || !OPLCheckpointGet(s->opl, &state)) {
+        return NULL;
+    }
+    r = g_new0(FdisbullOplInfo, 1);
+    r->api_version = 1; r->iobase = s->port; r->frequency = s->freq;
+    r->audiodev_id = g_strdup(audio_get_id(&s->card));
+    r->checkpoint_enabled = s->fdisbull_checkpoint;
+    r->active = s->active; r->enabled = s->enabled;
+    r->address = state.address; r->status = state.status; r->status_mask = state.statusmask;
+    r->mode = state.mode; r->rhythm = state.rhythm;
+    r->timer1_ticking = s->ticking[0]; r->timer2_ticking = s->ticking[1];
+    r->timer1_expiry_us = s->dexp[0]; r->timer2_expiry_us = s->dexp[1];
+    r->noise_state = state.noise;
+    r->synth_state_sha256 = checkpoint_hash(&state, sizeof(state));
+    r->register_sha256 = checkpoint_hash(state.registers, sizeof(state.registers));
+    for (c = 0; c < 9; c++) {
+        r->keyon_mask |= state.channel[c].keyon << c;
+        for (n = 0; n < 2; n++) {
+            r->active_operators += state.channel[c].slot[n].evc < (UINT32_C(8192) << 16);
+        }
+    }
+    wrapper[0] = s->freq; wrapper[1] = s->port; wrapper[2] = s->enabled;
+    wrapper[3] = s->active; wrapper[4] = s->bufpos; wrapper[5] = s->left;
+    wrapper[6] = s->pos; wrapper[7] = s->samples; wrapper[8] = s->ats.old_ts;
+    wrapper[9] = s->ticking[0]; wrapper[10] = s->ticking[1];
+    wrapper[11] = s->dexp[0]; wrapper[12] = s->dexp[1];
+    wrapper[13] = s->voice->active;
+    sum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_checksum_update(sum, (const guchar *)&state, sizeof(state));
+    g_checksum_update(sum, (const guchar *)wrapper, sizeof(wrapper));
+    g_checksum_update(sum, (const guchar *)s->mixbuf, sizeof(s->checkpoint_mixbuf));
+    r->state_sha256 = g_strdup(g_checksum_get_string(sum));
+    g_checksum_free(sum);
+    return r;
+}
