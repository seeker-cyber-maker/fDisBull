+##
+# @FdisbullClockBudgetState:
+#
+# Experimental fDisBull virtual-clock budget lifecycle.
+#
+# @idle: No budget has been armed.
+# @armed: A virtual timer is pending; the VM has not been resumed by this API.
+# @fired: The timer fired and requested a deferred native stop.
+# @stopped: The VM stopped, either before the timer or after it fired.
+# @cancelled: The matching stopped budget has been disarmed and acknowledged.
+# @invalidated: Reset or an unsupported runstate invalidated this process.
+#
+# Since: 10.0
+##
+{ 'enum': 'FdisbullClockBudgetState',
+  'data': [ 'idle', 'armed', 'fired', 'stopped', 'cancelled', 'invalidated' ] }
+
+##
+# @FdisbullClockInfo:
+#
+# Versioned native QEMU_CLOCK_VIRTUAL observation and budget receipt.
+#
+# @api-version: Private extension protocol version, currently 1.
+# @epoch: Process-local clock epoch, starting at 1; invalidation changes it.
+# @virtual-ns: Native virtual clock value, without an instruction conversion.
+# @running: Whether QEMU is in the running state.
+# @status: Native runstate at observation.
+# @budget-supported: Whether the fixed-icount single-vCPU profile is eligible.
+# @pending-stop: A native budget stop has not yet been consumed or satisfied.
+# @budget-state: Latest budget state.
+# @budget-token: Caller token for the latest budget, when present.
+# @budget-start-ns: Virtual time at arming.
+# @budget-deadline-ns: Absolute native virtual timer deadline.
+# @budget-fired-ns: Virtual time observed by the timer callback, if it fired.
+# @budget-stopped-ns: Virtual time after CPUs stopped or paused cancellation.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullClockInfo',
+  'data': { 'api-version': 'int', 'epoch': 'uint64', 'virtual-ns': 'int',
+            'running': 'bool', 'status': 'RunState',
+            'budget-supported': 'bool', 'pending-stop': 'bool',
+            'budget-state': 'FdisbullClockBudgetState',
+            '*budget-token': 'str', '*budget-start-ns': 'int',
+            '*budget-deadline-ns': 'int', '*budget-fired-ns': 'int',
+            '*budget-stopped-ns': 'int' } }
+
+##
+# @x-fdisbull-query-clock:
+#
+# Observe the native virtual clock without advancing it or resuming the VM.
+# Stopped observations are the supported stable observation contract.
+#
+# Returns: A version-1 native clock and budget record.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-query-clock', 'returns': 'FdisbullClockInfo' }
+
+##
+# @x-fdisbull-arm-clock-budget:
+#
+# Arm one ordinary virtual timer while one fixed-icount vCPU is stopped.
+# The caller separately owns exactly one GDB continue.  This command never
+# resumes the VM and does not set the clock.  Migration remains blocked
+# after the first successful arm.  Reset/restore invalidates the extension.
+#
+# @delta-ns: Positive virtual nanoseconds, at most 60000000000.
+# @token: New caller token, 1 through 128 bytes, used for cancellation.
+#
+# Returns: The accepted deadline and native state.  Timer expiry requests a
+#     stop; it does not promise an exact arbitrary-nanosecond cutoff.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-arm-clock-budget',
+  'data': { 'delta-ns': 'int', 'token': 'str' },
+  'returns': 'FdisbullClockInfo' }
+
+##
+# @x-fdisbull-cancel-clock-budget:
+#
+# Disarm and acknowledge the matching budget while stopped, retaining its
+# fired/stopped observations.  A pending deferred stop is an error; the
+# controller must close an uncertain VM instead of resuming it.
+#
+# @token: Token of the budget to cancel.  Repeating an already-completed
+#     cancellation with this token is safe while still stopped.
+#
+# Returns: A cancelled receipt with pending-stop false.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-cancel-clock-budget',
+  'data': { 'token': 'str' }, 'returns': 'FdisbullClockInfo' }
 
 ##
