+static void frame_key_repeat_rearm(void)
+{
+    /* A due timer must not be reinserted while saving or restoring a stop.
+     * Future timers keep their ordering across ordinary stops. */
+    if (!frame_repeat_save_paused && frame_repeat_deadline >= 0 &&
+        (runstate_is_running() ||
+         frame_repeat_deadline > qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL))) {
+        timer_mod_ns(&frame_repeat_timer, frame_repeat_deadline);
+    }
+}
+
+static void frame_key_repeat_vm_state_change(void *opaque, bool running,
+                                             RunState state)
+{
+    assert(bql_locked());
+    if (running && state == RUN_STATE_RUNNING &&
+        !timer_pending(&frame_repeat_timer)) {
+        frame_key_repeat_rearm();
+    }
+}
