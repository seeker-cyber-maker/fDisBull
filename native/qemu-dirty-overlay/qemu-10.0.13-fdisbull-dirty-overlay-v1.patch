+
+bool fdisbull_layers_active(void)
+{
+    return qatomic_read(&layers.active);
+}
+
+bool fdisbull_layers_watch_page(ram_addr_t address)
+{
+    bool found;
+    uint64_t page = address & ~(uint64_t)(LAYER_X86_PAGE_SIZE - 1);
+    if (!fdisbull_layers_active()) {
+        return false;
+    }
+    qemu_mutex_lock(&layers.lock);
+    found = g_hash_table_contains(layers.pages, &page);
+    qemu_mutex_unlock(&layers.lock);
+    return found;
+}
+
+bool fdisbull_layers_write_overlaps(ram_addr_t address, size_t length)
+{
+    bool found = false;
+    if (!fdisbull_layers_active()) {
+        return false;
+    }
+    qemu_mutex_lock(&layers.lock);
+    for (size_t i = 0; i < length; i++) {
+        if (g_hash_table_contains(layers.execute, &(uint64_t){ address + i })) {
+            found = true;
+            break;
+        }
+    }
+    qemu_mutex_unlock(&layers.lock);
+    return found;
 }
 
