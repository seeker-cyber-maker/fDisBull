 }

+FdisbullRasterProof *qmp_x_fdisbull_render_raster_proof(Error **errp)
+{
+    g_autoptr(FdisbullRasterProof) before = NULL;
+    QemuConsole *con;
+
+    assert(bql_locked());
+    before = qmp_x_fdisbull_query_raster_proof(errp);
+    if (!before) {
+        return NULL;
+    }
+    con = qemu_console_lookup_by_device(DEVICE(retrace_owner.device), 0);
+    if (!con || con != qemu_console_lookup_by_index(0) ||
+        fdisbull_instrumented_checkpoint_busy() ||
+        !qemu_console_can_update_headless_sync(con)) {
+        error_setg(errp, "Raster render requires an owned headless VGA console");
+        return NULL;
+    }
+    graphic_hw_update(con);
+    return pci_std_vga_fdisbull_raster_query(
+        retrace_owner.device, before->epoch, before->virtual_ns, errp);
+}
+
 bool fdisbull_retrace_checkpoint_admitted(void)
 {
     return retrace_owner.device != NULL && !retrace_owner.invalidated;
