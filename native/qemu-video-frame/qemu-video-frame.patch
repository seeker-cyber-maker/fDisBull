diff --git a/qapi/fdisbull-video-frame.json b/qapi/fdisbull-video-frame.json
new file mode 100644
--- /dev/null
+++ b/qapi/fdisbull-video-frame.json
@@ -0,0 +1,214 @@
+# Opt-in, owned source rows at a declared native precise-model cadence.
+# This stream is not the retained renderer-publication API or frame control.
+
+##
+# @FdisbullVideoFrameRow:
+#
+# @row: Source row index, 0 through 199, in increasing order.
+# @intended-ns: Original row deadline in QEMU_CLOCK_VIRTUAL nanoseconds.
+# @actual-ns: Actual sampling timestamp, no earlier than the deadline and
+#     strictly less than one physical line period after it.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullVideoFrameRow',
+  'data': { 'row': 'int', 'intended-ns': 'int', 'actual-ns': 'int' } }
+
+##
+# @FdisbullVideoFrame:
+#
+# @frame-id: Process-monotonic accepted complete-raster ordinal.
+# @stream-generation: Process-local explicit-start generation.
+# @epoch: Producing native clock epoch; never rebound to restored pixels.
+# @configuration-generation: Selected VGA configuration identity for all rows.
+# @timing-generation: Selected precise timing identity for all rows.
+# @width: Source width, 320 pixels.
+# @height: Source height, 200 rows.
+# @stride: Packed source stride, 960 bytes.
+# @pixel-format: RGB888 without padding or alpha.
+# @dac-conversion: replicate-6-to-8-v1; separate from the QEMU renderer adapter.
+# @dac-8bit: Eight-bit DAC channels are unchanged; otherwise six-bit channels
+#     are masked and expanded by bit replication.
+# @frame-start-ns: Phase-zero native boundary strictly after explicit start.
+# @period-ns: Whole native precise-model frame period.
+# @line-period-ns: Physical line period in that same native model.
+# @first-sample-ns: Actual row-zero sampling time.
+# @last-sample-ns: Actual row-199 sampling time.
+# @completed-ns: Accepted publication time, equal to last-sample-ns.
+# @pixel-sha256: SHA-256 of exactly 192000 retained packed RGB bytes.
+# @rows: Exactly 200 frozen source-row sampling receipts.
+#
+# This receipt owns one complete row-sampled raster. It does not claim
+# application drawing completion or equivalence with DOSBox's carried phase.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullVideoFrame',
+  'data': { 'frame-id': 'uint64', 'stream-generation': 'uint64',
+            'epoch': 'uint64', 'configuration-generation': 'uint64',
+            'timing-generation': 'uint64', 'width': 'int', 'height': 'int',
+            'stride': 'int', 'pixel-format': 'str', 'dac-conversion': 'str',
+            'dac-8bit': 'bool', 'frame-start-ns': 'int', 'period-ns': 'int',
+            'line-period-ns': 'int', 'first-sample-ns': 'int',
+            'last-sample-ns': 'int', 'completed-ns': 'int',
+            'pixel-sha256': 'str', 'rows': ['FdisbullVideoFrameRow'] } }
+
+##
+# @FdisbullVideoFrameInfo:
+#
+# @api-version: Private protocol version, 1.
+# @model: qemu-vga-chain4-scanline-v1.
+# @state: idle, observing, stopped, or invalidated.
+# @epoch: Current stopped native clock epoch; a retained frame has its own
+#     frozen producing epoch.
+# @virtual-ns: Current stopped QEMU_CLOCK_VIRTUAL timestamp.
+# @stream-generation: Explicit-start generation, zero before the first start.
+# @frame-sequence: Accepted raster count; not reset by start, stop, or load.
+# @aborted-frames: Discarded partial rasters that had sampled at least one row.
+# @in-progress: Whether the current partial raster has sampled rows.
+# @rows-sampled: Current partial row count, zero through 199.
+# @token: Caller ownership token, present after explicit start.
+# @device: Canonical selected VGA device path, present after explicit start.
+# @reason: First invalidation reason; present only for an invalidated stream.
+# @start-ns: Native stopped time of explicit start, present after start.
+# @stop-ns: Native stopped time of explicit stop, present only while stopped.
+# @next-deadline-ns: Original intended next-row deadline, present only while
+#     observing; a deferred callback does not replace it.
+# @frame: Frozen retained complete raster, absent before completion or after
+#     invalidation. Old renderer pixels cannot supply it.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullVideoFrameInfo',
+  'data': { 'api-version': 'int', 'model': 'str', 'state': 'str',
+            'epoch': 'uint64', 'virtual-ns': 'int',
+            'stream-generation': 'uint64', 'frame-sequence': 'uint64',
+            'aborted-frames': 'uint64', 'in-progress': 'bool',
+            'rows-sampled': 'int', '*token': 'str', '*device': 'str',
+            '*reason': 'str', '*start-ns': 'int', '*stop-ns': 'int',
+            '*next-deadline-ns': 'int', '*frame': 'FdisbullVideoFrame' } }
+
+##
+# @FdisbullVideoFramePoint:
+#
+# @x: Source column, zero through 319.
+# @y: Source row, zero through 199.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullVideoFramePoint',
+  'data': { 'x': 'int', 'y': 'int' } }
+
+##
+# @FdisbullVideoFramePixel:
+#
+# @x: Requested source column, preserved in request order.
+# @y: Requested source row, preserved in request order.
+# @r: Frozen red channel, zero through 255.
+# @g: Frozen green channel, zero through 255.
+# @b: Frozen blue channel, zero through 255.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullVideoFramePixel',
+  'data': { 'x': 'int', 'y': 'int', 'r': 'int', 'g': 'int', 'b': 'int' } }
+
+##
+# @FdisbullVideoFrameProbe:
+#
+# @info: Stopped stream receipt containing the exact requested retained frame.
+# @pixels: At most 256 ordered RGB samples; duplicates and an empty list are
+#     allowed. Pixels come only from the owned complete raster.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullVideoFrameProbe',
+  'data': { 'info': 'FdisbullVideoFrameInfo',
+            'pixels': ['FdisbullVideoFramePixel'] } }
+
+##
+# @x-fdisbull-start-video-frame:
+#
+# Explicitly opt into future source-row sampling. Requires the stopped native
+# clock, exact primary precise VGA and an inactive stream. Start schedules
+# the first strictly future native boundary but does not run the guest or
+# sample pixels. No separate launch property is added.
+#
+# @token: New caller ownership token, 1 through 128 bytes, different from the
+#     preceding stream's token.
+#
+# Returns: The observing stream receipt with no retained frame.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-start-video-frame', 'data': { 'token': 'str' },
+  'returns': 'FdisbullVideoFrameInfo' }
+
+##
+# @x-fdisbull-query-video-frame:
+#
+# Passively read the stopped stream. Requires the supported stopped native
+# clock and selected owner. Does not render, hash, sample, arm a timer, execute
+# the guest, or repair an empty or invalidated stream.
+#
+# Returns: Current stream metadata and any frozen retained complete frame.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-query-video-frame',
+  'returns': 'FdisbullVideoFrameInfo' }
+
+##
+# @x-fdisbull-stop-video-frame:
+#
+# Cancel future sampling while stopped. Discard a partial raster and retain
+# the last complete one for exact token and frame-ID reads. Repeated stop is
+# idempotent; an invalidated stream remains invalidated.
+#
+# @token: Exact current ownership token.
+#
+# Returns: Stream receipt after stopping.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-stop-video-frame', 'data': { 'token': 'str' },
+  'returns': 'FdisbullVideoFrameInfo' }
+
+##
+# @x-fdisbull-export-video-frame:
+#
+# Export one exact retained source raster while stopped. Does not render,
+# refresh, or execute. Exclusive creation refuses an existing path.
+#
+# @token: Exact current ownership token.
+# @frame-id: Exact retained accepted frame ordinal.
+# @filename: New private output path, 1 through 4096 bytes. The file is a
+#     P6 header followed by exactly 192000 RGB bytes, created with mode 0600.
+#
+# Returns: The same stopped stream and frozen frame receipt.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-export-video-frame',
+  'data': { 'token': 'str', 'frame-id': 'uint64', 'filename': 'str' },
+  'returns': 'FdisbullVideoFrameInfo' }
+
+##
+# @x-fdisbull-probe-video-frame:
+#
+# Read bounded ordered pixels from one retained complete source raster while
+# stopped. Does not create files, render, refresh, hash, or execute.
+#
+# @token: Exact current ownership token.
+# @frame-id: Exact retained accepted frame ordinal.
+# @points: At most 256 in-range source points. Duplicates and an empty list
+#     are allowed and request order is preserved.
+#
+# Returns: Current stopped metadata and ordered frozen RGB samples.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-probe-video-frame',
+  'data': { 'token': 'str', 'frame-id': 'uint64',
+            'points': ['FdisbullVideoFramePoint'] },
+  'returns': 'FdisbullVideoFrameProbe' }
