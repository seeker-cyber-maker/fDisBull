+/* Fresh source description; never repair or borrow the renderer's params. */
+bool vga_fdisbull_video_frame_sample(
+    VGACommonState *s, int64_t virtual_ns, int row, uint8_t *rgb,
+    FdisbullVideoFrameSource *source, Error **errp)
+{
+    g_autoptr(FdisbullRetraceInfo) retrace = g_new0(FdisbullRetraceInfo, 1);
+    g_autoptr(FdisbullVgaConfigurationSnapshot) configuration =
+        g_new0(FdisbullVgaConfigurationSnapshot, 1);
+    VGADisplayParams params;
+    FdisbullChain4Geometry geometry;
+    int width, height, depth, shift_control, double_scan, multi_scan;
+    const char *reason;
+
+    assert(bql_locked());
+    if (!source || row < -1 || row >= (int)FDISBULL_VIDEO_HEIGHT ||
+        (row >= 0 && !rgb) || !s->vram_ptr) {
+        error_setg(errp, "Invalid bounded video source-row request");
+        return false;
+    }
+    if (!vga_fdisbull_configuration_query(s, configuration, errp) ||
+        !vga_fdisbull_retrace_query(s, virtual_ns, retrace, errp)) {
+        return false;
+    }
+    if (!retrace->phase_supported) {
+        error_setg(errp, "Video frame source requires admitted precise timing");
+        return false;
+    }
+    vga_get_params(s, &params);
+    vga_get_resolution(s, &width, &height);
+    depth = vga_get_bpp(s);
+    shift_control = (s->gr[VGA_GFX_MODE] >> 5) & 3;
+    double_scan = s->cr[VGA_CRTC_MAX_SCAN] >> 7;
+    multi_scan = (s->cr[VGA_CRTC_MODE] & 1) ?
+        (((s->cr[VGA_CRTC_MAX_SCAN] & 0x1f) + 1) << double_scan) - 1 :
+        double_scan;
+    geometry = vga_fdisbull_chain4_geometry(
+        s, width, height, depth, shift_control, multi_scan);
+    geometry.start_address = (uint64_t)params.start_addr * 4;
+    geometry.line_offset = params.line_offset;
+    geometry.line_compare = params.line_compare;
+    geometry.hpel = params.hpel & 7;
+    reason = fdisbull_chain4_admission(&geometry);
+    if (reason) {
+        error_setg(errp, "Video frame source is unsupported: %s", reason);
+        return false;
+    }
+    source->configuration_generation = configuration->configuration_generation;
+    source->timing_generation = retrace->timing_generation;
+    source->line_period_ns = retrace->timing->ticks_per_char *
+                             retrace->timing->htotal;
+    source->period_ns = retrace->phase->period_ns;
+    source->dac_8bit = s->dac_8bit;
+    if (!fdisbull_video_timing_valid(source->line_period_ns, source->period_ns)) {
+        error_setg(errp, "Video frame timing cannot cover 400 physical lines");
+        return false;
+    }
+    if (row >= 0 && !fdisbull_video_copy_row(
+            s->vram_ptr + (size_t)row * FDISBULL_VIDEO_WIDTH,
+            FDISBULL_VIDEO_WIDTH, s->palette, sizeof(s->palette), s->dac_8bit,
+            rgb, FDISBULL_VIDEO_ROW_BYTES)) {
+        error_setg(errp, "Video frame row source is incomplete");
+        return false;
+    }
+    return true;
+}
