diff --git a/include/hw/display/fdisbull-video-frame.h b/include/hw/display/fdisbull-video-frame.h
new file mode 100644
--- /dev/null
+++ b/include/hw/display/fdisbull-video-frame.h
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Pure, bounded source-row sampling and native-model deadline arithmetic. */
+#ifndef HW_DISPLAY_FDISBULL_VIDEO_FRAME_H
+#define HW_DISPLAY_FDISBULL_VIDEO_FRAME_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define FDISBULL_VIDEO_WIDTH 320u
+#define FDISBULL_VIDEO_HEIGHT 200u
+#define FDISBULL_VIDEO_ROW_BYTES (FDISBULL_VIDEO_WIDTH * 3u)
+#define FDISBULL_VIDEO_RGB_BYTES (FDISBULL_VIDEO_ROW_BYTES * FDISBULL_VIDEO_HEIGHT)
+
+typedef struct FdisbullVideoFrameSource {
+    uint64_t configuration_generation;
+    uint64_t timing_generation;
+    int64_t line_period_ns;
+    int64_t period_ns;
+    bool dac_8bit;
+} FdisbullVideoFrameSource;
+
+static inline bool fdisbull_video_timing_valid(int64_t line, int64_t period)
+{
+    return line >= 4 && line <= INT64_MAX / 400 &&
+           period >= line * 400 && period % line == 0;
+}
+
+static inline bool fdisbull_video_next_start(int64_t now, int64_t period,
+                                            int64_t *start)
+{
+    int64_t remaining;
+
+    if (!start || now < 0 || period <= 0) {
+        return false;
+    }
+    remaining = period - now % period;
+    if (now > INT64_MAX - remaining) {
+        return false;
+    }
+    *start = now + remaining;
+    return true;
+}
+
+static inline bool fdisbull_video_row_deadline(int64_t start, int64_t line,
+                                              unsigned row, int64_t *deadline)
+{
+    int64_t offset;
+
+    if (!deadline || start < 0 || line < 4 || line > INT64_MAX / 400 ||
+        row >= FDISBULL_VIDEO_HEIGHT) {
+        return false;
+    }
+    offset = line / 4 + (int64_t)(2 * row) * line;
+    if (start > INT64_MAX - offset) {
+        return false;
+    }
+    *deadline = start + offset;
+    return true;
+}
+
+static inline bool fdisbull_video_row_timely(int64_t intended, int64_t actual,
+                                            int64_t line)
+{
+    return intended >= 0 && actual >= intended && line > 0 &&
+           actual - intended < line;
+}
+
+/* Explicit DOSBox-compatible DAC adapter, separate from QEMU c6_to_8. */
+static inline uint8_t fdisbull_video_dac(uint8_t value, bool dac_8bit)
+{
+    if (dac_8bit) {
+        return value;
+    }
+    value &= 63;
+    return (value << 2) | (value >> 4);
+}
+
+static inline bool fdisbull_video_copy_row(
+    const uint8_t *indices, size_t index_bytes, const uint8_t *palette,
+    size_t palette_bytes, bool dac_8bit, uint8_t *rgb, size_t rgb_bytes)
+{
+    unsigned x, channel;
+
+    if (!indices || !palette || !rgb || index_bytes != FDISBULL_VIDEO_WIDTH ||
+        palette_bytes != 256u * 3u || rgb_bytes != FDISBULL_VIDEO_ROW_BYTES) {
+        return false;
+    }
+    for (x = 0; x < FDISBULL_VIDEO_WIDTH; x++) {
+        for (channel = 0; channel < 3; channel++) {
+            rgb[x * 3 + channel] = fdisbull_video_dac(
+                palette[indices[x] * 3 + channel], dac_8bit);
+        }
+    }
+    return true;
+}
+
+#endif
