+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Opt-in complete source rasters assembled from timed native VGA source rows. */
+#include "qemu/osdep.h"
+#include "exec/cpu-interrupt.h"
+#include "hw/core/cpu.h"
+#include "hw/display/fdisbull-video-frame.h"
+#include "hw/display/vga.h"
+#include "hw/qdev-core.h"
+#include "qapi/error.h"
+#include "qapi/clone-visitor.h"
+#include "qapi/qapi-commands-fdisbull-retrace.h"
+#include "qapi/qapi-commands-fdisbull-video-frame.h"
+#include "qapi/qapi-commands-run-state.h"
+#include "qapi/qapi-visit-fdisbull-video-frame.h"
+#include "qemu/main-loop.h"
+#include "qemu/timer.h"
+#include "system/fdisbull-display.h"
+#include "system/fdisbull-instrumented-checkpoint.h"
+#include "system/fdisbull-video-frame.h"
+#include "system/runstate.h"
+#include "ui/console.h"
+
+#define VIDEO_MODEL "qemu-vga-chain4-scanline-v1"
+#define VIDEO_MAX_POINTS 256
+
+/* Never serialized. Counters survive stopped replacement streams and load. */
+static struct {
+    bool initialized;
+    bool observing;
+    bool stopped;
+    bool invalidated;
+    uint64_t epoch;
+    uint64_t generation;
+    uint64_t sequence;
+    uint64_t aborted;
+    char *token;
+    char *device_path;
+    char *reason;
+    Object *device;
+    QemuConsole *console;
+    QEMUTimer timer;
+    int64_t start_ns;
+    int64_t stop_ns;
+    int64_t frame_start_ns;
+    int64_t deadline_ns;
+    unsigned rows;
+    int64_t intended[FDISBULL_VIDEO_HEIGHT];
+    int64_t actual[FDISBULL_VIDEO_HEIGHT];
+    FdisbullVideoFrameSource source;
+    uint8_t *partial;
+    uint8_t *rgb;
+    FdisbullVideoFrame *frame;
+} video;
+
+typedef struct VideoVGASearch {
+    unsigned count;
+    Object *device;
+} VideoVGASearch;
+
+static int video_find_vga(Object *obj, void *opaque)
+{
+    VideoVGASearch *search = opaque;
+
+    if (!strcmp(object_get_typename(obj), "VGA") &&
+        qdev_is_realized(DEVICE(obj))) {
+        search->count++;
+        search->device = obj;
+    }
+    return 0;
+}
+
+/* Selection only: no ownership admission, timer, renderer or guest I/O. */
+static Object *video_device(QemuConsole **out, Error **errp)
+{
+    VideoVGASearch search = { 0 };
+    QemuConsole *con = qemu_console_lookup_by_index(0);
+
+    object_child_foreach_recursive(object_get_root(), video_find_vga, &search);
+    if (search.count != 1 || !con ||
+        !pci_std_vga_fdisbull_configuration_selected(search.device) ||
+        !qemu_console_can_update_headless_sync(con) ||
+        qemu_console_get_head(con) != 0 ||
+        object_property_get_link(OBJECT(con), "device", NULL) != search.device) {
+        error_setg(errp, "Video frame stream requires exact primary precise VGA "
+                   "on owned headless synchronous console zero/head zero");
+        return NULL;
+    }
+    *out = con;
+    return search.device;
+}
+
+static bool video_stopped(FdisbullClockInfo **out, Error **errp)
+{
+    FdisbullClockInfo *clock;
+    CPUState *cpu;
+
+    assert(bql_locked());
+    if (fdisbull_instrumented_checkpoint_busy()) {
+        error_setg(errp, "Video frame query cannot overlap checkpoint transaction");
+        return false;
+    }
+    clock = qmp_x_fdisbull_query_clock(errp);
+    if (!clock) {
+        return false;
+    }
+    if (clock->api_version != 1 || !clock->budget_supported ||
+        clock->virtual_ns < 0 || clock->running || clock->pending_stop ||
+        (clock->status != RUN_STATE_PRELAUNCH &&
+         clock->status != RUN_STATE_PAUSED && clock->status != RUN_STATE_DEBUG) ||
+        clock->budget_state == FDISBULL_CLOCK_BUDGET_STATE_ARMED ||
+        clock->budget_state == FDISBULL_CLOCK_BUDGET_STATE_FIRED) {
+        qapi_free_FdisbullClockInfo(clock);
+        error_setg(errp, "Video frame stream requires a valid stopped native clock");
+        return false;
+    }
+    CPU_FOREACH(cpu) {
+        if (!cpu->stopped) {
+            qapi_free_FdisbullClockInfo(clock);
+            error_setg(errp, "Video frame stream requires one stopped vCPU");
+            return false;
+        }
+    }
+    *out = clock;
+    return true;
+}
+
+static bool video_drop_partial(void)
+{
+    bool ok = true;
+
+    if (video.rows) {
+        if (video.aborted == UINT64_MAX) {
+            ok = false;
+        } else {
+            video.aborted++;
+        }
+        video.rows = 0;
+    }
+    return ok;
+}
+
+void fdisbull_video_frame_invalidate(QemuConsole *console, const char *reason)
+{
+    if (!video.token || video.console != console || video.invalidated) {
+        return;
+    }
+    assert(bql_locked());
+    if (video.initialized) {
+        timer_del(&video.timer);
+    }
+    if (!video_drop_partial()) {
+        reason = "aborted-frame-counter-overflow";
+    }
+    video.observing = false;
+    video.stopped = false;
+    video.invalidated = true;
+    g_free(video.reason);
+    video.reason = g_strdup(reason);
+    g_clear_pointer(&video.frame, qapi_free_FdisbullVideoFrame);
+    /* Buffers stay allocated but are unreachable as published pixels. */
+}
+
+static bool video_source_equal(const FdisbullVideoFrameSource *a,
+                               const FdisbullVideoFrameSource *b)
+{
+    return a->configuration_generation == b->configuration_generation &&
+           a->timing_generation == b->timing_generation &&
+           a->line_period_ns == b->line_period_ns &&
+           a->period_ns == b->period_ns && a->dac_8bit == b->dac_8bit;
+}
+
+static FdisbullVideoFrameInfo *video_info(const FdisbullClockInfo *clock)
+{
+    FdisbullVideoFrameInfo *info = g_new0(FdisbullVideoFrameInfo, 1);
+
+    info->api_version = 1;
+    info->model = g_strdup(VIDEO_MODEL);
+    info->state = g_strdup(video.invalidated ? "invalidated" :
+                          video.observing ? "observing" :
+                          video.stopped ? "stopped" : "idle");
+    info->epoch = clock->epoch;
+    info->virtual_ns = clock->virtual_ns;
+    info->stream_generation = video.generation;
+    info->frame_sequence = video.sequence;
+    info->aborted_frames = video.aborted;
+    info->in_progress = video.rows != 0;
+    info->rows_sampled = video.rows;
+    info->token = g_strdup(video.token);
+    info->device = g_strdup(video.device_path);
+    info->reason = g_strdup(video.reason);
+    info->has_start_ns = video.token != NULL;
+    info->start_ns = video.start_ns;
+    info->has_stop_ns = video.stopped;
+    info->stop_ns = video.stop_ns;
+    info->has_next_deadline_ns = video.observing;
+    info->next_deadline_ns = video.deadline_ns;
+    info->frame = video.frame ? QAPI_CLONE(FdisbullVideoFrame, video.frame) : NULL;
+    return info;
+}
+
+/* Passive consistency check; a query never repairs or invalidates the stream. */
+static bool video_query_guard(FdisbullClockInfo **out, Error **errp)
+{
+    QemuConsole *con;
+    Object *device;
+    FdisbullVideoFrameSource source;
+
+    if (!video_stopped(out, errp)) {
+        return false;
+    }
+    device = video_device(&con, errp);
+    if (!device) {
+        return false;
+    }
+    if (video.token && !video.invalidated &&
+        (video.device != device || video.console != con ||
+         video.epoch != (*out)->epoch ||
+         !pci_std_vga_fdisbull_video_frame_sample(device, (*out)->virtual_ns,
+                                                -1, NULL, &source, errp) ||
+         !video_source_equal(&source, &video.source))) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Video frame owner/source identity changed");
+        }
+        return false;
+    }
+    return true;
+}
+
+static void video_publish(int64_t actual_ns)
+{
+    FdisbullVideoFrame *frame = g_new0(FdisbullVideoFrame, 1);
+    FdisbullVideoFrameRowList **tail = &frame->rows;
+    uint8_t *swap = video.rgb;
+    unsigned row;
+
+    video.rgb = video.partial;
+    video.partial = swap;
+    video.sequence++;
+    frame->frame_id = video.sequence;
+    frame->stream_generation = video.generation;
+    frame->epoch = video.epoch;
+    frame->configuration_generation = video.source.configuration_generation;
+    frame->timing_generation = video.source.timing_generation;
+    frame->width = FDISBULL_VIDEO_WIDTH;
+    frame->height = FDISBULL_VIDEO_HEIGHT;
+    frame->stride = FDISBULL_VIDEO_ROW_BYTES;
+    frame->pixel_format = g_strdup("RGB888");
+    frame->dac_conversion = g_strdup("replicate-6-to-8-v1");
+    frame->dac_8bit = video.source.dac_8bit;
+    frame->frame_start_ns = video.frame_start_ns;
+    frame->period_ns = video.source.period_ns;
+    frame->line_period_ns = video.source.line_period_ns;
+    frame->first_sample_ns = video.actual[0];
+    frame->last_sample_ns = actual_ns;
+    frame->completed_ns = actual_ns;
+    frame->pixel_sha256 = g_compute_checksum_for_data(
+        G_CHECKSUM_SHA256, video.rgb, FDISBULL_VIDEO_RGB_BYTES);
+    for (row = 0; row < FDISBULL_VIDEO_HEIGHT; row++) {
+        FdisbullVideoFrameRowList *entry = g_new0(FdisbullVideoFrameRowList, 1);
+
+        entry->value = g_new0(FdisbullVideoFrameRow, 1);
+        entry->value->row = row;
+        entry->value->intended_ns = video.intended[row];
+        entry->value->actual_ns = video.actual[row];
+        *tail = entry;
+        tail = &entry->next;
+    }
+    g_clear_pointer(&video.frame, qapi_free_FdisbullVideoFrame);
+    video.frame = frame;
+    video.rows = 0;
+}
+
+static void video_defer_callback(int64_t now)
+{
+    if (now == INT64_MAX) {
+        fdisbull_video_frame_invalidate(video.console, "deadline-overflow");
+    } else {
+        /* Avoid a due-timer spin. Keep the original intended deadline. */
+        timer_mod_ns(&video.timer, now + 1);
+    }
+}
+
+static void video_timer_cb(void *opaque)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    g_autoptr(Error) error = NULL;
+    FdisbullVideoFrameSource source;
+    QemuConsole *con;
+    Object *device;
+    CPUState *cpu;
+    bool stopping = false;
+
+    assert(bql_locked());
+    if (!video.observing || video.invalidated) {
+        return;
+    }
+    if (fdisbull_instrumented_checkpoint_busy()) {
+        /* An owned save is inert; VGA reset/load explicitly invalidates. */
+        video_defer_callback(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+        return;
+    }
+    clock = qmp_x_fdisbull_query_clock(&error);
+    if (!clock || !clock->budget_supported || clock->api_version != 1 ||
+        clock->epoch != video.epoch || clock->virtual_ns < 0) {
+        fdisbull_video_frame_invalidate(video.console, "clock-invalidated");
+        return;
+    }
+    CPU_FOREACH(cpu) {
+        stopping |= cpu->stop || cpu->stopped ||
+                    (cpu->interrupt_request & CPU_INTERRUPT_DEBUG);
+    }
+    if (!clock->running || clock->pending_stop || stopping) {
+        video_defer_callback(clock->virtual_ns);
+        return;
+    }
+    device = video_device(&con, &error);
+    if (!device || device != video.device || con != video.console) {
+        fdisbull_video_frame_invalidate(video.console, "video-owner-lost");
+        return;
+    }
+    if (!fdisbull_video_row_timely(video.deadline_ns, clock->virtual_ns,
+                                  video.source.line_period_ns)) {
+        fdisbull_video_frame_invalidate(video.console, "row-deadline-missed");
+        return;
+    }
+    if (!pci_std_vga_fdisbull_video_frame_sample(
+            device, clock->virtual_ns, video.rows,
+            video.partial + video.rows * FDISBULL_VIDEO_ROW_BYTES,
+            &source, &error) || !video_source_equal(&source, &video.source)) {
+        fdisbull_video_frame_invalidate(video.console, "source-or-generation-changed");
+        return;
+    }
+    video.intended[video.rows] = video.deadline_ns;
+    video.actual[video.rows] = clock->virtual_ns;
+    video.rows++;
+    if (video.rows == FDISBULL_VIDEO_HEIGHT) {
+        if (video.sequence == UINT64_MAX) {
+            fdisbull_video_frame_invalidate(video.console, "frame-sequence-overflow");
+            return;
+        }
+        video_publish(clock->virtual_ns);
+        if (video.frame_start_ns > INT64_MAX - video.source.period_ns) {
+            fdisbull_video_frame_invalidate(video.console, "deadline-overflow");
+            return;
+        }
+        video.frame_start_ns += video.source.period_ns;
+    }
+    if (!fdisbull_video_row_deadline(video.frame_start_ns,
+                                    video.source.line_period_ns, video.rows,
+                                    &video.deadline_ns)) {
+        fdisbull_video_frame_invalidate(video.console, "deadline-overflow");
+        return;
+    }
+    timer_mod_ns(&video.timer, video.deadline_ns);
+}
+
+static void video_vm_state_change(void *opaque, bool running, RunState state)
+{
+    if (!fdisbull_instrumented_checkpoint_busy() && video.token && !running &&
+        state != RUN_STATE_PRELAUNCH &&
+        state != RUN_STATE_PAUSED && state != RUN_STATE_DEBUG) {
+        fdisbull_video_frame_invalidate(video.console, "unsupported-vm-state");
+    }
+}
+
+FdisbullVideoFrameInfo *qmp_x_fdisbull_start_video_frame(const char *token,
+                                                      Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    g_autoptr(FdisbullRetraceInfo) retrace = NULL;
+    g_autofree uint8_t *partial = NULL;
+    g_autofree uint8_t *rgb = NULL;
+    g_autofree char *path = NULL;
+    FdisbullVideoFrameSource source;
+    QemuConsole *con;
+    Object *device;
+    int64_t start, deadline;
+
+    if (!video_stopped(&clock, errp)) {
+        return NULL;
+    }
+    if (!token[0] || strlen(token) > 128 ||
+        (video.token && !strcmp(token, video.token)) || video.observing ||
+        video.generation == UINT64_MAX || video.sequence == UINT64_MAX ||
+        fdisbull_display_frame_fence_blocks_control()) {
+        error_setg(errp, "Video frame start requires an inactive stream, new "
+                   "1..128 byte token and available counters/controllers");
+        return NULL;
+    }
+    device = video_device(&con, errp);
+    if (!device || !pci_std_vga_fdisbull_video_frame_sample(
+            device, clock->virtual_ns, -1, NULL, &source, errp)) {
+        return NULL;
+    }
+    if (!fdisbull_video_next_start(clock->virtual_ns, source.period_ns, &start) ||
+        !fdisbull_video_row_deadline(start, source.line_period_ns, 0, &deadline)) {
+        error_setg(errp, "Video frame start deadline overflows native clock");
+        return NULL;
+    }
+    path = object_get_canonical_path(device);
+    partial = g_try_malloc(FDISBULL_VIDEO_RGB_BYTES);
+    rgb = g_try_malloc(FDISBULL_VIDEO_RGB_BYTES);
+    if (!path || !partial || !rgb) {
+        error_setg(errp, "Video frame bounded storage or device path unavailable");
+        return NULL;
+    }
+    /* Explicit start admits the existing precise owner/migration blocker. */
+    retrace = qmp_x_fdisbull_query_retrace(errp);
+    if (!retrace || retrace->epoch != clock->epoch ||
+        strcmp(retrace->device, path) || !retrace->phase_supported ||
+        retrace->timing_generation != source.timing_generation) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Video frame precise owner admission changed");
+        }
+        return NULL;
+    }
+    if (!video.initialized) {
+        video.initialized = true;
+        timer_init_ns(&video.timer, QEMU_CLOCK_VIRTUAL, video_timer_cb, NULL);
+        qemu_add_vm_change_state_handler(video_vm_state_change, NULL);
+    }
+    object_ref(device);
+    object_ref(OBJECT(con));
+    if (video.device) {
+        object_unref(video.device);
+        object_unref(OBJECT(video.console));
+    }
+    video.device = device;
+    video.console = con;
+    g_free(video.device_path);
+    video.device_path = g_steal_pointer(&path);
+    g_free(video.token);
+    video.token = g_strdup(token);
+    g_clear_pointer(&video.reason, g_free);
+    g_clear_pointer(&video.frame, qapi_free_FdisbullVideoFrame);
+    g_free(video.partial);
+    g_free(video.rgb);
+    video.partial = g_steal_pointer(&partial);
+    video.rgb = g_steal_pointer(&rgb);
+    video.source = source;
+    video.epoch = clock->epoch;
+    video.generation++;
+    video.rows = 0;
+    video.invalidated = false;
+    video.stopped = false;
+    video.observing = true;
+    video.start_ns = clock->virtual_ns;
+    video.stop_ns = 0;
+    video.frame_start_ns = start;
+    video.deadline_ns = deadline;
+    timer_mod_ns(&video.timer, deadline);
+    return video_info(clock);
+}
+
+FdisbullVideoFrameInfo *qmp_x_fdisbull_query_video_frame(Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+
+    return video_query_guard(&clock, errp) ? video_info(clock) : NULL;
+}
+
+static bool video_token(const char *token, Error **errp)
+{
+    if (!video.token || strcmp(video.token, token)) {
+        error_setg(errp, "Video frame token does not own the current stream");
+        return false;
+    }
+    return true;
+}
+
+FdisbullVideoFrameInfo *qmp_x_fdisbull_stop_video_frame(const char *token,
+                                                     Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+
+    if (!video_query_guard(&clock, errp) || !video_token(token, errp)) {
+        return NULL;
+    }
+    if (video.observing) {
+        timer_del(&video.timer);
+        if (!video_drop_partial()) {
+            fdisbull_video_frame_invalidate(video.console, "aborted-frame-counter-overflow");
+            return video_info(clock);
+        }
+        video.observing = false;
+        video.stopped = true;
+        video.stop_ns = clock->virtual_ns;
+    }
+    return video_info(clock);
+}
+
+static bool video_frame_id(const char *token, uint64_t frame_id, Error **errp)
+{
+    if (!video_token(token, errp)) {
+        return false;
+    }
+    if (video.invalidated || !video.frame || !frame_id ||
+        video.frame->frame_id != frame_id) {
+        error_setg(errp, "Video frame ID does not name a retained complete raster");
+        return false;
+    }
+    return true;
+}
+
+FdisbullVideoFrameInfo *qmp_x_fdisbull_export_video_frame(
+    const char *token, uint64_t frame_id, const char *filename, Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    static const char header[] = "P6\n320 200\n255\n";
+    int fd, saved_errno;
+
+    if (!video_query_guard(&clock, errp) ||
+        !video_frame_id(token, frame_id, errp)) {
+        return NULL;
+    }
+    if (!filename[0] || strlen(filename) > 4096) {
+        error_setg(errp, "Video frame export requires a bounded nonempty path");
+        return NULL;
+    }
+    fd = open(filename, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+    if (fd < 0) {
+        error_setg_errno(errp, errno, "Cannot create private video frame export");
+        return NULL;
+    }
+    if (qemu_write_full(fd, header, sizeof(header) - 1) != sizeof(header) - 1 ||
+        qemu_write_full(fd, video.rgb, FDISBULL_VIDEO_RGB_BYTES) !=
+        FDISBULL_VIDEO_RGB_BYTES) {
+        saved_errno = errno ? errno : EIO;
+        close(fd);
+        unlink(filename);
+        error_setg_errno(errp, saved_errno, "Cannot write private video frame export");
+        return NULL;
+    }
+    if (close(fd)) {
+        saved_errno = errno;
+        unlink(filename);
+        error_setg_errno(errp, saved_errno, "Cannot close private video frame export");
+        return NULL;
+    }
+    return video_info(clock);
+}
+
+FdisbullVideoFrameProbe *qmp_x_fdisbull_probe_video_frame(
+    const char *token, uint64_t frame_id, FdisbullVideoFramePointList *points,
+    Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    FdisbullVideoFramePointList *point;
+    FdisbullVideoFrameProbe *probe;
+    FdisbullVideoFramePixelList **tail;
+    unsigned count = 0;
+
+    if (!video_query_guard(&clock, errp) ||
+        !video_frame_id(token, frame_id, errp)) {
+        return NULL;
+    }
+    for (point = points; point; point = point->next) {
+        if (++count > VIDEO_MAX_POINTS || point->value->x < 0 ||
+            point->value->x >= FDISBULL_VIDEO_WIDTH || point->value->y < 0 ||
+            point->value->y >= FDISBULL_VIDEO_HEIGHT) {
+            error_setg(errp, "Video frame probe requires at most 256 in-range points");
+            return NULL;
+        }
+    }
+    probe = g_new0(FdisbullVideoFrameProbe, 1);
+    probe->info = video_info(clock);
+    tail = &probe->pixels;
+    for (point = points; point; point = point->next) {
+        FdisbullVideoFramePixelList *entry = g_new0(FdisbullVideoFramePixelList, 1);
+        FdisbullVideoFramePixel *pixel = g_new0(FdisbullVideoFramePixel, 1);
+        const uint8_t *rgb = video.rgb +
+            (point->value->y * FDISBULL_VIDEO_WIDTH + point->value->x) * 3;
+
+        pixel->x = point->value->x;
+        pixel->y = point->value->y;
+        pixel->r = rgb[0];
+        pixel->g = rgb[1];
+        pixel->b = rgb[2];
+        entry->value = pixel;
+        *tail = entry;
+        tail = &entry->next;
+    }
+    return probe;
+}
