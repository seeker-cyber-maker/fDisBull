+
+static FdisbullVideoFrameFenceInfo *video_fence_info(void)
+{
+    static const char *const names[] = {
+        "idle", "armed", "completed", "aborted", "cancelled",
+    };
+    FdisbullVideoFrameFenceInfo *info =
+        g_new0(FdisbullVideoFrameFenceInfo, 1);
+
+    info->api_version = 1;
+    info->model = g_strdup(VIDEO_FENCE_MODEL);
+    info->token = g_strdup(video_fence.token);
+    info->stream_token = g_strdup(video_fence.stream_token);
+    info->stream_generation = video_fence.generation;
+    info->epoch = video_fence.epoch;
+    info->configuration_generation = video_fence.configuration_generation;
+    info->timing_generation = video_fence.timing_generation;
+    info->baseline_frame_sequence = video_fence.baseline;
+    info->baseline_rows_sampled = video_fence.baseline_rows;
+    info->armed_ns = video_fence.armed_ns;
+    info->state = g_strdup(names[video_fence.state]);
+    info->released = video_fence.released;
+    info->stop_pending = video_fence.stop_pending;
+    info->stop_consumed = video_fence.stop_consumed;
+    info->completed_frame = video_fence.frame ?
+        QAPI_CLONE(FdisbullVideoFrame, video_fence.frame) : NULL;
+    info->has_stop_ns = video_fence.has_stop_ns;
+    info->stop_ns = video_fence.stop_ns;
+    info->reason = g_strdup(video_fence.reason);
+    return info;
+}
+
+FdisbullVideoFrameFenceInfo *qmp_x_fdisbull_arm_video_frame(
+    const char *token, const char *stream_token,
+    uint64_t expected_stream_generation, uint64_t expected_frame_sequence,
+    uint64_t expected_epoch, Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+
+    if (!video_query_guard(&clock, errp)) {
+        return NULL;
+    }
+    if (!video.observing || video.invalidated || !video.token ||
+        strcmp(stream_token, video.token) ||
+        expected_stream_generation != video.generation ||
+        expected_frame_sequence != video.sequence ||
+        expected_epoch != video.epoch || clock->epoch != video.epoch ||
+        video.sequence == UINT64_MAX) {
+        error_setg(errp, "Source-video fence requires its exact observing stream "
+                   "token, generation, frame sequence and clock epoch");
+        return NULL;
+    }
+    if (!token[0] || strlen(token) > 128 ||
+        (video_fence.token && !strcmp(token, video_fence.token)) ||
+        fdisbull_video_frame_fence_blocks_control() ||
+        video_fence.stop_pending ||
+        fdisbull_display_frame_fence_blocks_control()) {
+        error_setg(errp, "Source-video fence requires a new bounded token and "
+                   "released native frame controllers");
+        return NULL;
+    }
+    if (!fdisbull_input_checkpoint_safe(errp) ||
+        !fdisbull_frame_keys_checkpoint_safe(errp)) {
+        return NULL;
+    }
+
+    g_free(video_fence.token);
+    g_free(video_fence.stream_token);
+    g_clear_pointer(&video_fence.reason, g_free);
+    g_clear_pointer(&video_fence.frame, qapi_free_FdisbullVideoFrame);
+    video_fence.token = g_strdup(token);
+    video_fence.stream_token = g_strdup(stream_token);
+    video_fence.generation = video.generation;
+    video_fence.epoch = video.epoch;
+    video_fence.configuration_generation =
+        video.source.configuration_generation;
+    video_fence.timing_generation = video.source.timing_generation;
+    video_fence.baseline = video.sequence;
+    video_fence.baseline_rows = video.rows;
+    video_fence.armed_ns = clock->virtual_ns;
+    video_fence.state = VIDEO_FENCE_ARMED;
+    video_fence.released = false;
+    video_fence.retired = false;
+    video_fence.stop_pending = false;
+    video_fence.stop_consumed = false;
+    video_fence.stopping = false;
+    video_fence.has_stop_ns = false;
+    video_fence.stop_ns = 0;
+    return video_fence_info();
+}
+
+static bool video_fence_query_guard(const char *token, Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+
+    if (!video_stopped(&clock, errp)) {
+        return false;
+    }
+    if (!video_fence.token || video_fence.retired ||
+        strcmp(token, video_fence.token) ||
+        clock->epoch != video_fence.epoch) {
+        error_setg(errp, "Source-video fence requires its exact token and "
+                   "stopped producing clock epoch");
+        return false;
+    }
+    return true;
+}
+
+FdisbullVideoFrameFenceInfo *qmp_x_fdisbull_query_video_frame_fence(
+    const char *token, Error **errp)
+{
+    return video_fence_query_guard(token, errp) ? video_fence_info() : NULL;
+}
+
+FdisbullVideoFrameFenceInfo *qmp_x_fdisbull_cancel_video_frame_fence(
+    const char *token, Error **errp)
+{
+    if (!video_fence_query_guard(token, errp)) {
+        return NULL;
+    }
+    if (!video_fence_release()) {
+        error_setg(errp, "Source-video fence private stop has not settled");
+        return NULL;
+    }
+    return video_fence_info();
+}
