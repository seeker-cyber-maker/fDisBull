+/* Source-probe fence state begins: these are the production state helpers. */
+typedef enum VideoFenceState {
+    VIDEO_FENCE_IDLE,
+    VIDEO_FENCE_ARMED,
+    VIDEO_FENCE_COMPLETED,
+    VIDEO_FENCE_ABORTED,
+    VIDEO_FENCE_CANCELLED,
+} VideoFenceState;
+
+static struct {
+    VideoFenceState state;
+    bool released;
+    bool retired;
+    bool stop_pending;
+    bool stop_consumed;
+    bool stopping;
+    bool has_stop_ns;
+    uint64_t generation;
+    uint64_t epoch;
+    uint64_t configuration_generation;
+    uint64_t timing_generation;
+    uint64_t baseline;
+    unsigned baseline_rows;
+    int64_t armed_ns;
+    int64_t stop_ns;
+    char *token;
+    char *stream_token;
+    char *reason;
+    FdisbullVideoFrame *frame;
+} video_fence;
+
+bool fdisbull_video_frame_fence_blocks_control(void)
+{
+    return video_fence.token && !video_fence.released;
+}
+
+bool fdisbull_video_frame_stop_pending(void)
+{
+    return video_fence.stop_pending;
+}
+
+static bool video_fence_is_next_frame(const FdisbullVideoFrame *frame)
+{
+    return frame && video_fence.state == VIDEO_FENCE_ARMED &&
+           !video_fence.released && video_fence.baseline != UINT64_MAX &&
+           frame->frame_id == video_fence.baseline + 1 &&
+           frame->stream_generation == video_fence.generation &&
+           frame->epoch == video_fence.epoch &&
+           frame->configuration_generation ==
+               video_fence.configuration_generation &&
+           frame->timing_generation == video_fence.timing_generation;
+}
+
+static void video_fence_record_stopped(int64_t now, bool owned)
+{
+    if (video_fence.retired ||
+        (video_fence.state != VIDEO_FENCE_COMPLETED &&
+         video_fence.state != VIDEO_FENCE_ABORTED)) {
+        return;
+    }
+    video_fence.stop_pending = false;
+    if (!video_fence.has_stop_ns) {
+        video_fence.has_stop_ns = true;
+        video_fence.stop_ns = now;
+        video_fence.stop_consumed = owned;
+    }
+}
+
+static bool video_fence_release(void)
+{
+    if (!video_fence.token || video_fence.stop_pending || video_fence.retired) {
+        return false;
+    }
+    if (video_fence.state == VIDEO_FENCE_ARMED) {
+        video_fence.state = VIDEO_FENCE_CANCELLED;
+    }
+    video_fence.released = true;
+    return true;
+}
+/* Source-probe fence state ends. */
+
+static void video_fence_retire(const char *reason)
+{
+    if (!video_fence.token || video_fence.retired) {
+        return;
+    }
+    if (video_fence.state == VIDEO_FENCE_ARMED) {
+        video_fence.state = VIDEO_FENCE_ABORTED;
+        video_fence.reason = g_strdup(reason);
+    }
+    video_fence.released = true;
+    video_fence.retired = true;
+    video_fence.stop_pending = false;
+    video_fence.stopping = false;
+    /* Historical frame/epoch/stop evidence is never rebound or manufactured. */
+}
+
+void fdisbull_video_frame_clock_retire(const char *reason)
+{
+    assert(bql_locked());
+    video_fence_retire(reason);
+    if (video.token) {
+        fdisbull_video_frame_invalidate(video.console, reason);
+    }
+}
+
+static void video_fence_request_stop(void)
+{
+    if (video_fence.retired || video_fence.released) {
+        return;
+    }
+    if (runstate_is_running()) {
+        video_fence.stop_pending = true;
+        cpu_stop_current();
+        qemu_notify_event();
+    } else {
+        video_fence_record_stopped(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), false);
+    }
+}
+
+static void video_fence_abort(const char *reason)
+{
+    if (video_fence.state != VIDEO_FENCE_ARMED || video_fence.released) {
+        return;
+    }
+    video_fence.state = VIDEO_FENCE_ABORTED;
+    video_fence.reason = g_strdup(reason);
+    video_fence_request_stop();
+}
+
+bool fdisbull_video_frame_checkpoint_safe(Error **errp)
+{
+    assert(bql_locked());
+    if (fdisbull_video_frame_fence_blocks_control() ||
+        video_fence.stop_pending) {
+        error_setg(errp, "Release the source-video frame fence before checkpointing");
+        return false;
+    }
+    return true;
+}
+
+void fdisbull_video_frame_handle_stop_request(void)
+{
+    assert(bql_locked());
+    if (!video_fence.stop_pending) {
+        return;
+    }
+    if (runstate_is_running()) {
+        /* Stock debugger/reset/shutdown/VM-stop requests were handled first. */
+        video_fence.stopping = true;
+        vm_stop(RUN_STATE_PAUSED);
+        if (runstate_check(RUN_STATE_PAUSED)) {
+            video_fence_record_stopped(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+                                       true);
+        }
+        video_fence.stopping = false;
+    } else {
+        video_fence_record_stopped(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), false);
+    }
+}
