+##
+# @FdisbullVideoFrameFenceInfo:
+#
+# @api-version: Private fence protocol version, 1.
+# @model: qemu-video-frame-fence-v1.
+# @token: Fence ownership token, distinct from the preceding fence token.
+# @stream-token: Exact source-stream token bound by the arm.
+# @stream-generation: Explicit-start generation bound by the arm.
+# @epoch: Producing native clock epoch bound by the arm.
+# @configuration-generation: Source configuration identity bound by the arm.
+# @timing-generation: Source precise-timing identity bound by the arm.
+# @baseline-frame-sequence: Accepted source-raster count at arm time.
+# @baseline-rows-sampled: Already sampled rows at arm time, zero through 199.
+# @armed-ns: Stopped native timestamp at arm time.
+# @state: armed, completed, aborted, or cancelled. Completion and abort are
+#     retained when cancellation releases their control ownership.
+# @released: Explicit cancellation released this fence's control exclusion.
+# @stop-pending: A private safe-stop request has not yet reached a stopped VM.
+# @stop-consumed: The fence's main-loop handler itself stopped the running VM.
+# @completed-frame: Exact accepted baseline-plus-one source raster, present
+#     only for completed. It can exist even if a debugger stop won attribution.
+# @stop-ns: First known terminal stopped native time, when available. An abort
+#     that occurs while already stopped records that actual time too.
+# @reason: First source failure reason, present only for aborted.
+#
+# This process-local receipt does not claim DOSBox sampling-phase equivalence,
+# guest input consumption, or a whole raster sampled after arm time. Query is
+# legal in the same stopped PRELAUNCH, PAUSED, or DEBUG epoch.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullVideoFrameFenceInfo',
+  'data': { 'api-version': 'int', 'model': 'str', 'token': 'str',
+            'stream-token': 'str', 'stream-generation': 'uint64',
+            'epoch': 'uint64', 'configuration-generation': 'uint64',
+            'timing-generation': 'uint64',
+            'baseline-frame-sequence': 'uint64',
+            'baseline-rows-sampled': 'int', 'armed-ns': 'int',
+            'state': 'str', 'released': 'bool', 'stop-pending': 'bool',
+            'stop-consumed': 'bool', '*completed-frame': 'FdisbullVideoFrame',
+            '*stop-ns': 'int', '*reason': 'str' } }
+
+##
+# @x-fdisbull-arm-video-frame:
+#
+# Bind a stopped, observing source stream to the next accepted complete raster.
+# All expected identities are checked before publishing the arm. The arm does
+# not sample, change source phase, discard partial rows, or execute the guest.
+# Competing clock budgets, renderer/source fences, pending input schedules and
+# checkpoint transactions must be resolved first.
+#
+# @token: New fence token, 1 through 128 bytes.
+# @stream-token: Exact current source-stream token.
+# @expected-stream-generation: Exact current explicit-start generation.
+# @expected-frame-sequence: Exact current accepted-raster count.
+# @expected-epoch: Exact current stopped native clock epoch.
+#
+# Returns: An armed, unreleased receipt with no completion or stop fields.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-arm-video-frame',
+  'data': { 'token': 'str', 'stream-token': 'str',
+            'expected-stream-generation': 'uint64',
+            'expected-frame-sequence': 'uint64', 'expected-epoch': 'uint64' },
+  'returns': 'FdisbullVideoFrameFenceInfo' }
+
+##
+# @x-fdisbull-query-video-frame-fence:
+#
+# Passively read the exact fence while the native clock is stably stopped in
+# its producing epoch. An earlier DEBUG stop can leave the fence armed. A
+# completed source raster alone does not prove this fence caused the stop.
+#
+# @token: Exact current fence token.
+#
+# Returns: Frozen ownership and any terminal source-frame/stop evidence.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-query-video-frame-fence',
+  'data': { 'token': 'str' }, 'returns': 'FdisbullVideoFrameFenceInfo' }
+
+##
+# @x-fdisbull-cancel-video-frame-fence:
+#
+# Release an exact fence while stopped after any private stop request has
+# settled. Armed becomes cancelled. Completed or aborted keeps its terminal
+# evidence and state. Repeated cancellation is idempotent. No pixels, cadence,
+# guest input or execution state are changed.
+#
+# @token: Exact current fence token.
+#
+# Returns: A released receipt with no pending private stop.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-cancel-video-frame-fence',
+  'data': { 'token': 'str' }, 'returns': 'FdisbullVideoFrameFenceInfo' }
