+/*
+ * The one repeat timer belongs to the existing stopped frame-key owner.
+ * Guest hardware state supplies the rate and all scan-code/IRQ behavior.
+ */
+static QEMUTimer frame_repeat_timer;
+static bool frame_repeat_timer_ready;
+static bool frame_repeat_save_paused;
+static QKeyCode frame_repeat_key = Q_KEY_CODE_UNMAPPED;
+static int64_t frame_repeat_deadline = -1;
+
+static bool frame_batch_key_supported(QKeyCode key);
+
+static bool frame_key_repeatable(QKeyCode key)
+{
+    return frame_batch_key_supported(key) && !ps2_keyboard_modifier_bit(key) &&
+           key != Q_KEY_CODE_PRINT && key != Q_KEY_CODE_PAUSE;
+}
+
+static int64_t frame_repeat_delay(uint8_t parameter)
+{
+    return (1 + (parameter >> 5)) * 250 * SCALE_MS;
+}
+
+static int64_t frame_repeat_interval(uint8_t parameter)
+{
+    int64_t ticks = (8 + (parameter & 7)) << ((parameter >> 3) & 3);
+
+    return ticks * 1000 * SCALE_MS / 240;
+}
+
+static void frame_key_repeat_cancel(void)
+{
+    if (frame_repeat_timer_ready) {
+        timer_del(&frame_repeat_timer);
+    }
+    frame_repeat_key = Q_KEY_CODE_UNMAPPED;
+    frame_repeat_deadline = -1;
+}
+
+void fdisbull_frame_key_repeat_cancel_for(PS2KbdState *keyboard)
+{
+    if (frame_keys.keyboard == keyboard) {
+        frame_key_repeat_cancel();
+    }
+}
+
+static void frame_key_repeat_timer_cb(void *opaque)
+{
+    PS2KbdState *keyboard = frame_keys.keyboard;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int64_t interval, next;
+    PS2FrameKeyEncoding encoding = { 0 };
+    PS2Queue *queue;
+    KBDState *controller;
+    unsigned i;
+    bool stopping;
+
+    assert(bql_locked());
+    if (!keyboard || !frame_keys.active || !frame_keys.valid ||
+        frame_repeat_key == Q_KEY_CODE_UNMAPPED ||
+        !frame_keys.held[frame_repeat_key] || !keyboard->scan_enabled) {
+        frame_key_repeat_cancel();
+        return;
+    }
+    if (frame_repeat_save_paused) {
+        return;
+    }
+    stopping = fdisbull_clock_stop_pending();
+    if (stopping) {
+        /* A synchronous stop owns this boundary. Keep the make pending. */
+        next = 1;
+    } else {
+        interval = frame_repeat_interval(keyboard->typematic_parameter);
+        /* Preserve the cadence if a timer is late. Never emit a catch-up burst. */
+        next = interval - ((now - frame_repeat_deadline) % interval);
+    }
+    if (now > INT64_MAX - next) {
+        frame_key_repeat_cancel();
+        return;
+    }
+    frame_repeat_deadline = now + next;
+    timer_mod_ns(&frame_repeat_timer, frame_repeat_deadline);
+    if (stopping) {
+        return;
+    }
+
+    controller = frame_keyboard_controller(keyboard, NULL);
+    queue = &keyboard->parent_obj.queue;
+    if (!controller || (controller->mode & FRAME_KEYS_KBD_DISABLED) ||
+        keyboard->parent_obj.write_cmd != -1 || queue->cwptr != -1 ||
+        queue->count < 0 || queue->count > 16 ||
+        queue->wptr < 0 || queue->wptr >= PS2_BUFFER_SIZE ||
+        keyboard->need_high_bit) {
+        return;
+    }
+    encoding.modifiers = keyboard->modifiers;
+    if (!ps2_keyboard_frame_encode(keyboard->scancode_set, keyboard->translate,
+                                   frame_repeat_key, true, &encoding) ||
+        !encoding.count || encoding.count > 16 - queue->count ||
+        encoding.modifiers != keyboard->modifiers || encoding.need_high_bit) {
+        return;
+    }
+    /* Deliver the entire make or none of it, including an E0 prefix. */
+    for (i = 0; i < encoding.count; i++) {
+        ps2_queue_noirq(&keyboard->parent_obj, encoding.bytes[i]);
+    }
+    ps2_keyboard_frame_notify(keyboard);
+}
+
+static void frame_key_repeat_arm(QKeyCode key, int64_t deadline)
+{
+    if (!frame_repeat_timer_ready) {
+        timer_init_ns(&frame_repeat_timer, QEMU_CLOCK_VIRTUAL,
+                      frame_key_repeat_timer_cb, NULL);
+        frame_repeat_timer_ready = true;
+    }
+    frame_repeat_key = key;
+    frame_repeat_deadline = deadline;
+    timer_mod_ns(&frame_repeat_timer, frame_repeat_deadline);
+}
+
+static void frame_key_repeat_arm_initial(PS2KbdState *keyboard, QKeyCode key,
+                                         int64_t now)
+{
+    int64_t delay = frame_repeat_delay(keyboard->typematic_parameter);
+
+    if (now < 0 || now > INT64_MAX - delay) {
+        frame_key_repeat_cancel();
+    } else {
+        frame_key_repeat_arm(key, now + delay);
+    }
+}
+
+void fdisbull_frame_key_repeat_parameter_changed(PS2KbdState *keyboard)
+{
+    if (frame_keys.keyboard == keyboard &&
+        frame_repeat_key != Q_KEY_CODE_UNMAPPED) {
+        frame_key_repeat_arm_initial(keyboard, frame_repeat_key,
+                                    qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    }
+}
+
+static void frame_key_repeat_accept(const FdisbullFrameKeyEdgeList *edges,
+                                    int64_t now)
+{
+    PS2KbdState *keyboard = frame_keys.keyboard;
+
+    for (; edges; edges = edges->next) {
+        QKeyCode key = edges->value->key;
+
+        if (edges->value->pressed && frame_key_repeatable(key) &&
+            keyboard->scan_enabled && (keyboard->scancode_set == 1 ||
+                                       keyboard->scancode_set == 2) &&
+            (!keyboard->translate || keyboard->scancode_set == 2)) {
+            frame_key_repeat_arm_initial(keyboard, key, now);
+        } else if (!edges->value->pressed && frame_repeat_key == key) {
+            frame_key_repeat_cancel();
+        }
+    }
+}
+
+FdisbullFrameKeyRepeatState *qmp_x_fdisbull_query_frame_key_repeat(Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    g_autoptr(PS2KbdState) selected = NULL;
+    PS2KbdState *keyboard = frame_keys.keyboard;
+    FdisbullFrameKeyRepeatState *state;
+
+    assert(bql_locked());
+    if (fdisbull_instrumented_checkpoint_busy()) {
+        error_setg(errp, "Cannot query repeat during a checkpoint transaction");
+        return NULL;
+    }
+    if (!frame_keys_clock(&clock, errp) ||
+        !fdisbull_frame_keys_checkpoint_safe(errp)) {
+        return NULL;
+    }
+    if (!keyboard) {
+        selected = qemu_input_fdisbull_keyboard_target(errp);
+        keyboard = selected;
+    }
+    if (!keyboard || !frame_keyboard_controller(keyboard, errp)) {
+        return NULL;
+    }
+    if (frame_keys.active && frame_keys.epoch != clock->epoch) {
+        error_setg(errp, "Frame-key repeat owner epoch differs");
+        return NULL;
+    }
+    state = g_new0(FdisbullFrameKeyRepeatState, 1);
+    state->parameter = keyboard->typematic_parameter;
+    state->delay_ns = frame_repeat_delay(state->parameter);
+    state->interval_ns = frame_repeat_interval(state->parameter);
+    state->deadline_ns = frame_repeat_deadline;
+    state->has_key = frame_repeat_key != Q_KEY_CODE_UNMAPPED;
+    state->key = frame_repeat_key;
+    return state;
+}
+
+bool fdisbull_frame_key_repeat_checkpoint_validate(
+    const FdisbullFrameKeyRepeatState *state,
+    const FdisbullFrameKeysCheckpointState *keys, Error **errp)
+{
+    g_autoptr(PS2KbdState) keyboard = NULL;
+    const QKeyCodeList *key;
+
+    assert(bql_locked());
+    keyboard = qemu_input_fdisbull_keyboard_target(errp);
+    if (!keyboard) {
+        return false;
+    }
+    if (state->parameter != keyboard->typematic_parameter ||
+        state->delay_ns != frame_repeat_delay(state->parameter) ||
+        state->interval_ns != frame_repeat_interval(state->parameter) ||
+        state->deadline_ns < -1 || state->has_key != (state->deadline_ns >= 0)) {
+        error_setg(errp, "Frame-key repeat phase differs from the PS/2 device");
+        return false;
+    }
+    if (!state->has_key) {
+        return true;
+    }
+    if (keys && keys->active && keys->scan_enabled &&
+        (keys->scancode_set == 1 || keys->scancode_set == 2) &&
+        (!keys->translated || keys->scancode_set == 2) &&
+        frame_key_repeatable(state->key)) {
+        for (key = keys->held; key; key = key->next) {
+            if (key->value == state->key) {
+                return true;
+            }
+        }
+    }
+    error_setg(errp, "Frame-key repeat timer lacks an eligible held key");
+    return false;
+}
+
+void fdisbull_frame_key_repeat_checkpoint_restore(
+    const FdisbullFrameKeyRepeatState *state)
+{
+    assert(bql_locked());
+    frame_key_repeat_cancel();
+    if (state && state->has_key) {
+        frame_key_repeat_arm(state->key, state->deadline_ns);
+    }
+}
+
+void fdisbull_frame_key_repeat_save_begin(void)
+{
+    assert(bql_locked());
+    assert(!frame_repeat_save_paused);
+    frame_repeat_save_paused = true;
+    if (frame_repeat_timer_ready) {
+        timer_del(&frame_repeat_timer);
+    }
+}
+
+void fdisbull_frame_key_repeat_save_end(void)
+{
+    assert(bql_locked());
+    if (frame_repeat_save_paused && frame_repeat_deadline >= 0) {
+        timer_mod_ns(&frame_repeat_timer, frame_repeat_deadline);
+    }
+    frame_repeat_save_paused = false;
+}
