+static bool sb16_checkpoint_voice_format(SWVoiceOut *voice, int32_t *format)
+{
+    if (!voice || (voice->info.bits == 8 && !voice->info.is_signed)) {
+        *format = AUDIO_FORMAT_U8;
+        return true;
+    }
+    if (voice->info.bits == 16 && voice->info.is_signed == 1) {
+        *format = AUDIO_FORMAT_S16;
+        return true;
+    }
+    return false;
+}
+
+static bool sb16_checkpoint_s16_dma_safe(SB16State *s)
+{
+    I8257State *d = I8257(s->isa_hdma);
+    I8257Regs *r = &d->regs[s->hdma & 3];
+    int frame_bytes = s->voice->info.nchannels * 2;
+    int dma_bytes = ((int)r->base[1] + 1) * 2;
+
+    /* This extension covers complete signed frames on incrementing DMA5.
+     * Do not promote the existing decrement-path 16-bit ambiguity, partial
+     * frames, another transfer owner, or a mismatched live DSP voice.  The
+     * current DMA position and SB16 credit are bytes; DMA registers are words.
+     * Masked DREQ and pending IRQ (including an older 8-bit IRQ) are preserved
+     * by their existing codecs, not normalized or inferred from this format. */
+    return s->use_hdma == 1 && s->hdma == 5 && d->dshift == 1 &&
+        fdisbull_sb16_dma_channel(s->isa_hdma, s->hdma) &&
+        !(r->mode & 0x20) && (r->mode & 0x0c) == 0x08 &&
+        r->now[0] >= 0 && r->now[0] <= 131070 && !(r->now[0] & 1) &&
+        r->now[1] >= 0 && r->now[1] < dma_bytes &&
+        !(r->now[1] % frame_bytes) && !(dma_bytes % frame_bytes) &&
+        s->fmt_bits == 16 && s->fmt_signed == 1 &&
+        s->fmt == AUDIO_FORMAT_S16 &&
+        s->fmt_stereo == s->voice->info.nchannels - 1 &&
+        s->align == frame_bytes - 1 &&
+        s->bytes_per_second == s->voice->info.freq * frame_bytes &&
+        s->block_size > 0 && s->block_size <= 131072 &&
+        !(s->block_size % frame_bytes) &&
+        s->left_till_irq > 0 && s->left_till_irq <= s->block_size &&
+        !(s->left_till_irq % frame_bytes) &&
+        (s->dma_auto == 0 || s->dma_auto == 1) &&
+        (s->fifo == 0 || s->fifo == 1);
+}
