+
+    vga_fdisbull_vbe101_advance(s, now);
+    display->programmed_origin_bytes = s->vbe_start_addr * 4;
+    display->active_origin_bytes = s->fdisbull_vbe101_active_bytes;
+    display->has_pending_deadline_ns = s->fdisbull_vbe101_deadline_ns > 0;
+    display->pending_deadline_ns = s->fdisbull_vbe101_deadline_ns;
+    return display;
+}
