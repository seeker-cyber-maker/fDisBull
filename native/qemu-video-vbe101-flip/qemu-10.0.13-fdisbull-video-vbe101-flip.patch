+/* No IRQ or host update is produced by this latch. Materialize an elapsed
+ * edge before inspecting or replacing the pending display start. */
+static void vga_fdisbull_vbe101_advance(VGACommonState *s, int64_t now)
+{
+    if (s->fdisbull_vbe101_deadline_ns > 0 &&
+        now >= s->fdisbull_vbe101_deadline_ns) {
+        s->fdisbull_vbe101_active_bytes = s->vbe_start_addr * 4;
+        s->fdisbull_vbe101_deadline_ns = 0;
+    }
+}
+
+static int64_t vga_fdisbull_vbe101_next_edge(int64_t now)
+{
+    const int64_t period = vbe101_timing.line_period_ns *
+                           vbe101_timing.lines_per_frame;
+    const int64_t leading = vbe101_timing.line_period_ns *
+                            vbe101_timing.vsync_start_line;
+    int64_t delta = leading - now % period;
+
+    if (delta <= 0) {
+        delta += period;
+    }
+    return now <= INT64_MAX - delta ? now + delta : 0;
+}
+
+static FdisbullVbe101DisplayStart *vga_fdisbull_vbe101_start(
+    VGACommonState *s, int64_t now)
+{
