+
+/* The private capability is exposed only by the opt-in banked 101h device.
+ * Wait for a fresh leading edge even if INT 10h entered during retrace. */
+void
+bochsvga_wait_fdisbull_displaystart(void)
+{
+    if (dispi_read(0xf1) != 0xfb01)
+        return;
+    irq_enable();
+    while (inb(0x03da) & 0x08)
+        ;
+    while (!(inb(0x03da) & 0x08))
+        ;
+    irq_disable();
 }

