+##
+# @FdisbullTaskLayerView:
+# Explicit view used by a stopped read-only task-memory request.
+#
+# @ram: Task-private data bytes.
+# @execute: Effective task-private instruction-fetch bytes.
+# @base: Shared underlying guest RAM bytes.
+##
+{ 'enum': 'FdisbullTaskLayerView', 'data': [ 'ram', 'execute', 'base' ] }
+
+##
+# @FdisbullTaskPage:
+# One guest physical page requested for private storage.
+#
+# @address: Page-aligned guest physical address.
+##
+{ 'struct': 'FdisbullTaskPage',
+  'data': { 'address': 'uint64' } }
+
+##
+# @FdisbullTaskPatch:
+# Guarded bytes in a registered task-private page.
+#
+# @address: Guest physical start address.
+# @before: Expected bytes as lowercase hex.
+# @after: Replacement bytes as lowercase hex.
+##
+{ 'struct': 'FdisbullTaskPatch',
+  'data': { 'address': 'uint64', 'before': 'str', 'after': 'str' } }
+
+##
+# @FdisbullTaskPageInfo:
+# Identity and digest of a private page.
+#
+# @address: Guest physical page address.
+# @backing: Internal resolved RAM backing page address.
+# @sha256: Digest of the full task-private page.
+##
+{ 'struct': 'FdisbullTaskPageInfo',
+  'data': { 'address': 'uint64', 'backing': 'uint64', 'sha256': 'str' } }
+
+##
+# @FdisbullTaskInfo:
+# One registered task lifetime and its pages/layers.
+#
+# @uuid: Cooperating monitor UUID as 32 lowercase hex digits.
+# @cookie: Monitor task cookie.
+# @incarnation: Non-reusable lifetime counter.
+# @generation: Per-task layer generation.
+# @retired: Whether this lifetime has been tombstoned.
+# @pages: Private page identities and contents digests.
+# @execution-bytes: Count of task fetch overlay bytes.
+# @execution-sha256: Digest of effective task fetch overlay state.
+##
+{ 'struct': 'FdisbullTaskInfo',
+  'data': { 'uuid': 'str', 'cookie': 'uint64', 'incarnation': 'uint64',
+            'generation': 'uint64', 'retired': 'bool',
+            'pages': [ 'FdisbullTaskPageInfo' ],
+            'execution-bytes': 'uint64', 'execution-sha256': 'str' } }
+
+##
+# @FdisbullTaskStatusInfo:
+# Full task-private owner and registry receipt.
+#
+# @model: Native implementation model identifier.
+# @api-version: API schema version.
+# @epoch: Native owner epoch, changed on reset or migration load.
+# @generation: Native task-view manager generation.
+# @uuid: Requested monitor UUID.
+# @cookie: Requested task cookie.
+# @incarnation: Requested task incarnation.
+# @task-generation: Requested task's layer generation.
+# @selected: Whether the requested task owns the active CPU view.
+# @selected-uuid: Active task UUID, or empty when no task is selected.
+# @selected-cookie: Active task cookie, or zero when none is selected.
+# @selected-incarnation: Active task incarnation, or zero when none selected.
+# @sequence: Last committed even scheduler sequence.
+# @pending: Whether a task switch is queued for the next TB boundary.
+# @fault: Optional fail-closed task-view fault.
+# @tasks: Complete registered task and page inventory.
+##
+{ 'struct': 'FdisbullTaskStatusInfo',
+  'data': { 'model': 'str', 'api-version': 'uint64', 'epoch': 'uint64',
+            'generation': 'uint64', 'uuid': 'str', 'cookie': 'uint64',
+            'incarnation': 'uint64', 'task-generation': 'uint64',
+            'selected': 'bool', 'selected-uuid': 'str',
+            'selected-cookie': 'uint64', 'selected-incarnation': 'uint64',
+            'sequence': 'uint64', 'pending': 'bool', '*fault': 'str',
+            'tasks': [ 'FdisbullTaskInfo' ] } }
+
+##
+# @FdisbullTaskMonitorInfo:
+# Doorbell and arena initialization receipt.
+#
+# @model: Native implementation model identifier.
+# @anchor-address: Physical RAM address of FDBTASK1 record.
+# @anchor-size: FDBTASK1 record size in bytes.
+# @doorbell-port: Guest I/O port used to commit a task switch.
+# @doorbell-value: Required 16-bit doorbell token.
+# @epoch: Native task-context epoch.
+# @generation: Native manager generation.
+# @max-tasks: Maximum registered task lifetimes.
+# @max-pages-per-task: Maximum private pages per task.
+# @enabled: Whether guest doorbell commits are enabled.
+##
+{ 'struct': 'FdisbullTaskMonitorInfo',
+  'data': { 'model': 'str', 'anchor-address': 'uint64',
+            'anchor-size': 'uint64', 'doorbell-port': 'uint64',
+            'doorbell-value': 'uint64', 'epoch': 'uint64',
+            'generation': 'uint64', 'max-tasks': 'uint64',
+            'max-pages-per-task': 'uint64', 'enabled': 'bool' } }
+
+##
+# @FdisbullTaskConfigureInfo:
+# Atomic per-task layer transition receipt.
+#
+# @generation: New per-task layer generation.
+# @ram-bytes: Number of task-private data bytes written.
+# @execution-bytes: Number of active task fetch overlay bytes.
+# @fault: Optional task-view fault.
+##
+{ 'struct': 'FdisbullTaskConfigureInfo',
+  'data': { 'generation': 'uint64', 'ram-bytes': 'uint64',
+            'execution-bytes': 'uint64', '*fault': 'str' } }
+
+##
+# @FdisbullTaskReadInfo:
+# Explicit stopped task-memory view receipt.
+#
+# @generation: Task layer generation.
+# @data-hex: Requested byte span as lowercase hex.
+# @active: Whether the task currently owns the CPU view.
+##
+{ 'struct': 'FdisbullTaskReadInfo',
+  'data': { 'generation': 'uint64', 'data-hex': 'str', 'active': 'bool' } }
+
+##
+# @x-fdisbull-task-monitor-init:
+# Initialize the cooperative task monitor, its private RAM arena and the
+# VMState record. The guest commits an already-published even FDBTASK1 anchor
+# using OUTW 0xF1DB,0x4446.
+#
+# @anchor-address: Physical RAM address of the 56-byte FDBTASK1 anchor.
+# @prepare-only: Initialize for a snapshot destination without enabling
+#     guest commits before the saved VMState is restored.
+##
+{ 'command': 'x-fdisbull-task-monitor-init',
+  'data': { 'anchor-address': 'uint64', '*prepare-only': 'bool' },
+  'returns': 'FdisbullTaskMonitorInfo' }
+
+##
+# @x-fdisbull-task-register:
+# Register or extend one never-reused incarnation.
+#
+# @uuid: Cooperating monitor UUID as 32 lowercase hex digits.
+# @cookie: Task cookie.
+# @incarnation: Non-reusable task lifetime counter.
+# @pages: Physical RAM pages to clone into this private view.
+##
+{ 'command': 'x-fdisbull-task-register',
+  'data': { 'uuid': 'str', 'cookie': 'uint64', 'incarnation': 'uint64',
+            'pages': [ 'FdisbullTaskPage' ] },
+  'returns': 'FdisbullTaskStatusInfo' }
+
+##
+# @x-fdisbull-task-layer-configure:
+# Atomically configure guarded task layers.
+#
+# @uuid: Cooperating monitor UUID.
+# @cookie: Task cookie.
+# @incarnation: Task lifetime counter.
+# @generation: Expected current per-task layer generation.
+# @ram: Guarded private data writes.
+# @execute: Complete desired task-private fetch overlay.
+##
+{ 'command': 'x-fdisbull-task-layer-configure',
+  'data': { 'uuid': 'str', 'cookie': 'uint64', 'incarnation': 'uint64',
+            'generation': 'uint64', 'ram': [ 'FdisbullTaskPatch' ],
+            'execute': [ 'FdisbullTaskPatch' ] },
+  'returns': 'FdisbullTaskConfigureInfo' }
+
+##
+# @x-fdisbull-task-layer-read:
+# Read an explicit task/base/fetch memory view.
+#
+# @uuid: Cooperating monitor UUID.
+# @cookie: Task cookie.
+# @incarnation: Task lifetime counter.
+# @address: Guest physical address.
+# @length: Number of bytes, from 1 to 4096.
+# @view: Optional explicit memory view, defaulting to ram.
+##
+{ 'command': 'x-fdisbull-task-layer-read',
+  'data': { 'uuid': 'str', 'cookie': 'uint64', 'incarnation': 'uint64',
+            'address': 'uint64', 'length': 'uint16', '*view': 'FdisbullTaskLayerView' },
+  'returns': 'FdisbullTaskReadInfo' }
+
+##
+# @x-fdisbull-task-layer-observe:
+# Read registry, selection and page digests.
+#
+# @uuid: Cooperating monitor UUID.
+# @cookie: Task cookie.
+# @incarnation: Task lifetime counter.
+##
+{ 'command': 'x-fdisbull-task-layer-observe',
+  'data': { 'uuid': 'str', 'cookie': 'uint64', 'incarnation': 'uint64' },
+  'returns': 'FdisbullTaskStatusInfo' }
+
+##
+# @x-fdisbull-task-retire:
+# Retire one incarnation and revoke active mapping.
+#
+# @uuid: Cooperating monitor UUID.
+# @cookie: Task cookie.
