+};
+
+static void register_vmstate(void)
+{
+    vmstate_register(NULL, 0, &vmstate_fdisbull_task_private, &migration_state);
+}
+
+bool fdisbull_task_private_resolve(uint64_t base, ram_addr_t *private_addr)
+{
+    bool found = false;
+    if (!task_manager_ready) {
+        return false;
+    }
+    uint64_t page = base & ~(TASK_PAGE_SIZE - 1);
+    uint64_t within = base & (TASK_PAGE_SIZE - 1);
+    lock_init();
+    qemu_mutex_lock(&task_lock);
+    if (selected_task < TASK_MAX && tasks[selected_task].used &&
+        !tasks[selected_task].retired) {
+        TaskPageState *entry = find_page_by_backing(&tasks[selected_task], page);
+        if (entry) {
+            *private_addr = slot_ram_addr(entry->slot) + within;
+            found = true;
+        }
+    }
+    qemu_mutex_unlock(&task_lock);
+    return found;
+}
+
+void *fdisbull_task_private_ptr(uint64_t address)
+{
+    if (!arena_ready || address < arena_ram_addr ||
+        address >= arena_ram_addr + TASK_ARENA_SIZE) {
+        return NULL;
+    }
+    return arena_host + (address - arena_ram_addr);
+}
+
+void fdisbull_task_private_copy_code(void *dest, const void *host, size_t length)
+{
+    uint8_t *output = dest;
+    const uint8_t *input = host;
+    if (!task_manager_ready) {
+        return;
+    }
+    lock_init();
+    qemu_mutex_lock(&task_lock);
+    if (selected_task >= TASK_MAX || !tasks[selected_task].used) {
+        qemu_mutex_unlock(&task_lock);
+        return;
+    }
+    TaskState *task = &tasks[selected_task];
+    for (size_t i = 0; i < length; i++) {
+        uint64_t addr = qemu_ram_addr_from_host((void *)(input + i));
+        uint8_t value, expected;
+        if (addr != RAM_ADDR_INVALID && byte_map_get(task->execute, addr, &value)) {
+            if (!byte_map_get(task->expected, addr, &expected) || input[i] != expected) {
+                g_clear_pointer(&task_fault, g_free);
+                task_fault = g_strdup("task-private execute backing changed before fetch");
+                g_hash_table_remove_all(task->execute);
+                g_hash_table_remove_all(task->expected);
+                g_atomic_int_set(&pending_fault, 1);
+                if (current_cpu) cpu_exit(current_cpu);
+                output[i] = input[i];
+            } else {
+                output[i] = value;
+            }
+        }
+    }
+    qemu_mutex_unlock(&task_lock);
+}
+
+bool fdisbull_task_private_note_guest_write(uint64_t address, size_t length)
+{
+    bool invalidated = false;
+    if (!task_manager_ready) {
+        return false;
+    }
+    lock_init();
+    qemu_mutex_lock(&task_lock);
+    if (selected_task >= TASK_MAX || !tasks[selected_task].used) {
+        qemu_mutex_unlock(&task_lock);
+        return false;
+    }
+    TaskState *task = &tasks[selected_task];
+    for (size_t i = 0; i < length; i++) {
+        uint8_t ignored;
+        if (byte_map_get(task->execute, address + i, &ignored)) {
+            g_clear_pointer(&task_fault, g_free);
+            task_fault = g_strdup("guest self-modified task-private execution backing");
+            g_hash_table_remove_all(task->execute);
+            g_hash_table_remove_all(task->expected);
+            g_atomic_int_set(&pending_fault, 1);
+            invalidated = true;
+            break;
+        }
+    }
+    qemu_mutex_unlock(&task_lock);
+    if (invalidated && current_cpu) cpu_exit(current_cpu);
+    return invalidated;
+}
+
+void fdisbull_task_private_note_reset(void)
+{
+    selected_task = UINT8_MAX;
+    g_atomic_int_set(&pending_task, -1);
+    g_atomic_int_set(&pending_fault, 0);
+    g_clear_pointer(&task_fault, g_free);
+    if (generation_highwater != UINT64_MAX) {
+        generation_highwater++;
+    }
+}
+
+/* The OUTW callback only validates and queues. The execution loop commits it
+ * after the I/O-ending TB, before the following guest TB is looked up. */
+static void task_doorbell_write(void *opaque, hwaddr addr, uint64_t value,
+                                unsigned size)
+{
+    g_autofree char *uuid = NULL;
+    uint64_t sequence, cookie, incarnation;
+    int index;
+    if (size != 2 || addr != 0 || value != TASK_PORT_VALUE ||
+        !task_manager_ready || !monitor_enabled ||
+        !read_anchor(&uuid, &sequence, &cookie, &incarnation, NULL)) {
+        g_atomic_int_set(&pending_fault, 1);
+        if (current_cpu) cpu_exit(current_cpu);
+        return;
+    }
+    if ((sequence & 1) || sequence <= migration_state.sequence ||
+        !cookie || !incarnation) {
+        g_atomic_int_set(&pending_fault, 1);
+        if (current_cpu) cpu_exit(current_cpu);
+        return;
+    }
+    lock_init();
+    qemu_mutex_lock(&task_lock);
+    index = find_task(uuid, cookie, incarnation);
+    qemu_mutex_unlock(&task_lock);
+    if (index < 0 || tasks[index].retired) {
+        g_atomic_int_set(&pending_fault, 1);
+        if (current_cpu) cpu_exit(current_cpu);
+        return;
+    }
+    migration_state.sequence = sequence;
+    g_atomic_int_set(&pending_task, index);
+    /* Force a return to cpu_exec_loop before direct TB chaining can run the
+     * next instruction under the old TLB-selected task view. */
+    if (current_cpu) cpu_exit(current_cpu);
+}
+
+static const MemoryRegionOps task_io_ops = {
+    .write = task_doorbell_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4,
+               .unaligned = false },
+    .impl = { .min_access_size = 1, .max_access_size = 4,
+              .unaligned = false },
+};
+
+bool fdisbull_task_private_commit_switch(CPUState *cpu)
+{
+    gint pending = g_atomic_int_get(&pending_task);
+    if (pending < 0 && !g_atomic_int_get(&pending_fault)) {
+        return false;
+    }
+    lock_init();
+    qemu_mutex_lock(&task_lock);
+    Error *paging_error = NULL;
+    if (generation_highwater >= UINT64_MAX - 1 ||
+        g_atomic_int_get(&pending_fault) || pending < 0 || pending >= TASK_MAX ||
+        !tasks[pending].used || tasks[pending].retired ||
+        !task_paging_guard(cpu, pending >= 0 && pending < TASK_MAX ?
+                           &tasks[pending] : &tasks[0], &paging_error)) {
+        selected_task = UINT8_MAX;
+        if (paging_error) {
+            g_clear_pointer(&task_fault, g_free);
+            task_fault = g_strdup(error_get_pretty(paging_error));
+        } else if (generation_highwater >= UINT64_MAX - 1) {
+            g_clear_pointer(&task_fault, g_free);
+            task_fault = g_strdup("task generation counter exhausted; task view revoked");
+        } else if (!task_fault) {
+            task_fault = g_strdup("invalid or unregistered task anchor; previous view revoked");
+        }
+        error_free(paging_error);
+        g_atomic_int_set(&pending_fault, 0);
+        g_atomic_int_set(&pending_task, -1);
+        qemu_mutex_unlock(&task_lock);
+        tlb_flush(cpu);
+        tb_flush(cpu);
+        bql_lock();
+        cpu_interrupt(cpu, CPU_INTERRUPT_DEBUG);
+        bql_unlock();
+        return true;
+    }
+    selected_task = pending;
+    generation_highwater++;
+    g_clear_pointer(&task_fault, g_free);
+    g_atomic_int_set(&pending_task, -1);
+    qemu_mutex_unlock(&task_lock);
+    fdisbull_task_context_note_transition();
+    tlb_flush(cpu);
+    tb_flush(cpu);
+    return true;
+}
+
+void fdisbull_task_private_context_changed(CPUState *cpu)
+{
+    Error *err = NULL;
+    if (!task_manager_ready || selected_task >= TASK_MAX) {
+        return;
+    }
+    lock_init();
+    qemu_mutex_lock(&task_lock);
+    bool valid = task_paging_guard(cpu, &tasks[selected_task], &err);
+    if (!valid) {
+        selected_task = UINT8_MAX;
+        g_clear_pointer(&task_fault, g_free);
+        task_fault = g_strdup(error_get_pretty(err));
+    }
+    qemu_mutex_unlock(&task_lock);
+    if (!valid) {
+        error_free(err);
+        tlb_flush(cpu);
+        tb_flush(cpu);
+        bql_lock();
+        cpu_interrupt(cpu, CPU_INTERRUPT_DEBUG);
+        bql_unlock();
+        cpu_exit(cpu);
+    }
+}
+
+static bool add_task_page(TaskState *task, uint64_t guest, Error **errp)
+{
+    uint64_t backing;
+    uint8_t *base;
+    guest &= ~(TASK_PAGE_SIZE - 1);
+    if (!direct_ram(guest, TASK_PAGE_SIZE, NULL, NULL, &backing, &base, errp)) {
+        return false;
+    }
+    backing &= ~(TASK_PAGE_SIZE - 1);
+    TaskPageState *already = find_page_by_backing(task, backing);
+    if (already) {
+        return true;
+    }
+    if (task->page_count >= TASK_PAGES) {
+        task_error(errp, "task page cap exceeded");
+        return false;
+    }
+    bool used[TASK_MAX * TASK_PAGES] = {0};
+    for (int ti = 0; ti < TASK_MAX; ti++) {
+        if (!tasks[ti].used) {
+            continue;
+        }
+        for (unsigned pi = 0; pi < tasks[ti].page_count; pi++) {
+            used[tasks[ti].pages[pi].slot] = true;
+        }
+    }
+    unsigned slot;
+    for (slot = 0; slot < TASK_MAX * TASK_PAGES && used[slot]; slot++) {
+    }
+    if (slot == TASK_MAX * TASK_PAGES) {
+        task_error(errp, "private RAM arena is full");
+        return false;
+    }
+    memcpy(slot_ptr(slot), base, TASK_PAGE_SIZE);
+    memory_region_set_dirty(&task_arena, (uint64_t)slot * TASK_PAGE_SIZE,
+                            TASK_PAGE_SIZE);
+    task->pages[task->page_count++] = (TaskPageState) {
+        .guest_address = guest,
+        .backing_page = backing,
+        .slot = slot,
+        .used = true,
+    };
+    return true;
+}
+
+static TaskState *get_or_create_task(const char *uuid, uint64_t cookie,
+                                     uint64_t incarnation, Error **errp)
+{
+    int index = find_task(uuid, cookie, incarnation);
+    if (index >= 0) {
+        if (tasks[index].retired) {
+            task_error(errp, "retired task incarnation cannot be reused");
+            return NULL;
+        }
+        return &tasks[index];
+    }
+    for (int i = 0; i < TASK_MAX; i++) {
+        if (tasks[i].used && !strcmp(tasks[i].uuid, uuid) &&
+            tasks[i].cookie == cookie && !tasks[i].retired) {
+            task_error(errp, "task cookie already belongs to another incarnation");
+            return NULL;
+        }
+    }
+    index = find_free_task();
+    if (index < 0) {
+        task_error(errp, "task registry is full");
+        return NULL;
+    }
+    TaskState *task = &tasks[index];
+    memset(task, 0, sizeof(*task));
+    pstrcpy(task->uuid, sizeof(task->uuid), uuid);
+    task->cookie = cookie;
+    task->incarnation = incarnation;
+    task->used = true;
+    task->execute = byte_map_new();
+    task->expected = byte_map_new();
+    return task;
+}
+
+FdisbullTaskMonitorInfo *qmp_x_fdisbull_task_monitor_init(
+    uint64_t anchor_address, bool has_prepare_only, bool prepare_only,
+    Error **errp)
+{
+    g_autofree char *ignored = NULL;
+    uint64_t epoch, generation;
+    if (!stopped_single_tcg(errp) ||
+        !direct_ram(anchor_address, TASK_ANCHOR_SIZE, NULL, NULL, NULL, NULL, errp)) {
+        return NULL;
+    }
+    manager_init_empty(errp);
+    if (errp && *errp) {
+        return NULL;
+    }
+    if (io_ready && migration_state.anchor_address != anchor_address) {
+        task_error(errp, "monitor anchor cannot be changed after initialization");
+        return NULL;
+    }
+    if (!io_ready) {
+        memory_region_init_io(&task_io, NULL, &task_io_ops, NULL,
+                              "fdisbull-task-doorbell", 2);
+        memory_region_add_subregion(get_system_io(), TASK_PORT, &task_io);
+        io_ready = true;
+    }
+    migration_state.anchor_address = anchor_address;
+    if (!fdisbull_task_context_get_counters(&epoch, &generation, errp)) {
+        return NULL;
+    }
+    FdisbullTaskMonitorInfo *result = g_new0(FdisbullTaskMonitorInfo, 1);
+    result->model = g_strdup("qemu-pc-task-private-v1");
+    result->anchor_address = anchor_address;
+    result->anchor_size = TASK_ANCHOR_SIZE;
+    result->doorbell_port = TASK_PORT;
+    result->doorbell_value = TASK_PORT_VALUE;
+    result->epoch = epoch;
+    result->generation = generation_highwater;
+    result->max_tasks = TASK_MAX;
+    result->max_pages_per_task = TASK_PAGES;
+    result->enabled = !(has_prepare_only && prepare_only);
+    monitor_enabled = result->enabled;
+    migration_state.enabled = monitor_enabled;
+    return result;
+}
+
+FdisbullTaskStatusInfo *qmp_x_fdisbull_task_register(
+    const char *uuid, uint64_t cookie, uint64_t incarnation,
+    FdisbullTaskPageList *pages, Error **errp)
+{
+    TaskState *task;
+    struct { uint64_t guest; uint64_t backing; uint8_t *host; } candidate[TASK_PAGES];
+    unsigned candidate_count = 0;
+    bool selected_view_changed = false;
+    g_autofree char *anchor_uuid = NULL;
+    uint64_t anchor_sequence, anchor_cookie, anchor_incarnation;
+    bool anchor_matches;
+    if (!stopped_single_tcg(errp) ||
+        !task_key_validate(uuid, cookie, incarnation, errp)) {
+        return NULL;
+    }
+    manager_init_empty(errp);
+    if (errp && *errp) {
+        return NULL;
+    }
+    for (FdisbullTaskPageList *item = pages; item; item = item->next) {
+        uint64_t backing;
+        uint8_t *base;
+        if (candidate_count == TASK_PAGES ||
+            (item->value->address & (TASK_PAGE_SIZE - 1)) ||
+            !direct_ram(item->value->address, TASK_PAGE_SIZE, NULL, NULL,
+                        &backing, &base, errp)) {
+            if (!errp || !*errp) task_error(errp, "invalid or excessive task page list");
+            return NULL;
+        }
+        backing &= ~(TASK_PAGE_SIZE - 1);
+        bool duplicate = false;
+        for (unsigned i = 0; i < candidate_count; i++) {
+            duplicate |= candidate[i].backing == backing;
+        }
+        if (!duplicate) {
+            candidate[candidate_count++] = (typeof(candidate[0])) {
+                .guest = item->value->address, .backing = backing, .host = base
+            };
+        }
+    }
+    if (!read_anchor(&anchor_uuid, &anchor_sequence, &anchor_cookie,
+                     &anchor_incarnation, errp)) {
+        return NULL;
+    }
+    if (strcmp(uuid, anchor_uuid) || (anchor_sequence & 1)) {
+        task_error(errp, "task registration UUID differs from stable monitor anchor");
+        return NULL;
+    }
+    anchor_matches = anchor_cookie == cookie && anchor_incarnation == incarnation;
+    if (anchor_matches &&
+        ((selected_task == UINT8_MAX && migration_state.sequence != 0) ||
+         (selected_task < TASK_MAX &&
+          (selected_task >= TASK_MAX || strcmp(tasks[selected_task].uuid, uuid) ||
+           tasks[selected_task].cookie != cookie ||
+           tasks[selected_task].incarnation != incarnation)))) {
+        task_error(errp, "task selection can change only at a committed doorbell");
+        return NULL;
+    }
+    if (selected_task < TASK_MAX) {
+        TaskState *selected = &tasks[selected_task];
+        if (anchor_cookie == selected->cookie &&
+            anchor_incarnation == selected->incarnation &&
+            anchor_sequence != migration_state.sequence) {
+            task_error(errp, "registration anchor sequence differs from committed task selection");
+            return NULL;
+        }
+    } else if (migration_state.sequence != 0 &&
+               anchor_cookie == cookie && anchor_incarnation == incarnation &&
+               anchor_sequence != migration_state.sequence) {
+        task_error(errp, "cannot select a new task outside a committed doorbell");
+        return NULL;
+    }
+    CPUState *owner = NULL;
+    CPU_FOREACH(owner) { break; }
+    if (candidate_count && owner) {
+        TaskState probe = { .page_count = candidate_count };
+        for (unsigned i = 0; i < candidate_count; i++) {
+            probe.pages[i].backing_page = candidate[i].backing;
+        }
+        Error *paging_error = NULL;
+        if (!task_paging_guard(owner, &probe, &paging_error)) {
+            if (paging_error) error_propagate(errp, paging_error);
+            return NULL;
+        }
+    }
+    lock_init();
+    qemu_mutex_lock(&task_lock);
+    if (!generation_room(errp)) {
+        qemu_mutex_unlock(&task_lock);
+        return NULL;
+    }
+    int existing_index = find_task(uuid, cookie, incarnation);
+    TaskState *existing = existing_index >= 0 ? &tasks[existing_index] : NULL;
+    unsigned new_pages = 0;
+    for (unsigned i = 0; i < candidate_count; i++) {
+        if (!existing || !find_page_by_backing(existing, candidate[i].backing)) new_pages++;
+    }
+    unsigned free_slots = 0;
+    bool slot_used[TASK_MAX * TASK_PAGES] = {0};
+    for (int ti = 0; ti < TASK_MAX; ti++) for (unsigned pi = 0; tasks[ti].used && pi < tasks[ti].page_count; pi++) slot_used[tasks[ti].pages[pi].slot] = true;
+    for (unsigned i = 0; i < TASK_MAX * TASK_PAGES; i++) free_slots += !slot_used[i];
+    if (new_pages > free_slots || (existing && existing->page_count + new_pages > TASK_PAGES) ||
+        (!existing && find_free_task() < 0)) {
+        qemu_mutex_unlock(&task_lock);
+        task_error(errp, "task or private page capacity exceeded");
+        return NULL;
+    }
+    task = get_or_create_task(uuid, cookie, incarnation, errp);
+    if (!task) {
+        qemu_mutex_unlock(&task_lock);
+        return NULL;
+    }
+    unsigned old_page_count = task->page_count;
+    for (unsigned i = 0; i < candidate_count; i++) {
+        if (!find_page_by_backing(task, candidate[i].backing)) {
+            if (!add_task_page(task, candidate[i].guest, errp)) {
+                qemu_mutex_unlock(&task_lock);
+                return NULL;
+            }
+        }
+    }
+    int task_index = find_task(uuid, cookie, incarnation);
+    if (anchor_matches) {
+        bool initial_selection = selected_task == UINT8_MAX && migration_state.sequence == 0;
+        if (selected_task != task_index && !initial_selection) {
+            qemu_mutex_unlock(&task_lock);
+            task_error(errp, "task selection can change only at a committed doorbell");
+            return NULL;
+        }
+        if (initial_selection) {
+            selected_task = task_index;
+            generation_highwater++;
+            fdisbull_task_context_note_transition();
+            selected_view_changed = true;
+        }
+        migration_state.sequence = anchor_sequence;
+    }
+    generation_highwater++;
+    selected_view_changed |= selected_task == task_index && task->page_count != old_page_count;
+    FdisbullTaskStatusInfo *result = status_new(uuid, cookie, incarnation, errp);
+    qemu_mutex_unlock(&task_lock);
+    if (selected_view_changed) {
+        CPUState *cpu;
+        CPU_FOREACH(cpu) { tlb_flush(cpu); tb_flush(cpu); }
+    }
+    return result;
+}
+
+static bool parse_patch_hex(const char *hex, GByteArray **out, Error **errp)
+{
+    size_t length = hex ? strlen(hex) : 0;
+    if (!length || (length & 1) || length / 2 > TASK_MAX_PATCH_BYTES) {
+        task_error(errp, "patch bytes must be bounded nonempty lowercase hex");
+        return false;
+    }
+    GByteArray *bytes = g_byte_array_sized_new(length / 2);
+    for (size_t i = 0; i < length; i += 2) {
+        int hi = g_ascii_xdigit_value(hex[i]);
+        int lo = g_ascii_xdigit_value(hex[i + 1]);
+        if (hi < 0 || lo < 0 || g_ascii_isupper(hex[i]) || g_ascii_isupper(hex[i + 1])) {
+            g_byte_array_unref(bytes);
+            task_error(errp, "patch bytes must be lowercase hex");
+            return false;
+        }
+        uint8_t byte = (hi << 4) | lo;
+        g_byte_array_append(bytes, &byte, 1);
+    }
+    *out = bytes;
+    return true;
+}
+
+static bool task_patch_address(TaskState *task, uint64_t guest,
+                               uint64_t *private_address, Error **errp)
+{
+    uint64_t base;
+    if (!direct_ram(guest, 1, NULL, NULL, &base, NULL, errp)) {
+        return false;
+    }
+    TaskPageState *page = find_page_by_backing(task, base & ~(TASK_PAGE_SIZE - 1));
+    if (!page) {
+        task_error(errp, "patch address is outside registered task-private pages");
+        return false;
+    }
+    *private_address = slot_ram_addr(page->slot) + (base & (TASK_PAGE_SIZE - 1));
+    return true;
+}
+
+FdisbullTaskConfigureInfo *qmp_x_fdisbull_task_layer_configure(
+    const char *uuid, uint64_t cookie, uint64_t incarnation,
+    uint64_t generation, FdisbullTaskPatchList *ram,
+    FdisbullTaskPatchList *execute, Error **errp)
+{
+    g_autoptr(GHashTable) ram_before = byte_map_new();
+    g_autoptr(GHashTable) ram_after = byte_map_new();
+    g_autoptr(GHashTable) exec_before = byte_map_new();
+    g_autoptr(GHashTable) exec_after = byte_map_new();
+    g_autoptr(GHashTable) replacement = byte_map_new();
+    size_t ram_bytes = 0, exec_bytes = 0;
+    if (!stopped_single_tcg(errp) ||
+        !task_key_validate(uuid, cookie, incarnation, errp)) {
+        return NULL;
+    }
+    if (!task_manager_ready) {
+        task_error(errp, "task monitor is not initialized");
+        return NULL;
+    }
+    lock_init();
+    qemu_mutex_lock(&task_lock);
+    int ti = find_task(uuid, cookie, incarnation);
+    if (ti < 0 || tasks[ti].retired || tasks[ti].generation != generation) {
+        qemu_mutex_unlock(&task_lock);
+        task_error(errp, "task key is unknown, retired, or generation changed");
+        return NULL;
+    }
+    TaskState *task = &tasks[ti];
+    if (task->generation >= UINT64_MAX - 1 || generation_highwater >= UINT64_MAX - 1) {
+        qemu_mutex_unlock(&task_lock);
+        task_error(errp, "task generation counter exhausted");
+        return NULL;
+    }
+    for (int pass = 0; pass < 2; pass++) {
+        FdisbullTaskPatchList *item = pass ? execute : ram;
+        GHashTable *before = pass ? exec_before : ram_before;
+        GHashTable *after = pass ? exec_after : ram_after;
+        size_t *total = pass ? &exec_bytes : &ram_bytes;
+        unsigned count = 0;
+        for (; item; item = item->next) {
+            GByteArray *old_bytes = NULL, *new_bytes = NULL;
+            if (++count > 4096 ||
+                !parse_patch_hex(item->value->before, &old_bytes, errp) ||
+                !parse_patch_hex(item->value->after, &new_bytes, errp)) {
+                if (old_bytes) g_byte_array_unref(old_bytes);
+                if (new_bytes) g_byte_array_unref(new_bytes);
+                if (!errp || !*errp) task_error(errp, "patch count limit exceeded");
+                qemu_mutex_unlock(&task_lock);
+                return NULL;
+            }
+            if (old_bytes->len != new_bytes->len ||
+                item->value->address > UINT64_MAX - old_bytes->len) {
+                g_byte_array_unref(old_bytes); g_byte_array_unref(new_bytes);
+                qemu_mutex_unlock(&task_lock);
+                task_error(errp, "patch extent differs or overflows");
+                return NULL;
+            }
+            *total += old_bytes->len;
+            if (*total > TASK_MAX_PATCH_BYTES) {
+                g_byte_array_unref(old_bytes); g_byte_array_unref(new_bytes);
+                qemu_mutex_unlock(&task_lock);
+                task_error(errp, "patch byte limit exceeded");
+                return NULL;
+            }
+            for (unsigned i = 0; i < old_bytes->len; i++) {
+                uint64_t private_address;
+                if (!task_patch_address(task, item->value->address + i,
+                                        &private_address, errp)) {
+                    g_byte_array_unref(old_bytes); g_byte_array_unref(new_bytes);
+                    qemu_mutex_unlock(&task_lock);
+                    return NULL;
+                }
+                uint64_t *key1 = g_new(uint64_t, 1), *key2 = g_new(uint64_t, 1);
+                *key1 = private_address; *key2 = private_address;
+                if (g_hash_table_contains(before, key1)) {
+                    g_free(key1); g_free(key2);
+                    g_byte_array_unref(old_bytes); g_byte_array_unref(new_bytes);
+                    qemu_mutex_unlock(&task_lock);
+                    task_error(errp, "overlapping task patch ranges");
+                    return NULL;
+                }
+                g_hash_table_insert(before, key1,
+                                    GUINT_TO_POINTER((unsigned)old_bytes->data[i] + 1));
+                g_hash_table_insert(after, key2,
+                                    GUINT_TO_POINTER((unsigned)new_bytes->data[i] + 1));
+            }
+            g_byte_array_unref(old_bytes); g_byte_array_unref(new_bytes);
+        }
+    }
+    GHashTableIter iter; gpointer key, value;
+    g_hash_table_iter_init(&iter, ram_before);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        uint64_t address = *(uint64_t *)key;
+        uint8_t expected = GPOINTER_TO_UINT(value) - 1, actual;
+        uint8_t *host = arena_host + (address - arena_ram_addr);
+        actual = *host;
+        if (actual != expected) {
+            qemu_mutex_unlock(&task_lock);
+            task_error(errp, "task RAM guard byte differs");
+            return NULL;
+        }
+    }
+    g_hash_table_iter_init(&iter, exec_before);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        uint64_t address = *(uint64_t *)key;
+        uint8_t expected = GPOINTER_TO_UINT(value) - 1, actual;
+        if (!byte_map_get(ram_after, address, &actual)) {
+            actual = *(arena_host + (address - arena_ram_addr));
+        }
+        if (actual != expected) {
+            qemu_mutex_unlock(&task_lock);
+            task_error(errp, "task execute guard byte differs");
+            return NULL;
+        }
+    }
+    /* Build the full replacement before mutating task state. */
+    g_hash_table_iter_init(&iter, exec_after);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        uint64_t *copy = g_new(uint64_t, 1); *copy = *(uint64_t *)key;
+        g_hash_table_insert(replacement, copy, value);
+    }
+    g_hash_table_iter_init(&iter, ram_after);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        uint64_t address = *(uint64_t *)key;
+        *(arena_host + (address - arena_ram_addr)) = GPOINTER_TO_UINT(value) - 1;
+        memory_region_set_dirty(&task_arena, address - arena_ram_addr, 1);
+    }
+    g_hash_table_unref(task->execute);
+    task->execute = g_steal_pointer(&replacement);
+    g_hash_table_unref(task->expected);
+    task->expected = g_steal_pointer(&exec_before);
+    task->generation++;
+    generation_highwater++;
+    CPUState *cpu;
+    CPU_FOREACH(cpu) { tlb_flush(cpu); tb_flush(cpu); }
+    FdisbullTaskConfigureInfo *result = g_new0(FdisbullTaskConfigureInfo, 1);
+    result->generation = task->generation;
+    result->ram_bytes = ram_bytes;
+    result->execution_bytes = exec_bytes;
+    if (task_fault) result->fault = g_strdup(task_fault);
+    qemu_mutex_unlock(&task_lock);
+    return result;
+}
+
+FdisbullTaskReadInfo *qmp_x_fdisbull_task_layer_read(
+    const char *uuid, uint64_t cookie, uint64_t incarnation,
+    uint64_t address, uint16_t length, bool has_view,
+    FdisbullTaskLayerView view, Error **errp)
+{
+    if (!stopped_single_tcg(errp) ||
+        !task_key_validate(uuid, cookie, incarnation, errp)) return NULL;
+    if (!length || length > TASK_MAX_READ) {
+        task_error(errp, "read length must be 1..4096"); return NULL;
+    }
+    if (!has_view) view = FDISBULL_TASK_LAYER_VIEW_RAM;
+    lock_init(); qemu_mutex_lock(&task_lock);
+    int ti = find_task(uuid, cookie, incarnation);
+    if (ti < 0) { qemu_mutex_unlock(&task_lock); task_error(errp, "unknown task key"); return NULL; }
+    TaskState *task = &tasks[ti];
+    g_autofree char *hex = g_malloc(length * 2 + 1);
+    static const char digits[] = "0123456789abcdef";
+    for (unsigned i = 0; i < length; i++) {
+        uint8_t *base;
+        uint64_t backing, private_address;
+        if (address > UINT64_MAX - i ||
+            !direct_ram(address + i, 1, NULL, NULL, &backing, &base, errp)) {
+            qemu_mutex_unlock(&task_lock); return NULL;
+        }
+        uint8_t value = *base;
+        TaskPageState *page = find_page_by_backing(task, backing & ~(TASK_PAGE_SIZE - 1));
+        if (view != FDISBULL_TASK_LAYER_VIEW_BASE && page) {
+            private_address = slot_ram_addr(page->slot) + (backing & (TASK_PAGE_SIZE - 1));
+            value = *(arena_host + (private_address - arena_ram_addr));
+            if (view == FDISBULL_TASK_LAYER_VIEW_EXECUTE) {
+                uint8_t overlay;
+                if (byte_map_get(task->execute, private_address, &overlay)) value = overlay;
+            }
+        }
+        hex[i * 2] = digits[value >> 4]; hex[i * 2 + 1] = digits[value & 15];
+    }
+    hex[length * 2] = '\0';
+    FdisbullTaskReadInfo *result = g_new0(FdisbullTaskReadInfo, 1);
+    result->generation = task->generation;
+    result->data_hex = g_steal_pointer(&hex);
+    result->active = selected_task == ti;
+    qemu_mutex_unlock(&task_lock);
+    return result;
+}
+
+FdisbullTaskStatusInfo *qmp_x_fdisbull_task_layer_observe(
+    const char *uuid, uint64_t cookie, uint64_t incarnation, Error **errp)
+{
+    if (!stopped_single_tcg(errp) ||
+        !task_key_validate(uuid, cookie, incarnation, errp)) return NULL;
+    manager_init_empty(errp);
+    if (errp && *errp) return NULL;
+    lock_init(); qemu_mutex_lock(&task_lock);
+    if (find_task(uuid, cookie, incarnation) < 0) {
+        qemu_mutex_unlock(&task_lock);
+        task_error(errp, "task key is not registered");
+        return NULL;
+    }
+    FdisbullTaskStatusInfo *result = status_new(uuid, cookie, incarnation, errp);
+    qemu_mutex_unlock(&task_lock);
+    return result;
+}
+
+FdisbullTaskStatusInfo *qmp_x_fdisbull_task_retire(
+    const char *uuid, uint64_t cookie, uint64_t incarnation, Error **errp)
+{
+    if (!stopped_single_tcg(errp) ||
+        !task_key_validate(uuid, cookie, incarnation, errp)) return NULL;
+    lock_init(); qemu_mutex_lock(&task_lock);
+    int ti = find_task(uuid, cookie, incarnation);
+    if (ti < 0) { qemu_mutex_unlock(&task_lock); task_error(errp, "unknown task key"); return NULL; }
+    if (!generation_room(errp)) { qemu_mutex_unlock(&task_lock); return NULL; }
+    tasks[ti].retired = true;
+    if (selected_task == ti) selected_task = UINT8_MAX;
+    generation_highwater++;
+    CPUState *cpu; CPU_FOREACH(cpu) { tlb_flush(cpu); tb_flush(cpu); }
+    FdisbullTaskStatusInfo *result = status_new(uuid, cookie, incarnation, errp);
+    qemu_mutex_unlock(&task_lock);
+    return result;
+}
