+/*
+ * Cooperative per-task private RAM and instruction-fetch views.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "exec/address-spaces.h"
+#include "exec/cpu-common.h"
+#include "exec/cputlb.h"
+#include "exec/memory.h"
+#include "exec/tb-flush.h"
+#include "hw/core/cpu.h"
+#include "migration/vmstate.h"
+#include "qapi/qapi-commands-fdisbull-task-private.h"
+#include "qemu/uuid.h"
+#include "qemu/main-loop.h"
+#include "qemu/bswap.h"
+#include "qemu/cutils.h"
+#include "qemu/thread.h"
+#include "exec/cpu-interrupt.h"
+#include "target/i386/cpu.h"
+#include "system/cpus.h"
+#include "system/fdisbull-task-context.h"
+#include "system/fdisbull-task-private.h"
+#include "system/runstate.h"
+#include "system/tcg.h"
+
+#define TASK_MAX 16
+#define TASK_PAGES 16
+#define TASK_PAGE_SIZE 4096
+#define TASK_ARENA_SIZE (TASK_MAX * TASK_PAGES * TASK_PAGE_SIZE)
+#define TASK_MAX_EXEC_BYTES 65536
+#define TASK_MAX_PATCH_BYTES 65536
+#define TASK_MAX_READ 4096
+#define TASK_ANCHOR_SIZE 56
+#define TASK_PORT 0xf1db
+#define TASK_PORT_VALUE 0x4446
+
+typedef struct TaskPageState {
+    uint64_t guest_address;
+    uint64_t backing_page;
+    uint32_t slot;
+    bool used;
+} TaskPageState;
+
+typedef struct TaskState {
+    char uuid[37];
+    uint64_t cookie;
+    uint64_t incarnation;
+    uint64_t generation;
+    bool used;
+    bool retired;
+    uint8_t page_count;
+    TaskPageState pages[TASK_PAGES];
+    GHashTable *execute;
+    GHashTable *expected;
+} TaskState;
+
+typedef struct TaskExecState {
+    uint32_t private_offset;
+    uint8_t value;
+    uint8_t expected;
+} TaskExecState;
+
+typedef struct TaskMigrationState {
+    uint64_t anchor_address;
+    uint64_t sequence;
+    uint64_t epoch;
+    uint64_t generation;
+    uint8_t selected;
+    uint8_t task_used[TASK_MAX];
+    uint8_t task_retired[TASK_MAX];
+    uint8_t page_count[TASK_MAX];
+    uint8_t uuid[TASK_MAX * 37];
+    uint64_t cookie[TASK_MAX];
+    uint64_t incarnation[TASK_MAX];
+    uint64_t task_generation[TASK_MAX];
+    uint64_t page_guest[TASK_MAX * TASK_PAGES];
+    uint64_t page_backing[TASK_MAX * TASK_PAGES];
+    uint32_t page_slot[TASK_MAX * TASK_PAGES];
+    uint32_t exec_count;
+    uint32_t exec_offset[TASK_MAX_EXEC_BYTES];
+    uint8_t exec_task[TASK_MAX_EXEC_BYTES];
+    uint8_t exec_value[TASK_MAX_EXEC_BYTES];
+    uint8_t exec_expected[TASK_MAX_EXEC_BYTES];
+    bool overflow;
+    bool enabled;
+} TaskMigrationState;
+
+static TaskState tasks[TASK_MAX];
+static TaskMigrationState migration_state = { .selected = UINT8_MAX };
+static MemoryRegion task_arena;
+static MemoryRegion task_io;
+static uint8_t *arena_host;
+static uint64_t arena_ram_addr;
+static bool arena_ready;
+static bool io_ready;
+static bool vmstate_ready;
+static bool task_manager_ready;
+static bool monitor_enabled;
+static uint64_t epoch_highwater = 1;
+static uint64_t generation_highwater = 1;
+static uint8_t selected_task = UINT8_MAX;
+static gint pending_task = -1;
+static gint pending_fault;
+static char *task_fault;
+static QemuMutex task_lock;
+static gsize task_lock_initialized;
+
+static void lock_init(void)
+{
+    if (g_once_init_enter(&task_lock_initialized)) {
+        qemu_mutex_init(&task_lock);
+        g_once_init_leave(&task_lock_initialized, 1);
+    }
+}
+
+static void task_error(Error **errp, const char *why)
+{
+    error_setg(errp, "FDISBULL_TASK_PRECONDITION: %s", why);
+}
+
+static bool generation_room(Error **errp)
+{
+    if (generation_highwater >= UINT64_MAX - 2) {
+        task_error(errp, "task generation counter exhausted");
+        return false;
+    }
+    return true;
+}
+
+static GHashTable *byte_map_new(void)
+{
+    return g_hash_table_new_full(g_int64_hash, g_int64_equal, g_free, NULL);
+}
+
+static bool byte_map_put(GHashTable *map, uint64_t address, uint8_t value)
+{
+    uint64_t *key = g_new(uint64_t, 1);
+    *key = address;
+    g_hash_table_replace(map, key, GUINT_TO_POINTER((unsigned)value + 1));
+    return true;
+}
+
+static bool byte_map_get(GHashTable *map, uint64_t address, uint8_t *value)
+{
+    gpointer found = map ? g_hash_table_lookup(map, &address) : NULL;
+    if (!found) {
+        return false;
+    }
+    *value = GPOINTER_TO_UINT(found) - 1;
+    return true;
+}
+
+static uint8_t *slot_ptr(uint32_t slot)
+{
+    return arena_host + (size_t)slot * TASK_PAGE_SIZE;
+}
+
+static uint64_t slot_ram_addr(uint32_t slot)
+{
+    return arena_ram_addr + (uint64_t)slot * TASK_PAGE_SIZE;
+}
+
+static bool direct_ram(uint64_t physical, hwaddr size, MemoryRegion **mr_out,
+                       hwaddr *offset_out, uint64_t *backing_out,
+                       uint8_t **host_out, Error **errp)
+{
+    MemoryRegion *mr;
+    hwaddr offset, length = size;
+
+    if (physical > UINT32_MAX || size == 0 ||
+        physical > UINT64_MAX - size) {
+        task_error(errp, "address is outside bounded 32-bit physical RAM");
+        return false;
+    }
+    mr = address_space_translate(&address_space_memory, physical, &offset,
+                                 &length, true, MEMTXATTRS_UNSPECIFIED);
+    if (!mr || !memory_region_is_ram(mr) || memory_region_is_rom(mr) ||
+        memory_region_is_romd(mr) || mr->readonly || length < size ||
+        memory_region_has_ram_discard_manager(mr)) {
+        task_error(errp, "address does not resolve to direct writable RAM");
+        return false;
+    }
+    if (mr_out) {
+        *mr_out = mr;
+    }
+    if (offset_out) {
+        *offset_out = offset;
+    }
+    if (backing_out) {
+        *backing_out = memory_region_get_ram_addr(mr) + offset;
+    }
+    if (host_out) {
+        *host_out = memory_region_get_ram_ptr(mr) + offset;
+    }
+    return true;
+}
+
+static bool stopped_single_tcg(Error **errp)
+{
+    CPUState *cpu;
+    unsigned count = 0;
+    if (!tcg_enabled() || (runstate_get() != RUN_STATE_PAUSED &&
+                           runstate_get() != RUN_STATE_DEBUG &&
+                           runstate_get() != RUN_STATE_PRELAUNCH)) {
+        task_error(errp, "requires stopped system-mode TCG");
+        return false;
+    }
+    CPU_FOREACH(cpu) {
+        if (++count > 1 || !cpu->stopped) {
+            task_error(errp, "requires one stopped vCPU");
+            return false;
+        }
+    }
+    if (count != 1) {
+        task_error(errp, "requires one stopped vCPU");
+        return false;
+    }
+    return true;
+}
+
+static void register_vmstate(void);
+static void manager_init_empty(Error **errp)
+{
+    g_autoptr(Error) local_err = NULL;
+    if (task_manager_ready) {
+        return;
+    }
+    if (!arena_ready) {
+        if (!memory_region_init_ram(&task_arena, NULL,
+                                    "fdisbull-task-private-ram",
+                                    TASK_ARENA_SIZE, &local_err)) {
+            error_propagate(errp, local_err);
+            return;
+        }
+        arena_host = memory_region_get_ram_ptr(&task_arena);
+        arena_ram_addr = memory_region_get_ram_addr(&task_arena);
+        memset(arena_host, 0, TASK_ARENA_SIZE);
+        arena_ready = true;
+    }
+    lock_init();
+    if (!vmstate_ready) {
+        register_vmstate();
+        vmstate_ready = true;
+    }
+    task_manager_ready = true;
+}
+
+static int find_task(const char *uuid, uint64_t cookie, uint64_t incarnation)
+{
+    for (int i = 0; i < TASK_MAX; i++) {
+        if (tasks[i].used && tasks[i].cookie == cookie &&
+            tasks[i].incarnation == incarnation &&
+            !strcmp(tasks[i].uuid, uuid)) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static gint uint64_compare(gconstpointer a, gconstpointer b)
+{
+    uint64_t x = *(const uint64_t *)a;
+    uint64_t y = *(const uint64_t *)b;
+    return x < y ? -1 : x > y;
+}
+
+static int find_free_task(void)
+{
+    for (int i = 0; i < TASK_MAX; i++) {
+        if (!tasks[i].used) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static TaskPageState *find_page_by_backing(TaskState *task,
+                                            uint64_t backing_page)
+{
+    for (unsigned i = 0; i < task->page_count; i++) {
+        if (task->pages[i].backing_page == backing_page) {
+            return &task->pages[i];
+        }
+    }
+    return NULL;
+}
+
+static bool task_has_backing_page(TaskState *task, uint64_t backing)
+{
+    return find_page_by_backing(task, backing & ~(TASK_PAGE_SIZE - 1)) != NULL;
+}
+
+static bool physical_backing_page(uint64_t physical, uint64_t *backing)
+{
+    if (!direct_ram(physical & ~(TASK_PAGE_SIZE - 1), TASK_PAGE_SIZE,
+                    NULL, NULL, backing, NULL, NULL)) {
+        return false;
+    }
+    *backing &= ~(TASK_PAGE_SIZE - 1);
+    return true;
+}
+
+/* This release supports nonpaged memory and legacy non-PAE paging. Private
+ * pages may not alias the active page directory or any present page table. */
+static bool task_paging_guard(CPUState *cpu, TaskState *task, Error **errp)
+{
+    CPUX86State *env = &X86_CPU(cpu)->env;
+    uint8_t entry[4];
+    uint64_t directory, backing;
+    if (!(env->cr[0] & CR0_PG_MASK) || !task->page_count) {
+        return true;
+    }
+    if (env->cr[4] & CR4_PAE_MASK) {
+        task_error(errp, "task-private RAM with PAE page tables is unsupported");
+        return false;
+    }
+    directory = env->cr[3] & ~(uint64_t)(TASK_PAGE_SIZE - 1);
+    if (!physical_backing_page(directory, &backing)) {
+        task_error(errp, "active page directory is not direct RAM");
+        return false;
+    }
+    if (task_has_backing_page(task, backing)) {
+        task_error(errp, "private task page aliases the active page directory");
+        return false;
+    }
+    for (unsigned i = 0; i < 1024; i++) {
+        uint64_t pde_address = directory + i * sizeof(uint32_t);
+        if (address_space_read(&address_space_memory, pde_address,
+                               MEMTXATTRS_UNSPECIFIED, entry,
+                               sizeof(entry)) != MEMTX_OK) {
+            task_error(errp, "active page directory cannot be read as RAM");
+            return false;
+        }
+        uint32_t pde = ldl_le_p(entry);
+        if (!(pde & PG_PRESENT_MASK) ||
+            ((pde & PG_PSE_MASK) && (env->cr[4] & CR4_PSE_MASK))) {
+            continue;
+        }
+        uint64_t table = pde & ~(uint64_t)(TASK_PAGE_SIZE - 1);
+        if (!physical_backing_page(table, &backing)) {
+            task_error(errp, "active page table is not direct RAM");
+            return false;
+        }
+        if (task_has_backing_page(task, backing)) {
+            task_error(errp, "private task page aliases an active page table");
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool task_key_validate(const char *uuid, uint64_t cookie,
+                              uint64_t incarnation, Error **errp)
+{
+    if (!uuid || strnlen(uuid, 33) != 32 || !cookie || !incarnation) {
+        task_error(errp, "task key needs 32 lowercase UUID hex digits and nonzero cookie/incarnation");
+        return false;
+    }
+    for (unsigned i = 0; i < 32; i++) {
+        if (!g_ascii_isxdigit(uuid[i]) || g_ascii_isupper(uuid[i])) {
+            task_error(errp, "task monitor UUID must be lowercase hex");
+            return false;
+        }
+    }
+    return true;
+}
+
+static char *uuid_bytes_hex(const uint8_t *bytes)
+{
+    static const char digits[] = "0123456789abcdef";
+    char *text = g_malloc(33);
+    for (unsigned i = 0; i < 16; i++) {
+        text[i * 2] = digits[bytes[i] >> 4];
+        text[i * 2 + 1] = digits[bytes[i] & 15];
+    }
+    text[32] = '\0';
+    return text;
+}
+
+static bool read_anchor(char **uuid_out, uint64_t *sequence,
+                        uint64_t *cookie, uint64_t *incarnation,
+                        Error **errp)
+{
+    uint8_t *host;
+    if (!migration_state.anchor_address ||
+        !direct_ram(migration_state.anchor_address, TASK_ANCHOR_SIZE,
+                    NULL, NULL, NULL, &host, errp)) {
+        return false;
+    }
+    if (memcmp(host, "FDBTASK1", 8) || ldl_le_p(host + 48) != 1 ||
+        ldl_le_p(host + 52) != 0) {
+        task_error(errp, "anchor format, active state, or reserved field is invalid");
+        return false;
+    }
+    *sequence = ldq_le_p(host + 24);
+    *cookie = ldq_le_p(host + 32);
+    *incarnation = ldq_le_p(host + 40);
+    if ((*sequence & 1) || !*cookie || !*incarnation) {
+        task_error(errp, "anchor is not an even, active task lifetime");
+        return false;
+    }
+    *uuid_out = uuid_bytes_hex(host + 8);
+    return true;
+}
+
+static FdisbullTaskPageInfo *page_info_new(TaskPageState *page)
+{
+    FdisbullTaskPageInfo *info = g_new0(FdisbullTaskPageInfo, 1);
+    info->address = page->guest_address;
+    info->backing = page->backing_page;
+    info->sha256 = g_compute_checksum_for_data(G_CHECKSUM_SHA256,
+                                               slot_ptr(page->slot),
+                                               TASK_PAGE_SIZE);
+    return info;
+}
+
+static char *task_exec_digest(TaskState *task)
+{
+    GArray *items = g_array_new(FALSE, FALSE, sizeof(uint64_t));
+    GChecksum *sum = g_checksum_new(G_CHECKSUM_SHA256);
+    GHashTableIter iter;
+    gpointer key, value;
+    g_hash_table_iter_init(&iter, task->execute);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        uint64_t address = *(uint64_t *)key;
+        g_array_append_val(items, address);
+    }
+    g_array_sort(items, uint64_compare);
+    for (guint i = 0; i < items->len; i++) {
+        uint64_t address = g_array_index(items, uint64_t, i);
+        uint8_t value_byte = 0, expected_byte = 0;
+        byte_map_get(task->execute, address, &value_byte);
+        byte_map_get(task->expected, address, &expected_byte);
+        g_checksum_update(sum, (const guchar *)&address, sizeof(address));
+        g_checksum_update(sum, &value_byte, 1);
+        g_checksum_update(sum, &expected_byte, 1);
+    }
+    char *digest = g_strdup(g_checksum_get_string(sum));
+    g_checksum_free(sum);
+    g_array_unref(items);
+    return digest;
+}
+
+static FdisbullTaskStatusInfo *status_new(const char *uuid, uint64_t cookie,
+                                           uint64_t incarnation,
+                                           Error **errp)
+{
+    FdisbullTaskStatusInfo *result = g_new0(FdisbullTaskStatusInfo, 1);
+    uint64_t epoch, ignored_generation;
+    if (!fdisbull_task_context_get_counters(&epoch, &ignored_generation, errp)) {
+        g_free(result);
+        return NULL;
+    }
+    result->model = g_strdup("qemu-pc-task-private-v1");
+    result->api_version = 1;
+    result->epoch = epoch;
+    result->generation = generation_highwater;
+    result->uuid = g_strdup(uuid);
+    result->cookie = cookie;
+    result->incarnation = incarnation;
+    result->selected = false;
+    result->selected_uuid = g_strdup("");
+    result->selected_cookie = 0;
+    result->selected_incarnation = 0;
+    result->sequence = migration_state.sequence;
+    result->pending = g_atomic_int_get(&pending_task) >= 0;
+    if (task_fault) {
+        result->fault = g_strdup(task_fault);
+    }
+    int requested = find_task(uuid, cookie, incarnation);
+    if (requested >= 0) {
+        result->task_generation = tasks[requested].generation;
+        result->selected = selected_task == requested;
+    }
+    if (selected_task < TASK_MAX && tasks[selected_task].used) {
+        g_free(result->selected_uuid);
+        result->selected_uuid = g_strdup(tasks[selected_task].uuid);
+        result->selected_cookie = tasks[selected_task].cookie;
+        result->selected_incarnation = tasks[selected_task].incarnation;
+    }
+    FdisbullTaskInfoList **tail = &result->tasks;
+    for (int ti = 0; ti < TASK_MAX; ti++) {
+        TaskState *task = &tasks[ti];
+        if (!task->used) {
+            continue;
+        }
+        FdisbullTaskInfo *info = g_new0(FdisbullTaskInfo, 1);
+        info->uuid = g_strdup(task->uuid);
+        info->cookie = task->cookie;
+        info->incarnation = task->incarnation;
+        info->generation = task->generation;
+        info->retired = task->retired;
+        info->execution_bytes = g_hash_table_size(task->execute);
+        info->execution_sha256 = task_exec_digest(task);
+        FdisbullTaskPageInfoList **ptail = &info->pages;
+        for (unsigned pi = 0; pi < task->page_count; pi++) {
+            FdisbullTaskPageInfoList *node = g_new0(FdisbullTaskPageInfoList, 1);
+            node->value = page_info_new(&task->pages[pi]);
+            *ptail = node;
+            ptail = &node->next;
+        }
+        FdisbullTaskInfoList *node = g_new0(FdisbullTaskInfoList, 1);
+        node->value = info;
+        *tail = node;
+        tail = &node->next;
+    }
+    return result;
+}
+
+static void clear_task(TaskState *task)
+{
+    g_clear_pointer(&task->execute, g_hash_table_unref);
+    g_clear_pointer(&task->expected, g_hash_table_unref);
+    memset(task, 0, sizeof(*task));
+}
+
+static int migration_pre_save(void *opaque)
+{
+    TaskMigrationState *state = opaque;
+    if (g_atomic_int_get(&pending_task) >= 0 || g_atomic_int_get(&pending_fault)) {
+        return -EBUSY;
+    }
+    memset(state->task_used, 0, sizeof(state->task_used));
+    memset(state->task_retired, 0, sizeof(state->task_retired));
+    state->exec_count = 0;
+    state->selected = selected_task;
+    state->epoch = epoch_highwater;
+    state->generation = generation_highwater;
+    state->enabled = monitor_enabled;
+    for (int ti = 0; ti < TASK_MAX; ti++) {
+        TaskState *task = &tasks[ti];
+        state->task_used[ti] = task->used;
+        state->task_retired[ti] = task->retired;
+        state->page_count[ti] = task->page_count;
+        if (!task->used) {
+            continue;
+        }
+        pstrcpy((char *)&state->uuid[ti * 37], 37, task->uuid);
+        state->cookie[ti] = task->cookie;
+        state->incarnation[ti] = task->incarnation;
+        state->task_generation[ti] = task->generation;
+        for (unsigned pi = 0; pi < task->page_count; pi++) {
+            unsigned pidx = ti * TASK_PAGES + pi;
+            state->page_guest[pidx] = task->pages[pi].guest_address;
+            state->page_backing[pidx] = task->pages[pi].backing_page;
+            state->page_slot[pidx] = task->pages[pi].slot;
+        }
+        GHashTableIter iter;
+        gpointer key, value;
+        g_hash_table_iter_init(&iter, task->execute);
+        while (g_hash_table_iter_next(&iter, &key, &value)) {
+            if (state->exec_count >= TASK_MAX_EXEC_BYTES) {
+                return -ENOSPC;
+            }
+            uint32_t n = state->exec_count++;
+            uint64_t address = *(uint64_t *)key;
+            uint8_t expected;
+            state->exec_task[n] = ti;
+            state->exec_offset[n] = address - arena_ram_addr;
+            state->exec_value[n] = GPOINTER_TO_UINT(value) - 1;
+            if (!byte_map_get(task->expected, address, &expected)) {
+                return -EINVAL;
+            }
+            state->exec_expected[n] = expected;
+        }
+    }
+    return 0;
+}
+
+static int migration_post_load(void *opaque, int version_id)
+{
+    TaskMigrationState *state = opaque;
+    if (state->overflow || !state->epoch || !state->generation ||
+        state->epoch == UINT64_MAX || state->generation == UINT64_MAX ||
+        (state->selected >= TASK_MAX && state->selected != UINT8_MAX) ||
+        state->exec_count > TASK_MAX_EXEC_BYTES) {
+        return -EINVAL;
+    }
+    TaskState restored[TASK_MAX] = {0};
+    bool slots[TASK_MAX * TASK_PAGES] = {0};
+    if (epoch_highwater == UINT64_MAX || generation_highwater == UINT64_MAX) {
+        return -EINVAL;
+    }
+    for (int i = 0; i < TASK_MAX; i++) {
+        if (!state->task_used[i]) {
+            if (state->page_count[i] || state->task_retired[i]) return -EINVAL;
+            continue;
+        }
+        if (state->task_retired[i] > 1) return -EINVAL;
+        if (state->page_count[i] > TASK_PAGES ||
+            !state->cookie[i] || !state->incarnation[i] ||
+            strnlen((char *)&state->uuid[i * 37], 37) != 32) {
+            return -EINVAL;
+        }
+        const char *uuid = (char *)&state->uuid[i * 37];
+        for (unsigned c = 0; c < 32; c++) {
+            if (!g_ascii_isdigit(uuid[c]) && (uuid[c] < 'a' || uuid[c] > 'f')) return -EINVAL;
+        }
+        for (int j = 0; j < i; j++) {
+            if (restored[j].used && !strcmp(restored[j].uuid, uuid) &&
+                restored[j].cookie == state->cookie[i] &&
+                restored[j].incarnation == state->incarnation[i]) return -EINVAL;
+            if (restored[j].used && !strcmp(restored[j].uuid, uuid) &&
+                restored[j].cookie == state->cookie[i] &&
+                !restored[j].retired && !state->task_retired[i]) return -EINVAL;
+        }
+        TaskState *task = &restored[i];
+        task->used = true;
+        task->retired = state->task_retired[i];
+        pstrcpy(task->uuid, sizeof(task->uuid),
+                (char *)&state->uuid[i * 37]);
+        task->cookie = state->cookie[i];
+        task->incarnation = state->incarnation[i];
+        task->generation = state->task_generation[i];
+        task->page_count = state->page_count[i];
+        task->execute = byte_map_new();
+        task->expected = byte_map_new();
+        for (unsigned p = 0; p < task->page_count; p++) {
+            unsigned pidx = i * TASK_PAGES + p;
+            uint32_t slot = state->page_slot[pidx];
+            if (slot >= TASK_MAX * TASK_PAGES ||
+                slots[slot] ||
+                (state->page_guest[pidx] & (TASK_PAGE_SIZE - 1)) ||
+                (state->page_backing[pidx] & (TASK_PAGE_SIZE - 1))) {
+                return -EINVAL;
+            }
+            slots[slot] = true;
+            for (unsigned q = 0; q < p; q++) {
+                if (task->pages[q].guest_address == state->page_guest[pidx] ||
+                    task->pages[q].backing_page == state->page_backing[pidx]) return -EINVAL;
+            }
+            uint64_t actual_backing;
+            if (!physical_backing_page(state->page_guest[pidx], &actual_backing) ||
+                actual_backing != state->page_backing[pidx]) return -EINVAL;
+            task->pages[p] = (TaskPageState) {
+                .guest_address = state->page_guest[pidx],
+                .backing_page = state->page_backing[pidx],
+                .slot = slot,
+                .used = true,
+            };
+        }
+    }
+    for (uint32_t n = 0; n < state->exec_count; n++) {
+        unsigned ti = state->exec_task[n];
+        uint32_t offset = state->exec_offset[n];
+        if (ti >= TASK_MAX || !restored[ti].used ||
+            offset >= TASK_ARENA_SIZE || (offset >> 12) >= TASK_MAX * TASK_PAGES) {
+            return -EINVAL;
+        }
+        uint64_t address = arena_ram_addr + offset;
+        bool owned = false;
+        for (unsigned p = 0; p < restored[ti].page_count; p++) {
+            owned |= restored[ti].pages[p].slot == (offset >> 12);
+        }
+        if (!owned || byte_map_get(restored[ti].execute, address, &(uint8_t){0})) return -EINVAL;
+        byte_map_put(restored[ti].execute, address, state->exec_value[n]);
+        byte_map_put(restored[ti].expected, address, state->exec_expected[n]);
+    }
+    if (state->selected < TASK_MAX &&
+        (!restored[state->selected].used || restored[state->selected].retired)) {
+        return -EINVAL;
+    }
+    if (state->selected == UINT8_MAX && state->enabled) return -EINVAL;
+    for (int i = 0; i < TASK_MAX; i++) clear_task(&tasks[i]);
+    memcpy(tasks, restored, sizeof(tasks));
+    selected_task = state->selected;
+    monitor_enabled = state->enabled;
+    migration_state.anchor_address = state->anchor_address;
+    migration_state.sequence = state->sequence;
+    epoch_highwater = MAX(epoch_highwater, state->epoch) + 1;
+    generation_highwater = MAX(generation_highwater, state->generation) + 1;
+    state->epoch = epoch_highwater;
+    state->generation = generation_highwater;
+    g_clear_pointer(&task_fault, g_free);
+    g_atomic_int_set(&pending_task, -1);
+    g_atomic_int_set(&pending_fault, 0);
+    CPUState *cpu;
+    CPU_FOREACH(cpu) {
+        tlb_flush(cpu);
+        tb_flush(cpu);
+    }
+    return 0;
+}
+
+static const VMStateDescription vmstate_fdisbull_task_private = {
+    .name = "fdisbull/task-private",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .pre_save = migration_pre_save,
+    .post_load = migration_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT64(anchor_address, TaskMigrationState),
+        VMSTATE_UINT64(sequence, TaskMigrationState),
+        VMSTATE_UINT64(epoch, TaskMigrationState),
+        VMSTATE_UINT64(generation, TaskMigrationState),
+        VMSTATE_UINT8(selected, TaskMigrationState),
+        VMSTATE_UINT8_ARRAY(task_used, TaskMigrationState, TASK_MAX),
+        VMSTATE_UINT8_ARRAY(task_retired, TaskMigrationState, TASK_MAX),
+        VMSTATE_UINT8_ARRAY(page_count, TaskMigrationState, TASK_MAX),
+        VMSTATE_UINT8_ARRAY(uuid, TaskMigrationState, TASK_MAX * 37),
+        VMSTATE_UINT64_ARRAY(cookie, TaskMigrationState, TASK_MAX),
+        VMSTATE_UINT64_ARRAY(incarnation, TaskMigrationState, TASK_MAX),
+        VMSTATE_UINT64_ARRAY(task_generation, TaskMigrationState, TASK_MAX),
+        VMSTATE_UINT64_ARRAY(page_guest, TaskMigrationState, TASK_MAX * TASK_PAGES),
+        VMSTATE_UINT64_ARRAY(page_backing, TaskMigrationState, TASK_MAX * TASK_PAGES),
+        VMSTATE_UINT32_ARRAY(page_slot, TaskMigrationState, TASK_MAX * TASK_PAGES),
+        VMSTATE_UINT32(exec_count, TaskMigrationState),
+        VMSTATE_UINT32_ARRAY(exec_offset, TaskMigrationState, TASK_MAX_EXEC_BYTES),
+        VMSTATE_UINT8_ARRAY(exec_task, TaskMigrationState, TASK_MAX_EXEC_BYTES),
+        VMSTATE_UINT8_ARRAY(exec_value, TaskMigrationState, TASK_MAX_EXEC_BYTES),
+        VMSTATE_UINT8_ARRAY(exec_expected, TaskMigrationState, TASK_MAX_EXEC_BYTES),
