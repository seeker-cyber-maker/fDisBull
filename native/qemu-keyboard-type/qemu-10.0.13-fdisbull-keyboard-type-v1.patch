+/* Match the retained physical US-layout text mapping, without guest inference. */
+static bool input_type_key(unsigned char ch, QKeyCode *key, bool *shift)
+{
+    static const QKeyCode letters[] = {
+        Q_KEY_CODE_A, Q_KEY_CODE_B, Q_KEY_CODE_C, Q_KEY_CODE_D,
+        Q_KEY_CODE_E, Q_KEY_CODE_F, Q_KEY_CODE_G, Q_KEY_CODE_H,
+        Q_KEY_CODE_I, Q_KEY_CODE_J, Q_KEY_CODE_K, Q_KEY_CODE_L,
+        Q_KEY_CODE_M, Q_KEY_CODE_N, Q_KEY_CODE_O, Q_KEY_CODE_P,
+        Q_KEY_CODE_Q, Q_KEY_CODE_R, Q_KEY_CODE_S, Q_KEY_CODE_T,
+        Q_KEY_CODE_U, Q_KEY_CODE_V, Q_KEY_CODE_W, Q_KEY_CODE_X,
+        Q_KEY_CODE_Y, Q_KEY_CODE_Z,
+    };
+    static const QKeyCode digits[] = {
+        Q_KEY_CODE_0, Q_KEY_CODE_1, Q_KEY_CODE_2, Q_KEY_CODE_3,
+        Q_KEY_CODE_4, Q_KEY_CODE_5, Q_KEY_CODE_6, Q_KEY_CODE_7,
+        Q_KEY_CODE_8, Q_KEY_CODE_9,
+    };
+    static const char shifted[] = "!@#$%^&*()_+{}|:\"<>?~";
+    static const char unshifted[] = "1234567890-=[]\\;',./`";
+    const char *found;
+
+    G_STATIC_ASSERT(sizeof(shifted) == sizeof(unshifted));
+    if (!((ch >= ' ' && ch <= '~') || ch == '\r' || ch == '\n' ||
+          ch == '\t')) {
+        return false;
+    }
+    *shift = false;
+    if (ch >= 'A' && ch <= 'Z') {
+        ch += 'a' - 'A';
+        *shift = true;
+    } else if ((found = strchr(shifted, ch))) {
+        ch = unshifted[found - shifted];
+        *shift = true;
+    }
+    if (ch >= 'a' && ch <= 'z') {
+        *key = letters[ch - 'a'];
+        return true;
+    }
+    if (ch >= '0' && ch <= '9') {
+        *key = digits[ch - '0'];
+        return true;
+    }
+    switch (ch) {
+    case ' ':  *key = Q_KEY_CODE_SPC; break;
+    case '\r':
+    case '\n': *key = Q_KEY_CODE_RET; break;
+    case '\t': *key = Q_KEY_CODE_TAB; break;
+    case '-':  *key = Q_KEY_CODE_MINUS; break;
+    case '=':  *key = Q_KEY_CODE_EQUAL; break;
+    case '[':  *key = Q_KEY_CODE_BRACKET_LEFT; break;
+    case ']':  *key = Q_KEY_CODE_BRACKET_RIGHT; break;
+    case ';':  *key = Q_KEY_CODE_SEMICOLON; break;
+    case '\'': *key = Q_KEY_CODE_APOSTROPHE; break;
+    case '`':  *key = Q_KEY_CODE_GRAVE_ACCENT; break;
+    case '\\': *key = Q_KEY_CODE_BACKSLASH; break;
+    case ',':  *key = Q_KEY_CODE_COMMA; break;
+    case '.':  *key = Q_KEY_CODE_DOT; break;
+    case '/':  *key = Q_KEY_CODE_SLASH; break;
+    default: return false;
+    }
+    return true;
+}
+
+FdisbullInputInfo *qmp_x_fdisbull_arm_keyboard_type(
+    const char *token, const char *text, int64_t hold_ms, int64_t gap_ms,
+    Error **errp)
+{
+    g_autoptr(FdisbullInputType) typing = NULL;
+    FdisbullInputBatch *batches[INPUT_MAX_TYPE_STEPS] = { 0 };
+    FdisbullInputPressStepList **tail;
+    QKeyCode keys[INPUT_MAX_TYPE_CHARS];
+    bool shifts[INPUT_MAX_TYPE_CHARS];
+    size_t length;
+    unsigned count = 0, i, edge;
+    int64_t now, horizon = 0;
+
+    if (!input_arm_guard(token, errp)) {
+        return NULL;
+    }
+    if (hold_ms < 1 || hold_ms > 1000 || gap_ms < 1 || gap_ms > 1000) {
+        error_setg(errp, "Keyboard type hold-ms and gap-ms must be 1..1000");
+        return NULL;
+    }
+    length = strnlen(text, INPUT_MAX_TYPE_CHARS + 1);
+    if (!length || length > INPUT_MAX_TYPE_CHARS) {
+        error_setg(errp, "Keyboard type requires 1..64 US-layout ASCII characters");
+        return NULL;
+    }
+    /* Validate all characters before preparing devices or publishing a plan. */
+    for (i = 0; i < length; i++) {
+        if (!input_type_key((unsigned char)text[i], &keys[i], &shifts[i])) {
+            error_setg(errp, "Keyboard type supports printable US-layout ASCII, "
+                       "Enter and Tab only");
+            return NULL;
+        }
+        horizon += (shifts[i] ? 3 : 1) * INPUT_PRESS_EDGE_DELAY_NS +
+                   hold_ms * SCALE_MS + (i ? gap_ms * SCALE_MS : 0);
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (now < 0 || now > INT64_MAX - horizon) {
+        error_setg(errp, "Keyboard type nominal horizon exceeds signed time");
+        return NULL;
+    }
+    typing = g_new0(FdisbullInputType, 1);
+    typing->text = g_strdup(text);
+    typing->hold_ms = hold_ms;
+    typing->gap_ms = gap_ms;
+    tail = &typing->steps;
+    for (i = 0; i < length; i++) {
+        unsigned main_make = shifts[i] ? 1 : 0;
+        unsigned edges = shifts[i] ? 4 : 2;
+
+        for (edge = 0; edge < edges; edge++) {
+            FdisbullInputPressStepList *node =
+                g_new0(FdisbullInputPressStepList, 1);
+            FdisbullInputPressStep *step = g_new0(FdisbullInputPressStep, 1);
+
+            *tail = node;
+            node->value = step;
+            tail = &node->next;
+            step->key = edge == main_make || edge == main_make + 1 ?
+                        keys[i] : Q_KEY_CODE_SHIFT;
+            step->down = edge <= main_make;
+            step->delay_ns = edge == main_make + 1 ? hold_ms * SCALE_MS :
+                                                   INPUT_PRESS_EDGE_DELAY_NS;
+            if (i && edge == 0) {
+                step->delay_ns += gap_ms * SCALE_MS;
+            }
+            if (count == 0) {
+                step->has_deadline_ns = true;
+                step->deadline_ns = now + step->delay_ns;
+            }
+            batches[count] = input_keyboard_prepare_step(step->key,
+                                                         step->down, errp);
+            if (!batches[count]) {
+                goto fail;
+            }
+            count++;
+        }
+    }
+    if (!input_block_migration(errp)) {
+        goto fail;
+    }
+
+    input_schedule.batch = NULL;
+    g_clear_pointer(&input_schedule.retrace, qapi_free_FdisbullInputRetrace);
+    input_keyboard_free_batches();
+    g_clear_pointer(&input_schedule.press, qapi_free_FdisbullInputPress);
+    qapi_free_FdisbullInputType(input_schedule.typing);
+    input_schedule.typing = g_steal_pointer(&typing);
+    input_schedule.keyboard_next = input_schedule.typing->steps;
+    for (i = 0; i < count; i++) {
+        input_schedule.keyboard_batches[i] = batches[i];
+        batches[i] = NULL;
+    }
+    input_arm_commit(token, now,
+                     input_schedule.keyboard_next->value->deadline_ns, count);
+    return input_info();
+
+fail:
+    for (i = 0; i < INPUT_MAX_TYPE_STEPS; i++) {
+        qemu_input_fdisbull_free(batches[i]);
+    }
+    return NULL;
+}
+
 FdisbullInputInfo *qmp_x_fdisbull_cancel_input(const char *token, Error **errp)
 {
     if (!input_guard(errp)) {
