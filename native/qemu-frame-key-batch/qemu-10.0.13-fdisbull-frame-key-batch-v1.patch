+# @FdisbullFrameKeyBatchReason:
+#
+# Complete typed no-commit reasons for a stopped keyboard batch.
+#
+# @invalid-edges: The bounded request is not a set of real transitions.
+# @unsupported-profile: Scan-code or translation profile is unsupported.
+# @unsupported-qcode: A QCode lacks an admitted exact encoding.
+# @device-busy: Keyboard/controller command, FIFO, IRQ or timer state is busy.
+# @insufficient-space: The complete encoded stream exceeds the protocol FIFO.
+# @stale-state: Expected owner, epoch, generation or digest changed.
+# @ownership-conflict: Foreign holds or inconsistent modifier ownership exist.
+# @counter-exhausted: Generation or accepted-edge counter would overflow.
+# @migration-blocked: Migration blocker admission failed before commit.
+#
+# Since: 10.0
+##
+{ 'enum': 'FdisbullFrameKeyBatchReason',
+  'data': [ 'invalid-edges', 'unsupported-profile', 'unsupported-qcode',
+            'device-busy', 'insufficient-space', 'stale-state',
+            'ownership-conflict', 'counter-exhausted', 'migration-blocked' ] }
+
+##
+# @FdisbullFrameKeyBatchPlanOutcome:
+#
+# @ready: Exact stream fits; this is not a reservation.
