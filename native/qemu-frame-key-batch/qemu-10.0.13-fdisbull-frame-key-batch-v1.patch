+# @expected-generation: Exact supplied owner generation.
+# @expected-state-sha256: Exact supplied selected-device state digest.
+# @expected-batch-sha256: Exact supplied ordered batch digest.
+# @edges: Exact supplied ordered bounded request.
+# @before: Actual proof immediately before this attempt.
+# @after: Actual post-IRQ proof if accepted; exact before proof if refused.
+#
+# Since: 10.0
+##
+{ 'union': 'FdisbullFrameKeyBatchApply',
+  'base': { 'api-version': 'uint64', 'outcome': 'FdisbullFrameKeyBatchApplyOutcome',
+            'token': 'str', 'expected-epoch': 'uint64', 'expected-generation': 'uint64',
+            'expected-state-sha256': 'str', 'expected-batch-sha256': 'str',
+            'edges': ['FdisbullFrameKeyEdge'],
+            'before': 'FdisbullFrameKeysInfo', 'after': 'FdisbullFrameKeysInfo' },
+  'discriminator': 'outcome',
+  'data': { 'accepted': 'FdisbullFrameKeyBatchAccepted',
+            'refused': 'FdisbullFrameKeyBatchApplyRefused' } }
+
+##
