+# set2 are supported. This selected-device proof is not a whole-machine revision.
+#
+# @edges: 1..32 distinct ordered transitions; at most64 resulting held keys.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-plan-frame-key-batch',
+  'data': { 'edges': ['FdisbullFrameKeyEdge'] },
+  'returns': 'FdisbullFrameKeyBatchPlan' }
+
+##
+# @FdisbullFrameKeyBatchApplyOutcome:
+#
+# @accepted: The complete queue/owner afterimage was committed once.
+# @refused: No commit began; before and after are the same current proof.
+#
+# Since: 10.0
+##
+{ 'enum': 'FdisbullFrameKeyBatchApplyOutcome', 'data': [ 'accepted', 'refused' ] }
+
+##
+# @FdisbullFrameKeyBatchAccepted:
+#
+# @encoded-byte-count: Number of accepted scan-code bytes; guest consumption unknown.
+# @accepted-edge-count: Number of explicit transitions, including zero-byte release.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullFrameKeyBatchAccepted',
+  'data': { 'encoded-byte-count': 'uint64', 'accepted-edge-count': 'uint64' } }
+
+##
+# @FdisbullFrameKeyBatchApplyRefused:
+#
+# @reason: Exact no-commit reason. Stale proof does not establish host continuity.
+#
+# Since: 10.0
