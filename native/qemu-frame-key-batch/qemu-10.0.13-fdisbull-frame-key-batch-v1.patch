+typedef struct PS2FrameKeySink {
+    PS2FrameKeyEncoding *encoding;
+    bool translated;
+    bool overflow;
+    unsigned raw_count;
+} PS2FrameKeySink;
+
+static void ps2_frame_key_byte(void *opaque, int value)
+{
+    PS2FrameKeySink *sink = opaque;
+    PS2FrameKeyEncoding *encoding = sink->encoding;
+
+    if (++sink->raw_count > 8 || value < 0 || value > 255) {
+        sink->overflow = true;
+        return;
+    }
+    if (sink->translated) {
+        if (value == 0xf0) {
+            encoding->need_high_bit = true;
+            return;
+        }
+        value = translate_table[value] |
+                (encoding->need_high_bit ? 0x80 : 0);
+        encoding->need_high_bit = false;
+    }
+    if (encoding->count >= PS2_FRAME_KEY_BYTES) {
+        sink->overflow = true;
+        return;
+    }
+    encoding->bytes[encoding->count++] = value;
+}
+
+bool ps2_keyboard_frame_encode(unsigned scancode_set, bool translated,
+                               QKeyCode key, bool pressed,
+                               PS2FrameKeyEncoding *encoding)
+{
+    PS2FrameKeyEncoding next = *encoding;
+    PS2FrameKeySink sink = { .encoding = &next, .translated = translated };
+    unsigned modifier;
+
+    if ((scancode_set != 1 && scancode_set != 2) ||
+        (translated && scancode_set != 2) ||
+        (unsigned)key >= Q_KEY_CODE__MAX || key == Q_KEY_CODE_UNMAPPED) {
+        return false;
+    }
+    modifier = ps2_modifier_bit(key);
+    if (pressed) {
+        next.modifiers |= modifier;
+    } else {
+        next.modifiers &= ~modifier;
+    }
+    if (!ps2_encode_keycode(scancode_set, next.modifiers, key, pressed,
+                            ps2_frame_key_byte, &sink) || sink.overflow) {
+        return false;
+    }
+    *encoding = next;
+    return true;
+}
+
+void ps2_keyboard_frame_notify(PS2KbdState *s)
+{
+    ps2_raise_irq(PS2_DEVICE(s));
+}
+
+static void ps2_keyboard_event(DeviceState *dev, QemuConsole *src,
+                               InputEvent *evt)
+{
+    PS2KbdState *s = (PS2KbdState *)dev;
+    InputKeyEvent *key = evt->u.key.data;
+    int qcode;
+    int mod;
+
+    /* do not process events while disabled to prevent stream corruption */
+    if (!s->scan_enabled) {
+        return;
+    }
+
+    qemu_system_wakeup_request(QEMU_WAKEUP_REASON_OTHER, NULL);
+    assert(evt->type == INPUT_EVENT_KIND_KEY);
+    qcode = qemu_input_key_value_to_qcode(key->key);
+
+    if (!fdisbull_frame_keys_keyboard_event(s, qcode, key->down)) {
+        return;
+    }
+
+    mod = ps2_modifier_bit(qcode);
+    trace_ps2_keyboard_event(s, qcode, key->down, mod,
+                             s->modifiers, s->scancode_set, s->translate);
+    if (key->down) {
+        s->modifiers |= mod;
+    } else {
+        s->modifiers &= ~mod;
+    }
+
+    if (!ps2_encode_keycode(s->scancode_set, s->modifiers, qcode,
+                            key->down, ps2_put_keycode, s)) {
+        qemu_log_mask(LOG_UNIMP, "ps2: ignoring key with qcode %d\n", qcode);
+    }
 }
 
