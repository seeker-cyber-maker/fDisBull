+static SB16State *sb16_checkpoint_device(Error **errp)
+{
+    bool ambiguous = false;
+    Object *obj = object_resolve_path_type("", TYPE_SB16, &ambiguous);
+    SB16State *s;
+
+    if (ambiguous || !obj || !DEVICE(obj)->realized) {
+        error_setg(errp, "SB16 checkpoint requires exactly one realized SB16");
+        return NULL;
+    }
+    s = SB16(obj);
+    if (strcmp(audio_get_id(&s->card), "fdisbull-sb16")) {
+        error_setg(errp, "SB16 checkpoint requires audiodev fdisbull-sb16");
+        return NULL;
+    }
+    return s;
+}
+
+bool fdisbull_sb16_checkpoint_enabled(void)
+{
+    return sb16_checkpoint_device(NULL) != NULL;
+}
+
+static bool sb16_checkpoint_device_safe(SB16State *s, Error **errp)
+{
+    I8257State *low, *high;
+    int channel;
+    I8257State *active;
+
+    if (runstate_is_running() || !s->aux_ts ||
+        !object_dynamic_cast(OBJECT(s->isa_dma), TYPE_I8257) ||
+        !object_dynamic_cast(OBJECT(s->isa_hdma), TYPE_I8257)) {
+        error_setg(errp, "SB16 checkpoint requires stopped i8257 DMA");
+        return false;
+    }
+    low = I8257(s->isa_dma);
+    high = I8257(s->isa_hdma);
+    active = s->use_hdma ? high : low;
+    channel = (s->use_hdma ? s->hdma : s->dma) & 3;
+    if (low->running || high->running || s->dma_running < 0 ||
+        s->dma_running > 1 || s->audio_free < 0 ||
+        s->audio_free > 1048576 || s->use_hdma < 0 || s->use_hdma > 1 ||
+        (s->dma_running && (!s->voice || s->block_size <= 0 ||
+                           s->left_till_irq <= 0 ||
+                           !(active->status & (1 << (channel + 4)))))) {
+        error_setg(errp, "SB16 checkpoint DMA or audio credit is unsupported");
+        return false;
+    }
+    if (s->voice && (s->voice->info.bits != 8 ||
+        s->voice->info.is_signed || s->voice->info.is_float ||
+        s->voice->info.nchannels != 1 ||
+        s->voice->info.freq < SAMPLE_RATE_MIN ||
+        s->voice->info.freq > SAMPLE_RATE_MAX ||
+        s->voice->info.swap_endianness ||
+        s->voice->active < 0 || s->voice->active > 1)) {
+        error_setg(errp, "SB16 checkpoint supports U8 mono voices at 5000..45000 Hz");
+        return false;
+    }
+    if (timer_pending(s->aux_ts) &&
+        timer_expire_time_ns(s->aux_ts) > INT64_MAX) {
+        error_setg(errp, "SB16 auxiliary timer deadline is invalid");
+        return false;
+    }
+    return true;
+}
+
+bool fdisbull_sb16_checkpoint_safe(Error **errp)
+{
+    SB16State *s = sb16_checkpoint_device(errp);
+    int64_t deadline;
+
+    return s && sb16_checkpoint_device_safe(s, errp) &&
+        fdisbull_audio_output_checkpoint_safe(&deadline, errp);
+}
+
+static bool sb16_checkpoint_needed(void *opaque)
+{
+    SB16State *s = opaque;
+    return fdisbull_instrumented_checkpoint_busy() &&
+        !strcmp(audio_get_id(&s->card), "fdisbull-sb16");
+}
+
+static int sb16_checkpoint_pre_save(void *opaque)
+{
+    SB16State *s = opaque;
+    g_autoptr(Error) err = NULL;
+
+    if (s != sb16_checkpoint_device(&err) ||
+        !sb16_checkpoint_device_safe(s, &err) ||
+        !fdisbull_audio_output_checkpoint_safe(&s->checkpoint_audio_deadline,
+                                               &err)) {
+        if (err) {
+            error_report_err(g_steal_pointer(&err));
+        }
+        return -EINVAL;
+    }
+    s->checkpoint_voice_present = s->voice != NULL;
+    s->checkpoint_voice_active = s->voice && s->voice->active;
+    s->checkpoint_voice_freq = s->voice ? s->voice->info.freq : 0;
+    s->checkpoint_voice_channels = s->voice ? s->voice->info.nchannels : 0;
+    s->checkpoint_voice_format = s->voice ? AUDIO_FORMAT_U8 : 0;
+    s->checkpoint_voice_endianness = 0;
+    s->checkpoint_aux_deadline = timer_pending(s->aux_ts) ?
+        timer_expire_time_ns(s->aux_ts) : -1;
+    return 0;
+}
+
+static int sb16_checkpoint_pre_load(void *opaque)
+{
+    SB16State *s = opaque;
+    s->checkpoint_loaded = false;
+    return 0;
+}
+
+static int sb16_checkpoint_post_load(void *opaque, int version_id)
+{
+    SB16State *s = opaque;
+    struct audsettings as;
+
+    if (!fdisbull_instrumented_checkpoint_busy() ||
+        s != sb16_checkpoint_device(NULL) ||
+        s->checkpoint_audio_deadline < -1 || s->checkpoint_aux_deadline < -1 ||
+        (!s->checkpoint_voice_present &&
+         (s->checkpoint_voice_active || s->checkpoint_voice_freq ||
+          s->checkpoint_voice_channels || s->checkpoint_voice_format ||
+          s->checkpoint_voice_endianness || s->dma_running)) ||
+        (s->checkpoint_voice_present &&
+         (s->checkpoint_voice_freq < SAMPLE_RATE_MIN ||
+          s->checkpoint_voice_freq > SAMPLE_RATE_MAX ||
+          s->checkpoint_voice_channels != 1 ||
+          s->checkpoint_voice_format != AUDIO_FORMAT_U8 ||
+          s->checkpoint_voice_endianness))) {
+        return -EINVAL;
+    }
+    if (s->voice) {
+        AUD_close_out(&s->card, s->voice);
+        s->voice = NULL;
+    }
+    timer_del(s->aux_ts);
+    if (s->checkpoint_voice_present) {
+        as.freq = s->checkpoint_voice_freq;
+        as.nchannels = s->checkpoint_voice_channels;
+        as.fmt = s->checkpoint_voice_format;
+        as.endianness = s->checkpoint_voice_endianness;
+        s->voice = AUD_open_out(&s->card, NULL, "sb16", s,
+                                SB_audio_callback, &as);
+        if (!s->voice) {
+            return -EINVAL;
+        }
+        /* This changes no ISA request and transfers no guest memory.  The
+         * private audio import subsequently restores exact mixer/ring state. */
+        AUD_set_active_out(s->voice, s->checkpoint_voice_active);
+    }
+    s->checkpoint_loaded = true;
+    return 0;
+}
+
+static bool sb16_checkpoint_dma_loaded(IsaDma *dma)
+{
+    I8257State *d = I8257(dma);
+    return d->checkpoint_loaded && d->status == d->checkpoint_status &&
+        d->running == d->checkpoint_running && !d->running &&
+        d->dma_bh_scheduled == d->checkpoint_bh_pending &&
+        d->checkpoint_deferred == d->checkpoint_bh_pending;
+}
+
+bool fdisbull_sb16_checkpoint_rearm(Error **errp)
+{
+    SB16State *s = sb16_checkpoint_device(errp);
+
+    if (!s) {
+        return false;
+    }
+    if (!fdisbull_instrumented_checkpoint_busy() || !s->checkpoint_loaded ||
+        !sb16_checkpoint_device_safe(s, errp) ||
+        !sb16_checkpoint_dma_loaded(s->isa_dma) ||
+        !sb16_checkpoint_dma_loaded(s->isa_hdma) ||
+        (s->voice != NULL) != s->checkpoint_voice_present ||
+        (s->voice && !!s->voice->active != s->checkpoint_voice_active)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "SB16 scoped checkpoint state is absent or changed");
+        }
+        return false;
+    }
+    if (!fdisbull_audio_output_checkpoint_restore_timer(
+            s->checkpoint_audio_deadline, errp)) {
+        return false;
+    }
+    if (s->checkpoint_aux_deadline >= 0) {
+        timer_mod_ns(s->aux_ts, s->checkpoint_aux_deadline);
+    } else {
+        timer_del(s->aux_ts);
+    }
+    s->checkpoint_loaded = false;
+    I8257(s->isa_dma)->checkpoint_loaded = false;
+    I8257(s->isa_hdma)->checkpoint_loaded = false;
+    return true;
+}
