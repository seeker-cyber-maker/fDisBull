--- a/audio/audio.c
+++ b/audio/audio.c
@@ -945,6 +945,487 @@
     dst->r = src->r;
 }
 
+/* SB16 uses a separate audiodev and a separate codec. The legacy PC-speaker
+ * codec above and below this block remains version 1 and equal-rate only.
+ * This version contains only scalar state and bounded sample/ring arrays;
+ * callbacks, opaque pointers, converters and list links belong to the freshly
+ * recreated device graph. The integer mixer ABI is pinned to this native kit. */
+#define FDISBULL_SB16_CORE_MAGIC UINT64_C(0x4644424155443032)
+#define FDISBULL_SB16_CORE_MAX (8 * 1024 * 1024)
+#define FDISBULL_SB16_HW_MAX UINT64_C(65536)
+#define FDISBULL_SB16_SW_MAX UINT64_C(92161)
+
+typedef struct FdisbullSB16Graph {
+    AudioState *state;
+    HWVoiceOut *hw;
+    SWVoiceOut *sw;
+    CaptureVoiceOut *cap;
+    SWVoiceOut *csw;
+} FdisbullSB16Graph;
+
+/* Every member is an explicit 64-bit scalar: no structure padding, pointers,
+ * host size_t or opaque rate object is copied into the private wire header. */
+typedef struct FdisbullSB16Core {
+    uint64_t magic, version, sample_size, byte_order;
+    uint64_t has_hw, has_sw, has_capture;
+    uint64_t hw_size, hw_pos, hw_timestamp, hw_enabled, hw_pending_disable;
+    uint64_t emul_size, emul_pos, emul_pending;
+    uint64_t sw_freq, sw_channels, sw_bits, sw_signed, sw_swap;
+    uint64_t sw_total, sw_active, sw_empty, sw_size, sw_pos;
+    uint64_t sw_mute;
+    int64_t sw_l, sw_r;
+    uint64_t rate_opos, rate_increment, rate_ipos;
+    int64_t rate_last_l, rate_last_r;
+    uint64_t cap_size, cap_pos, cap_timestamp, cap_enabled;
+    uint64_t csw_total, csw_active, csw_empty, csw_mute;
+    int64_t csw_l, csw_r;
+} FdisbullSB16Core;
+
+static bool fdisbull_audio_profile_exclusive(Error **errp)
+{
+    if (audio_state_by_name("fdisbull-pc", NULL) &&
+        audio_state_by_name("fdisbull-sb16", NULL)) {
+        error_setg(errp, "PC-speaker and SB16 checkpoint profiles are exclusive");
+        return false;
+    }
+    return true;
+}
+
+static bool fdisbull_sb16_volume_valid(uint64_t mute, int64_t l, int64_t r)
+{
+#ifdef FLOAT_MIXENG
+    return false;
+#else
+    return mute <= 1 && l >= 0 && r >= 0 &&
+           l <= nominal_volume.l && r <= nominal_volume.r;
+#endif
+}
+
+static bool fdisbull_sb16_samples_valid(const uint8_t *bytes, uint64_t frames)
+{
+#ifdef FLOAT_MIXENG
+    return false;
+#else
+    uint64_t i;
+
+    for (i = 0; i < frames; i++) {
+        st_sample value;
+        memcpy(&value, bytes + i * sizeof(value), sizeof(value));
+        /* Unsigned PCM's conversion subtracts IN_MAX >> 1, so positive
+         * full scale is +2^31 rather than INT32_MAX. */
+        if (value.l < INT32_MIN || value.l > INT64_C(2147483648) ||
+            value.r < INT32_MIN || value.r > INT64_C(2147483648)) {
+            return false;
+        }
+    }
+    return true;
+#endif
+}
+
+static bool fdisbull_sb16_pcm_valid(const struct audio_pcm_info *info)
+{
+    return info->freq >= 5000 && info->freq <= 45000 &&
+           (info->nchannels == 1 || info->nchannels == 2) &&
+           (info->bits == 8 || info->bits == 16) && !info->is_float &&
+           info->swap_endianness == (AUDIO_HOST_ENDIANNESS != 0) &&
+           info->bytes_per_frame == info->nchannels * (info->bits / 8) &&
+           info->bytes_per_second == info->freq * info->bytes_per_frame;
+}
+
+static bool fdisbull_sb16_activity_valid(uint64_t enabled, uint64_t pending,
+                                        uint64_t active)
+{
+    /* One active SW enables its HW. An inactive voice may still be draining
+     * the already mixed prefix until audio_run_out observes it empty. */
+    return enabled <= 1 && pending <= 1 && active <= 1 &&
+           (active ? enabled && !pending : enabled == pending);
+}
+
+static bool fdisbull_sb16_graph(FdisbullSB16Graph *graph, Error **errp)
+{
+    AudioState *s;
+    QEMUSoundCard *card;
+    HWVoiceOut *hw;
+    SWVoiceOut *sw = NULL;
+    CaptureVoiceOut *cap;
+    SWVoiceCap *sc = NULL;
+    FdisbullRateState rate;
+
+    assert(bql_locked());
+    memset(graph, 0, sizeof(*graph));
+#ifdef FLOAT_MIXENG
+    error_setg(errp, "SB16 checkpoint requires the pinned integer mixer ABI");
+    return false;
+#endif
+    if (!fdisbull_audio_profile_exclusive(errp)) {
+        return false;
+    }
+    s = audio_state_by_name("fdisbull-sb16", errp);
+    if (!s) {
+        return false;
+    }
+    card = QLIST_FIRST(&s->card_head);
+    if (!s->drv || strcmp(s->drv->name, "none") || !s->dev || s->vm_running ||
+        !audio_get_pdo_out(s->dev)->mixing_engine ||
+        !QLIST_EMPTY(&s->hw_head_in) || !card ||
+        QLIST_NEXT(card, entries) || card->state != s || !card->name ||
+        strcmp(card->name, "sb16")) {
+        error_setg(errp, "SB16 checkpoint requires its stopped single-card none backend");
+        return false;
+    }
+    hw = QLIST_FIRST(&s->hw_head_out);
+    if (hw) {
+        sw = QLIST_FIRST(&hw->sw_head);
+        if (QLIST_NEXT(hw, entries) || hw->s != s || hw->poll_mode ||
+            !fdisbull_audio_info_supported(&hw->info) ||
+            !fdisbull_audio_buffer_valid(&hw->mix_buf) ||
+            !sw || QLIST_NEXT(sw, entries) || sw->s != s || sw->card != card ||
+            sw->hw != hw || !sw->name || strcmp(sw->name, "sb16") ||
+            !sw->conv || !sw->callback.fn || !sw->callback.opaque ||
+            !fdisbull_sb16_pcm_valid(&sw->info) ||
+            sw->total_hw_samples_mixed > hw->mix_buf.size ||
+            sw->empty != (sw->total_hw_samples_mixed == 0) ||
+            !fdisbull_sb16_activity_valid(hw->enabled, hw->pending_disable, sw->active) ||
+            !sw->resample_buf.buffer || sw->resample_buf.pos > 1 ||
+            !sw->resample_buf.size || sw->resample_buf.size > FDISBULL_SB16_SW_MAX ||
+            sw->resample_buf.size !=
+                ((uint64_t)hw->mix_buf.size * sw->info.freq / 32000) + 1 ||
+            !st_rate_checkpoint_get(sw->rate, sw->info.freq, 32000, &rate) ||
+            !fdisbull_sb16_volume_valid(sw->vol.mute, sw->vol.l, sw->vol.r) ||
+            !fdisbull_sb16_samples_valid((uint8_t *)hw->mix_buf.buffer, hw->mix_buf.size) ||
+            !fdisbull_sb16_samples_valid((uint8_t *)sw->resample_buf.buffer, sw->resample_buf.size)) {
+            error_setg(errp, "SB16 checkpoint output voice, format or resampler is unsupported");
+            return false;
+        }
+        if ((hw->buf_emul && (!hw->size_emul || hw->size_emul > 65536 ||
+                hw->pos_emul >= hw->size_emul || hw->pending_emul > hw->size_emul)) ||
+            (!hw->buf_emul && (hw->size_emul || hw->pos_emul || hw->pending_emul))) {
+            error_setg(errp, "SB16 checkpoint backend ring is not bounded");
+            return false;
+        }
+        sc = QLIST_FIRST(&hw->cap_head);
+    }
+    cap = QLIST_FIRST(&s->cap_head);
+    if (cap) {
+        struct capture_callback *cb = QLIST_FIRST(&cap->cb_head);
+        SWVoiceOut *csw = QLIST_FIRST(&cap->hw.sw_head);
+        if (QLIST_NEXT(cap, entries) || cap->hw.s != s || !cb ||
+            QLIST_NEXT(cb, entries) || !cb->ops.capture || !cb->ops.notify ||
+            !fdisbull_audio_info_supported(&cap->hw.info) ||
+            !fdisbull_audio_buffer_valid(&cap->hw.mix_buf) ||
+            cap->hw.pending_disable || cap->hw.poll_mode ||
+            cap->hw.buf_emul || cap->hw.size_emul || cap->hw.pos_emul ||
+            cap->hw.pending_emul || !cap->buf ||
+            !fdisbull_sb16_samples_valid((uint8_t *)cap->hw.mix_buf.buffer,
+                                         cap->hw.mix_buf.size)) {
+            error_setg(errp, "SB16 checkpoint capture graph is unsupported");
+            return false;
+        }
+        if (hw) {
+            if (!sc || QLIST_NEXT(sc, entries) || sc->cap != cap || csw != &sc->sw ||
+                QLIST_NEXT(csw, entries) || csw->hw != &cap->hw ||
+                csw->total_hw_samples_mixed > cap->hw.mix_buf.size ||
+                csw->empty != (csw->total_hw_samples_mixed == 0) ||
+                csw->active != hw->enabled || cap->hw.enabled != hw->enabled ||
+                csw->resample_buf.pos ||
+                !fdisbull_audio_info_supported(&csw->info) ||
+                !st_rate_checkpoint_get(csw->rate, 32000, 32000, &rate) ||
+                !fdisbull_sb16_volume_valid(csw->vol.mute, csw->vol.l, csw->vol.r)) {
+                error_setg(errp, "SB16 checkpoint capture link differs from output");
+                return false;
+            }
+            graph->csw = csw;
+        } else if (sc || csw || cap->hw.enabled) {
+            error_setg(errp, "Silent SB16 checkpoint unexpectedly has a capture source");
+            return false;
+        }
+    } else if (sc) {
+        error_setg(errp, "SB16 checkpoint has an unowned capture link");
+        return false;
+    }
+    graph->state = s;
+    graph->hw = hw;
+    graph->sw = sw;
+    graph->cap = cap;
+    return true;
+}
+
+static char *fdisbull_sb16_export(Error **errp)
+{
+    FdisbullSB16Graph g;
+    FdisbullSB16Core h = { 0 };
+    FdisbullRateState rate;
+    g_autofree uint8_t *blob = NULL;
+    size_t hw_bytes, sw_bytes, cap_bytes, len;
+    uint8_t *p;
+
+    if (!fdisbull_sb16_graph(&g, errp)) {
+        return NULL;
+    }
+    h.magic = FDISBULL_SB16_CORE_MAGIC;
+    h.version = 2;
+    h.sample_size = sizeof(st_sample);
+    h.byte_order = G_BYTE_ORDER;
+    h.has_hw = !!g.hw;
+    h.has_sw = !!g.sw;
+    h.has_capture = !!g.cap;
+    if (g.hw) {
+        HWVoiceOut *hw = g.hw;
+        SWVoiceOut *sw = g.sw;
+        st_rate_checkpoint_get(sw->rate, sw->info.freq, 32000, &rate);
+        h.hw_size = hw->mix_buf.size; h.hw_pos = hw->mix_buf.pos;
+        h.hw_timestamp = hw->ts_helper; h.hw_enabled = hw->enabled;
+        h.hw_pending_disable = hw->pending_disable;
+        h.emul_size = hw->size_emul; h.emul_pos = hw->pos_emul;
+        h.emul_pending = hw->pending_emul;
+        h.sw_freq = sw->info.freq; h.sw_channels = sw->info.nchannels;
+        h.sw_bits = sw->info.bits; h.sw_signed = sw->info.is_signed;
+        h.sw_swap = sw->info.swap_endianness;
+        h.sw_total = sw->total_hw_samples_mixed;
+        h.sw_active = sw->active; h.sw_empty = sw->empty;
+        h.sw_size = sw->resample_buf.size; h.sw_pos = sw->resample_buf.pos;
+        h.sw_mute = sw->vol.mute; h.sw_l = sw->vol.l; h.sw_r = sw->vol.r;
+        h.rate_opos = rate.opos; h.rate_increment = rate.opos_inc;
+        h.rate_ipos = rate.ipos; h.rate_last_l = rate.ilast.l; h.rate_last_r = rate.ilast.r;
+    }
+    if (g.cap) {
+        h.cap_size = g.cap->hw.mix_buf.size; h.cap_pos = g.cap->hw.mix_buf.pos;
+        h.cap_timestamp = g.cap->hw.ts_helper; h.cap_enabled = g.cap->hw.enabled;
+        if (g.csw) {
+            h.csw_total = g.csw->total_hw_samples_mixed;
+            h.csw_active = g.csw->active; h.csw_empty = g.csw->empty;
+            h.csw_mute = g.csw->vol.mute; h.csw_l = g.csw->vol.l; h.csw_r = g.csw->vol.r;
+        }
+    }
+    hw_bytes = h.hw_size * sizeof(st_sample);
+    sw_bytes = h.sw_size * sizeof(st_sample);
+    cap_bytes = h.cap_size * sizeof(st_sample);
+    len = sizeof(h) + hw_bytes + sw_bytes + cap_bytes + h.emul_size;
+    if (len > FDISBULL_SB16_CORE_MAX * 3 / 4 - 3) {
+        error_setg(errp, "SB16 checkpoint mixer blob exceeds 8 MiB encoded budget");
+        return NULL;
+    }
+    blob = g_malloc0(len);
+    memcpy(blob, &h, sizeof(h));
+    p = blob + sizeof(h);
+    if (hw_bytes) { memcpy(p, g.hw->mix_buf.buffer, hw_bytes); p += hw_bytes; }
+    if (sw_bytes) { memcpy(p, g.sw->resample_buf.buffer, sw_bytes); p += sw_bytes; }
+    if (cap_bytes) { memcpy(p, g.cap->hw.mix_buf.buffer, cap_bytes); p += cap_bytes; }
+    /* Only initialized pending ring bytes are retained; unused bytes are
+     * canonical zero, exactly as in the version-1 codec. */
+    if (h.emul_pending) {
+        size_t first = audio_ring_posb(h.emul_pos, h.emul_pending, h.emul_size);
+        size_t count = MIN(h.emul_pending, h.emul_size - first);
+        memcpy(p + first, g.hw->buf_emul + first, count);
+        if (count < h.emul_pending) {
+            memcpy(p, g.hw->buf_emul, h.emul_pending - count);
+        }
+    }
+    return g_base64_encode(blob, len);
+}
+
+static bool fdisbull_sb16_import(const char *base64, Error **errp)
+{
+    FdisbullSB16Graph g;
+    FdisbullSB16Core h, empty = { 0 };
+    FdisbullRateState rate = { 0 };
+    g_autofree guchar *blob = NULL;
+    g_autofree char *canonical = NULL;
+    g_autofree uint8_t *emul = NULL;
+    gsize len;
+    size_t hw_bytes, sw_bytes, cap_bytes;
+    const uint8_t *p;
+
+    if (!base64 || !*base64 || strlen(base64) > FDISBULL_SB16_CORE_MAX) {
+        error_setg(errp, "SB16 checkpoint mixer encoding is missing or oversized");
+        return false;
+    }
+    blob = g_base64_decode(base64, &len);
+    canonical = g_base64_encode(blob, len);
+    if (strcmp(canonical, base64) || len < sizeof(h)) {
+        error_setg(errp, "SB16 checkpoint mixer encoding is not canonical");
+        return false;
+    }
+    memcpy(&h, blob, sizeof(h));
+    if (h.magic != FDISBULL_SB16_CORE_MAGIC || h.version != 2 ||
+        h.sample_size != sizeof(st_sample) || h.byte_order != G_BYTE_ORDER ||
+        h.has_hw > 1 || h.has_sw != h.has_hw || h.has_capture > 1 ||
+        h.hw_size > FDISBULL_SB16_HW_MAX || h.sw_size > FDISBULL_SB16_SW_MAX ||
+        h.cap_size > FDISBULL_SB16_HW_MAX || h.emul_size > 65536 ||
+        h.emul_pending > h.emul_size ||
+        (h.emul_size ? h.emul_pos >= h.emul_size : h.emul_pos != 0)) {
+        error_setg(errp, "SB16 checkpoint mixer header is incompatible");
+        return false;
+    }
+    if (h.has_hw) {
+        if (!h.hw_size || h.hw_pos >= h.hw_size ||
+            h.sw_freq < 5000 || h.sw_freq > 45000 ||
+            (h.sw_channels != 1 && h.sw_channels != 2) ||
+            (h.sw_bits != 8 && h.sw_bits != 16) || h.sw_signed > 1 ||
+            h.sw_swap != (AUDIO_HOST_ENDIANNESS != 0) ||
+            !h.sw_size || h.sw_size != h.hw_size * h.sw_freq / 32000 + 1 ||
+            h.sw_pos > 1 || h.sw_total > h.hw_size ||
+            h.sw_empty != (h.sw_total == 0) ||
+            !fdisbull_sb16_activity_valid(h.hw_enabled, h.hw_pending_disable, h.sw_active) ||
+            !fdisbull_sb16_volume_valid(h.sw_mute, h.sw_l, h.sw_r) ||
+            h.rate_ipos > UINT32_MAX) {
+            error_setg(errp, "SB16 checkpoint software voice state is invalid");
+            return false;
+        }
+        rate.opos = h.rate_opos; rate.opos_inc = h.rate_increment;
+        rate.ipos = h.rate_ipos; rate.ilast.l = h.rate_last_l; rate.ilast.r = h.rate_last_r;
+        if (!st_rate_checkpoint_validate(&rate, h.sw_freq, 32000)) {
+            error_setg(errp, "SB16 checkpoint resampler phase is invalid");
+            return false;
+        }
+    } else {
+        /* Presence cannot be used to smuggle unvalidated dormant fields. */
+        empty = h;
+        empty.magic = empty.version = empty.sample_size = empty.byte_order = 0;
+        empty.has_capture = 0;
+        empty.cap_size = empty.cap_pos = empty.cap_timestamp = empty.cap_enabled = 0;
+        if (memcmp(&empty, &(FdisbullSB16Core){0}, sizeof(empty))) {
+            error_setg(errp, "Silent SB16 checkpoint retains absent output state");
+            return false;
+        }
+    }
+    if (h.has_capture) {
+        if (!h.cap_size || h.cap_pos >= h.cap_size || h.cap_enabled > 1 ||
+            (h.has_hw && (h.csw_total > h.cap_size ||
+                h.csw_empty != (h.csw_total == 0) ||
+                h.csw_active != h.hw_enabled || h.cap_enabled != h.hw_enabled ||
+                !fdisbull_sb16_volume_valid(h.csw_mute, h.csw_l, h.csw_r))) ||
+            (!h.has_hw && (h.cap_enabled || h.csw_total || h.csw_active ||
+                           h.csw_empty || h.csw_mute || h.csw_l || h.csw_r))) {
+            error_setg(errp, "SB16 checkpoint capture state is invalid");
+            return false;
+        }
+    } else if (h.cap_size || h.cap_pos || h.cap_timestamp || h.cap_enabled ||
+               h.csw_total || h.csw_active || h.csw_empty || h.csw_mute ||
+               h.csw_l || h.csw_r) {
+        error_setg(errp, "SB16 checkpoint retains an absent capture voice");
+        return false;
+    }
+    hw_bytes = h.hw_size * sizeof(st_sample);
+    sw_bytes = h.sw_size * sizeof(st_sample);
+    cap_bytes = h.cap_size * sizeof(st_sample);
+    if (len != sizeof(h) + hw_bytes + sw_bytes + cap_bytes + h.emul_size ||
+        !fdisbull_sb16_samples_valid(blob + sizeof(h), h.hw_size + h.sw_size + h.cap_size)) {
+        error_setg(errp, "SB16 checkpoint mixer length or samples are invalid");
+        return false;
+    }
+    if (!fdisbull_sb16_graph(&g, errp)) {
+        return false;
+    }
+    if (h.has_hw != !!g.hw || h.has_capture != !!g.cap ||
+        (g.hw && (h.hw_size != g.hw->mix_buf.size ||
+            h.sw_size != g.sw->resample_buf.size || h.sw_freq != g.sw->info.freq ||
+            h.sw_channels != g.sw->info.nchannels || h.sw_bits != g.sw->info.bits ||
+            h.sw_signed != g.sw->info.is_signed || h.sw_swap != g.sw->info.swap_endianness)) ||
+        (g.cap && h.cap_size != g.cap->hw.mix_buf.size)) {
+        error_setg(errp, "SB16 checkpoint recreated graph or software format differs");
+        return false;
+    }
+    p = blob + sizeof(h) + hw_bytes + sw_bytes + cap_bytes;
+    if (h.emul_size) {
+        size_t first = audio_ring_posb(h.emul_pos, h.emul_pending, h.emul_size);
+        size_t i;
+        for (i = 0; i < h.emul_size; i++) {
+            size_t offset = (i + h.emul_size - first) % h.emul_size;
+            if (offset >= h.emul_pending && p[i]) {
+                error_setg(errp, "SB16 checkpoint unused backend bytes are not canonical");
+                return false;
+            }
+        }
+        emul = g_memdup2(p, h.emul_size);
+    }
+    /* Every input, allocation, link and destination check precedes mutation.
+     * The device's post_load recreated callbacks/converters, but may leave
+     * fresh inactive flags. Restore the saved draining/active state directly
+     * under BQL: do not run a callback, DMA or an audio timer here. */
+    p = blob + sizeof(h);
+    if (g.hw) {
+        memcpy(g.hw->mix_buf.buffer, p, hw_bytes); p += hw_bytes;
+        memcpy(g.sw->resample_buf.buffer, p, sw_bytes); p += sw_bytes;
+        g.hw->mix_buf.pos = h.hw_pos; g.hw->ts_helper = h.hw_timestamp;
+        g.hw->enabled = h.hw_enabled; g.hw->pending_disable = h.hw_pending_disable;
+        g_free(g.hw->buf_emul); g.hw->buf_emul = g_steal_pointer(&emul);
+        g.hw->size_emul = h.emul_size; g.hw->pos_emul = h.emul_pos;
+        g.hw->pending_emul = h.emul_pending;
+        g.sw->total_hw_samples_mixed = h.sw_total;
+        g.sw->active = h.sw_active; g.sw->empty = h.sw_empty;
+        g.sw->resample_buf.pos = h.sw_pos;
+        g.sw->vol.mute = h.sw_mute; g.sw->vol.l = h.sw_l; g.sw->vol.r = h.sw_r;
+        /* Already validated above; this operation only copies scalar fields. */
+        st_rate_checkpoint_import(g.sw->rate, h.sw_freq, 32000, &rate);
+    }
+    if (g.cap) {
+        memcpy(g.cap->hw.mix_buf.buffer, p, cap_bytes);
+        g.cap->hw.mix_buf.pos = h.cap_pos; g.cap->hw.ts_helper = h.cap_timestamp;
+        g.cap->hw.enabled = h.cap_enabled;
+        if (g.csw) {
+            g.csw->total_hw_samples_mixed = h.csw_total;
+            g.csw->active = h.csw_active; g.csw->empty = h.csw_empty;
+            g.csw->vol.mute = h.csw_mute; g.csw->vol.l = h.csw_l; g.csw->vol.r = h.csw_r;
+        }
+        /* Only the restored graph can set the live observer's enabled bit.
+         * This notification updates ownership metadata; no PCM callback,
+         * stream, timer or guest execution is dispatched. */
+        audio_notify_capture(g.cap, h.cap_enabled ? AUD_CNOTIFY_ENABLE :
+                                                   AUD_CNOTIFY_DISABLE);
+    }
+    return true;
+}
+
+static bool fdisbull_sb16_timer(int64_t *timer_ns, bool restore, Error **errp)
+{
+    FdisbullSB16Graph g;
+    bool needed, pending;
+    int64_t now;
+    uint64_t expiry;
+
+    if (!timer_ns || !fdisbull_sb16_graph(&g, errp)) {
+        return false;
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    needed = audio_is_timer_needed(g.state);
+    if (g.state->period_ticks <= 0 || now < 0 ||
+        g.state->period_ticks > INT64_MAX - now) {
+        error_setg(errp, "SB16 checkpoint audio timer range is invalid");
+        return false;
+    }
+    if (!restore) {
