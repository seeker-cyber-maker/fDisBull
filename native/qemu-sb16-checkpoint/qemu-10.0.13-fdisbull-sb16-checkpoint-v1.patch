+# Private stopped digital-only SB16 admission/observation, API 1.
+##
+# @FdisbullSb16Info:
+#
+# Passive state. No port read, IRQ acknowledgement, DMA transfer or timer tick.
+#
+# @api-version: api version observation.
+# @iobase: iobase observation.
+# @irq: irq observation.
+# @dma: dma observation.
+# @dma16: dma16 observation.
+# @version: version observation.
+# @audiodev-id: audiodev id observation.
+# @voice-present: voice present observation.
+# @voice-active: voice active observation.
+# @voice-frequency: voice frequency observation.
+# @voice-channels: voice channels observation.
+# @voice-bits: voice bits observation.
+# @voice-signed: voice signed observation.
+# @dma-active: dma active observation.
+# @audio-free: audio free observation.
+# @left-till-irq: left till irq observation.
+# @block-size: block size observation.
+# @irq-status: irq status observation.
+# @dma-position: dma position observation.
+# @dma-length: dma length observation.
+# @dma-address: dma address observation.
+# @dma-status: dma status observation.
+# @dma-mask: dma mask observation.
+# @dma-pending: dma pending observation.
+# @dma-running: dma running observation.
+# @aux-timer-pending: aux timer pending observation.
+# @aux-timer-deadline: aux timer deadline observation.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullSb16Info',
+  'data': { 'api-version': 'int',
+            'iobase': 'int',
+            'irq': 'int',
+            'dma': 'int',
+            'dma16': 'int',
+            'version': 'int',
+            'audiodev-id': 'str',
+            'voice-present': 'bool',
+            'voice-active': 'bool',
+            'voice-frequency': 'int',
+            'voice-channels': 'int',
+            'voice-bits': 'int',
+            'voice-signed': 'bool',
+            'dma-active': 'bool',
+            'audio-free': 'int',
+            'left-till-irq': 'int',
+            'block-size': 'int',
+            'irq-status': 'int',
+            'dma-position': 'int',
+            'dma-length': 'int',
+            'dma-address': 'uint32',
+            'dma-status': 'int',
+            'dma-mask': 'int',
+            'dma-pending': 'bool',
+            'dma-running': 'int',
+            'aux-timer-pending': 'bool',
+            'aux-timer-deadline': 'int' } }
