+bool st_rate_checkpoint_validate(const FdisbullRateState *state,
+                                 int inrate, int outrate)
+{
+#ifdef FLOAT_MIXENG
+    /* This private codec deliberately pins the integer mixer ABI. */
+    return false;
+#else
+    uint64_t increment, limit;
+
+    if (!state || inrate < 5000 || inrate > 45000 || outrate != 32000) {
+        return false;
+    }
+    increment = ((uint64_t)inrate << 32) / outrate;
+    /* rate_template wraps before producing a frame at ipos >= 0x10001.
+     * Input exhaustion can leave at most one ratio-sized input step beyond
+     * that frontier. Bound both counters before any later frame arithmetic. */
+    limit = UINT64_C(0x10001) + (inrate + outrate - 1) / outrate;
+    if (state->opos_inc != increment || state->ipos > limit ||
+        (state->opos >> 32) > limit ||
+        state->ilast.l < INT32_MIN || state->ilast.l > INT64_C(2147483648) ||
+        state->ilast.r < INT32_MIN || state->ilast.r > INT64_C(2147483648)) {
+        return false;
+    }
+    /* The equal-rate copy branch never consumes these phase fields. */
+    if (inrate == outrate && (state->opos || state->ipos ||
+                              state->ilast.l || state->ilast.r)) {
+        return false;
+    }
+    return true;
+#endif
+}
+
+bool st_rate_checkpoint_get(void *opaque, int inrate, int outrate,
+                            FdisbullRateState *state)
+{
+    struct rate *rate = opaque;
+
+    if (!rate || !state) {
+        return false;
+    }
+    memset(state, 0, sizeof(*state));
+    state->opos = rate->opos;
+    state->opos_inc = rate->opos_inc;
+    state->ipos = rate->ipos;
+    state->ilast.l = rate->ilast.l;
+    state->ilast.r = rate->ilast.r;
+    return st_rate_checkpoint_validate(state, inrate, outrate);
+}
+
+bool st_rate_checkpoint_import(void *opaque, int inrate, int outrate,
+                               const FdisbullRateState *state)
+{
+    struct rate *rate = opaque;
+
+    if (!rate || !st_rate_checkpoint_validate(state, inrate, outrate)) {
+        return false;
+    }
+    rate->opos = state->opos;
+    rate->opos_inc = state->opos_inc;
+    rate->ipos = state->ipos;
+    rate->ilast.l = state->ilast.l;
+    rate->ilast.r = state->ilast.r;
+    return true;
+}
