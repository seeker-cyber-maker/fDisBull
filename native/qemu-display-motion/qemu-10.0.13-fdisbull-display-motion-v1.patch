+}
+
+FdisbullVgaConfigurationInfo *
+fdisbull_vga_configuration_snapshot_owned(Error **errp)
+{
+    g_autoptr(FdisbullRetraceInfo) retrace = NULL;
+    QemuConsole *console;
+    Object *device;
+
+    assert(bql_locked());
+    /* This path never initializes a timer or admits a replacement VGA owner. */
+    retrace = fdisbull_retrace_snapshot_owned(errp);
+    if (!retrace) {
+        return NULL;
+    }
+    if (!display_window.initialized || display_window.invalidated ||
+        display_window.epoch != retrace->epoch) {
+        error_setg(errp, "Owned display configuration snapshot is unavailable; "
+                   "close an invalidated VM");
+        return NULL;
+    }
+    if (display_window.token &&
+        (!display_console(&console, &device) ||
+         console != display_window.console || device != display_window.device)) {
+        display_invalidate("owned display console identity changed");
+        error_setg(errp, "Owned display console identity changed; close the VM");
+        return NULL;
+    }
+    /* Empty/new windows are evidence, not permission to refresh or substitute. */
+    return display_configuration_info(retrace, errp);
+}
