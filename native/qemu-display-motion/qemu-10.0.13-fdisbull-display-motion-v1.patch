+static bool input_motion_check(int64_t now)
+{
+    FdisbullInputMotion *motion = input_schedule.motion;
+    FdisbullVgaConfigurationInfo *armed, *checked;
+    Error *err = NULL;
+
+    if (!motion) {
+        return true;
+    }
+    if (motion->checked || !input_motion_observation_coherent(motion->armed) ||
+        !motion->armed->published ||
+        g_strcmp0(motion->armed->display->state, "stopped") ||
+        motion->armed->current->configuration_generation !=
+            motion->armed->published->configuration_generation) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "display motion lost its immutable arm observation");
+        return false;
+    }
+    armed = motion->armed;
+    checked = fdisbull_vga_configuration_snapshot_owned(&err);
+    if (!checked) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     err ? error_get_pretty(err) :
+                           "display motion owned snapshot failed");
+        error_free(err);
+        return false;
+    }
+    /* Retain the actual guard observation even when it refuses this attempt. */
+    motion->checked = checked;
+    if (!input_motion_observation_coherent(checked) ||
+        checked->current->virtual_ns != now ||
+        checked->current->virtual_ns < armed->current->virtual_ns ||
+        checked->current->epoch != input_schedule.epoch ||
+        !input_motion_identity_equal(armed->current, checked->current) ||
+        checked->current->configuration_generation <
+            armed->current->configuration_generation) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "display motion clock, identity or generation regressed");
+        return false;
+    }
+    if (checked->current->configuration_generation ==
+        armed->current->configuration_generation &&
+        !input_motion_raw_equal(armed->current->raw, checked->current->raw)) {
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "display motion raw state changed under one generation");
+        return false;
+    }
+    if (checked->published &&
+        (checked->published->virtual_ns < armed->published->virtual_ns ||
+         checked->published->configuration_generation <
+             armed->published->configuration_generation ||
+         (checked->published->configuration_generation ==
+              armed->current->configuration_generation &&
+          !input_motion_raw_equal(checked->published->raw, armed->current->raw)) ||
+         (checked->published->virtual_ns < armed->current->virtual_ns &&
+          checked->published->configuration_generation >
+              armed->current->configuration_generation))) {
+        /* Equal timestamps do not order paused QOM changes; strict order does. */
+        input_finish(FDISBULL_INPUT_STATE_FAILED,
+                     "display motion publication configuration history regressed");
+        return false;
+    }
+    if (!g_strcmp0(checked->display->token, armed->display->token)) {
+        if (!checked->display->has_start_ns ||
+            checked->display->start_ns != armed->display->start_ns ||
+            checked->display->period_ns != armed->display->period_ns ||
+            checked->display->updates < armed->display->updates ||
+            (checked->display->has_published_ns &&
+             checked->display->published_ns < armed->display->published_ns)) {
+            input_finish(FDISBULL_INPUT_STATE_FAILED,
+                         "display motion retained window history regressed");
+            return false;
+        }
+        /*
+         * A state-only policy change can cancel, but it cannot hide a changed
+         * raster extent, publication time or frozen stamp under the same ID.
+         * State/stop fields are checked separately after cancellation policy.
+         */
+        if (checked->display->has_update_id &&
+            checked->display->update_id == armed->display->update_id &&
+            (checked->display->published_ns != armed->display->published_ns ||
+             checked->display->width != armed->display->width ||
+             checked->display->height != armed->display->height ||
