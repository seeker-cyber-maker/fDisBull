+static bool input_motion_bytes_equal(const uint8List *a, const uint8List *b)
+{
+    while (a && b) {
+        if (a->value != b->value) {
+            return false;
+        }
+        a = a->next;
+        b = b->next;
+    }
+    return !a && !b;
+}
+
+static bool input_motion_words_equal(const uint16List *a, const uint16List *b)
+{
+    while (a && b) {
+        if (a->value != b->value) {
+            return false;
+        }
+        a = a->next;
+        b = b->next;
+    }
+    return !a && !b;
+}
+
+static bool input_motion_raw_equal(const FdisbullVgaConfigurationRaw *a,
+                                    const FdisbullVgaConfigurationRaw *b)
+{
+    /* Compare declared values, never QAPI list pointers or structure padding. */
+    return a && b &&
+        input_motion_bytes_equal(a->sequencer, b->sequencer) &&
+        input_motion_bytes_equal(a->sequencer_vbe, b->sequencer_vbe) &&
+        input_motion_bytes_equal(a->graphics, b->graphics) &&
+        input_motion_bytes_equal(a->crtc, b->crtc) &&
+        input_motion_bytes_equal(a->attribute_controls, b->attribute_controls) &&
+        input_motion_words_equal(a->vbe, b->vbe) &&
+        a->misc_output == b->misc_output &&
+        a->feature_control == b->feature_control &&
+        a->display_enabled == b->display_enabled &&
+        a->vbe_start_address == b->vbe_start_address &&
+        a->vbe_line_offset == b->vbe_line_offset &&
+        a->vbe_bank_mask == b->vbe_bank_mask &&
+        a->bank_offset == b->bank_offset && a->dac_8bit == b->dac_8bit &&
+        a->big_endian_framebuffer == b->big_endian_framebuffer &&
+        a->vram_size == b->vram_size && a->vbe_size == b->vbe_size &&
+        a->vbe_size_mask == b->vbe_size_mask;
+}
+
+static bool input_motion_identity_equal(
+    const FdisbullVgaConfigurationSnapshot *a,
+    const FdisbullVgaConfigurationSnapshot *b)
+{
+    return a && b && a->api_version == b->api_version &&
+        !g_strcmp0(a->model, b->model) && a->epoch == b->epoch &&
+        !g_strcmp0(a->device, b->device) &&
+        !g_strcmp0(a->device_type, b->device_type) &&
+        a->console == b->console && a->head == b->head;
+}
+
+static bool input_motion_snapshot_equal(
+    const FdisbullVgaConfigurationSnapshot *a,
+    const FdisbullVgaConfigurationSnapshot *b)
+{
+    return input_motion_identity_equal(a, b) &&
+        a->virtual_ns == b->virtual_ns &&
+        a->configuration_generation == b->configuration_generation &&
+        input_motion_raw_equal(a->raw, b->raw);
+}
+
+static bool input_motion_observation_coherent(
+    const FdisbullVgaConfigurationInfo *info)
+{
+    const FdisbullDisplayInfo *display;
+    const FdisbullVgaConfigurationSnapshot *current, *published;
+    bool have_publication;
+
+    if (!info || !info->display || !info->current) {
+        return false;
+    }
+    display = info->display;
+    current = info->current;
+    published = info->published;
+    have_publication = published != NULL;
+    if (current->api_version != 1 || !current->epoch ||
+        current->virtual_ns < 0 || !current->configuration_generation ||
+        g_strcmp0(current->model, "qemu-vga-configuration-fdisbull-v1") ||
+        g_strcmp0(current->device_type, "VGA") || !current->device ||
+        current->console || current->head || !current->raw ||
+        display->api_version != 1 || display->epoch != current->epoch ||
+        display->virtual_ns != current->virtual_ns ||
+        (g_strcmp0(display->state, "idle") &&
+         g_strcmp0(display->state, "observing") &&
+         g_strcmp0(display->state, "stopped")) ||
+        !!display->updates != have_publication ||
+        display->has_update_id != have_publication ||
+        display->has_published_ns != have_publication ||
+        display->has_width != have_publication ||
+        display->has_height != have_publication) {
+        return false;
+    }
+    if (!published) {
+        return true;
+    }
+    return display->token && display->has_start_ns &&
+        display->update_id == display->updates &&
+        display->start_ns <= display->published_ns &&
+        display->published_ns <= current->virtual_ns &&
+        display->width > 0 && display->width <= 8192 &&
+        display->height > 0 && display->height <= 8192 &&
+        input_motion_identity_equal(current, published) &&
+        published->raw &&
+        published->virtual_ns == display->published_ns &&
+        published->configuration_generation &&
+        published->configuration_generation <= current->configuration_generation &&
+        (published->configuration_generation != current->configuration_generation ||
+         input_motion_raw_equal(published->raw, current->raw));
+}
+
+static bool input_motion_display_equal(const FdisbullDisplayInfo *a,
+                                        const FdisbullDisplayInfo *b)
+{
+    /* The stopped publication is immutable except for observation time. */
+    return a->api_version == b->api_version && a->epoch == b->epoch &&
+        !g_strcmp0(a->state, b->state) && !g_strcmp0(a->token, b->token) &&
+        a->period_ns == b->period_ns && a->updates == b->updates &&
+        a->has_start_ns == b->has_start_ns && a->start_ns == b->start_ns &&
+        a->has_stop_ns == b->has_stop_ns && a->stop_ns == b->stop_ns &&
+        a->has_update_id == b->has_update_id && a->update_id == b->update_id &&
+        a->has_published_ns == b->has_published_ns &&
+        a->published_ns == b->published_ns &&
+        a->has_width == b->has_width && a->width == b->width &&
+        a->has_height == b->has_height && a->height == b->height;
+}
