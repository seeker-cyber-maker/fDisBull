+FdisbullInputInfo *qmp_x_fdisbull_arm_display_motion(
+    const char *token, int64_t dx, int64_t dy,
+    FdisbullDisplayMotionExpected *expected, Error **errp)
+{
+    g_autoptr(FdisbullVgaConfigurationInfo) armed = NULL;
+    FdisbullInputMotion motion = {
+        .dx = dx, .dy = dy, .delay_ns = INPUT_MOTION_DELAY_NS,
+    };
+    InputMoveEvent move_x = { .axis = INPUT_AXIS_X, .value = dx };
+    InputMoveEvent move_y = { .axis = INPUT_AXIS_Y, .value = dy };
+    InputEvent event_x = { .type = INPUT_EVENT_KIND_REL,
+                          .u.rel = { .data = &move_x } };
+    InputEvent event_y = { .type = INPUT_EVENT_KIND_REL,
+                          .u.rel = { .data = &move_y } };
+    InputEventList list_y = { .value = &event_y };
+    InputEventList list_x = { .value = &event_x, .next = dy ? &list_y : NULL };
+    const FdisbullDisplayInfo *display;
+    const FdisbullVgaConfigurationSnapshot *current, *published;
+    int64_t now;
+
+    if (!input_arm_guard(token, errp)) {
+        return NULL;
+    }
+    if (dx < -INPUT_MOTION_REL_LIMIT || dx > INPUT_MOTION_REL_LIMIT ||
+        dy < -INPUT_MOTION_REL_LIMIT || dy > INPUT_MOTION_REL_LIMIT ||
+        (!dx && !dy)) {
+        error_setg(errp, "Display motion requires a nonzero relative X/Y pair "
+                   "with each count in -127..127");
+        return NULL;
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (now < 0 || now > INT64_MAX - INPUT_MOTION_DELAY_NS) {
+        error_setg(errp, "Display motion deadline exceeds signed virtual time");
+        return NULL;
+    }
+    armed = fdisbull_vga_configuration_snapshot_owned(errp);
+    if (!armed) {
+        return NULL;
+    }
+    if (!input_motion_observation_coherent(armed)) {
+        error_setg(errp, "Display motion requires coherent owned configuration "
+                   "and publication observations");
+        return NULL;
+    }
+    display = armed->display;
+    current = armed->current;
+    published = armed->published;
+    if (!expected || !published || g_strcmp0(display->state, "stopped") ||
+        !display->has_stop_ns || current->epoch != input_schedule.epoch ||
+        current->virtual_ns != now || expected->virtual_ns != now ||
+        expected->epoch != current->epoch ||
+        g_strcmp0(expected->device, current->device) ||
+        g_strcmp0(expected->model, current->model) ||
+        expected->configuration_generation != current->configuration_generation ||
+        expected->configuration_generation != published->configuration_generation ||
+        g_strcmp0(expected->window, display->token) ||
+        expected->update_id != display->update_id ||
+        expected->published_ns != display->published_ns ||
+        expected->width != display->width || expected->height != display->height ||
+        !input_motion_raw_equal(current->raw, published->raw)) {
+        error_setg(errp, "Display motion expectations differ from a stopped "
+                   "nonempty publication and its current configuration");
+        return NULL;
+    }
+    motion.armed = armed;
+    /*
+     * prepare() deep-copies only nonzero X then nonzero Y before accepting the
+     * token.  One final sync follows the batch.  No button event or zero-valued
+     * callback is invented, and native code does not interpret a pixel scale.
+     */
+    return input_arm(token, now, now + INPUT_MOTION_DELAY_NS,
+                     dx ? &list_x : &list_y, NULL, &motion, errp);
+}
