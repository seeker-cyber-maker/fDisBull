+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Internal observations of the admitted VGA and retained display owner. */
+#ifndef SYSTEM_FDISBULL_DISPLAY_H
+#define SYSTEM_FDISBULL_DISPLAY_H
+
+#include "qapi/qapi-types-fdisbull-vga-configuration.h"
+
+/*
+ * Requires BQL, prior precise VGA admission and an initialized display owner.
+ * Unlike the public stopped-only query, input may call this while running or
+ * with an armed clock budget.  The current/display timestamps describe that
+ * actual observation; the published snapshot keeps its historical timestamp.
+ * The caller must apply its own stop/budget precedence and publication policy.
+ *
+ * This never admits an owner, renders, rearms a timer or repairs configuration
+ * history.  Valid empty/replaced/observing windows remain observable so a caller
+ * can cancel its old binding with evidence.  Invalidated identity is an error.
+ * The caller owns the returned immutable snapshot and must not use historical
+ * callback observations to replace a later live configuration frontier.
+ */
+FdisbullVgaConfigurationInfo *
+fdisbull_vga_configuration_snapshot_owned(Error **errp);
+
+#endif
