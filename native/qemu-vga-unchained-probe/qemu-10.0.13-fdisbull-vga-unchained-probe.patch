+FdisbullUnchainedVideoProbe *qmp_x_fdisbull_probe_unchained_vga_rows(
+    uint8List *rows, Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    QemuConsole *console;
+    Object *device;
+
+    uint8_t selected[16];
+    bool seen[FDISBULL_VIDEO_HEIGHT] = { 0 };
+    unsigned count = 0;
+
+    for (const uint8List *entry = rows; entry; entry = entry->next) {
+        unsigned row = entry->value;
+
+        if (count == ARRAY_SIZE(selected) || row >= FDISBULL_VIDEO_HEIGHT ||
+            seen[row]) {
+            error_setg(errp, "Expected one to 16 unique unchained VGA source rows");
+            return NULL;
+        }
+        selected[count++] = row;
+        seen[row] = true;
+    }
+    if (!count) {
+        error_setg(errp, "Expected one to 16 unique unchained VGA source rows");
+        return NULL;
+    }
+    if (!video_stopped(&clock, errp)) {
+        return NULL;
+    }
+    device = video_device(&console, errp);
+    return device ? pci_std_vga_fdisbull_probe_unchained_rows(
+        device, clock->epoch, clock->virtual_ns, selected, count, errp) : NULL;
+}
