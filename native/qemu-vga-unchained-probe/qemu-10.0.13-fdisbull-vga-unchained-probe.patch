+/* Timed renderers use a separate contract. This only admits a stopped
+ * nonwrapping 320x200 256-color source page in standard VGA storage. */
+static inline const char *
+fdisbull_unchained_admission(const FdisbullChain4Geometry *g,
+                            unsigned sequencer_memory, unsigned graphics_misc,
+                            unsigned crtc_underline)
+{
+    const uint64_t source_bytes = 320u * 200u;
+
+    if (!g->display_enabled || !g->graphics) {
+        return "display-disabled-or-not-graphics";
+    }
+    if (g->vbe_enabled || g->chain4 || g->depth != 0 || g->shift_control != 2 ||
+        (sequencer_memory & 0x0e) != 0x06 || (graphics_misc & 0x0f) != 0x05) {
+        return "unsupported-unchained-pixel-interpretation";
+    }
+    if (g->width != 640 || g->height != 400 || g->multi_scan != 1) {
+        return "unsupported-source-extent";
+    }
+    if ((g->crtc_mode & 0x43) != 0x43 || (crtc_underline & 0x40) ||
+        (g->attribute_mode & ~0x20) != 0x41 || (g->plane_enable & 15) != 15) {
+        return "unsupported-address-or-plane-mode";
+    }
+    if (g->bank_offset || g->line_offset != 320 || g->line_compare < 400 ||
+        g->hpel || (g->start_address & 3)) {
+        return "unsupported-origin-pitch-split-or-panning";
+    }
+    if (g->vram_size < source_bytes ||
+        g->start_address > g->vram_size - source_bytes) {
+        return "incomplete-or-wrapping-source-storage";
+    }
+    return NULL;
+}
