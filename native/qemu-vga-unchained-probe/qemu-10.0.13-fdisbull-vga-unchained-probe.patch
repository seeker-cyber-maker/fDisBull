+FdisbullUnchainedVideoProbe *vga_fdisbull_probe_unchained_rows(
+    VGACommonState *s, int64_t virtual_ns, const uint8_t *rows, unsigned count, Error **errp)
+{
+    g_autoptr(FdisbullVgaConfigurationSnapshot) configuration =
+        g_new0(FdisbullVgaConfigurationSnapshot, 1);
+    g_autoptr(FdisbullRetraceInfo) retrace = g_new0(FdisbullRetraceInfo, 1);
+    g_autoptr(FdisbullUnchainedVideoProbe) result = NULL;
+    FdisbullUnchainedVideoRowList **tail;
+    VGADisplayParams params;
+    FdisbullChain4Geometry geometry;
+    int width, height, double_scan, multi_scan;
+    const char *reason;
+
+    assert(bql_locked());
+    if (!count || !s->vram_ptr) {
+        error_setg(errp, "Unchained VGA source rows and storage are required");
+        return NULL;
+    }
+    if (!vga_fdisbull_configuration_query(s, configuration, errp) ||
+        !vga_fdisbull_retrace_query(s, virtual_ns, retrace, errp)) {
+        return NULL;
+    }
+    if (!retrace->phase_supported) {
+        error_setg(errp, "Unchained VGA source probe requires admitted precise timing");
+        return NULL;
+    }
+
+    vga_get_params(s, &params);
+    vga_get_resolution(s, &width, &height);
+    double_scan = s->cr[VGA_CRTC_MAX_SCAN] >> 7;
+    multi_scan = (s->cr[VGA_CRTC_MODE] & 1) ?
+        (((s->cr[VGA_CRTC_MAX_SCAN] & 0x1f) + 1) << double_scan) - 1 :
+        double_scan;
+    geometry = vga_fdisbull_chain4_geometry(s, width, height, vga_get_bpp(s),
+                    (s->gr[VGA_GFX_MODE] >> 5) & 3, multi_scan);
+    geometry.start_address = (uint64_t)params.start_addr * 4;
+    geometry.line_offset = params.line_offset;
+    geometry.line_compare = params.line_compare;
+    geometry.hpel = params.hpel & 7;
+    geometry.vram_size = MIN(MIN(s->vram_size, s->vbe_size), VGA_VRAM_SIZE);
+    reason = fdisbull_unchained_admission(&geometry,
+                 sr(s, VGA_SEQ_MEMORY_MODE), s->gr[VGA_GFX_MISC],
+                 s->cr[VGA_CRTC_UNDERLINE]);
+    if (reason) {
+        error_setg(errp, "Unchained VGA source probe is unsupported: %s", reason);
+        return NULL;
+    }
+
+    result = g_new0(FdisbullUnchainedVideoProbe, 1);
+    result->model = g_strdup("qemu-vga-unchained-320x200-probe-v1");
+    result->configuration_generation = configuration->configuration_generation;
+    result->timing_generation = retrace->timing_generation;
+    result->origin_bytes = geometry.start_address;
+    result->pitch_bytes = geometry.line_offset;
+    result->dac_8bit = s->dac_8bit;
+    tail = &result->rows;
+    for (unsigned i = 0; i < count; i++) {
+        uint8_t rgb[FDISBULL_VIDEO_ROW_BYTES];
+
+        /* With this geometry QEMU's stock 8d2 renderer takes four adjacent
+         * interleaved plane bytes at a time from the same byte origin. */
+        if (!fdisbull_video_copy_row(s->vram_ptr + geometry.start_address +
+                                    rows[i] * geometry.line_offset,
+                                    FDISBULL_VIDEO_WIDTH, s->palette,
+                                    sizeof(s->palette), s->dac_8bit,
+                                    rgb, sizeof(rgb))) {
+            error_setg(errp, "Unchained VGA source row is incomplete");
+            return NULL;
+        }
+        FdisbullUnchainedVideoRow *row = g_new0(FdisbullUnchainedVideoRow, 1);
+        row->row = rows[i];
+        row->rgb_base64 = g_base64_encode(rgb, sizeof(rgb));
+        QAPI_LIST_APPEND(tail, row);
+    }
+    return g_steal_pointer(&result);
+}
