--- a/qemu-10.0.13/qapi/fdisbull-dos-checkpoint.json
+++ b/qemu-10.0.13/qapi/fdisbull-dos-checkpoint.json
@@ -0,0 +1,49 @@
+##
+# Read-only UART state for stopped fDisBull DOS process checkpoints.
+##
+
+##
+# @FdisbullDosCheckpointStatus:
+# Bounded internal state for the one ISA COM2 UART. The device registers are
+# sampled directly; this command never performs guest I/O-port reads, so it
+# cannot pop receive data or clear line-status error bits. Host socket buffers
+# are outside this reply and must be checked by the owning host session.
+#
+# @device-path: Stable QOM path of the selected ISA serial frontend.
+# @uart-path: Stable QOM path of its native UART child.
+# @device-type: QOM device type.
+# @index: ISA serial index.
+# @iobase: ISA I/O base, required to equal 0x2f8.
+# @irq: ISA interrupt line.
+# @lsr: Raw line status register value.
+# @fifo-enabled: Whether the UART FIFO enable bit is set.
+# @rx-fifo-bytes: Number of bytes in the receive FIFO, at most 16.
+# @tx-fifo-bytes: Number of bytes in the transmit FIFO, at most 16.
+# @rbr: Receive buffer register value; may be stale while FIFO mode is active.
+# @thr: Transmit holding register value; may be stale while FIFO mode is active.
+# @tsr: Transmit shift register value; may be stale when @temt is true.
+# @tsr-retry: Pending character backend write retries.
+# @thre: Raw LSR transmit-holding/FIFO-empty bit.
+# @temt: Raw LSR transmitter-empty bit.
+# @tx-idle: True only when both raw empty bits are set, the TX FIFO is empty,
+#     and no backend retry is pending. This does not attest the host socket queue.
+# @rx-empty: True only when LSR data-ready is clear and the RX FIFO is empty.
+##
+{ 'struct': 'FdisbullDosCheckpointStatus',
+  'data': { 'device-path': 'str', 'uart-path': 'str', 'device-type': 'str', 'index': 'uint32',
+            'iobase': 'uint16', 'irq': 'uint16', 'lsr': 'uint8',
+            'fifo-enabled': 'bool', 'rx-fifo-bytes': 'uint8',
+            'tx-fifo-bytes': 'uint8', 'rbr': 'uint8', 'thr': 'uint8',
+            'tsr': 'uint8', 'tsr-retry': 'uint32', 'thre': 'bool',
+            'temt': 'bool', 'tx-idle': 'bool', 'rx-empty': 'bool' } }
+
+##
+# @x-fdisbull-dos-checkpoint-status:
+# Read the internal state of exactly one realized ISA serial device at 0x2f8.
+# Requires a paused, single-vCPU system-mode TCG machine. No UART register is
+# read through its I/O interface and no FIFO or error state is changed.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-dos-checkpoint-status',
+  'returns': 'FdisbullDosCheckpointStatus' }
