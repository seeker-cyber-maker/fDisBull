+FdisbullDosSaveStopInfo *qmp_x_fdisbull_set_dos_save_stop(
+    const char *token, uint64_t epoch, uint64_t expected_generation,
+    bool enabled, Error **errp)
+{
+    CPUState *cpu;
+    CPUX86State *env;
