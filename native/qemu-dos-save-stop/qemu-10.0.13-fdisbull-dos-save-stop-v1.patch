+static bool dos_save_stop_cas(const char *token, uint64_t epoch,
+                              uint64_t expected_generation, Error **errp)
+{
+    if (!witness.token[0] || !token || strcmp(token, (const char *)witness.token) ||
+        epoch != witness.stop_epoch ||
+        expected_generation != witness.stop_generation) {
+        error_setg(errp, "DOS save-stop owner or generation CAS failed");
+        return false;
+    }
+    return true;
+}
+
+FdisbullDosSaveStopInfo *qmp_x_fdisbull_query_dos_save_stop(Error **errp)
+{
+    CPUState *cpu;
+    CPUX86State *env;
+    if (!stopped_cpu(&cpu, &env, false, errp) || !witness_register_vmstate(errp)) {
+        return NULL;
+    }
+    fdisbull_dos_save_stop_handle_request();
+    return dos_save_stop_info();
