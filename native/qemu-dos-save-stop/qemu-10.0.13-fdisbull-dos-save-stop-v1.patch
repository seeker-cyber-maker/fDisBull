+static void dos_save_stop_latch(uint8_t state, const char *reason,
+                                CPUX86State *env, const DosWitnessEvent *event)
+{
+    witness.stop_pending = false;
+    witness.stop_state = state;
+    witness.stop_acknowledged = false;
+    witness.stop_event_count = witness.event_count;
+    witness.stop_witness_generation = witness.generation;
+    witness.stop_return_pc = event->return_pc;
+    witness.stop_return_cs = env->segs[R_CS].selector;
+    witness.stop_return_ss = env->segs[R_SS].selector;
+    witness.stop_return_sp = env->regs[R_ESP] & 0xffff;
+    g_strlcpy((char *)witness.stop_reason, reason ? reason : "",
+              sizeof(witness.stop_reason));
+    dos_save_stop_advance_generation();
+}
+
+static void dos_save_stop_on_ready(CPUX86State *env,
+                                   const DosWitnessEvent *event)
+{
+    CPUState *cpu = env_cpu(env);
+    const char *reason = NULL;
+
+    if (!witness.stop_enabled || !witness.active || !witness.valid ||
+        witness.operation_policy != 1 || witness.phase != 6 ||
+        witness.pending || witness.hardware_depth || !witness.close_seen ||
+        !witness.flush_seen || witness.file_open || witness.temporary_exists) {
+        return;
+    }
+    if ((witness.stop_state == DOS_SAVE_STOP_CONSUMED ||
+         witness.stop_state == DOS_SAVE_STOP_PREEMPTED) &&
+        !witness.stop_acknowledged) {
+        witness.stop_enabled = false;
+        witness.stop_pending = false;
+        witness.stop_state = DOS_SAVE_STOP_INVALID;
+        g_strlcpy((char *)witness.stop_reason,
+                  "new flush reached before prior stop receipt was acknowledged",
+                  sizeof(witness.stop_reason));
+        dos_save_stop_advance_generation();
+        return;
+    }
+    if (witness.stop_state == DOS_SAVE_STOP_PENDING ||
+        stop_sequence_highwater == UINT64_MAX) {
+        witness.stop_enabled = false;
+        witness.stop_state = DOS_SAVE_STOP_INVALID;
+        g_strlcpy((char *)witness.stop_reason,
+                  "safe-stop attempt sequence is unresolved or exhausted",
+                  sizeof(witness.stop_reason));
+        dos_save_stop_advance_generation();
+        return;
+    }
+    witness.stop_sequence = stop_sequence_highwater++;
+
+    if (cpu->stop || cpu->stopped) {
+        reason = "existing-cpu-stop";
+    } else if (cpu->singlestep_enabled) {
+        reason = "single-step-stop-precedence";
+    } else if (cpu->interrupt_request & CPU_INTERRUPT_DEBUG) {
+        reason = "debug-interrupt-pending";
+    } else if (cpu_breakpoint_test(cpu, event->return_pc, BP_GDB | BP_CPU)) {
+        reason = "breakpoint-at-return-pc";
+    } else if (fdisbull_clock_budget_active()) {
+        reason = "clock-budget-owns-stop-selection";
+    } else if (fdisbull_display_frame_fence_blocks_control()) {
+        reason = "display-frame-fence-owns-stop-selection";
+    }
+
+    if (reason) {
+        dos_save_stop_latch(DOS_SAVE_STOP_PREEMPTED, reason, env, event);
+        return;
+    }
+
+    witness.stop_pending = true;
+    witness.stop_state = DOS_SAVE_STOP_PENDING;
+    witness.stop_acknowledged = false;
+    witness.stop_event_count = witness.event_count;
+    witness.stop_witness_generation = witness.generation;
+    witness.stop_return_pc = event->return_pc;
+    witness.stop_return_cs = env->segs[R_CS].selector;
+    witness.stop_return_ss = env->segs[R_SS].selector;
+    witness.stop_return_sp = env->regs[R_ESP] & 0xffff;
+    witness.stop_reason[0] = 0;
+    if (!dos_save_stop_advance_generation()) {
+        return;
+    }
+    /* cpu_exit forces the current translated IRET instruction to finish at
+     * its own safe boundary.  The main-loop handler attributes PAUSED. */
+    cpu_stop_current();
+    qemu_notify_event();
+}
