+    if (!stopped_cpu(&cpu, &env, false, errp) || !witness_register_vmstate(errp) ||
+        !dos_save_stop_cas(token, epoch, expected_generation, errp)) {
+        return NULL;
+    }
+    if (witness.stop_pending ||
+        ((witness.stop_state == DOS_SAVE_STOP_CONSUMED ||
+          witness.stop_state == DOS_SAVE_STOP_PREEMPTED) &&
