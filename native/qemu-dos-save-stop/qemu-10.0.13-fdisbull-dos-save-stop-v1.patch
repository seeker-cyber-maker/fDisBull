+    if (enabled && (!witness.active || !witness.valid ||
+                    witness.operation_policy != 1)) {
+        error_setg(errp, "Automatic save-stop requires a valid active save-operations v2 witness");
+        return NULL;
+    }
+    if (enabled && witness.stop_state == DOS_SAVE_STOP_INVALID) {
+        error_setg(errp, "Invalid save-stop control requires a fresh save-witness owner");
+        return NULL;
+    }
+    if (enabled && (fdisbull_clock_budget_active() ||
