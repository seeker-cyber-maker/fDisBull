+##
+# @FdisbullDosSaveStopInfo:
+# @api-version: Version of the independent safe-stop receipt protocol.
+# @model: Exact native model name.
+# @observer-token: Current save-witness owner token, or empty before arming.
+# @epoch: Safe-stop owner epoch, rotated after native restore.
+# @generation: Safe-stop compare-and-swap generation.
+# @observer-generation: Current save-witness generation.
+# @enabled: Whether future qualifying AH=0Dh returns request a stop.
+# @state: Current stop receipt state.
+# @sequence: Monotone one-shot qualifying-return sequence.
+# @acknowledged: Whether the current terminal receipt has been acknowledged.
+# @pending: A stop request awaits main-loop consumption.
+# @event-count: Witness event count latched at the qualifying return.
+# @witness-generation: Witness generation latched at the qualifying return.
+# @return-pc: Linear return address immediately after the qualifying IRET.
+# @return-cs: Return CS selector.
+# @return-ss: Return SS selector.
+# @return-sp: Return 16-bit return stack pointer.
+# @reason: Empty for normal receipts, otherwise a bounded diagnostic.
+##
+{ 'struct': 'FdisbullDosSaveStopInfo',
+  'data': { 'api-version': 'int', 'model': 'str', 'observer-token': 'str',
+            'epoch': 'uint64', 'generation': 'uint64',
+            'observer-generation': 'uint64', 'enabled': 'bool', 'state': 'str',
+            'sequence': 'uint64', 'acknowledged': 'bool', 'pending': 'bool',
+            'event-count': 'uint32', 'witness-generation': 'uint64',
+            'return-pc': 'uint32', 'return-cs': 'uint16',
+            'return-ss': 'uint16', 'return-sp': 'uint16', 'reason': 'str' } }
+
+##
+# @x-fdisbull-query-dos-save-stop:
+# Query the independent automatic safe-stop receipt. This command does not
+# infer a stop from a ready save ledger and never resumes guest execution.
+##
+{ 'command': 'x-fdisbull-query-dos-save-stop',
+  'returns': 'FdisbullDosSaveStopInfo' }
+
+##
+# @x-fdisbull-set-dos-save-stop:
+# @token: Current save-witness owner token.
+# @epoch: Current safe-stop epoch.
+# @expected-generation: Safe-stop CAS generation observed by the caller.
+# @enabled: Enable stop requests for future qualifying flush returns.
+#
+# Set the one-shot automatic stop policy without changing witness proof data.
+##
+{ 'command': 'x-fdisbull-set-dos-save-stop',
+  'data': { 'token': 'str', 'epoch': 'uint64',
+            'expected-generation': 'uint64', 'enabled': 'bool' },
+  'returns': 'FdisbullDosSaveStopInfo' }
+
+##
+# @x-fdisbull-ack-dos-save-stop:
+# @token: Current save-witness owner token.
+# @epoch: Current safe-stop epoch.
+# @expected-generation: Safe-stop CAS generation observed by the caller.
+# @sequence: Exact terminal stop receipt sequence to acknowledge.
+#
+# Acknowledge a consumed or preempted receipt. Acknowledgement never retries.
+##
+{ 'command': 'x-fdisbull-ack-dos-save-stop',
+  'data': { 'token': 'str', 'epoch': 'uint64',
+            'expected-generation': 'uint64', 'sequence': 'uint64' },
+  'returns': 'FdisbullDosSaveStopInfo' }

