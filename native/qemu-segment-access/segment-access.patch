+/* Check the segment-relative offset for one scalar memory operand. */
+static void gen_check_mem_segment(DisasContext *s, X86DecodedInsn *decode,
+                                  MemOp ot)
+{
+    int seg_reg;
+    bool seg_added;
+    TCGv ea;
+    TCGv offset;
+
+    if (!PE(s) || CODE64(s)) {
+        return;
+    }
+
+    seg_reg = s->override >= 0 ? s->override : decode->mem.def_seg;
+    seg_added = s->override >= 0 || ADDSEG(s);
+    if (s->aflag == MO_64 && s->override < 0) {
+        seg_added = false;
+    }
+    if (seg_added) {
+        ea = tcg_temp_new();
+        tcg_gen_sub_tl(ea, s->A0, cpu_seg_base[seg_reg]);
+    } else {
+        ea = s->A0;
+    }
+    offset = gen_ext_tl(NULL, ea, s->aflag, false);
+    gen_helper_check_seg_access(tcg_env, offset,
+                                tcg_constant_i32(seg_reg),
+                                tcg_constant_i32(1 << ot));
+}
