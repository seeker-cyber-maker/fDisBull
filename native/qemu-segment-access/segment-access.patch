+
+/* Check one legacy-mode data access before its memory operation. */
+void helper_check_seg_access(CPUX86State *env, target_ulong offset,
+                             int seg_reg, int size)
+{
+    SegmentCache *seg = &env->segs[seg_reg];
+    uint64_t first = offset;
+    uint64_t last = first + size - 1;
+    bool expand_down = (seg->flags & DESC_S_MASK) &&
+        !(seg->flags & DESC_CS_MASK) &&
+        (seg->flags & DESC_E_MASK);
+
+#ifdef TARGET_X86_64
+    /* Segment limits are ignored in 64-bit submode. */
+    if (env->hflags & HF_CS64_MASK) {
+        return;
+    }
+#endif
+    if (!(env->hflags & HF_PE_MASK)) {
+        return;
+    }
+
+    if ((seg->selector & 0xfffc) == 0 || !(seg->flags & DESC_P_MASK)) {
+        raise_exception_err_ra(env,
+                               seg_reg == R_SS ? EXCP0C_STACK : EXCP0D_GPF,
+                               0, GETPC());
+    }
+
+    if (expand_down) {
+        uint64_t upper = (seg->flags & DESC_B_MASK) ? UINT32_MAX : UINT16_MAX;
+
+        if (first <= seg->limit || last > upper) {
+            raise_exception_err_ra(env,
+                                   seg_reg == R_SS ? EXCP0C_STACK : EXCP0D_GPF,
+                                   0, GETPC());
+        }
+    } else if (last > seg->limit) {
+        raise_exception_err_ra(env,
+                               seg_reg == R_SS ? EXCP0C_STACK : EXCP0D_GPF,
+                               0, GETPC());
+    }
