+void AGENT_EnableFrameSourceProbe(bool enabled)
+{
+    if (enabled != frame_source_probe_enabled) {
+        frame_source_probe_enabled = enabled;
+        AGENT_AbandonFrameSource();
+        agent_frame.source = FrameSourceSnapshot();
+    }
+}
+
+bool AGENT_FrameSourceProbeEnabled()
+{
+    return frame_source_probe_enabled && agent_frame_capture_enabled;
+}
+
+void AGENT_BeginFrameSource(std::uint64_t latched_start, std::uint64_t draw_address,
+                            std::uint64_t ticks, std::uint64_t cycles,
+                            std::uint64_t cycles_per_tick)
+{
+    if (!frame_source_probe_enabled || !agent_frame_capture_enabled) {
+        return;
+    }
+    FrameSourceSnapshot pending;
+    pending.latched_crtc_start = latched_start;
+    pending.selected_draw_address = draw_address;
+    pending.selected_ticks = ticks;
+    pending.selected_tick_cycles = cycles;
+    pending.cycles_per_tick = cycles_per_tick;
+    pending.indices.resize(FrameSourceSnapshot::width * FrameSourceSnapshot::height);
+    pending_frame_source = std::move(pending);
+    frame_source_rows = 0;
+}
+
+bool AGENT_FrameSourcePending() { return !pending_frame_source.indices.empty(); }
+
+void AGENT_AbandonFrameSource()
+{
+    pending_frame_source.indices.clear();
+    frame_source_rows = 0;
+}
+
+void AGENT_RecordFrameSourceRow(std::uint32_t row, std::uint64_t row_address,
+                                const std::uint8_t* indices)
+{
+    if (!AGENT_FrameSourcePending() || row != frame_source_rows ||
+        row >= FrameSourceSnapshot::height) {
+        AGENT_AbandonFrameSource();
+        return;
+    }
+    if (row == 0) {
+        pending_frame_source.first_row_address = row_address;
+    }
+    memcpy(pending_frame_source.indices.data() + row * FrameSourceSnapshot::width,
+           indices, FrameSourceSnapshot::width);
+    ++frame_source_rows;
+}
