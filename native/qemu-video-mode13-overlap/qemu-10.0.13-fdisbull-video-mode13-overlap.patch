+static bool video_mode_phase(int64_t setup, bool reapplied, int64_t start,
+                             int64_t period, unsigned *phase)
+{
+    int64_t first;
+
+    if (!reapplied) {
+        return fdisbull_video_mode_phase(setup, start, period, phase);
+    }
+    if (!fdisbull_video_next_start(setup, period, &first) ||
+        start < first || start % period) {
+        return false;
+    }
+    /* The mixed odd raster is followed by one full even raster. */
+    *phase = start - first == period ? 0 : 1;
+    return true;
