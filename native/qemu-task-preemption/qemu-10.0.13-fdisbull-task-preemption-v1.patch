+    if (!pic_inflight || pic_inflight_slot >= TASK_MAX ||
+        scheduler_selected != pic_inflight_slot || !frame ||
+        !frame->pic_irq_valid || frame->pic_eoi_seen ||
+        frame->pic_irq != pic_inflight_irq ||
