+static bool pic_preemption_mode_supported(const PICPreemptionState *pic,
+                                          uint8_t irq, Error **errp)
+{
+    if (!pic || !pic->present || irq > 7 || irq == 2 ||
+        pic->master_auto_eoi || pic->slave_auto_eoi ||
+        pic->master_special_fully_nested || pic->slave_special_fully_nested ||
+        pic->master_special_mask || pic->slave_special_mask ||
+        pic->master_poll || pic->slave_poll ||
+        pic->master_single_mode || pic->slave_single_mode ||
+        pic->master_init_state || pic->slave_init_state) {
+        task_error(errp, "PIC preemption requires normal dual-8259 mode, a direct master IRQ other than cascade IRQ2, no polling, and no auto-EOI");
+        return false;
+    }
+    return true;
+}
