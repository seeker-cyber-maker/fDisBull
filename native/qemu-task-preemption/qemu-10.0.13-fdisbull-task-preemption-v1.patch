+        info->spurious || !info->acknowledged || info->slave ||
+        info->master_irq == 2 || info->master_auto_eoi ||
+        info->slave_auto_eoi || intno != info->vector) {
+        task_pic_preemption_fault(cpu,
+            "accepted hard interrupt was spurious, APIC, slave-cascade, auto-EOI, or otherwise outside the supported master-PIC path");
