+        !tasks[pic_inflight_slot].used) {
+        return NULL;
+    }
+    TaskState *task = &tasks[pic_inflight_slot];
+    for (int i = task->frame_depth - 1; i >= 0; i--) {
+        TaskFrameState *frame = &task->frames[i];
+        if (frame->sequence == pic_inflight_frame_sequence) {
+            return frame;
+        }
+    }
