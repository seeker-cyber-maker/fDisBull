+            "target PIC IRQ has no matching newly-created hardware frame");
+        return;
+    }
+    pic_ack_count++;
+    frame->pic_irq_valid = true;
+    frame->pic_irq = info->irq;
+    frame->pic_vector = info->vector;
+    frame->pic_ack_sequence = pic_ack_count;
+    frame->pic_eoi_seen = false;
+    pic_inflight = true;
+    pic_inflight_slot = scheduler_selected;
+    pic_inflight_irq = info->irq;
+    pic_inflight_vector = info->vector;
+    pic_inflight_sequence = pic_ack_count;
+    pic_inflight_frame_sequence = frame->sequence;
+}
