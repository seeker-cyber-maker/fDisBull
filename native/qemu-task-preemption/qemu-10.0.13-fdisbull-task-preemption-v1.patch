+void fdisbull_task_scheduler_pic_observer(PICCommonState *pic,
+                                          PICPreemptionEvent event,
+                                          bool master, uint8_t irq)
+{
+    CPUState *cpu = current_cpu;
+    PICPreemptionState state = {0};
+    TaskFrameState *frame;
+    g_autoptr(Error) err = NULL;
+
+    if (!pic_preemption_enabled) {
+        return;
+    }
+    if (event == PIC_PREEMPTION_EVENT_CONFIG) {
+        task_pic_preemption_fault(cpu,
+            "8259 PIC was reinitialized or changed into an unsupported mode while preemption was enabled");
+        return;
+    }
+    if (event == PIC_PREEMPTION_EVENT_POLL_ACK) {
+        task_pic_preemption_fault(cpu,
+            "8259 poll-mode acknowledgement is unsupported for task preemption");
+        return;
+    }
+    if (event != PIC_PREEMPTION_EVENT_EOI) {
+        return;
+    }
+    if (!master) {
+        task_pic_preemption_fault(cpu,
+            "slave-PIC cascade EOI is unsupported for task preemption");
+        return;
+    }
+    if (irq != pic_preemption_irq) {
+        return;
+    }
+    frame = task_pic_inflight_frame();
+    if (!pic_inflight || scheduler_selected != pic_inflight_slot || !frame ||
+        !frame->pic_irq_valid || frame->pic_eoi_seen ||
+        frame->pic_irq != pic_inflight_irq ||
+        frame->pic_vector != pic_inflight_vector ||
+        frame->pic_ack_sequence != pic_inflight_sequence ||
+        frame->sequence != pic_inflight_frame_sequence ||
+        pic_inflight_irq != pic_preemption_irq) {
+        task_pic_preemption_fault(cpu,
+            "PIC EOI did not match the selected task's outstanding IRQ frame");
+        return;
+    }
+    if (!frame || !pic_get_preemption_state(&state) ||
+        (state.master_isr & (1u << irq))) {
+        task_pic_preemption_fault(cpu,
+            "master PIC EOI did not clear the tracked in-service line");
+        return;
+    }
+    if (pic_eoi_count == UINT64_MAX) {
+        task_pic_preemption_fault(cpu, "PIC EOI counter exhausted");
+        return;
+    }
+    frame->pic_eoi_seen = true;
+    pic_eoi_count++;
+    pic_inflight = false;
+    pic_inflight_slot = UINT8_MAX;
+    pic_inflight_sequence = 0;
+    pic_inflight_frame_sequence = 0;
+    if (pic_preemption_progress >= pic_preemption_quantum - 1) {
+        pic_preemption_progress = 0;
+        pic_pending_irq = pic_preemption_irq;
+        pic_pending_vector = frame->pic_vector;
+        pic_preemption_pending = true;
+        if (cpu) {
+            cpu_exit(cpu);
