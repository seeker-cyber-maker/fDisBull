  "generation_transitions": [
    "CR3 value changes",
    "successful LLDT hidden-cache changes",
    "successful LTR hidden-cache changes",
    "successful hardware TSS task switch",
    "x86 CPU reset (advances epoch and generation)"
  ],
  "anchor_protocol": {
    "size": 56,
    "layout": [
      "8-byte magic FDBTASK1",
      "16-byte UUID",
      "uint64 little-endian scheduler sequence",
      "uint64 little-endian task cookie",
      "uint64 little-endian incarnation",
      "uint32 little-endian state (1 active)",
      "uint32 little-endian reserved (0)"
    ],
    "native_behavior": "Raw byte read only; host validates protocol and derives any monitor task identity."
  },
  "limits": [
    "Architectural context and generation are not a QEMM/DESQview software task ID.",
    "Tasks sharing CR3/TR/LDTR without a cooperating anchor remain indistinguishable.",
    "Anchor address must map to one contiguous 56-byte direct RAM span; I/O, ROM/ROMD, RAM devices, discard-managed and cross-region reads are refused.",
    "Task-context VMState is registered when the QMP query is first called; host must query source and fresh destination before snapshot save/load.",
    "QEMU does not parse the anchor; software identity and sequence validation belong to the host.",
    "This x86-specific patch has no non-x86 QMP-handler stub and is intended for an x86 system target, not a multi-target QEMU build."
  ],
