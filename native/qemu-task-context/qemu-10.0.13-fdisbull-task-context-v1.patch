+# Read-only x86 architectural task context plus a caller-selected RAM anchor.
+##
+# @FdisbullTaskContextInfo:
+#
+# Stopped x86 architectural context.  This is not a guest software-task ID.
+#
+# @api-version: Private wire protocol version.
+# @model: Exact architectural observation model.
+# @epoch: Native owner epoch, changed after loading a saved context.
+# @context-generation: Monotone transition counter for CR3, task-register,
+#   local-descriptor-table and hardware TSS task-switch transitions.
+# @cpu-index: The sole observed CPU's index.
+# @mode: Current architectural execution mode.
+# @cpl: Current privilege level.
+# @eip: Current instruction pointer.
+# @esp: Current stack pointer.
+# @cs-selector: Current code segment selector.
+# @ss-selector: Current stack segment selector.
+# @cr0: Current control register 0.
+# @cr3: Current control register 3.
+# @cr4: Current control register 4.
+# @efer: Current extended feature enable register.
+# @gdt-base: Current GDT base.
+# @gdt-limit: Current GDT limit.
+# @idt-base: Current IDT base.
+# @idt-limit: Current IDT limit.
+# @tr-selector: Current task-register selector.
+# @tr-base: Hidden task-register base.
+# @tr-limit: Hidden task-register limit.
+# @tr-flags: Hidden task-register flags.
+# @ldtr-selector: Current local-descriptor-table selector.
+# @ldtr-base: Hidden local-descriptor-table base.
+# @ldtr-limit: Hidden local-descriptor-table limit.
+# @ldtr-flags: Hidden local-descriptor-table flags.
+# @anchor-address: Optional guest physical address supplied by the caller.
+# @anchor-hex: Exactly 56 bytes read from the supplied direct RAM address.
+#
+# The optional anchor bytes are returned unchanged.  The monitor format and
+# any software-task meaning are interpreted by the host, not QEMU.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullTaskContextInfo',
+  'data': { 'api-version': 'int', 'model': 'str', 'epoch': 'uint64',
+            'context-generation': 'uint64', 'cpu-index': 'int', 'mode': 'str',
+            'cpl': 'int', 'eip': 'uint64', 'esp': 'uint64',
+            'cs-selector': 'uint32', 'ss-selector': 'uint32',
+            'cr0': 'uint64', 'cr3': 'uint64', 'cr4': 'uint64', 'efer': 'uint64',
+            'gdt-base': 'uint64', 'gdt-limit': 'uint32',
+            'idt-base': 'uint64', 'idt-limit': 'uint32',
+            'tr-selector': 'uint32', 'tr-base': 'uint64',
+            'tr-limit': 'uint32', 'tr-flags': 'uint32',
+            'ldtr-selector': 'uint32', 'ldtr-base': 'uint64',
+            'ldtr-limit': 'uint32', 'ldtr-flags': 'uint32',
+            '*anchor-address': 'uint64', '*anchor-hex': 'str' } }
+
+##
+# @x-fdisbull-query-task-context:
+#
+# Read the stopped single-vCPU x86 architectural task context.  If an anchor
+# address is supplied, read 56 bytes only from direct guest RAM.
+#
+# @anchor-address: Optional guest physical address of the caller-owned anchor.
+#
+# Since: 10.0
+##
+{ 'command': 'x-fdisbull-query-task-context',
+  'data': { '*anchor-address': 'uint64' },
+  'returns': 'FdisbullTaskContextInfo' }
