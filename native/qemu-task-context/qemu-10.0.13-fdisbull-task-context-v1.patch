+/*
+ * Stopped x86 architectural task-context QMP observation.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "exec/address-spaces.h"
+#include "exec/memory.h"
+#include "hw/core/cpu.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-fdisbull-task-context.h"
+#include "qemu/main-loop.h"
+#include "system/cpus.h"
+#include "system/runstate.h"
+#include "system/tcg.h"
+#include "system/fdisbull-task-context.h"
+#include "target/i386/cpu.h"
+
+#define TASK_CONTEXT_ANCHOR_SIZE 56
+#define TASK_CONTEXT_MODEL "qemu-i386-architectural-task-context-v1"
+
+static void task_context_mode(const CPUX86State *env, const char **mode)
+{
+    if (env->eflags & VM_MASK) {
+        *mode = "v86";
+    } else if (!(env->hflags & HF_PE_MASK)) {
+        *mode = "real";
+    } else if (env->hflags & HF_CS64_MASK) {
+        *mode = "long";
+    } else if (env->hflags & HF_LMA_MASK) {
+        *mode = "compat";
+    } else {
+        *mode = "protected";
+    }
+}
+
+static bool task_context_read_anchor(uint64_t address, char **hex_out,
+                                     Error **errp)
+{
+    static const char digits[] = "0123456789abcdef";
+    g_autofree uint8_t *bytes = g_malloc(TASK_CONTEXT_ANCHOR_SIZE);
+    hwaddr offset;
+    hwaddr length = TASK_CONTEXT_ANCHOR_SIZE;
+    MemoryRegion *mr;
+    char *hex;
+
+    if (address > (uint64_t)HWADDR_MAX - TASK_CONTEXT_ANCHOR_SIZE) {
+        error_setg(errp, "Task-context anchor address overflows guest physical memory");
+        return false;
+    }
+    mr = address_space_translate(&address_space_memory, address, &offset,
+                                 &length, false, MEMTXATTRS_UNSPECIFIED);
+    if (!mr || !memory_region_is_ram(mr) || memory_region_is_ram_device(mr) ||
+        memory_region_is_rom(mr) || memory_region_is_romd(mr) ||
+        memory_region_has_ram_discard_manager(mr) ||
+        length < TASK_CONTEXT_ANCHOR_SIZE) {
+        error_setg(errp, "Task-context anchor must be exactly 56 bytes in direct guest RAM");
+        return false;
+    }
+
+    memcpy(bytes, memory_region_get_ram_ptr(mr) + offset,
+           TASK_CONTEXT_ANCHOR_SIZE);
+    hex = g_malloc(TASK_CONTEXT_ANCHOR_SIZE * 2 + 1);
+    for (size_t i = 0; i < TASK_CONTEXT_ANCHOR_SIZE; i++) {
+        hex[i * 2] = digits[bytes[i] >> 4];
+        hex[i * 2 + 1] = digits[bytes[i] & 0x0f];
+    }
+    hex[TASK_CONTEXT_ANCHOR_SIZE * 2] = '\0';
+    *hex_out = hex;
+    return true;
+}
+
+FdisbullTaskContextInfo *qmp_x_fdisbull_query_task_context(
+    bool has_anchor_address, uint64_t anchor_address, Error **errp)
+{
+    CPUState *cs = NULL;
+    CPUState *cpu;
+    X86CPU *x86;
+    CPUX86State *env;
+    FdisbullTaskContextInfo *info;
+    const char *mode;
+
+    assert(bql_locked());
+    if (!tcg_enabled() || runstate_is_running()) {
+        error_setg(errp, "Task-context query requires a stopped system-mode TCG machine");
+        return NULL;
+    }
+    CPU_FOREACH(cpu) {
+        if (cs) {
+            error_setg(errp, "Task-context query requires exactly one vCPU");
+            return NULL;
+        }
+        cs = cpu;
+    }
+    if (!cs || !cs->stopped ||
+        !object_dynamic_cast(OBJECT(cs), TYPE_X86_CPU)) {
+        error_setg(errp, "Task-context query requires one stopped x86 vCPU");
+        return NULL;
+    }
+
+    info = g_new0(FdisbullTaskContextInfo, 1);
+    if (!fdisbull_task_context_get_counters(&info->epoch,
+                                            &info->context_generation,
+                                            errp)) {
+        g_free(info);
+        return NULL;
+    }
+    x86 = X86_CPU(cs);
+    env = &x86->env;
+    task_context_mode(env, &mode);
+    info->api_version = 1;
+    info->model = g_strdup(TASK_CONTEXT_MODEL);
+    info->cpu_index = cs->cpu_index;
+    info->mode = g_strdup(mode);
+    info->cpl = env->hflags & HF_CPL_MASK;
+    info->eip = env->eip;
+    info->esp = env->regs[R_ESP];
+    info->cs_selector = env->segs[R_CS].selector;
+    info->ss_selector = env->segs[R_SS].selector;
+    info->cr0 = env->cr[0];
+    info->cr3 = env->cr[3];
+    info->cr4 = env->cr[4];
+    info->efer = env->efer;
+    info->gdt_base = env->gdt.base;
+    info->gdt_limit = env->gdt.limit;
+    info->idt_base = env->idt.base;
+    info->idt_limit = env->idt.limit;
+    info->tr_selector = env->tr.selector;
+    info->tr_base = env->tr.base;
+    info->tr_limit = env->tr.limit;
+    info->tr_flags = env->tr.flags;
+    info->ldtr_selector = env->ldt.selector;
+    info->ldtr_base = env->ldt.base;
+    info->ldtr_limit = env->ldt.limit;
+    info->ldtr_flags = env->ldt.flags;
+    if (has_anchor_address) {
+        if (!task_context_read_anchor(anchor_address, &info->anchor_hex,
+                                      errp)) {
+            qapi_free_FdisbullTaskContextInfo(info);
+            return NULL;
+        }
+        info->has_anchor_address = true;
+        info->anchor_address = anchor_address;
+    }
+    return info;
+}
