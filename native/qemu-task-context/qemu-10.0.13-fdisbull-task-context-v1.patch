+/*
+ * Stopped x86 architectural task-context observations and transition fence.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qemu/main-loop.h"
+#include "qemu/thread.h"
+#include "system/fdisbull-task-context.h"
+
+typedef struct FdisbullTaskContextMigration {
+    uint64_t epoch;
+    uint64_t generation;
+    bool overflow;
+} FdisbullTaskContextMigration;
+
+static FdisbullTaskContextMigration migration_state = {
+    .epoch = 1,
+    .generation = 1,
+};
+static uint64_t epoch_highwater = 1;
+static uint64_t generation_highwater = 1;
+static bool vmstate_registered;
+static QemuMutex task_context_lock;
+static gsize task_context_lock_initialized;
+
+static void task_context_lock_init(void)
+{
+    if (g_once_init_enter(&task_context_lock_initialized)) {
+        qemu_mutex_init(&task_context_lock);
+        g_once_init_leave(&task_context_lock_initialized, 1);
+    }
+}
+
+static bool task_counter_advance(uint64_t *value)
+{
+    if (*value == UINT64_MAX) {
+        migration_state.overflow = true;
+        return false;
+    }
+    (*value)++;
+    return true;
+}
+
+void fdisbull_task_context_note_transition(void)
+{
+    task_context_lock_init();
+    qemu_mutex_lock(&task_context_lock);
+    if (!migration_state.overflow) {
+        if (!task_counter_advance(&generation_highwater)) {
+            qemu_mutex_unlock(&task_context_lock);
+            return;
+        }
+        migration_state.generation = generation_highwater;
+    }
+    qemu_mutex_unlock(&task_context_lock);
+}
+
+void fdisbull_task_context_note_reset(void)
+{
+    task_context_lock_init();
+    qemu_mutex_lock(&task_context_lock);
+    if (!migration_state.overflow &&
+        task_counter_advance(&epoch_highwater) &&
+        task_counter_advance(&generation_highwater)) {
+        migration_state.epoch = epoch_highwater;
+        migration_state.generation = generation_highwater;
+    }
+    qemu_mutex_unlock(&task_context_lock);
+}
+
+static int task_context_pre_save(void *opaque)
+{
+    FdisbullTaskContextMigration *state = opaque;
+
+    task_context_lock_init();
+    qemu_mutex_lock(&task_context_lock);
+    state->epoch = epoch_highwater;
+    state->generation = generation_highwater;
+    qemu_mutex_unlock(&task_context_lock);
+    return 0;
+}
+
+static int task_context_post_load(void *opaque, int version_id)
+{
+    FdisbullTaskContextMigration *state = opaque;
+    uint64_t next_epoch, next_generation;
+
+    task_context_lock_init();
+    qemu_mutex_lock(&task_context_lock);
+    if (state->overflow || !state->epoch || !state->generation ||
+        state->epoch == UINT64_MAX || state->generation == UINT64_MAX ||
+        !epoch_highwater || !generation_highwater ||
+        epoch_highwater == UINT64_MAX || generation_highwater == UINT64_MAX) {
+        state->overflow = true;
+        qemu_mutex_unlock(&task_context_lock);
+        return -EINVAL;
+    }
+
+    next_epoch = MAX(epoch_highwater, state->epoch) + 1;
+    next_generation = MAX(generation_highwater, state->generation) + 1;
+    epoch_highwater = next_epoch;
+    generation_highwater = next_generation;
+    state->epoch = next_epoch;
+    state->generation = next_generation;
+    state->overflow = false;
+    qemu_mutex_unlock(&task_context_lock);
+    return 0;
+}
+
+static const VMStateDescription vmstate_fdisbull_task_context = {
+    .name = "fdisbull/task-context",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .pre_save = task_context_pre_save,
+    .post_load = task_context_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT64(epoch, FdisbullTaskContextMigration),
+        VMSTATE_UINT64(generation, FdisbullTaskContextMigration),
+        VMSTATE_BOOL(overflow, FdisbullTaskContextMigration),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+bool fdisbull_task_context_get_counters(uint64_t *epoch, uint64_t *generation,
+                                       Error **errp)
+{
+    assert(bql_locked());
+    task_context_lock_init();
+    if (!vmstate_registered) {
+        vmstate_register(NULL, 0, &vmstate_fdisbull_task_context,
+                         &migration_state);
+        vmstate_registered = true;
+    }
+    qemu_mutex_lock(&task_context_lock);
+    if (migration_state.overflow || !epoch_highwater ||
+        !generation_highwater) {
+        qemu_mutex_unlock(&task_context_lock);
+        error_setg(errp, "Native x86 task-context generation is invalidated");
+        return false;
+    }
+    *epoch = epoch_highwater;
+    *generation = generation_highwater;
+    qemu_mutex_unlock(&task_context_lock);
+    return true;
+}
