+/* The checkpoint path does not run audio or discard samples. Restrict it to
+ * the known one-voice, equal-rate none backend, where no resampler history is
+ * consumed by rate_template's equal-rate copy path. */
+static bool fdisbull_audio_info_supported(const struct audio_pcm_info *info)
+{
+    return info->freq == 32000 && info->nchannels == 1 && info->bits == 8 &&
+           !info->is_signed && !info->is_float && info->bytes_per_frame == 1;
+}
+
+static bool fdisbull_audio_buffer_valid(const STSampleBuffer *buffer)
+{
+    return buffer->buffer && buffer->size && buffer->size <= 65536 &&
+           buffer->pos < buffer->size;
+}
+
+static bool fdisbull_audio_output_graph_safe(AudioState **state, Error **errp)
+{
+    AudioState *s;
+    HWVoiceOut *hw;
+    SWVoiceOut *sw;
+    CaptureVoiceOut *cap;
+    SWVoiceCap *sc;
+
+    assert(bql_locked());
+    s = audio_state_by_name("fdisbull-pc", errp);
+    if (!s) {
+        return false;
+    }
+    if (!s->drv || strcmp(s->drv->name, "none") || !s->dev ||
+        !audio_get_pdo_out(s->dev)->mixing_engine || s->vm_running ||
+        !QLIST_EMPTY(&s->hw_head_in)) {
+        error_setg(errp, "Audio checkpoint requires a stopped none backend with no input");
+        return false;
+    }
+    hw = QLIST_FIRST(&s->hw_head_out);
+    if (!hw || QLIST_NEXT(hw, entries) || hw->s != s || hw->poll_mode ||
+        hw->pending_disable ||
+        !fdisbull_audio_info_supported(&hw->info) ||
+        !fdisbull_audio_buffer_valid(&hw->mix_buf)) {
+        error_setg(errp, "Audio checkpoint requires one supported PC speaker hardware output");
+        return false;
+    }
+    if ((hw->buf_emul && (!hw->size_emul || hw->size_emul > 65536 ||
+            hw->pos_emul >= hw->size_emul || hw->pending_emul > hw->size_emul)) ||
+        (!hw->buf_emul && (hw->size_emul || hw->pos_emul || hw->pending_emul))) {
+        error_setg(errp, "Audio checkpoint backend ring is not bounded");
+        return false;
+    }
+    sw = QLIST_FIRST(&hw->sw_head);
+    if (!sw || QLIST_NEXT(sw, entries) || !sw->name || strcmp(sw->name, "pcspk") ||
+        sw->hw != hw || !sw->card || sw->card->state != s || !sw->rate ||
+        sw->total_hw_samples_mixed > hw->mix_buf.size ||
+        !!sw->empty != (sw->total_hw_samples_mixed == 0) || sw->resample_buf.pos ||
+        !!sw->active != !!hw->enabled || !fdisbull_audio_info_supported(&sw->info)) {
+        error_setg(errp, "Audio checkpoint requires a supported equal-rate PC speaker voice");
+        return false;
+    }
+    cap = QLIST_FIRST(&s->cap_head);
+    sc = QLIST_FIRST(&hw->cap_head);
+    if (cap) {
+        SWVoiceOut *csw = QLIST_FIRST(&cap->hw.sw_head);
+        struct capture_callback *cb = QLIST_FIRST(&cap->cb_head);
+        if (QLIST_NEXT(cap, entries) || !sc || QLIST_NEXT(sc, entries) ||
+            sc->cap != cap || csw != &sc->sw || QLIST_NEXT(csw, entries) ||
+            !cb || QLIST_NEXT(cb, entries) || csw->hw != &cap->hw || !csw->rate ||
+            csw->total_hw_samples_mixed > cap->hw.mix_buf.size ||
+            !!csw->empty != (csw->total_hw_samples_mixed == 0) || csw->resample_buf.pos ||
+            cap->hw.pending_emul || !fdisbull_audio_info_supported(&csw->info) ||
+            !fdisbull_audio_info_supported(&cap->hw.info) ||
+            !fdisbull_audio_buffer_valid(&cap->hw.mix_buf)) {
+            error_setg(errp, "Audio checkpoint requires one supported equal-rate capture path");
+            return false;
+        }
+    } else if (sc) {
+        error_setg(errp, "Audio checkpoint capture graph is inconsistent");
+        return false;
+    }
+    *state = s;
+    return true;
+}
