+# Bounded fDisBull local process checkpoint for native observers.
+{ 'include': 'run-state.json' }
+{ 'include': 'fdisbull-audio.json' }
+{ 'include': 'fdisbull-display.json' }
+{ 'include': 'fdisbull-retrace.json' }
+{ 'include': 'fdisbull-vga-configuration.json' }
+
+##
+# @FdisbullInstrumentedAudioState:
+#
+# Retained fDisBull PC-speaker capture metadata and bounded PCM prefix.
+#
+# @profile: Admitted native observer profile.
+#
+# @active: Whether its native callback or timer remains active.
+#
+# @info: Validated native observation at the stopped capture time.
+#
+# @pcm-base64: Canonical base64 of retained mono unsigned 8-bit PCM.
+#
+# @core-base64: Bounded pending mixer state for the exact admitted output graph.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullInstrumentedAudioState',
+  'data': { 'profile': 'str', 'active': 'bool', 'info': 'FdisbullAudioInfo',
+            'pcm-base64': 'str', 'core-base64': 'str' } }
+
+##
+# @FdisbullInstrumentedDisplayState:
+#
+# Retained renderer publication and timer owner for one display session.
+#
+# @profile: Admitted native observer profile.
+#
+# @active: Whether its native callback or timer remains active.
+#
+# @device-path: Canonical primary VGA device path.
+#
+# @console-index: Selected primary console index.
+#
+# @next-deadline-ns: Absolute virtual display timer deadline or minus one.
+#
+# @info: Validated native observation at the stopped capture time.
+#
+# @rgb-base64: Canonical base64 of the retained RGB publication.
+#
+# @published-configuration: Configuration observed when the retained publication was made.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullInstrumentedDisplayState',
+  'data': { 'profile': 'str', 'active': 'bool', 'device-path': 'str',
+            'console-index': 'int', 'next-deadline-ns': 'int',
+            'info': 'FdisbullDisplayInfo', 'rgb-base64': 'str',
+            '*published-configuration': 'FdisbullVgaConfigurationSnapshot' } }
+
+##
+# @FdisbullInstrumentedRetraceState:
+#
+# Exact previously admitted primary VGA retrace owner and observation.
+#
+# @profile: Admitted native observer profile.
+#
+# @admitted: Whether the precise retrace model was admitted.
+#
+# @device-path: Canonical primary VGA device path.
+#
+# @info: Validated native observation at the stopped capture time.
+#
+# @configuration: Current VGA configuration and generation.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullInstrumentedRetraceState',
+  'data': { 'profile': 'str', 'admitted': 'bool', '*device-path': 'str',
+            '*info': 'FdisbullRetraceInfo',
+            '*configuration': 'FdisbullVgaConfigurationSnapshot' } }
+
+##
+# @FdisbullInstrumentedCheckpointState:
+#
+# Bounded sidecar for process-local fDisBull instrumentation owners.  Guest
+# CPU, RAM and device state is carried by the QEMU internal snapshot.
+#
+# @format: Versioned private instrumentation state format.
+#
+# @virtual-ns: Exact stopped QEMU virtual-clock time in nanoseconds.
+#
+# @source-epoch: Native clock owner epoch at capture.
+#
+# @clock: Resolved stopped clock budget history.
+#
+# @audio: Retained audio observer owner and data.
+#
+# @display: Retained renderer observer owner and data.
+#
+# @retrace: Retained precise retrace owner and provenance.
+#
+# Since: 10.0
+##
+{ 'struct': 'FdisbullInstrumentedCheckpointState',
+  'data': { 'format': 'str', 'virtual-ns': 'int', 'source-epoch': 'uint64',
+            'clock': 'FdisbullClockInfo', 'audio': 'FdisbullInstrumentedAudioState',
+            'display': 'FdisbullInstrumentedDisplayState',
+            'retrace': 'FdisbullInstrumentedRetraceState' } }
+
+##
