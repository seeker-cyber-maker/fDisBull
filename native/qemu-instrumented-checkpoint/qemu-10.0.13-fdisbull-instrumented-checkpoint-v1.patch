+    const FdisbullInstrumentedDisplayState *state, uint64_t source_epoch,
+    int64_t virtual_ns, Error **errp)
+{
+    g_autofree uint8_t *rgb = NULL;
+    size_t rgb_bytes = 0;
+
+    if (!display_checkpoint_decode(state, &rgb, &rgb_bytes, errp)) {
+        return false;
+    }
+    if (state->info->api_version != 1 || state->info->epoch != source_epoch ||
+        state->info->virtual_ns != virtual_ns ||
+        !strcmp(state->info->state, "invalidated") ||
+        (state->info->token && !state->info->has_start_ns) ||
+        (state->active && state->info->period_ns < DISPLAY_MIN_PERIOD_NS)) {
+        error_setg(errp, "Native display checkpoint epoch or observer state is invalid");
+        return false;
+    }
+    return true;
+}
+
+bool fdisbull_display_checkpoint_restore(
+    const FdisbullInstrumentedDisplayState *state, uint64_t epoch,
+    const char **new_token, Error **errp)
+{
+    g_autofree uint8_t *rgb = NULL;
+    size_t rgb_bytes = 0;
+    QemuConsole *console = NULL;
+    Object *device = NULL;
+    g_autofree char *path = NULL;
+
+    assert(bql_locked());
+    if (!display_checkpoint_decode(state, &rgb, &rgb_bytes, errp) ||
+        !fdisbull_display_checkpoint_validate(state, state->info->epoch,
+                                             state->info->virtual_ns, errp)) {
+        return false;
+    }
+    if (display_window.token || display_window.observing || display_window.device) {
+        error_setg(errp, "Destination already owns a native display observer");
+        return false;
+    }
+    if (state->info->token) {
+        if (!display_window.migration_blocker) {
+            error_setg(&display_window.migration_blocker,
+                       "fDisBull retained display does not support migration");
+            if (migrate_add_blocker(&display_window.migration_blocker, errp) < 0) {
+                return false;
+            }
+        }
+        if (!display_console(&console, &device)) {
+            error_setg(errp, "Restored display requires headless synchronous standard VGA");
+            return false;
+        }
+        path = object_get_canonical_path(device);
+        if (!path || strcmp(path, state->device_path)) {
+            error_setg(errp, "Restored display VGA identity differs from its checkpoint");
+            return false;
+        }
+    }
+    if (!display_window.initialized) {
+        display_window.initialized = true;
+        timer_init_ns(&display_window.timer, QEMU_CLOCK_VIRTUAL,
+                      display_timer_cb, NULL);
+        qemu_register_reset(display_reset, NULL);
+        qemu_add_vm_change_state_handler(display_vm_state_change, NULL);
+    }
+    display_window.invalidated = false;
+    display_window.observing = state->active;
+    display_window.stopped = !strcmp(state->info->state, "stopped");
+    display_window.epoch = epoch;
+    display_window.failure = NULL;
+    display_window.start_ns = state->info->has_start_ns ? state->info->start_ns : 0;
+    display_window.stop_ns = state->info->has_stop_ns ? state->info->stop_ns : 0;
+    display_window.period_ns = state->info->period_ns;
+    display_window.updates = state->info->updates;
+    display_window.published_ns = state->info->has_published_ns ?
+        state->info->published_ns : 0;
+    display_window.width = state->info->has_width ? state->info->width : 0;
+    display_window.height = state->info->has_height ? state->info->height : 0;
+    display_window.rgb_bytes = rgb_bytes;
+    g_free(display_window.rgb);
+    display_window.rgb = rgb_bytes ? g_memdup2(rgb, rgb_bytes) : NULL;
+    g_clear_pointer(&display_window.published_configuration,
+                    qapi_free_FdisbullVgaConfigurationSnapshot);
+    display_window.published_configuration = state->published_configuration ?
+        QAPI_CLONE(FdisbullVgaConfigurationSnapshot,
+                   state->published_configuration) : NULL;
+    if (display_window.published_configuration) {
+        display_window.published_configuration->epoch = epoch;
+    }
+    g_free(display_window.token);
+    display_window.token = state->info->token ? g_uuid_string_random() : NULL;
+    if (state->info->token) {
+        object_ref(OBJECT(console));
+        object_ref(device);
+        display_window.console = console;
+        display_window.device = device;
+    }
+    if (display_window.observing && !display_rearm(state->info->virtual_ns)) {
+        error_setg(errp, "Restored display timer phase is invalid");
+        return false;
+    }
+    if (new_token) {
+        *new_token = display_window.token;
+    }
+    return true;
+}
+
+bool fdisbull_display_checkpoint_owns_blocker(const Error *reason)
+{
+    return reason && display_window.migration_blocker == reason;
+}
