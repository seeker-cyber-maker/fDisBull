+void qmp_x_fdisbull_instrumented_snapshot_save(const char *job_id,
+                                              const char *tag,
+                                              const char *vmstate,
+                                              strList *devices,
+                                              const char *token, Error **errp)
+{
+    SnapshotJob *s;
+
+    if (!fdisbull_snapshot_nodes(vmstate, devices, errp)) {
+        return;
+    }
+    s = job_create(job_id, &snapshot_save_job_driver, NULL,
+                   qemu_get_aio_context(), JOB_MANUAL_DISMISS,
+                   NULL, NULL, errp);
+    if (!s) {
+        return;
+    }
+    s->tag = g_strdup(tag);
+    s->vmstate = g_strdup(vmstate);
+    s->devices = QAPI_CLONE(strList, devices);
+    s->instrumented_token = g_strdup(token);
+    job_start(&s->common);
+}
