+FdisbullInstrumentedCheckpointReceipt *
+qmp_x_fdisbull_instrumented_checkpoint_import(const char *json, Error **errp)
+{
+    g_autoptr(FdisbullInstrumentedCheckpointState) state = NULL;
+    g_autoptr(FdisbullClockInfo) current_clock = NULL;
+    const char *audio_token = NULL, *display_token = NULL, *retrace_device = NULL;
+    FdisbullInstrumentedCheckpointReceipt *receipt = NULL;
+    uint64_t epoch;
+
+    assert(bql_locked());
+    if (!restore_pending) {
+        error_setg(errp, "Instrumented checkpoint import requires its scoped snapshot load");
+        return NULL;
+    }
+    state = parse_state(json, errp);
+    if (!state) {
+        return NULL;
+    }
+    if (strcmp(state->format, FDISBULL_INSTRUMENTED_CHECKPOINT_FORMAT) ||
+        !state->clock || !state->audio || !state->display || !state->retrace ||
+        state->source_epoch != state->clock->epoch ||
+        state->virtual_ns != state->clock->virtual_ns) {
+        error_setg(errp, "Invalid instrumented checkpoint envelope identity");
+        return NULL;
+    }
+    if (!fdisbull_clock_checkpoint_validate(state->clock, state->virtual_ns, errp) ||
+        !fdisbull_audio_checkpoint_validate(state->audio, state->source_epoch,
+                                            state->virtual_ns, errp) ||
+        !fdisbull_display_checkpoint_validate(state->display, state->source_epoch,
+                                              state->virtual_ns, errp) ||
+        !fdisbull_retrace_checkpoint_validate(state->retrace, state->source_epoch,
+                                              state->virtual_ns, errp)) {
+        return NULL;
+    }
+    current_clock = qmp_x_fdisbull_query_clock(errp);
+    if (!current_clock) {
+        return NULL;
+    }
+    if (current_clock->running || current_clock->pending_stop ||
+        current_clock->virtual_ns != state->virtual_ns ||
+        !current_clock->budget_supported ||
+        qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) != state->virtual_ns) {
+        error_setg(errp, "Restored QEMU clock does not match the instrumented checkpoint");
+        return NULL;
+    }
+
+    epoch = fdisbull_clock_checkpoint_restore(state->clock, errp);
+    if (!epoch) {
+        return NULL;
+    }
+    if (!fdisbull_retrace_checkpoint_restore(state->retrace, epoch,
+                                             &retrace_device, errp) ||
+        !fdisbull_audio_checkpoint_restore(state->audio, epoch,
+                                           &audio_token, errp) ||
+        !fdisbull_display_checkpoint_restore(state->display, epoch,
+                                             &display_token, errp)) {
+        return NULL;
+    }
+    receipt = g_new0(FdisbullInstrumentedCheckpointReceipt, 1);
+    receipt->format = g_strdup(FDISBULL_INSTRUMENTED_CHECKPOINT_FORMAT);
+    receipt->virtual_ns = state->virtual_ns;
+    receipt->new_epoch = epoch;
+    receipt->audio_token = audio_token ? g_strdup(audio_token) : NULL;
+    receipt->display_token = display_token ? g_strdup(display_token) : NULL;
+    receipt->retrace_device = retrace_device ? g_strdup(retrace_device) : NULL;
+    g_clear_pointer(&last_receipt, qapi_free_FdisbullInstrumentedCheckpointReceipt);
+    last_receipt = receipt_copy(receipt);
+    restore_pending = false;
+    return receipt;
+}
+
+FdisbullInstrumentedCheckpointReceipt *
+qmp_x_fdisbull_instrumented_checkpoint_status(Error **errp)
+{
+    assert(bql_locked());
+    if (restore_pending || !last_receipt) {
+        error_setg(errp, "No successfully imported instrumented checkpoint is owned");
+        return NULL;
+    }
+    return receipt_copy(last_receipt);
+}
