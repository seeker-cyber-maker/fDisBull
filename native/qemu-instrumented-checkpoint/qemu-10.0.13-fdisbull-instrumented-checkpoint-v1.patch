+
+/* Private same-build format. The zeroed header contains no pointers; sample
+ * arrays and scalar volume values use the pinned mixer ABI. */
+typedef struct FdisbullAudioCore {
+    uint64_t magic, version, sample_size, volume_size, has_capture;
+    uint64_t hw_size, hw_pos, hw_timestamp, hw_enabled;
+    uint64_t sw_total, sw_active, sw_empty;
+    uint64_t emul_size, emul_pos, emul_pending;
+    uint64_t cap_size, cap_pos, cap_timestamp, cap_enabled;
+    uint64_t csw_total, csw_active, csw_empty;
+    struct mixeng_volume sw_volume, csw_volume;
+} FdisbullAudioCore;
+
+#define FDISBULL_AUDIO_CORE_MAGIC UINT64_C(0x4644424155443031)
+
+static void fdisbull_audio_copy_volume(struct mixeng_volume *dst,
+                                       const struct mixeng_volume *src)
+{
+    dst->mute = src->mute;
+    dst->l = src->l;
+    dst->r = src->r;
+}
+
+char *fdisbull_audio_output_checkpoint_export(Error **errp)
+{
+    AudioState *s;
+    HWVoiceOut *hw;
+    SWVoiceOut *sw;
+    CaptureVoiceOut *cap;
+    FdisbullAudioCore h = { 0 };
+    g_autofree uint8_t *blob = NULL;
+    size_t len, hw_bytes, cap_bytes = 0;
+
+    assert(bql_locked());
+    s = audio_state_by_name("fdisbull-pc", NULL);
+    if (!s) {
+        return g_strdup("");
+    }
+    if (!fdisbull_audio_output_graph_safe(&s, errp)) {
+        return NULL;
+    }
+    hw = QLIST_FIRST(&s->hw_head_out);
+    sw = QLIST_FIRST(&hw->sw_head);
+    cap = QLIST_FIRST(&s->cap_head);
+    h.magic = FDISBULL_AUDIO_CORE_MAGIC;
+    h.version = 1;
+    h.sample_size = sizeof(st_sample);
+    h.volume_size = sizeof(struct mixeng_volume);
+    h.has_capture = !!cap;
+    h.hw_size = hw->mix_buf.size;
+    h.hw_pos = hw->mix_buf.pos;
+    h.hw_timestamp = hw->ts_helper;
+    h.hw_enabled = !!hw->enabled;
+    h.sw_total = sw->total_hw_samples_mixed;
+    h.sw_active = !!sw->active;
+    h.sw_empty = !!sw->empty;
+    h.emul_size = hw->size_emul;
+    h.emul_pos = hw->pos_emul;
+    h.emul_pending = hw->pending_emul;
+    fdisbull_audio_copy_volume(&h.sw_volume, &sw->vol);
+    hw_bytes = h.hw_size * sizeof(st_sample);
+    if (cap) {
+        SWVoiceOut *csw = QLIST_FIRST(&cap->hw.sw_head);
+        h.cap_size = cap->hw.mix_buf.size;
+        h.cap_pos = cap->hw.mix_buf.pos;
+        h.cap_timestamp = cap->hw.ts_helper;
+        h.cap_enabled = !!cap->hw.enabled;
+        h.csw_total = csw->total_hw_samples_mixed;
+        h.csw_active = !!csw->active;
+        h.csw_empty = !!csw->empty;
+        fdisbull_audio_copy_volume(&h.csw_volume, &csw->vol);
+        cap_bytes = h.cap_size * sizeof(st_sample);
+    }
+    len = sizeof(h) + hw_bytes + cap_bytes + h.emul_size;
+    blob = g_malloc0(len);
+    memcpy(blob, &h, sizeof(h));
+    memcpy(blob + sizeof(h), hw->mix_buf.buffer, hw_bytes);
+    if (cap) {
+        memcpy(blob + sizeof(h) + hw_bytes, cap->hw.mix_buf.buffer, cap_bytes);
+    }
+    if (h.emul_pending) {
+        size_t first = audio_ring_posb(h.emul_pos, h.emul_pending, h.emul_size);
+        size_t count = MIN(h.emul_pending, h.emul_size - first);
+        uint8_t *out = blob + sizeof(h) + hw_bytes + cap_bytes;
+        memcpy(out + first, hw->buf_emul + first, count);
+        if (count < h.emul_pending) {
+            memcpy(out, hw->buf_emul, h.emul_pending - count);
+        }
+    }
+    return g_base64_encode(blob, len);
+}
+
+bool fdisbull_audio_output_checkpoint_import(const char *base64, Error **errp)
+{
+    AudioState *s;
+    HWVoiceOut *hw;
+    SWVoiceOut *sw;
+    CaptureVoiceOut *cap;
+    FdisbullAudioCore h;
+    g_autofree guchar *blob = NULL;
+    g_autofree char *canonical = NULL;
+    gsize len;
+    size_t hw_bytes, cap_bytes;
+
+    assert(bql_locked());
+    if (!base64) {
+        error_setg(errp, "Missing audio core checkpoint");
+        return false;
+    }
+    s = audio_state_by_name("fdisbull-pc", NULL);
+    if (!*base64) {
+        if (!s) {
+            return true;
+        }
+        error_setg(errp, "Audio core checkpoint lacks the destination device");
+        return false;
+    }
+    /* The maximum follows two 65536-frame buffers, plus the fixed header. */
+    if (!s || strlen(base64) > 4 * ((sizeof(h) + 2 * 65536 * sizeof(st_sample) + 65536 + 2) / 3)) {
+        error_setg(errp, "Audio core checkpoint device or size mismatch");
+        return false;
+    }
+    blob = g_base64_decode(base64, &len);
+    canonical = g_base64_encode(blob, len);
+    if (strcmp(base64, canonical) || len < sizeof(h)) {
+        error_setg(errp, "Invalid audio core checkpoint encoding");
+        return false;
+    }
+    memcpy(&h, blob, sizeof(h));
+    if (h.magic != FDISBULL_AUDIO_CORE_MAGIC || h.version != 1 ||
+        h.sample_size != sizeof(st_sample) || h.volume_size != sizeof(struct mixeng_volume) ||
+        h.has_capture > 1 || !h.hw_size || h.hw_size > 65536 ||
+        h.hw_pos >= h.hw_size || h.hw_enabled > 1 || h.sw_active > 1 ||
+        h.sw_empty > 1 || h.sw_total > h.hw_size ||
+        h.sw_empty != (h.sw_total == 0) || h.sw_active != h.hw_enabled ||
+        h.emul_size > 65536 || h.emul_pending > h.emul_size ||
+        (h.emul_size ? h.emul_pos >= h.emul_size : h.emul_pos != 0) ||
+        h.cap_size > 65536 || h.cap_enabled > 1 || h.csw_active > 1 || h.csw_empty > 1 ||
+        (h.has_capture && (!h.cap_size || h.cap_pos >= h.cap_size ||
+          h.csw_total > h.cap_size || h.csw_empty != (h.csw_total == 0))) ||
+        (!h.has_capture && (h.cap_size || h.cap_pos || h.cap_timestamp || h.cap_enabled ||
+                            h.csw_total || h.csw_active || h.csw_empty))) {
+        error_setg(errp, "Invalid or incompatible audio core checkpoint header");
+        return false;
+    }
+    hw_bytes = h.hw_size * sizeof(st_sample);
+    cap_bytes = h.cap_size * sizeof(st_sample);
+    if (len != sizeof(h) + hw_bytes + cap_bytes + h.emul_size ||
+        !fdisbull_audio_output_graph_safe(&s, errp)) {
+        if (len != sizeof(h) + hw_bytes + cap_bytes + h.emul_size) {
+            error_setg(errp, "Invalid audio core checkpoint length");
+        }
+        return false;
+    }
+    hw = QLIST_FIRST(&s->hw_head_out);
+    sw = QLIST_FIRST(&hw->sw_head);
+    cap = QLIST_FIRST(&s->cap_head);
+    if (h.hw_size != hw->mix_buf.size || h.hw_enabled != !!hw->enabled ||
+        h.sw_active != !!sw->active || h.has_capture != !!cap ||
+        (cap && (h.cap_size != cap->hw.mix_buf.size ||
+                 h.cap_enabled != !!cap->hw.enabled ||
+                 h.csw_active != !!QLIST_FIRST(&cap->hw.sw_head)->active))) {
+        error_setg(errp, "Audio core checkpoint graph differs from destination");
+        return false;
+    }
+    /* All input and destination checks precede the first mutation. */
+    memcpy(hw->mix_buf.buffer, blob + sizeof(h), hw_bytes);
+    hw->mix_buf.pos = h.hw_pos;
+    hw->ts_helper = h.hw_timestamp;
+    g_free(hw->buf_emul);
+    hw->buf_emul = h.emul_size ? g_memdup2(blob + sizeof(h) + hw_bytes + cap_bytes,
+                                         h.emul_size) : NULL;
+    hw->size_emul = h.emul_size;
+    hw->pos_emul = h.emul_pos;
+    hw->pending_emul = h.emul_pending;
+    sw->total_hw_samples_mixed = h.sw_total;
+    sw->empty = h.sw_empty;
+    fdisbull_audio_copy_volume(&sw->vol, &h.sw_volume);
+    if (cap) {
+        SWVoiceOut *csw = QLIST_FIRST(&cap->hw.sw_head);
+        memcpy(cap->hw.mix_buf.buffer, blob + sizeof(h) + hw_bytes, cap_bytes);
+        cap->hw.mix_buf.pos = h.cap_pos;
+        cap->hw.ts_helper = h.cap_timestamp;
+        csw->total_hw_samples_mixed = h.csw_total;
+        csw->empty = h.csw_empty;
+        fdisbull_audio_copy_volume(&csw->vol, &h.csw_volume);
+    }
+    return true;
+}
+
+bool fdisbull_audio_output_checkpoint_safe(int64_t *timer_ns, Error **errp)
+{
+    AudioState *s;
+    bool pending;
+    uint64_t expiry;
+    int64_t now;
+
+    if (!timer_ns || !fdisbull_audio_output_graph_safe(&s, errp)) {
+        return false;
+    }
+    pending = timer_pending(s->ts);
+    if (s->period_ticks <= 0 || pending != s->timer_running ||
+        pending != !!audio_is_timer_needed(s)) {
+        error_setg(errp, "Audio checkpoint timer state is not reconstructible");
+        return false;
+    }
+    if (!pending) {
+        *timer_ns = -1;
+        return true;
+    }
+    expiry = timer_expire_time_ns(s->ts);
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (now < 0 || s->period_ticks > INT64_MAX - now ||
+        expiry > (uint64_t)(now + s->period_ticks)) {
+        error_setg(errp, "Audio checkpoint timer deadline would change on resume");
+        return false;
+    }
+    *timer_ns = expiry;
+    return true;
+}
+
+bool fdisbull_audio_output_checkpoint_restore_timer(int64_t timer_ns, Error **errp)
+{
+    AudioState *s;
+    int64_t now;
+
+    if (!fdisbull_audio_output_graph_safe(&s, errp)) {
+        return false;
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (s->period_ticks <= 0 || now < 0 ||
+        s->period_ticks > INT64_MAX - now ||
+        (timer_ns >= 0 && timer_ns > now + s->period_ticks)) {
+        error_setg(errp, "Restored audio timer deadline would change on resume");
+        return false;
+    }
+    if (timer_ns < -1 || (timer_ns >= 0) != !!audio_is_timer_needed(s)) {
+        error_setg(errp, "Restored audio timer does not match the voice state");
+        return false;
+    }
+    if (timer_ns < 0) {
+        timer_del(s->ts);
+        s->timer_running = false;
+    } else {
+        timer_mod_ns(s->ts, timer_ns);
+        s->timer_running = true;
+        /* timer_last only diagnoses late callbacks; it does not drive audio. */
+        s->timer_last = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    }
+    return true;
 }
 
