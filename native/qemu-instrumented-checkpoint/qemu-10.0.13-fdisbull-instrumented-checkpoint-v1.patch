+        return NULL;
+    }
+    clock = qmp_x_fdisbull_query_clock(errp);
+    if (!clock || !retrace_guard(clock, errp)) {
+        return NULL;
+    }
+    return retrace_snapshot(clock, false, errp);
+}
+
+char *fdisbull_retrace_checkpoint_device_path(void)
+{
+    return retrace_owner.device_path ? g_strdup(retrace_owner.device_path) :
+                                      g_strdup("");
+}
+
+bool fdisbull_retrace_checkpoint_validate(
+    const FdisbullInstrumentedRetraceState *state, uint64_t source_epoch,
+    int64_t virtual_ns, Error **errp)
+{
+    if (!state || !state->profile ||
+        (strcmp(state->profile, "off") && strcmp(state->profile, "precise")) ||
+        (state->admitted != !strcmp(state->profile, "precise")) ||
+        (state->admitted != (state->info != NULL)) ||
+        (state->admitted != (state->device_path != NULL)) ||
+        (state->admitted != (state->configuration != NULL))) {
+        error_setg(errp, "Invalid native retrace checkpoint profile or ownership");
+        return false;
+    }
+    if (state->admitted &&
+        (state->info->api_version != 1 || state->info->epoch != source_epoch ||
+         state->info->virtual_ns != virtual_ns || !state->device_path[0] ||
+         strcmp(state->info->device, state->device_path))) {
+        error_setg(errp, "Native retrace checkpoint identity or epoch differs");
+        return false;
+    }
+    return true;
+}
+
+bool fdisbull_retrace_checkpoint_restore(
+    const FdisbullInstrumentedRetraceState *state, uint64_t epoch,
+    const char **device, Error **errp)
+{
+    g_autoptr(FdisbullRetraceInfo) actual = NULL;
+
+    assert(bql_locked());
+    if (!fdisbull_retrace_checkpoint_validate(state, state->info ?
+            state->info->epoch : 0, state->info ? state->info->virtual_ns :
+            qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), errp)) {
+        return false;
+    }
+    if (!state->admitted) {
+        if (device) {
+            *device = NULL;
+        }
+        return true;
+    }
+    if (!retrace_owner.device || retrace_owner.invalidated ||
+        !retrace_owner.device_path ||
+        strcmp(retrace_owner.device_path, state->device_path)) {
+        error_setg(errp, "Restored retrace requires the same freshly admitted VGA owner");
+        return false;
+    }
+    if (!pci_std_vga_fdisbull_checkpoint_restore(retrace_owner.device,
+            state->info, state->configuration, epoch,
+            state->info->virtual_ns, errp)) {
+        retrace_owner.invalidated = true;
+        return false;
+    }
+    retrace_owner.epoch = epoch;
+    retrace_owner.invalidated = false;
+    actual = fdisbull_retrace_checkpoint_info(errp);
+    if (!actual) {
+        retrace_owner.invalidated = true;
+        return false;
+    }
+    if (device) {
+        *device = retrace_owner.device_path;
+    }
+    return true;
+}
+
+bool fdisbull_retrace_checkpoint_owns_blocker(const Error *reason)
+{
+    return reason && retrace_owner.migration_blocker == reason;
+}
