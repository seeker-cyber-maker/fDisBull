+
+static bool audio_checkpoint_decode(const FdisbullInstrumentedAudioState *state,
+                                    g_autofree uint8_t **pcm,
+                                    size_t *pcm_bytes, Error **errp)
+{
+    g_autofree char *canonical = NULL;
+    FdisbullAudioChunkList *chunk;
+    uint64_t frames = 0;
+    unsigned nchunks = 0;
+
+    if (!state || !state->profile ||
+        (strcmp(state->profile, "off") && strcmp(state->profile, "pc-speaker")) ||
+        !state->info || !state->core_base64 || strlen(state->core_base64) > 8 * 1024 * 1024 ||
+        !state->pcm_base64 || strlen(state->pcm_base64) > 4 * MAX_FRAMES / 3 + 8 ||
+        state->info->api_version != 1 || state->info->rate != AUDIO_RATE ||
+        state->info->channels != 1 || strcmp(state->info->format, "u8") ||
+        state->info->max_frames > MAX_FRAMES || state->info->frames > state->info->max_frames ||
+        state->info->dropped_frames ||
+        (state->info->has_start_ns != (state->info->token != NULL))) {
+        error_setg(errp, "Invalid native audio checkpoint profile or metadata");
+        return false;
+    }
+    *pcm = g_base64_decode(state->pcm_base64, pcm_bytes);
+    canonical = g_base64_encode(*pcm, *pcm_bytes);
+    if (!canonical || strcmp(canonical, state->pcm_base64) ||
+        *pcm_bytes != state->info->frames || *pcm_bytes > MAX_FRAMES) {
+        error_setg(errp, "Native audio checkpoint PCM length or encoding differs");
+        return false;
+    }
+    for (chunk = state->info->chunks; chunk; chunk = chunk->next) {
+        FdisbullAudioChunk *item = chunk->value;
+        if (!item || !item->frames || item->first_frame != frames ||
+            item->virtual_ns < state->info->start_ns ||
+            item->virtual_ns > state->info->virtual_ns ||
+            UINT64_MAX - frames < item->frames || ++nchunks > MAX_CHUNKS) {
+            error_setg(errp, "Invalid native audio checkpoint callback timeline");
+            return false;
+        }
+        frames += item->frames;
+    }
+    if (frames != state->info->frames ||
+        (state->active != !strcmp(state->info->state, "capturing")) ||
+        (state->active && strcmp(state->profile, "pc-speaker")) ||
+        (!state->info->token && (state->active || state->info->frames || nchunks)) ||
+        (state->info->token && strcmp(state->profile, "pc-speaker"))) {
+        error_setg(errp, "Native audio checkpoint state and retained frames disagree");
+        return false;
+    }
+    return true;
+}
+
+bool fdisbull_audio_checkpoint_validate(
+    const FdisbullInstrumentedAudioState *state, uint64_t source_epoch,
+    int64_t virtual_ns, Error **errp)
+{
+    g_autofree uint8_t *pcm = NULL;
+    size_t pcm_bytes = 0;
+
+    if (!audio_checkpoint_decode(state, &pcm, &pcm_bytes, errp)) {
+        return false;
+    }
+    if (state->info->epoch != source_epoch || state->info->virtual_ns != virtual_ns ||
+        state->info->state == NULL || !strcmp(state->info->state, "invalidated") ||
+        !strcmp(state->info->state, "overflow")) {
+        error_setg(errp, "Native audio checkpoint epoch or state is invalid");
+        return false;
+    }
+    return true;
+}
+
+bool fdisbull_audio_checkpoint_restore(
+    const FdisbullInstrumentedAudioState *state, uint64_t epoch,
+    const char **new_token, Error **errp)
+{
+    g_autofree uint8_t *pcm = NULL;
+    size_t pcm_bytes = 0;
+    FdisbullAudioChunkList *chunk;
+    AudioState *audio = NULL;
+    struct audsettings settings = { AUDIO_RATE, 1, AUDIO_FORMAT_U8, 0 };
+    struct audio_capture_ops ops = {
+        .notify = audio_notify, .capture = audio_capture, .destroy = audio_destroy,
+    };
+    bool expected_enabled;
+
+    assert(bql_locked());
+    if (!audio_checkpoint_decode(state, &pcm, &pcm_bytes, errp) ||
+        !fdisbull_audio_checkpoint_validate(state, state->info->epoch,
+                                            state->info->virtual_ns, errp)) {
+        return false;
+    }
+    if (!fdisbull_pcspk_checkpoint_rearm(errp)) {
+        return false;
+    }
+    if (audio_window.capture || audio_window.token) {
+        error_setg(errp, "Destination already owns a native audio window");
+        return false;
+    }
+    if (state->info->token && !audio_window.migration_blocker) {
+        error_setg(&audio_window.migration_blocker,
+                   "fDisBull audio capture windows do not support generic migration");
+        if (migrate_add_blocker(&audio_window.migration_blocker, errp) < 0) {
+            return false;
+        }
+    }
+    if (state->active) {
+        audio = audio_state_by_name("fdisbull-pc", errp);
+        if (!audio) {
+            return false;
+        }
+    }
+    audio_window.initialized = true;
+    qemu_register_reset(audio_reset, NULL);
+    audio_window.invalidated = false;
+    audio_window.epoch = epoch;
+    audio_window.token = state->info->token ? g_uuid_string_random() : NULL;
+    audio_window.start_ns = state->info->has_start_ns ? state->info->start_ns : 0;
+    audio_window.stop_ns = state->info->has_stop_ns ? state->info->stop_ns : 0;
+    audio_window.max_frames = state->info->max_frames;
+    audio_window.frames = state->info->frames;
+    audio_window.dropped = state->info->dropped_frames;
+    audio_window.nchunks = 0;
+    for (chunk = state->info->chunks; chunk; chunk = chunk->next) {
+        audio_window.chunks[audio_window.nchunks++] = *chunk->value;
+    }
+    g_free(audio_window.pcm);
+    audio_window.pcm = g_malloc(MAX(1, audio_window.max_frames));
+    if (pcm_bytes) {
+        memcpy(audio_window.pcm, pcm, pcm_bytes);
+    }
+    audio_window.overflow = !strcmp(state->info->state, "overflow");
+    audio_window.stopped = state->info->has_stop_ns;
+    audio_window.enabled = state->info->enabled;
+    expected_enabled = state->info->enabled;
+    if (state->active) {
+        audio_window.capture = AUD_add_capture(audio, &settings, &ops, NULL);
+        if (!audio_window.capture || audio_window.enabled != expected_enabled) {
+            audio_window.invalidated = true;
+            error_setg(errp, "Restored native PC-speaker capture profile differs");
+            return false;
+        }
+    }
+    if (!fdisbull_audio_output_checkpoint_import(state->core_base64, errp)) {
+        audio_window.invalidated = true;
+        return false;
+    }
+    if (new_token) {
+        *new_token = audio_window.token;
+    }
+    return true;
+}
+
+bool fdisbull_audio_checkpoint_owns_blocker(const Error *reason)
+{
+    return reason && audio_window.migration_blocker == reason;
+}
