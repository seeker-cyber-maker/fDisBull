+static bool vga_u8_list_equal(const uint8List *list, const uint8_t *bytes,
+                              size_t count)
+{
+    size_t i = 0;
+
+    for (; list && i < count; list = list->next, i++) {
+        if (list->value != bytes[i]) {
+            return false;
+        }
+    }
+    return !list && i == count;
+}
+
+static bool vga_u16_list_equal(const uint16List *list, const uint16_t *words,
+                               size_t count)
+{
+    size_t i = 0;
+
+    for (; list && i < count; list = list->next, i++) {
+        if (list->value != words[i]) {
+            return false;
+        }
+    }
+    return !list && i == count;
+}
+
+static bool vga_fdisbull_configuration_snapshot_equal(
+    const VGAConfigurationState *raw,
+    const FdisbullVgaConfigurationSnapshot *snapshot)
+{
+    const FdisbullVgaConfigurationRaw *saved = snapshot->raw;
+
+    return saved &&
+        vga_u8_list_equal(saved->sequencer, raw->sequencer,
+                          ARRAY_SIZE(raw->sequencer)) &&
+        vga_u8_list_equal(saved->sequencer_vbe, raw->sequencer_vbe,
+                          ARRAY_SIZE(raw->sequencer_vbe)) &&
+        vga_u8_list_equal(saved->graphics, raw->graphics,
+                          ARRAY_SIZE(raw->graphics)) &&
+        vga_u8_list_equal(saved->crtc, raw->crtc, ARRAY_SIZE(raw->crtc)) &&
+        vga_u8_list_equal(saved->attribute_controls, raw->attribute_controls,
+                          ARRAY_SIZE(raw->attribute_controls)) &&
+        vga_u16_list_equal(saved->vbe, raw->vbe, ARRAY_SIZE(raw->vbe)) &&
+        saved->misc_output == raw->misc_output &&
+        saved->feature_control == raw->feature_control &&
+        saved->display_enabled == raw->display_enabled &&
+        saved->vbe_start_address == raw->vbe_start_address &&
+        saved->vbe_line_offset == raw->vbe_line_offset &&
+        saved->vbe_bank_mask == raw->vbe_bank_mask &&
+        saved->bank_offset == raw->bank_offset &&
+        saved->dac_8bit == raw->dac_8bit &&
+        saved->big_endian_framebuffer == raw->big_endian_framebuffer &&
+        saved->vram_size == raw->vram_size &&
+        saved->vbe_size == raw->vbe_size &&
+        saved->vbe_size_mask == raw->vbe_size_mask;
+}
+
+bool vga_fdisbull_checkpoint_restore(
+    VGACommonState *s, const FdisbullRetraceInfo *retrace,
+    const FdisbullVgaConfigurationSnapshot *configuration,
+    uint64_t new_epoch, int64_t virtual_ns, Error **errp)
+{
+    g_autoptr(FdisbullRetraceInfo) actual = NULL;
+    VGAConfigurationState raw;
+    FdisbullRetraceRaw retrace_raw;
+    bool initialized;
+
+    assert(bql_locked());
+    if (!fdisbull_instrumented_checkpoint_busy() || !s->fdisbull_retrace ||
+        !retrace || !retrace->raw || !retrace->timing || !configuration ||
+        !retrace->timing_generation || !configuration->configuration_generation ||
+        !new_epoch || virtual_ns < 0 || configuration->epoch != retrace->epoch ||
+        configuration->virtual_ns != virtual_ns ||
+        configuration->device_type == NULL ||
+        strcmp(configuration->device_type, "VGA")) {
+        error_setg(errp, "Invalid fDisBull VGA checkpoint restore request");
+        return false;
+    }
+    retrace_raw = vga_fdisbull_retrace_raw(s);
+    if (!vga_fdisbull_raw_equal(&retrace_raw, retrace->raw)) {
+        error_setg(errp, "Restored VGA timing registers differ from checkpoint");
+        return false;
+    }
+    vga_fdisbull_configuration_raw(s, &raw);
+    if (!vga_fdisbull_configuration_snapshot_equal(&raw, configuration)) {
+        error_setg(errp, "Restored VGA configuration differs from checkpoint");
+        return false;
+    }
+
+    initialized = !retrace->unsupported_reason ||
+                  strcmp(retrace->unsupported_reason, "uninitialized");
+    s->fdisbull_retrace_generation = retrace->timing_generation;
+    s->fdisbull_retrace_initialized = initialized;
+    s->fdisbull_retrace_overflow = false;
+    if (initialized) {
+        s->update_retrace_info(s);
+    } else {
+        memset(&s->retrace_info.precise, 0, sizeof(s->retrace_info.precise));
+    }
+    s->fdisbull_configuration_initialized = true;
+    s->fdisbull_configuration_invalidated = false;
+    s->fdisbull_configuration_generation = configuration->configuration_generation;
+    s->fdisbull_configuration_committed = raw;
+
+    actual = g_new0(FdisbullRetraceInfo, 1);
+    if (!vga_fdisbull_retrace_query(s, virtual_ns, actual, errp)) {
+        return false;
+    }
+    if (!vga_fdisbull_raw_equal(actual->raw, retrace->raw) ||
+        actual->timing_generation != retrace->timing_generation ||
+        actual->phase_supported != retrace->phase_supported ||
+        actual->timing->ticks_per_char != retrace->timing->ticks_per_char ||
+        actual->timing->total_chars != retrace->timing->total_chars ||
+        actual->timing->htotal != retrace->timing->htotal ||
+        actual->timing->hstart != retrace->timing->hstart ||
+        actual->timing->hend != retrace->timing->hend ||
+        actual->timing->vstart != retrace->timing->vstart ||
+        actual->timing->vend != retrace->timing->vend ||
+        actual->timing->freq != retrace->timing->freq) {
+        error_setg(errp, "Restored VGA retrace cache differs from checkpoint");
+        return false;
+    }
+    if (actual->phase_supported &&
+        (!actual->phase || !retrace->phase ||
+         actual->phase->period_ns != retrace->phase->period_ns ||
+         actual->phase->phase_ns != retrace->phase->phase_ns ||
+         actual->phase->line != retrace->phase->line ||
+         actual->phase->character != retrace->phase->character ||
+         actual->phase->line_character != retrace->phase->line_character ||
+         actual->phase->vertical_retrace != retrace->phase->vertical_retrace ||
+         actual->phase->horizontal_retrace != retrace->phase->horizontal_retrace ||
+         actual->phase->status1_timing_bits != retrace->phase->status1_timing_bits)) {
+        error_setg(errp, "Restored VGA retrace phase differs from checkpoint");
+        return false;
+    }
+    return true;
+}
