+static FdisbullInstrumentedCheckpointReceipt *receipt_copy(
+    const FdisbullInstrumentedCheckpointReceipt *source)
+{
+    return source ? QAPI_CLONE(FdisbullInstrumentedCheckpointReceipt, source) : NULL;
+}
