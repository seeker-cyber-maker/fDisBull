+static bool pcspk_checkpoint_needed(void *opaque)
+{
+    (void)opaque;
+    return fdisbull_instrumented_checkpoint_busy();
+}
+
+bool fdisbull_pcspk_checkpoint_audio_safe(Error **errp)
+{
+    PCSpkState *s = pcspk_state;
+    int64_t deadline;
+
+    if (!s || !s->pit) {
+        error_setg(errp, "PC speaker checkpoint device is unavailable");
+        return false;
+    }
+    if (!s->card.state) {
+        return true;
+    }
+    if (!s->voice) {
+        error_setg(errp, "PC speaker checkpoint audio voice is unavailable");
+        return false;
+    }
+    return fdisbull_audio_output_checkpoint_safe(&deadline, errp);
+}
+
+static int pcspk_checkpoint_pre_save(void *opaque)
+{
+    PCSpkState *s = opaque;
+    g_autoptr(Error) local_err = NULL;
+
+    s->fdisbull_checkpoint_audio_timer_ns = -1;
+    if (s->card.state && (!s->voice ||
+        !fdisbull_audio_output_checkpoint_safe(&s->fdisbull_checkpoint_audio_timer_ns,
+                                               &local_err))) {
+        if (local_err) {
+            error_report_err(g_steal_pointer(&local_err));
+        }
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static int pcspk_checkpoint_post_load(void *opaque, int version_id)
+{
+    PCSpkState *s = opaque;
+    unsigned int expected;
+
+    (void)version_id;
+
+    /* The optional subsection is never admitted to ordinary migration. */
+    if (!fdisbull_instrumented_checkpoint_busy() || s->data_on > 1 ||
+        (s->dummy_refresh_clock & ~0x10) || s->pit_count > 65536 ||
+        (s->pit_count && s->pit_count < PCSPK_MIN_COUNT) ||
+        s->samples > PCSPK_BUF_LEN || s->fdisbull_checkpoint_audio_timer_ns < -1 ||
+        (!s->card.state && s->fdisbull_checkpoint_audio_timer_ns != -1) ||
+        (s->samples ? s->play_pos >= s->samples : s->play_pos != 0)) {
+        return -EINVAL;
+    }
+    if (s->pit_count) {
+        const uint32_t m = PCSPK_SAMPLE_RATE * s->pit_count;
+        expected = (QEMU_ALIGN_DOWN(PCSPK_BUF_LEN * PIT_FREQ, m) /
+                    (PIT_FREQ >> 1) + 1) >> 1;
+        if (!expected || s->samples != expected) {
+            return -EINVAL;
+        }
+    } else if (s->samples && s->samples != PCSPK_BUF_LEN) {
+        return -EINVAL;
+    }
+
+    /* PIT ordering is not established during individual device post_load.
+     * The scoped import owner rearms after the whole snapshot job completes. */
+    s->fdisbull_checkpoint_loaded = true;
+    return 0;
+}
+
+bool fdisbull_pcspk_checkpoint_rearm(Error **errp)
+{
+    PCSpkState *s = pcspk_state;
+    PITChannelInfo channel;
+
+    if (!fdisbull_instrumented_checkpoint_busy() || !s || !s->pit ||
+        !s->fdisbull_checkpoint_loaded) {
+        error_setg(errp, "PC speaker checkpoint state or owned load is absent");
+        return false;
+    }
+    pit_get_channel_info(s->pit, 2, &channel);
+    if (channel.gate != 0 && channel.gate != 1) {
+        error_setg(errp, "Restored PC speaker PIT gate is invalid");
+        return false;
+    }
+    if (s->card.state && !s->voice) {
+        error_setg(errp, "Restored PC speaker audio voice is unavailable");
+        return false;
+    }
+    if (s->voice) {
+        /* Unlike a port write, rearming must not reset the restored phase. */
+        AUD_set_active_out(s->voice, channel.gate && s->data_on);
+    }
+    if (s->card.state && !fdisbull_audio_output_checkpoint_restore_timer(
+            s->fdisbull_checkpoint_audio_timer_ns, errp)) {
+        return false;
+    }
+    s->fdisbull_checkpoint_loaded = false;
+    return true;
+}
