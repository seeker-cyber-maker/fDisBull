+G_DEFINE_AUTOPTR_CLEANUP_FUNC(QObject, checkpoint_qobject_unref)
+
+static char *export_token;
+static char *export_json;
+static char *export_sha256;
+static bool save_busy;
+static bool restore_pending;
+static FdisbullInstrumentedCheckpointReceipt *last_receipt;
+
+static char *sha256_text(const char *text)
+{
+    return g_compute_checksum_for_data(G_CHECKSUM_SHA256,
+                                       (const guchar *)text, strlen(text));
+}
+
+static char *state_json(FdisbullInstrumentedCheckpointState *state,
+                        Error **errp)
+{
+    g_autoptr(QObject) object = NULL;
+    g_autoptr(GString) json = NULL;
+    Visitor *visitor = qobject_output_visitor_new(&object);
+
+    if (!visit_type_FdisbullInstrumentedCheckpointState(visitor, NULL,
+                                                       &state, errp)) {
+        visit_free(visitor);
+        return NULL;
+    }
+    visit_complete(visitor, &object);
+    visit_free(visitor);
+    json = qobject_to_json(object);
+    return json ? g_string_free(g_steal_pointer(&json), false) : NULL;
+}
+
+static FdisbullInstrumentedCheckpointState *parse_state(const char *text,
+                                                         Error **errp)
+{
+    g_autoptr(QObject) object = NULL;
+    FdisbullInstrumentedCheckpointState *state = NULL;
+    Visitor *visitor;
+
+    if (!text || strlen(text) > 48 * 1024 * 1024) {
+        error_setg(errp, "Instrumented checkpoint sidecar exceeds 48 MiB");
+        return NULL;
+    }
+    object = qobject_from_json(text, errp);
+    if (!object) {
+        return NULL;
+    }
+    visitor = qobject_input_visitor_new(object);
+    if (!visit_type_FdisbullInstrumentedCheckpointState(visitor, NULL,
+                                                        &state, errp)) {
+        visit_free(visitor);
+        return NULL;
+    }
+    visit_free(visitor);
+    return state;
+}
+
+bool fdisbull_instrumented_checkpoint_busy(void)
+{
+    return save_busy || restore_pending;
+}
+
+bool fdisbull_instrumented_checkpoint_allows_blocker(const Error *reason)
+{
+    return save_busy && reason &&
+        (fdisbull_clock_checkpoint_owns_blocker(reason) ||
+         fdisbull_audio_checkpoint_owns_blocker(reason) ||
+         fdisbull_display_checkpoint_owns_blocker(reason) ||
+         fdisbull_retrace_checkpoint_owns_blocker(reason) ||
+         fdisbull_input_checkpoint_owns_blocker(reason));
+}
+
+static FdisbullInstrumentedCheckpointState *capture_state(Error **errp)
+{
+    g_autoptr(FdisbullInstrumentedCheckpointState) result = NULL;
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    g_autoptr(FdisbullAudioInfo) audio = NULL;
+    g_autoptr(FdisbullDisplayInfo) display = NULL;
+    g_autoptr(FdisbullRetraceInfo) retrace = NULL;
+    g_autoptr(FdisbullVgaConfigurationInfo) configuration = NULL;
+
+    assert(bql_locked());
+    if (fdisbull_instrumented_checkpoint_busy()) {
+        error_setg(errp, "Instrumented checkpoint transaction is in progress");
+        return NULL;
+    }
+    clock = qmp_x_fdisbull_query_clock(errp);
+    if (!clock || !fdisbull_clock_checkpoint_validate(clock, clock->virtual_ns,
+                                                     errp)) {
+        return NULL;
+    }
+    if (!fdisbull_input_checkpoint_safe(errp) ||
+        !fdisbull_pcspk_checkpoint_audio_safe(errp)) {
+        return NULL;
+    }
+    audio = fdisbull_audio_checkpoint_info(errp);
+    if (!audio) {
+        return NULL;
+    }
+    display = fdisbull_display_checkpoint_info(errp);
+    if (!display) {
+        return NULL;
+    }
+    if (fdisbull_retrace_checkpoint_admitted()) {
+        retrace = fdisbull_retrace_checkpoint_info(errp);
+        configuration = qmp_x_fdisbull_query_vga_configuration(errp);
+        if (!retrace || !configuration || !configuration->current) {
+            return NULL;
+        }
+    }
+
+    result = g_new0(FdisbullInstrumentedCheckpointState, 1);
+    result->format = g_strdup(FDISBULL_INSTRUMENTED_CHECKPOINT_FORMAT);
+    result->virtual_ns = clock->virtual_ns;
+    result->source_epoch = clock->epoch;
+    result->clock = g_steal_pointer(&clock);
+
+    result->audio = g_new0(FdisbullInstrumentedAudioState, 1);
+    result->audio->profile = g_strdup(audio->token ? "pc-speaker" : "off");
+    result->audio->active = !strcmp(audio->state, "capturing");
+    result->audio->info = g_steal_pointer(&audio);
+    result->audio->pcm_base64 = fdisbull_audio_checkpoint_pcm_base64();
+    result->audio->core_base64 = fdisbull_audio_output_checkpoint_export(errp);
+    if (!result->audio->core_base64) {
+        return NULL;
+    }
+
+    result->display = g_new0(FdisbullInstrumentedDisplayState, 1);
+    result->display->profile = g_strdup(display->token ? "renderer" : "off");
+    result->display->active = !strcmp(display->state, "observing");
+    result->display->device_path = fdisbull_display_checkpoint_device_path();
+    result->display->console_index = 0;
+    result->display->next_deadline_ns = fdisbull_display_checkpoint_deadline();
+    result->display->info = g_steal_pointer(&display);
+    result->display->rgb_base64 = fdisbull_display_checkpoint_rgb_base64();
+    result->display->published_configuration =
+        fdisbull_display_checkpoint_configuration();
+
+    result->retrace = g_new0(FdisbullInstrumentedRetraceState, 1);
+    result->retrace->admitted = retrace != NULL;
+    result->retrace->profile = g_strdup(retrace ? "precise" : "off");
+    if (retrace) {
+        result->retrace->device_path = fdisbull_retrace_checkpoint_device_path();
+        result->retrace->info = g_steal_pointer(&retrace);
+        result->retrace->configuration =
+            QAPI_CLONE(FdisbullVgaConfigurationSnapshot, configuration->current);
+    }
+    return g_steal_pointer(&result);
+}
+
+FdisbullInstrumentedCheckpointExport *
+qmp_x_fdisbull_instrumented_checkpoint_export(Error **errp)
+{
+    g_autoptr(FdisbullInstrumentedCheckpointState) state = NULL;
+    g_autofree char *json = NULL;
+    g_autofree char *digest = NULL;
+    FdisbullInstrumentedCheckpointExport *result;
+
+    assert(bql_locked());
+    state = capture_state(errp);
+    if (!state) {
+        return NULL;
+    }
+    json = state_json(state, errp);
+    if (!json) {
+        return NULL;
+    }
+    if (strlen(json) > 48 * 1024 * 1024) {
+        error_setg(errp, "Instrumented checkpoint sidecar exceeds 48 MiB");
+        return NULL;
+    }
+    digest = sha256_text(json);
+    g_free(export_token);
+    g_free(export_json);
+    g_free(export_sha256);
+    export_token = g_uuid_string_random();
+    export_json = g_strdup(json);
+    export_sha256 = g_strdup(digest);
+
+    result = g_new0(FdisbullInstrumentedCheckpointExport, 1);
+    result->state = g_steal_pointer(&json);
+    result->sha256 = g_steal_pointer(&digest);
+    result->token = g_strdup(export_token);
+    return result;
+}
+
+bool fdisbull_instrumented_checkpoint_snapshot_save_authorize(
+    const char *token, Error **errp)
+{
+    g_autoptr(FdisbullInstrumentedCheckpointState) state = NULL;
+    g_autofree char *json = NULL;
+    g_autofree char *digest = NULL;
+
+    assert(bql_locked());
+    if (!token || !export_token || strcmp(token, export_token) ||
+        save_busy || restore_pending) {
+        error_setg(errp, "Instrumented snapshot save token is absent, expired or already used");
+        return false;
+    }
+    state = capture_state(errp);
+    if (!state) {
+        return false;
+    }
+    json = state_json(state, errp);
+    if (!json) {
+        return false;
+    }
+    digest = sha256_text(json);
+    if (strcmp(json, export_json) || strcmp(digest, export_sha256)) {
+        error_setg(errp, "Native instrumented state changed after checkpoint export");
+        return false;
+    }
+    save_busy = true;
+    return true;
+}
+
+void fdisbull_instrumented_checkpoint_snapshot_save_complete(
+    const char *token, bool success)
+{
+    assert(bql_locked());
+    (void)success;
+    if (export_token && token && !strcmp(token, export_token)) {
+        save_busy = false;
+        g_clear_pointer(&export_token, g_free);
+        g_clear_pointer(&export_json, g_free);
+        g_clear_pointer(&export_sha256, g_free);
+    }
+}
+
+bool fdisbull_instrumented_checkpoint_snapshot_load_begin(Error **errp)
+{
+    g_autoptr(FdisbullClockInfo) clock = NULL;
+    Error *local_err = NULL;
+
+    assert(bql_locked());
+    if (save_busy || restore_pending) {
+        error_setg(errp, "An instrumented checkpoint transaction is already active");
+        return false;
+    }
+    clock = qmp_x_fdisbull_query_clock(&local_err);
+    if (!clock || clock->running || clock->pending_stop ||
+        !clock->budget_supported ||
+        clock->budget_state == FDISBULL_CLOCK_BUDGET_STATE_ARMED ||
+        clock->budget_state == FDISBULL_CLOCK_BUDGET_STATE_FIRED ||
+        !fdisbull_input_checkpoint_safe(&local_err) ||
+        !fdisbull_clock_checkpoint_validate(clock, clock->virtual_ns,
+                                            &local_err)) {
+        if (!local_err) {
+            error_setg(&local_err, "Instrumented snapshot load requires a valid stopped virtual profile");
+        }
+        error_propagate(errp, local_err);
+        return false;
+    }
+    restore_pending = true;
+    return true;
+}
+
+void fdisbull_instrumented_checkpoint_snapshot_load_complete(bool success)
+{
+    assert(bql_locked());
+    if (!success) {
+        restore_pending = false;
+    }
+}
