+static bool vga_fdisbull_sample_640x480(
+    VGACommonState *s, const FdisbullChain4Geometry *geometry,
+    const FdisbullVgaConfigurationSnapshot *configuration,
+    const FdisbullRetraceInfo *retrace, int row, uint8_t *rgb,
+    FdisbullVideoFrameSource *source, Error **errp)
+{
+    bool banked = vbe_enabled(s);
+    unsigned pitch = banked ? 640 : 320;
+    FdisbullVideoScanoutLayout layout = banked ? FDISBULL_SCANOUT_VBE101 :
+                                               FDISBULL_SCANOUT_MODE12;
+
+    if (geometry->width != FDISBULL_VIDEO_WIDE_WIDTH ||
+        geometry->height != FDISBULL_VIDEO_WIDE_HEIGHT ||
+        geometry->start_address != 0 || geometry->line_offset != pitch ||
+        geometry->line_compare < FDISBULL_VIDEO_WIDE_HEIGHT - 1 ||
+        geometry->multi_scan || geometry->hpel || !geometry->display_enabled ||
+        !(s->gr[VGA_GFX_MISC] & VGA_GR06_GRAPHICS_MODE) ||
+        (s->cr[VGA_CRTC_MODE] & 3) != 3 || s->dac_8bit ||
+        pitch * FDISBULL_VIDEO_WIDE_HEIGHT > MIN(s->vram_size, s->vbe_size)) {
+        error_setg(errp, "Unsupported 640x480 scanout geometry");
+        return false;
+    }
+    if (banked) {
+        if (geometry->depth != 8 || geometry->shift_control != 2 ||
+            (s->vbe_regs[VBE_DISPI_INDEX_ENABLE] &
+             ~(VBE_DISPI_ENABLED | VBE_DISPI_NOCLEARMEM)) ||
+            s->vbe_regs[VBE_DISPI_INDEX_X_OFFSET] ||
+            s->vbe_regs[VBE_DISPI_INDEX_Y_OFFSET] ||
+            s->vbe_regs[VBE_DISPI_INDEX_VIRT_WIDTH] != FDISBULL_VIDEO_WIDE_WIDTH ||
+            (s->gr[VGA_GFX_MISC] & 0x0c) != 0x04) {
+            error_setg(errp, "Unsupported banked VBE 101 scanout layout");
+            return false;
+        }
+    } else if (!retrace->phase_supported || geometry->depth != 0 ||
+               geometry->shift_control || geometry->chain4 ||
+               (sr(s, VGA_SEQ_CLOCK_MODE) & 8) ||
+               pitch * FDISBULL_VIDEO_WIDE_HEIGHT > VGA_VRAM_SIZE) {
+        error_setg(errp, "Unsupported VGA Mode 12 scanout layout");
+        return false;
+    }
+
+    *source = (FdisbullVideoFrameSource) {
+        .configuration_generation = configuration->configuration_generation,
+        .timing_generation = retrace->timing_generation,
+        .layout = layout,
+    };
+    if (banked) {
+        /* Bochs VBE has no analog raster timing. This profile models the
+         * DOSBox-X S3 BIOS's Mode 101h timing: 800 dots, 525 lines, and a
+         * 29.403 MHz PLL result for the nominal 70 Hz mode. Quantize the
+         * individual line to virtual-clock nanoseconds. */
+        const int64_t clock_hz = 29403000;
+
+        source->line_period_ns = (800 * (int64_t)NANOSECONDS_PER_SECOND +
+                                  clock_hz / 2) / clock_hz;
+        source->period_ns = source->line_period_ns * 525;
+    } else {
+        source->line_period_ns = retrace->timing->ticks_per_char *
+                                 retrace->timing->htotal;
+        source->period_ns = retrace->phase->period_ns;
+        if (retrace->timing->vstart < FDISBULL_VIDEO_WIDE_HEIGHT) {
+            error_setg(errp, "Mode 12 retrace overlaps visible rows");
+            return false;
+        }
+    }
+    if (!fdisbull_video_scanout_timing_valid(layout, source->line_period_ns,
+                                            source->period_ns)) {
+        error_setg(errp, "Insufficient timing for 480 visible rows");
+        return false;
+    }
+    if (row >= 0) {
+        vga_fdisbull_scanout_row(s, layout, s->vram_ptr + row * pitch, rgb);
+    }
+    return true;
+}
