+static void vga_fdisbull_scanout_row(const VGACommonState *s,
+                                     FdisbullVideoScanoutLayout layout,
+                                     const uint8_t *memory, uint8_t *rgb)
+{
+    const unsigned plane_mask = s->ar[VGA_ATC_PLANE_ENABLE] & 15;
+
+    for (unsigned x = 0; x < FDISBULL_VIDEO_WIDE_WIDTH; x++) {
+        unsigned index;
+
+        if (layout == FDISBULL_SCANOUT_MODE12) {
+            const uint8_t *planes = memory + (x / 8) * 4;
+            unsigned bit = 7 - (x % 8);
+            unsigned color = 0;
+
+            for (unsigned plane = 0; plane < 4; plane++) {
+                color |= ((planes[plane] >> bit) & 1) << plane;
+            }
+            index = vga_palette16_index(s, color & plane_mask);
+        } else {
+            index = memory[x];
+        }
+        for (unsigned channel = 0; channel < 3; channel++) {
+            *rgb++ = fdisbull_video_dac(s->palette[index * 3 + channel],
+                                       s->dac_8bit);
+        }
+    }
+}
