include README.md AGENTS.md pyproject.toml MANIFEST.in player/pyproject.toml
include player/fdisbull_player/*.py
recursive-include src/fdisbull *.py *.c *.sh
recursive-include src/fdisbull/data *.json *.txt
recursive-include src/fdisbull/skills *.md
recursive-include tests *.py
include tests/wine_gui_fixture.c
include tests/dosbox_zip_empty_write.cpp
include tests/ida_rpc_vectors.json
include src/fdisbull/ida_guest/SDK-LICENSE.txt
recursive-include docs *.md
include docs/evidence/spatial-2026-10-29/verification.json
include docs/evidence/zork-2026-10-29/verification.json
recursive-include scripts *.py
prune examples
prune history
prune experimental
prune build
prune dist
prune .github
global-exclude __pycache__ *.py[cod] *.fdb *.fdb-* *.db *.sqlite *.sqlite3 *.sav *.state *.exe *.com *.dll *.bin *.dat *.DAT
